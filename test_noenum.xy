/**
 * @file types.xy
 * @brief 玄语L2编译器 - 共享类型定义
 * @description 所有模块共享的类型、
/* ============ Token 结构 ============ */
结构体 Token {
    类型: 整数,      // TokenType
    值: 文本,        // token 文本值
    行号: 整数,      // 所在行
    列号: 整数,      // 所在列
    开始位置: 整数,  // 在源码中的开始位置
    结束位置: 整数   // 在源码中的结束位置
}
/* ============ AST 节点类型 ============ */
/* ============ AST 节点结构体 ============ */
结构体 AST节点 {
    id: 整数,
    kind: 整数,
    name: 文本,
    value: 文本,
    intValue: 整数,
    line: 整数,
    children: 列表
}
/* ============ Lexer 结构体 ============ */
结构体 Lexer {
    源码: 文本,
    位置: 整数,
    长度: 整数,
    行号: 整数,
    列号: 整数,
    当前字符: 整数,
    token列表: 列表,
    开始位置: 整数,
    当前位置: 整数,
    当前token: Token
}
/* ============ Lexer 上下文结构体 ============ */
结构体 LexerContext {
    状态: 整数,
    起始位置: 整数,
    当前位置: 整数,
    行号: 整数,
    列号: 整数,
    错误信息: 文本,
    是否错误: 整数
}
/* ============ Parser 结构体 ============ */
结构体 Parser {
    tokens: 列表,
    pos: 整数,
    errors: 列表,
    nodeCount: 整数,
    tokenCount: 整数,
    当前位置: 整数,
    当前行号: 整数,
    当前列号: 整数,
    源码长度: 整数
}
/* ============ 类型别名
/* ============ 符号表结构体 ============ */
结构体 符号 {
    名称: 文本,
    类型: 整数,
    可变: 整数,
    行号: 整数,
    作用域层级: 整数,
    已初始化: 整数
}
/* ============ 作用域结构体 ============ */
结构体 作用域 {
    名称: 文本,
    符号表: 列表,
    父作用域: 整数,
    层级: 整数
}
/* ============ 循环状态结构体 ============ */
结构体 循环状态 {
    激活: 整数,
    循环层级: 整数
}
/* ============ Sema 结构体 ============ */
结构体 Sema {
    源码: 文本,
    当前作用域: 整数,
    作用域栈: 列表,
    错误列表: 列表,
    警告列表: 列表,
    当前行号: 整数,
    错误计数: 整数,
    警告计数: 整数,
    全局作用域: 整数,
    循环状态: 循环状态,
    当前函数名: 文本,
    当前函数返回类型: 整数
}
/* ============ 循环上下文结构体（用于 break/continue） ============ */
结构体 循环上下文 {
    循环开始标签: 文本,
    循环体标签: 文本,
    continue标签: 文本,
    结束标签: 文本
}
/* ============ Codegen 结构体 ============ */
结构体 Codegen {
    moduleName: 文本,
    tempCount: 整数,
    labelCount: 整数,
    funcCount: 整数,
    output: 文本,
    indent: 整数,
    stringConstCount: 整数,
    funcDefs: 列表,
    currentFunc: 文本,
    currentReturnType: 文本,
    variableMap: 列表,
    variableTypes: 列表,
    stringConstants: 列表,
    loopContextStack: 列表,
    currentFunctionIndex: 整数,
    functionIndexCounter: 整数,
    stringConstDefs: 文本
}
/* ============ 错误级别
/* ============ 错误恢复结构体 ============ */
结构体 ErrorRecovery {
    已恢复: 整数,
    跳过Token数: 整数,
    恢复点: 整数
}

函数 主(): 整数 { 返回 0 }
