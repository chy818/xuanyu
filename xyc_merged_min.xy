    } 否则 若 funcName == "列表克隆" 则 {
        映射后的函数名 = "rt_list_clone"
    } 否则 若 funcName == "文件读取" 则 {
        映射后的函数名 = "file_read"
    } 否则 若 funcName == "文件写入" 则 {
        映射后的函数名 = "file_write"
    } 否则 若 funcName == "取参数个数" 则 {
        映射后的函数名 = "argc"
    } 否则 若 funcName == "取参数" 则 {
        映射后的函数名 = "argv"
    } 否则 若 funcName == "取时间戳" 则 {
        映射后的函数名 = "rt_time"
    } 否则 若 funcName == "执行系统命令" 则 {
        映射后的函数名 = "exec_cmd"
    } 否则 若 funcName == "命令输出" 则 {
        映射后的函数名 = "cmd_output"
    } 否则 若 funcName == "退出" 则 {
        映射后的函数名 = "rt_exit"
    } 否则 若 funcName == "申请内存" 则 {
        映射后的函数名 = "rt_malloc"
    } 否则 若 funcName == "释放内存块" 则 {
        映射后的函数名 = "rt_free"
    }
    定义 可变 returnType: 文本
    returnType = "i64"
    若 funcName == "_u6574_u6570_u8f6c_u6587_u672c_u90e8" 则 {
        returnType = "double"
    } 否则 {
        若 funcName == "print_float" 则 {
            returnType = "double"
        }
    }
    若 funcName == "打印" || funcName == "打印整数" ||
       funcName == "列表追加" || funcName == "列表设置" ||
       funcName == "列表清空" || funcName == "运行时错误" ||
       funcName == "退出" || funcName == "释放内存块" ||
       funcName == "列表添加" 则 {
        returnType = "void"
    }
    若 funcName == "文本拼接" || funcName == "文本连接" ||
       funcName == "列表" || funcName == "列表获取" ||
       funcName == "文件读取" || funcName == "命令行参数" ||
       funcName == "输入文本" || funcName == "申请内存" ||
       funcName == "文本截取" || funcName == "文本转大写" ||
       funcName == "文本转小写" || funcName == "创建列表" ||
       funcName == "列表克隆" || funcName == "命令输出" ||
       funcName == "取列表元素" || funcName == "添加列表元素" ||
       funcName == "获取参数" || funcName == "获取命令输出" 则 {
        returnType = "i8*"
    }
    定义 可变 argStr: 文本
    argStr = ""
    若 列表长度(args) > 0 则 {
        定义 可变 i: 整数
        i = 0
        当 i < 列表长度(args) 则 {
            定义 可变 argNode: AST节点
            argNode = 列表获取(args, i)
            定义 可变 argValue: 文本
            argValue = codegen遍历表达式(cg, argNode)
            定义 可变 paramType: 文本
            paramType = codegen获取参数类型(映射后的函数名, i)
            若 i > 0 则 {
                argStr = argStr + ", "
            }
            argStr = argStr + paramType + " %" + argValue
            i = i + 1
        }
    }
    若 returnType == "void" 则 {
        若 argStr != "" 则 {
            codegenEmit(cg, "  call void @" + 映射后的函数名 + "(" + argStr + ")")
        } 否则 {
            codegenEmit(cg, "  call void @" + 映射后的函数名 + "()")
        }
        result = ""
    } 否则 {
        若 argStr != "" 则 {
            codegenEmit(cg, "  %" + result + " = call " + returnType + " @" + 映射后的函数名 + "(" + argStr + ")")
        } 否则 {
            codegenEmit(cg, "  %" + result + " = call " + returnType + " @" + 映射后的函数名 + "()")
        }
    }
    返回 result
}
函数 codegen获取参数类型(funcName: 文本, paramIndex: 整数): 文本 {
    若 funcName == "rt_list_append" 则 {
        返回 "i8*"
    }
    若 funcName == "rt_list_set" 则 {
        若 paramIndex == 0 || paramIndex == 2 则 {
            返回 "i8*"
        }
        若 paramIndex == 1 则 {
            返回 "i64"
        }
    }
    若 funcName == "rt_list_get" 则 {
        若 paramIndex == 0 则 {
            返回 "i8*"
        }
        若 paramIndex == 1 则 {
            返回 "i64"
        }
    }
    若 funcName == "rt_list_len" 则 {
        返回 "i8*"
    }
    若 funcName == "rt_string_len" 则 {
        返回 "i8*"
    }
    若 funcName == "rt_string_concat" 则 {
        返回 "i8*"
    }
    若 funcName == "rt_string_slice" 则 {
        若 paramIndex == 0 则 {
            返回 "i8*"
        }
        返回 "i64"
    }
    若 funcName == "rt_str_new" 则 {
        返回 "i8*"
    }
    若 funcName == "print" || funcName == "rt_print" 则 {
        返回 "i8*"
    }
    若 funcName == "print_string" 则 {
        返回 "i8*"
    }
    若 funcName == "rt_list_new" 则 {
        返回 "i64"
    }
    若 funcName == "file_read" 则 {
        返回 "i8*"
    }
    若 funcName == "file_write" 则 {
        返回 "i8*"
    }
    若 funcName == "file_exists" 则 {
        返回 "i8*"
    }
    若 funcName == "file_delete" 则 {
        返回 "i8*"
    }
    若 funcName == "exec_cmd" 则 {
        返回 "i8*"
    }
    若 funcName == "argv" 则 {
        返回 "i64"
    }
    若 funcName == "argc" 则 {
        返回 "i64"
    }
    若 funcName == "rt_error" 则 {
        返回 "i8*"
    }
    若 funcName == "rt_input_int" 则 {
        返回 "i64"
    }
    若 funcName == "rt_input_text" 则 {
        返回 "i64"
    }
    若 funcName == "print_int" || funcName == "rt_print_int" 则 {
        返回 "i64"
    }
    若 funcName == "rt_int_to_str" 则 {
        返回 "i64"
    }
    若 funcName == "rt_str_to_int" 则 {
        返回 "i8*"
    }
    若 funcName == "is_space" 则 {
        返回 "i8*"
    }
    若 funcName == "is_digit" 则 {
        返回 "i8*"
    }
    若 funcName == "is_alpha" 则 {
        返回 "i8*"
    }
    若 funcName == "is_alnum" 则 {
        返回 "i8*"
    }
    若 funcName == "rt_utf8_byte_length" 则 {
        返回 "i64"
    }
    若 funcName == "rt_is_utf8_leader" 则 {
        返回 "i64"
    }
    若 funcName == "rt_is_utf8_continuation" 则 {
        返回 "i64"
    }
    若 funcName == "rt_string_substring" 则 {
        若 paramIndex == 0 则 {
            返回 "i8*"
        }
        返回 "i64"
    }
    若 funcName == "rt_string_indexOf" 则 {
        返回 "i8*"
    }
    若 funcName == "rt_string_toUpperCase" 则 {
        返回 "i8*"
    }
    若 funcName == "rt_string_toLowerCase" 则 {
        返回 "i8*"
    }
    若 funcName == "rt_list_clear" 则 {
        返回 "i8*"
    }
    若 funcName == "rt_list_clone" 则 {
        返回 "i8*"
    }
    若 funcName == "rt_time" 则 {
        返回 "i64"
    }
    若 funcName == "cmd_output" 则 {
        返回 "i8*"
    }
    若 funcName == "rt_exit" 则 {
        返回 "i64"
    }
    若 funcName == "rt_malloc" 则 {
        返回 "i64"
    }
    若 funcName == "rt_free" 则 {
        返回 "i8*"
    }
    返回 "i64"
}
函数 codegenNewLabelWithPrefix(cg: Codegen, prefix: 文本): 文本 {
    定义 可变 num: 整数
    num = cg.labelCount
    cg.labelCount = cg.labelCount + 1
    定义 可变 result: 文本
    result = prefix
    定义 可变 numStr: 文本
    numStr = 整数转文本(num)
    result = result + numStr
    返回 result
}
函数 codegen遍历节点(cg: Codegen, nodeKind: 整数, nodeName: 文本): 文本 {
    打印("遍历节点: kind=")
    打印(nodeKind)
    打印(", name=")
    打印(nodeName)
    定义 可变 result: 文本
    result = ""
    若 nodeKind == 0 则 {
        result = codegen生成标识符(cg, nodeName)
    } 否则 {
        若 nodeKind == 2 则 {
            result = codegen生成变量声明(cg, nodeName)
        } 否则 {
            若 nodeKind == 5 则 {
                result = codegen生成函数调用(cg, nodeName, 0)
            } 否则 {
                若 nodeKind == 10 则 {
                    result = codegen生成二元表达式(cg, nodeName, "", "")
                } 否则 {
                    若 nodeKind == 14 则 {
                        result = codegen生成字面量(cg, nodeName)
                    }
                }
            }
        }
    }
    返回 result
}
函数 codegen生成标识符(cg: Codegen, name: 文本): 文本 {
    定义 可变 result: 文本
    result = name + "_val"
    定义 可变 line: 文本
    line = "%" + result + " = load i64, i64* %" + name + "_slot"
    codegenEmit(cg, line)
    返回 result
}
函数 codegen生成变量声明(cg: Codegen, name: 文本): 文本 {
    定义 可变 tmpPtr: 文本
    tmpPtr = name + "_slot"
    定义 可变 line: 文本
    line = "%" + tmpPtr + " = alloca i64"
    codegenEmit(cg, line)
    返回 tmpPtr
}
函数 codegen生成函数调用(cg: Codegen, funcName: 文本, argCount: 整数): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    定义 可变 line: 文本
    若 funcName == "_u5217_u8868_u8ffd_u52a0" 则 {
        line = "%" + result + " = call i64 @_u5217_u8868_u8ffd_u52a0(i8* null, i64 0)"
        codegenEmit(cg, line)
        返回 result
    }
    若 funcName == "_u5217_u8868_u8bbe_u7f6e" 则 {
        line = "call void @_u5217_u8868_u8bbe_u7f6e(i8* null, i64 0, i64 0)"
        codegenEmit(cg, line)
        返回 result
    }
    若 funcName == "_u5217_u8868_u83b7_u53d6" 则 {
        line = "%" + result + " = call i64 @_u5217_u8868_u83b7_u53d6(i8* null, i64 0)"
        codegenEmit(cg, line)
        返回 result
    }
    若 funcName == "_u5217_u8868_u957f_u5ea6" 则 {
        line = "%" + result + " = call i64 @_u5217_u8868_u957f_u5ea6(i8* null)"
        codegenEmit(cg, line)
        返回 result
    }
    若 funcName == "rt_list_new" 则 {
        line = "%" + result + " = call i8* @rt_list_new()"
        codegenEmit(cg, line)
        返回 result
    }
    line = "%" + result + " = call i64 @" + funcName + "()"
    codegenEmit(cg, line)
    返回 result
}
函数 codegen生成二元表达式(cg: Codegen, op: 文本, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    定义 可变 llOp: 文本
    llOp = "add"
    若 op == "+" 则 { llOp = "add" }
    若 op == "-" 则 { llOp = "sub" }
    若 op == "*" 则 { llOp = "mul" }
    若 op == "/" 则 { llOp = "sdiv" }
    若 op == "%" 则 { llOp = "srem" }
    定义 可变 line: 文本
    line = "%" + result + " = " + llOp + " i64 %" + left + ", %" + right
    codegenEmit(cg, line)
    返回 result
}
函数 codegen生成字面量(cg: Codegen, value: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    定义 可变 line: 文本
    line = "%" + result + " = add i64 0, " + value
    codegenEmit(cg, line)
    返回 result
}
函数 codegen生成赋值IR(cg: Codegen, varName: 文本, value: 文本): 无返回 {
    定义 可变 tmpPtr: 文本
    tmpPtr = varName + "_slot"
    定义 可变 line: 文本
    line = "store i64 %" + value + ", i64* %" + tmpPtr
    codegenEmit(cg, line)
}
函数 codegen生成If语句(cg: Codegen, condVar: 文本, thenLabel: 文本, elseLabel: 文本, endLabel: 文本): 无返回 {
    定义 可变 line: 文本
    line = "br i1 %" + condVar + ", label %" + thenLabel + ", label %" + elseLabel
    codegenEmit(cg, line)
}
函数 codegen生成While循环(cg: Codegen, condVar: 文本, bodyLabel: 文本, endLabel: 文本): 无返回 {
    定义 可变 line: 文本
    line = "br i1 %" + condVar + ", label %" + bodyLabel + ", label %" + endLabel
    codegenEmit(cg, line)
}
函数 codegen生成For循环(cg: Codegen, varName: 文本, startVal: 整数, endVal: 整数, bodyLabel: 文本, incLabel: 文本, endLabel: 文本): 无返回 {
    定义 可变 tmpPtr: 文本
    tmpPtr = varName + "_slot"
    定义 可变 startTmp: 文本
    startTmp = codegenNewTemp(cg)
    定义 可变 line: 文本
    line = "%" + startTmp + " = add i64 0, " + 整数转文本(startVal)
    codegenEmit(cg, line)
    line = "store i64 %" + startTmp + ", i64* %" + tmpPtr
    codegenEmit(cg, line)
    line = "br label %" + incLabel
    codegenEmit(cg, line)
}
函数 codegen生成Match语句(cg: Codegen, subjectVar: 文本, branchCount: 整数): 无返回 {
    打印("生成 match 语句 IR, subject=")
    打印(subjectVar)
    打印(", 分支数=")
    打印(branchCount)
}
函数 codegen生成返回IR(cg: Codegen, value: 文本): 无返回 {
    定义 可变 line: 文本
    line = "ret i64 %" + value
    codegenEmit(cg, line)
}
函数 codegen生成BreakIR(cg: Codegen, endLabel: 文本): 无返回 {
    定义 可变 line: 文本
    line = "br label %" + endLabel
    codegenEmit(cg, line)
}
函数 codegen生成ContinueIR(cg: Codegen, loopLabel: 文本): 无返回 {
    定义 可变 line: 文本
    line = "br label %" + loopLabel
    codegenEmit(cg, line)
}
函数 codegen生成比较IR(cg: Codegen, op: 文本, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    定义 可变 llOp: 文本
    llOp = "eq"
    若 op == "==" 则 { llOp = "eq" }
    若 op == "!=" 则 { llOp = "ne" }
    若 op == "<" 则 { llOp = "slt" }
    若 op == ">" 则 { llOp = "sgt" }
    若 op == "<=" 则 { llOp = "sle" }
    若 op == ">=" 则 { llOp = "sge" }
    定义 可变 line: 文本
    line = "%" + result + " = icmp " + llOp + " i64 %" + left + ", %" + right
    codegenEmit(cg, line)
    返回 result
}
函数 codegen生成逻辑与(cg: Codegen, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    定义 可变 line: 文本
    line = "%" + result + " = and i1 %" + left + ", %" + right
    codegenEmit(cg, line)
    返回 result
}
函数 codegen生成逻辑或(cg: Codegen, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    定义 可变 line: 文本
    line = "%" + result + " = or i1 %" + left + ", %" + right
    codegenEmit(cg, line)
    返回 result
}
函数 codegen生成逻辑非(cg: Codegen, operand: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    定义 可变 line: 文本
    line = "%" + result + " = xor i1 %" + operand + ", true"
    codegenEmit(cg, line)
    返回 result
}
函数 codegen生成负值(cg: Codegen, operand: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    定义 可变 line: 文本
    line = "%" + result + " = sub i64 0, %" + operand
    codegenEmit(cg, line)
    返回 result
}
函数 codegen创建统计(): CodegenStats {
    定义 可变 stats: CodegenStats
    stats.生成的指令数 = 0
    stats.生成的分支数 = 0
    stats.生成的函数数 = 0
    stats.生成的全局变量数 = 0
    stats.总内存分配 = 0
    返回 stats
}
函数 codegen打印统计(stats: CodegenStats): 无返回 {
    打印("=== 代码生成统计 ===")
    打印("  生成的指令数: ")
    打印(stats.生成的指令数)
    打印("  生成的分支数: ")
    打印(stats.生成的分支数)
    打印("  生成的函数数: ")
    打印(stats.生成的函数数)
    打印("  生成的全局变量数: ")
    打印(stats.生成的全局变量数)
    打印("  总内存分配: ")
