        当 tok.值 != "{" && tok.值 != "" && tok.类型 != 6 则 {
            p.pos = p.pos + 1
            tok = parserPeekToken(p)
        }
    }
    返回 whereNode
}
函数 parser创建错误恢复(): ErrorRecovery {
    定义 可变 recovery: ErrorRecovery
    recovery.已恢复 = 0
    recovery.跳过Token数 = 0
    recovery.恢复点 = 0
    返回 recovery
}
函数 parser找到恢复点(p: Parser): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    若 tok.值 == "函数" 则 { 返回 1 }
    若 tok.值 == "定义" 则 { 返回 1 }
    若 tok.值 == "若" 则 { 返回 1 }
    若 tok.值 == "当" 则 { 返回 1 }
    若 tok.值 == "循环" 则 { 返回 1 }
    若 tok.值 == "返回" 则 { 返回 1 }
    若 tok.值 == "{" 则 { 返回 1 }
    若 tok.值 == "}" 则 { 返回 1 }
    若 tok.值 == "结构体" 则 { 返回 1 }
    若 tok.值 == "枚举" 则 { 返回 1 }
    若 tok.值 == "模块" 则 { 返回 1 }
    若 tok.值 == "导入" 则 { 返回 1 }
    返回 0
}
函数 parser跳过到恢复点(p: Parser): Parser {
    定义 可变 recovery: ErrorRecovery
    recovery = parser创建错误恢复()
    当 p.pos < p.tokenCount && recovery.已恢复 == 0 则 {
        定义 可变 tok: Token
        tok = parserPeekToken(p)
        若 parser找到恢复点(p) == 1 则 {
            recovery.已恢复 = 1
        } 否则 {
            p.pos = p.pos + 1
            recovery.跳过Token数 = recovery.跳过Token数 + 1
        }
    }
    返回 p
}
函数 parser错误报告恢复(p: Parser, 消息: 文本): Parser {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    打印("解析错误 [行 ")
    打印(tok.行号)
    打印("]: ")
    打印(消息)
    p = parser跳过到恢复点(p)
    返回 p
}
函数 parser检查缺失Token(p: Parser, expected: 文本): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    若 tok.值 == expected 则 {
        返回 1
    }
    打印("警告: 期望 '")
    打印(expected)
    打印("'，实际 '")
    打印(tok.值)
    打印("'")
    返回 0
}
函数 parser插入缺失Token(p: Parser, tokenType: 整数, tokenValue: 文本): Token {
    定义 可变 inserted: Token
    inserted.类型 = tokenType
    inserted.值 = tokenValue
    inserted.行号 = p.当前行号
    inserted.列号 = p.当前列号
    inserted.开始位置 = p.当前位置
    inserted.结束位置 = p.当前位置
    打印("插入缺失 token: ")
    打印(tokenValue)
    返回 inserted
}
函数 parser同步到函数(p: Parser): Parser {
    定义 可变 depth: 整数
    depth = 0
    当 p.pos < p.tokenCount 则 {
        定义 可变 tok: Token
        tok = parserPeekToken(p)
        若 tok.值 == "函数" && depth == 0 则 {
            返回 p
        }
        若 tok.值 == "{" 则 {
            depth = depth + 1
        } 否则 {
            若 tok.值 == "}" 则 {
                depth = depth - 1
            }
        }
        p.pos = p.pos + 1
    }
    返回 p
}
函数 parser同步到语句(p: Parser): Parser {
    当 p.当前位置 < p.源码长度 则 {
        定义 可变 tok: Token
        tok = parserPeekToken(p)
        若 tok.值 == "若" 则 { 返回 p }
        若 tok.值 == "当" 则 { 返回 p }
        若 tok.值 == "循环" 则 { 返回 p }
        若 tok.值 == "定义" 则 { 返回 p }
        若 tok.值 == "返回" 则 { 返回 p }
        若 tok.值 == "打印" 则 { 返回 p }
        若 tok.值 == "{" 则 { 返回 p }
        若 tok.值 == "}" 则 { 返回 p }
        若 tok.类型 == 6 则 { 返回 p }
        p.pos = p.pos + 1
    }
    返回 p
}
函数 parserPanic恢复(p: Parser): Parser {
    打印("进入 panic 模式恢复...")
    p = parser同步到函数(p)
    打印("panic 模式恢复完成")
    返回 p
}
函数 parser记录边界(p: Parser): 无返回 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    打印("解析位置: 行 ")
    打印(tok.行号)
    打印(", 列 ")
    打印(tok.列号)
}
函数 parser诊断(p: Parser): 无返回 {
    打印("=== 解析器诊断 ===")
    打印("  当前位置: ")
    打印(p.pos)
    打印("/")
    打印(p.tokenCount)
    打印("  节点计数: ")
    打印(p.nodeCount)
    打印("  错误列表长度: ")
    打印(列表长度(p.errors))
}
函数 打印AST节点(node: AST节点, 缩进: 整数): 无返回 {
    定义 可变 i: 整数
    i = 0
    当 i < 缩进 则 {
        打印("  ")
        i = i + 1
    }
    定义 可变 类型名: 文本
    类型名 = ""
    若 node.kind == 0 则 { 类型名 = "程序" }
    若 node.kind == 1 则 { 类型名 = "函数定义" }
    若 node.kind == 2 则 { 类型名 = "参数列表" }
    若 node.kind == 3 则 { 类型名 = "变量定义" }
    若 node.kind == 4 则 { 类型名 = "赋值语句" }
    若 node.kind == 5 则 { 类型名 = "if语句" }
    若 node.kind == 6 则 { 类型名 = "while语句" }
    若 node.kind == 7 则 { 类型名 = "循环语句" }
    若 node.kind == 8 则 { 类型名 = "返回语句" }
    若 node.kind == 9 则 { 类型名 = "表达式语句" }
    若 node.kind == 10 则 { 类型名 = "二元表达式" }
    若 node.kind == 11 则 { 类型名 = "一元表达式" }
    若 node.kind == 12 则 { 类型名 = "调用表达式" }
    若 node.kind == 13 则 { 类型名 = "标识符表达式" }
    若 node.kind == 14 则 { 类型名 = "字面量表达式" }
    若 node.kind == 15 则 { 类型名 = "类型转换" }
    若 node.kind == 16 则 { 类型名 = "break语句" }
    若 node.kind == 17 则 { 类型名 = "continue语句" }
    若 node.kind == 18 则 { 类型名 = "块语句" }
    若 node.kind == 19 则 { 类型名 = "赋值表达式" }
    若 node.kind == 20 则 { 类型名 = "for循环" }
    若 node.kind == 21 则 { 类型名 = "结构体定义" }
    若 node.kind == 22 则 { 类型名 = "枚举定义" }
    若 node.kind == 23 则 { 类型名 = "结构体字段" }
    若 node.kind == 24 则 { 类型名 = "枚举成员" }
    若 node.kind == 25 则 { 类型名 = "match语句" }
    若 node.kind == 26 则 { 类型名 = "match分支" }
    若 node.kind == 27 则 { 类型名 = "match默认分支" }
    若 node.kind == 28 则 { 类型名 = "导入语句" }
    若 node.kind == 29 则 { 类型名 = "模块定义" }
    若 node.kind == 30 则 { 类型名 = "外部声明" }
    打印("[")
    打印(类型名)
    打印("]")
    若 node.name != "" 则 {
        打印(" 名称: ")
        打印(node.name)
    }
    若 node.value != "" 则 {
        打印(" 值: '")
        打印(node.value)
        打印("'")
    }
    若 node.line > 0 则 {
        打印(" 行: ")
        打印(node.line)
    }
    打印("")
    定义 可变 childCount: 整数
    childCount = 列表长度(node.children)
    i = 0
    当 i < childCount 则 {
        定义 可变 child: AST节点
        child = 列表获取(node.children, i)
        打印AST节点(child, 缩进 + 1)
        i = i + 1
    }
}
函数 打印AST(root: AST节点): 无返回 {
    打印("=== AST 树 ===")
    打印AST节点(root, 0)
    打印("=== AST 结束 ===")
}
函数 parser获取统计(p: Parser): 列表 {
    定义 可变 stats: 列表
    stats = 列表()
    返回 stats
}
函数 parser打印进度(p: Parser): 无返回 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    详细输出("解析进度: 位置=")
    详细输出(整数转文本(p.pos))
    详细输出("/")
    详细输出(整数转文本(p.tokenCount))
    详细输出(", 当前Token=")
    详细输出(tok.值)
}
函数 parser验证状态(p: Parser): 整数 {
    若 p.pos < 0 则 { 返回 0 }
    若 p.pos > p.tokenCount 则 { 返回 0 }
    返回 1
}
函数 parserRun(tokens: 列表): 整数 {
    打印("=== 语法分析 ===")
    定义 可变 p: Parser
    p = parserInit(tokens)
    定义 可变 funcCount: 整数
    funcCount = 0
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    当 tok.类型 != 6 && tok.值 != "" && funcCount < 100 则 {
        若 tok.值 == "函数" 则 {
            定义 可变 funcNode: AST节点
            funcNode = parseFunction(p)
            funcCount = funcCount + 1
        } 否则 {
            若 tok.值 == "结构体" 则 {
                定义 可变 structNode: AST节点
                structNode = parseStructDefinition(p)
                打印("解析结构体: ")
                打印(structNode.name)
            } 否则 {
                若 tok.值 == "枚举" 则 {
                    定义 可变 enumNode: AST节点
                    enumNode = parseEnumDefinition(p)
                    打印("解析枚举: ")
                    打印(enumNode.name)
                } 否则 {
                    若 tok.值 == "引入" 则 {
                        定义 可变 importNode: AST节点
                        importNode = parseImportStatement(p)
                        打印("解析导入: ")
                        打印(importNode.name)
                    } 否则 {
                        若 tok.值 == "模块" 则 {
                            定义 可变 moduleNode: AST节点
                            moduleNode = parseModuleDefinition(p)
                            打印("解析模块: ")
                            打印(moduleNode.name)
                        } 否则 {
                            p.pos = p.pos + 1
                        }
                    }
                }
            }
        }
        tok = parserPeekToken(p)
    }
    打印("语法分析完成，共解析 ")
    打印(funcCount)
    打印(" 个函数")
    打印("生成 ")
    打印(p.nodeCount)
    打印(" 个 AST 节点")
    返回 funcCount
}
函数 parser分析Tokens(tokens: 列表, source: 文本): AST节点 {
    定义 可变 p: Parser
    p = parserInit(tokens)
    定义 可变 progNode: AST节点
    progNode = parserCreateNode(0, "程序", "", 0)  // kind=0 表示程序节点
    progNode.children = 列表()
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    当 tok.类型 != 6 && tok.值 != "" 则 {
        若 tok.值 == "函数" || tok.值 == "function" 则 {
            定义 可变 funcNode: AST节点
            funcNode = parseFunction(p)
            progNode.children.追加(funcNode)
        } 否则 若 tok.值 == "结构体" || tok.值 == "struct" 则 {
            定义 可变 structNode: AST节点
            structNode = parseStructDefinition(p)
            progNode.children.追加(structNode)
        } 否则 若 tok.值 == "枚举" || tok.值 == "enum" 则 {
            定义 可变 enumNode: AST节点
            enumNode = parseEnumDefinition(p)
            progNode.children.追加(enumNode)
        } 否则 若 tok.值 == "引入" || tok.值 == "import" 则 {
            定义 可变 importNode: AST节点
            importNode = parseImportStatement(p)
            progNode.children.追加(importNode)
        } 否则 若 tok.值 == "模块" || tok.值 == "module" 则 {
            定义 可变 moduleNode: AST节点
            moduleNode = parseModuleDefinition(p)
            progNode.children.追加(moduleNode)
        } 否则 若 tok.值 == "外部" || tok.值 == "extern" 则 {
            定义 可变 externalNode: AST节点
            externalNode = parseExternalDeclaration(p)
            progNode.children.追加(externalNode)
        } 否则 {
            p.pos = p.pos + 1
        }
        打印("[LOOP next tok='")
        打印(tok.值)
        打印("' type=")
        打印整数(tok.类型)
        打印("\n")
        tok = parserPeekToken(p)
    }
    打印("[PARSER DONE] children=")
    打印整数(列表长度(progNode.children))
    打印("\n")
    返回 progNode
}
函数 parseExternalDeclaration(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0
    定义 可变 node: AST节点
    node = parserCreateNode(30, "", "", line)
    node.children = 列表()
    tok = parserPeekToken(p)
    若 tok.值 == "外部" 则 {
        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    若 tok.类型 == 2 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }
    返回 node
}
// ==== sema_s.xy ====
函数 创建作用域(sema: Sema, 名称: 文本): 整数 {
    定义 可变 scope: 作用域
    scope.名称 = 名称
    scope.符号表 = 列表()
    scope.层级 = 列表长度(sema.作用域栈)
    若 列表长度(sema.作用域栈) > 0 则 {
        scope.父作用域 = sema.当前作用域
    } 否则 {
        scope.父作用域 = -1
    }
    定义 可变 idx: 整数
    idx = 列表长度(sema.作用域栈)
    列表追加(sema.作用域栈, scope)
    sema.当前作用域 = idx
    返回 idx
}
函数 退出作用域(sema: Sema): 整数 {
    定义 可变 prevScope: 整数
    prevScope = -1
    若 列表长度(sema.作用域栈) > 0 则 {
        定义 可变 currentScope: 作用域
        currentScope = sema.作用域栈[sema.当前作用域]
        prevScope = currentScope.父作用域
    }
    若 prevScope >= 0 则 {
        sema.当前作用域 = prevScope
    }
    返回 prevScope
}
函数 查找符号(sema: Sema, 名称: 文本): 整数 {
    定义 可变 scopeIdx: 整数
    scopeIdx = sema.当前作用域
    定义 可变 result: 整数
    result = -1
    当 scopeIdx >= 0 && scopeIdx < 列表长度(sema.作用域栈) 则 {
        定义 可变 scope: 作用域
        scope = sema.作用域栈[scopeIdx]
        定义 可变 i: 整数
        i = 0
        当 i < 列表长度(scope.符号表) 则 {
            定义 可变 sym: 符号
            sym = scope.符号表[i]
            若 sym.名称 == 名称 则 {
                result = scopeIdx
                返回 result
            }
            i = i + 1
        }
        若 scope.父作用域 < 0 则 {
            返回 -1
        }
        scopeIdx = scope.父作用域
    }
    返回 result
}
函数 获取符号类型(sema: Sema, 名称: 文本): 整数 {
    定义 可变 scopeIdx: 整数
    scopeIdx = sema.当前作用域
    当 scopeIdx >= 0 && scopeIdx < 列表长度(sema.作用域栈) 则 {
        定义 可变 scope: 作用域
        scope = sema.作用域栈[scopeIdx]
        定义 可变 i: 整数
        i = 0
        当 i < 列表长度(scope.符号表) 则 {
            定义 可变 sym: 符号
            sym = scope.符号表[i]
            若 sym.名称 == 名称 则 {
                返回 sym.类型
            }
            i = i + 1
        }
        若 scope.父作用域 < 0 则 {
            返回 -1
        }
        scopeIdx = scope.父作用域
    }
    返回 -1
}
函数 在当前作用域查找符号(sema: Sema, 名称: 文本): 整数 {
    若 sema.当前作用域 < 0 || sema.当前作用域 >= 列表长度(sema.作用域栈) 则 {
        返回 -1
    }
    定义 可变 scope: 作用域
    scope = sema.作用域栈[sema.当前作用域]
    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(scope.符号表) 则 {
        定义 可变 sym: 符号
        sym = scope.符号表[i]
        若 sym.名称 == 名称 则 {
            返回 i
        }
        i = i + 1
    }
    返回 -1
}
函数 添加符号(sema: Sema, 名称: 文本, 类型: 整数, 可变: 整数): 整数 {
    定义 可变 existingIdx: 整数
    existingIdx = 在当前作用域查找符号(sema, 名称)
    若 existingIdx >= 0 则 {
        报告错误(sema, "符号 '" + 名称 + "' 已在当前作用域定义", sema.当前行号)
        返回 -1
    }
    定义 可变 sym: 符号
    sym.名称 = 名称
    sym.类型 = 类型
    sym.可变 = 可变
    sym.行号 = sema.当前行号
    sym.作用域层级 = sema.当前作用域
    sym.已初始化 = 0
    若 sema.当前作用域 < 0 || sema.当前作用域 >= 列表长度(sema.作用域栈) 则 {
        创建作用域(sema, "全局")
    }
    定义 可变 scope: 作用域
    scope = 列表获取(sema.作用域栈, sema.当前作用域)
    列表追加(scope.符号表, sym)
    列表设置(sema.作用域栈, sema.当前作用域, scope)
    返回 0
}
函数 类型兼容(type1: 整数, type2: 整数): 整数 {
    若 type1 == type2 则 {
        返回 1
    }
    若 type1 == 0 && type2 == 1 则 {
        返回 1
    }
    若 type1 == 1 && type2 == 0 则 {
        返回 1
    }
    若 type1 == 3 && type2 == 6 则 { 返回 1 }
    若 type1 == 6 && type2 == 3 则 { 返回 1 }
    返回 0
}
函数 类型转文本(type: 整数): 文本 {
    若 type == 0 则 { 返回 "整数" }
    若 type == 1 则 { 返回 "浮点数" }
    若 type == 2 则 { 返回 "布尔" }
    若 type == 3 则 { 返回 "文本" }
    若 type == 4 则 { 返回 "字符" }
    若 type == 5 则 { 返回 "无返回" }
    若 type == 6 则 { 返回 "指针" }
    若 type == 7 则 { 返回 "列表" }
    返回 "未知"
}
函数 二元运算结果类型(leftType: 整数, op: 文本, rightType: 整数): 整数 {
    若 op == "+" || op == "-" || op == "*" || op == "/" || op == "%" 则 {
        若 leftType == 1 || rightType == 1 则 {
            返回 1
        }
        返回 0
    }
    若 op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" 则 {
        返回 2
    }
    若 op == "&&" || op == "||" 则 {
        返回 2
    }
    若 op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" 则 {
        返回 0
    }
    返回 0
}
函数 是有效类型(type: 整数): 整数 {
    若 type >= 0 && type <= 8 则 {
        返回 1
    }
    返回 0
}
函数 报告错误(sema: Sema, 消息: 文本, 行号: 整数): 整数 {
    sema.错误计数 = sema.错误计数 + 1
    打印("[错误]")
    若 行号 > 0 则 {
        打印(" (行")
        打印(行号)
        打印(")")
    }
    打印(": ")
    打印(消息)
    返回 -1
}
函数 报告警告(sema: Sema, 消息: 文本, 行号: 整数): 整数 {
    sema.警告计数 = sema.警告计数 + 1
    打印("[警告]")
    若 行号 > 0 则 {
        打印(" (行")
        打印(行号)
        打印(")")
    }
    打印(": ")
    打印(消息)
    返回 0
}
函数 报告详细错误(sema: Sema, 消息: 文本, 行号: 整数, 列号: 整数, 建议: 文本): 整数 {
    sema.错误计数 = sema.错误计数 + 1
    打印("━━━━━━━━━━━━━━━━━━━━━━━━")
    打印("[错误]")
    若 行号 > 0 则 {
        打印(" 位置: 第")
        打印(行号)
        打印("行")
        若 列号 > 0 则 {
            打印(", 第")
            打印(列号)
            打印("列")
        }
    }
    打印("")
    打印("  信息: " + 消息)
    若 建议 != "" 则 {
        打印("  建议: " + 建议)
    }
    打印("━━━━━━━━━━━━━━━━━━━━━━━━")
    返回 -1
}
函数 获取错误统计(sema: Sema): 文本 {
    定义 可变 result: 文本
    result = "错误: "
    result = result + 整数转文本(sema.错误计数)
    result = result + ", 警告: "
    result = result + 整数转文本(sema.警告计数)
    返回 result
}
函数 推断表达式类型(exprKind: 整数): 整数 {
    若 exprKind == 14 则 {
        返回 0
    }
    若 exprKind == 13 则 {
        返回 0
    }
    若 exprKind == 12 则 {
        返回 0
    }
    若 exprKind == 10 则 {
        返回 0
    }
    若 exprKind == 11 则 {
        返回 0
    }
    若 exprKind == 19 则 {
        返回 0
    }
    若 exprKind == 20 则 {
        返回 0
    }
    若 exprKind == 21 则 {
        返回 0
    }
    返回 0
}
函数 推断二元类型(左: 整数, op: 文本, 右: 整数): 整数 {
    若 op == "+" || op == "-" || op == "*" || op == "/" || op == "%" 则 {
        若 左 == 1 || 右 == 1 则 {
            返回 1
        }
        若 左 == 3 || 右 == 3 则 {
            返回 3
        }
        返回 0
    }
    若 op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" 则 {
        返回 2
    }
    若 op == "&&" || op == "||" 则 {
        返回 2
    }
    若 op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" 则 {
        返回 0
    }
    返回 0
}
函数 检查赋值兼容性(目标类型: 整数, 源类型: 整数): 整数 {
