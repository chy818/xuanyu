            node.children.追加(memberNode)
            p.pos = p.pos + 1
            tok = parserPeekToken(p)
            若 tok.值 == "=" 则 {
                p.pos = p.pos + 1
                tok = parserPeekToken(p)
                p.pos = p.pos + 1
                tok = parserPeekToken(p)
            }
            若 tok.值 == "," 则 {
                p.pos = p.pos + 1
            }
        } 否则 {
            p.pos = p.pos + 1
        }
        tok = parserPeekToken(p)
    }
    tok = parserPeekToken(p)
    若 tok.值 == "}" 则 {
        p.pos = p.pos + 1
    }
    返回 node
}
函数 parseFunctionSignature(p: Parser): AST节点 {
    打印("[SIG enter]\n")
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0
    定义 可变 node: AST节点
    node = parserCreateNode(1, "", "", line)  // 函数定义
    打印("[SIG node created]\n")
    node.children = 列表()
    打印("[SIG about to peek func]\n")
    tok = parserPeekToken(p)
    打印("[SIG peeked func] val=")
    打印(tok.值)
    打印("\n")
    若 tok.值 == "函数" 则 {
        line = tok.行号
        打印("[SIG consuming func]\n")
        p.pos = p.pos + 1
        打印("[SIG consumed func]\n")
    }
    打印("[SIG before peek name] pos=")
    打印整数(p.pos)
    打印("\n")
    tok = parserPeekToken(p)
    打印("[SIG peeked name] val=")
    打印(tok.值)
    打印("\n")
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    若 tok.值 == "(" 则 {
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    当 tok.值 != ")" && tok.值 != "" && tok.类型 != 6 则 {
        若 tok.类型 == 0 则 {
            p.pos = p.pos + 1
            tok = parserPeekToken(p)
            若 tok.值 == ":" 则 {
                p.pos = p.pos + 1
                tok = parserPeekToken(p)
                若 tok.类型 == 3 则 {
                    p.pos = p.pos + 1
                }
            }
        }
        tok = parserPeekToken(p)
        若 tok.值 == "," 则 {
            p.pos = p.pos + 1
        }
        tok = parserPeekToken(p)
    }
    打印("[SIG before )]\n")
    tok = parserPeekToken(p)
    若 tok.值 == ")" 则 {
        p.pos = p.pos + 1
    }
    打印("[SIG after )]\n")
    tok = parserPeekToken(p)
    若 tok.值 == ":" 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
        node.value = tok.值
        p.pos = p.pos + 1
    }
    打印("[SIG returning]\n")
    node.line = line
    返回 node
}
函数 parseFunction(p: Parser): AST节点 {
    打印("[PFUNC enter]\n")
    定义 可变 funcNode: AST节点
    funcNode = parseFunctionSignature(p)
    打印("[PFUNC sig done]\n")
    定义 可变 bodyNode: AST节点
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    打印("[PARSEFUNC: peeked='")
    打印(tok.值)
    打印("' type=")
    打印整数(tok.类型)
    打印("]\n")
    若 tok.值 == "{" 则 {
        打印("[PARSEFUNC: calling parseBlock]\n")
        bodyNode = parseBlock(p)
    } 否则 {
        打印("[PARSEFUNC: calling parseExpression]\n")
        bodyNode = parseExpression(p)
    }
    打印("解析函数: ")
    打印(funcNode.name)
    定义 可变 funcChildren: 列表
    funcChildren = 列表()
    打印("[PFUNC appending body]\n")
    funcChildren.追加(bodyNode)
    打印("[PFUNC appended ok]\n")
    funcNode.children = funcChildren
    打印("[PFUNC returning funcNode]\n")
    返回 funcNode
}
函数 parser报告错误(p: Parser, 消息: 文本): 无返回 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    打印("语法错误 (行")
    打印(tok.行号)
    打印(", 列")
    打印(tok.列号)
    打印("): ")
    打印(消息)
}
函数 parser跳过到(p: Parser, target: 文本): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    当 tok.值 != target && tok.类型 != 6 && tok.值 != "" 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
    }
    若 tok.值 == target 则 {
        返回 1
    }
    返回 0
}
函数 parser跳过到类型(p: Parser, 类型: 整数): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    当 tok.类型 != 类型 && tok.类型 != 6 && tok.值 != "" 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
    }
    若 tok.类型 == 类型 则 {
        返回 1
    }
    返回 0
}
函数 parser预览(p: Parser, 值: 文本): 整数 {
    定义 可变 savedPos: 整数
    savedPos = p.pos
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    p.pos = p.pos + 1
    p.pos = savedPos
    若 tok.值 == 值 则 {
        返回 1
    }
    返回 0
}
函数 parser预览类型(p: Parser, 类型: 整数): 整数 {
