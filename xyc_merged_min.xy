    打印("  bytes")
}
函数 codegen创建测试AST(): AST节点 {
    定义 可变 root: AST节点
    root.kind = 0
    root.name = "测试程序"
    root.children = 列表()
    定义 可变 mainFunc: AST节点
    mainFunc.kind = 1
    mainFunc.name = "主"
    mainFunc.children = 列表()
    定义 可变 body: AST节点
    body.kind = 18
    body.children = 列表()
    定义 可变 varX: AST节点
    varX.kind = 3
    varX.name = "x"
    varX.children = 列表()
    定义 可变 lit42: AST节点
    lit42.kind = 14
    lit42.value = "42"
    列表追加(varX.children, lit42)
    列表追加(body.children, varX)
    定义 可变 retStmt: AST节点
    retStmt.kind = 8
    retStmt.children = 列表()
    定义 可变 idX: AST节点
    idX.kind = 13
    idX.name = "x"
    列表追加(retStmt.children, idX)
    列表追加(body.children, retStmt)
    列表追加(mainFunc.children, body)
    列表追加(root.children, mainFunc)
    返回 root
}
函数 codegen测试(): 整数 {
    打印("=== 代码生成器测试 ===")
    定义 可变 testAST: AST节点
    testAST = codegen创建测试AST()
    打印("正在生成 LLVM IR...")
    定义 可变 moduleName: 文本
    moduleName = codegen遍历AST(testAST)
    打印("=== 测试完成 ===")
    打印("生成的模块: ")
    打印(moduleName)
    返回 1
}
