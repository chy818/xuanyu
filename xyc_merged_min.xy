    若 typeName == 1 则 { 返回 "0.0" }
    若 typeName == 2 则 { 返回 "假" }
    若 typeName == 3 则 { 返回 "\"\"" }
    若 typeName == 4 则 { 返回 "'\\0'" }
    返回 "null"
}
函数 检查整数溢出(op: 文本, left: 整数, right: 整数): 整数 {
    若 op == "+" 则 {
        若 left > 0 && right > 0 && left > 9223372036854775807 - right 则 {
            打印("警告: 整数加法可能溢出")
            返回 1
        }
    }
    若 op == "*" 则 {
        若 left != 0 && right > 9223372036854775807 / left 则 {
            打印("警告: 整数乘法可能溢出")
            返回 1
        }
    }
    返回 0
}
函数 semaInit(源码: 文本): Sema {
    定义 可变 sema: Sema
    sema.源码 = 源码
    sema.当前作用域 = -1
    sema.作用域栈 = 列表()
    sema.错误列表 = 列表()
    sema.警告列表 = 列表()
    sema.当前行号 = 1
    sema.错误计数 = 0
    sema.警告计数 = 0
    sema.全局作用域 = -1
    sema.当前函数名 = ""
    sema.当前函数返回类型 = -1
    sema.循环状态.激活 = 0
    sema.循环状态.循环层级 = 0
    定义 可变 globalScopeIdx: 整数
    globalScopeIdx = 创建作用域(sema, "全局")
    sema.全局作用域 = globalScopeIdx
    注册内置函数(sema)
    返回 sema
}
函数 sema分析AST(sema: Sema, ast: AST节点): 整数 {
    打印("=== 开始语义分析 ===")
    sema.错误计数 = 0
    sema.警告计数 = 0
    定义 可变 errorCount: 整数
    errorCount = sema遍历AST(sema, ast)
    打印("=== 语义分析完成 ===")
    打印("错误数: ")
    打印(sema.错误计数)
    打印("警告数: ")
    打印(sema.警告计数)
    返回 errorCount
}
函数 打印符号表(sema: Sema): 无返回 {
    打印("=== 符号表 ===")
    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(sema.作用域栈) 则 {
        定义 可变 scope: 作用域
        scope = 列表获取(sema.作用域栈, i)
        打印("作用域 ")
        打印(i)
        打印(": ")
        打印(scope.名称)
        打印(" (层级=")
        打印(scope.层级)
        打印(")")
        定义 可变 j: 整数
        j = 0
        当 j < 列表长度(scope.符号表) 则 {
            定义 可变 sym: 符号
            sym = 列表获取(scope.符号表, j)
            打印("  符号: ")
            打印(sym.名称)
            打印(" 类型: ")
            打印(类型转文本(sym.类型))
            打印(" 可变: ")
            若 sym.可变 == 1 则 { 打印("是") } 否则 { 打印("否") }
            j = j + 1
        }
        i = i + 1
    }
    打印("=== 符号表结束 ===")
}
函数 创建测试AST(): AST节点 {
    定义 可变 root: AST节点
    root.kind = 0
    root.name = "测试程序"
    root.children = 列表()
    定义 可变 varNode: AST节点
    varNode.kind = 3
    varNode.name = "x"
    varNode.intValue = 0
    varNode.line = 1
    varNode.children = 列表()
    列表追加(root.children, varNode)
    定义 可变 funcNode: AST节点
    funcNode.kind = 1
    funcNode.name = "测试函数"
    funcNode.line = 3
    funcNode.children = 列表()
    定义 可变 blockNode: AST节点
    blockNode.kind = 18
    blockNode.line = 4
    blockNode.children = 列表()
    列表追加(funcNode.children, blockNode)
    列表追加(root.children, funcNode)
    返回 root
}
函数 测试语义分析(): 整数 {
    打印("=== 开始语义分析器测试 ===")
    定义 可变 sema: Sema
    sema = semaInit("测试源码")
    定义 可变 testAST: AST节点
    testAST = 创建测试AST()
    定义 可变 errorCount: 整数
    errorCount = sema分析AST(sema, testAST)
    打印符号表(sema)
    打印("=== 测试完成 ===")
    打印("错误数: ")
    打印(errorCount)
    返回 errorCount
}
// ==== codegen_s.xy ====
函数 escapeLLVM标识符(name: 文本): 文本 {
    定义 可变 result: 文本
    result = ""
    定义 可变 hex: 文本
    hex = "0123456789abcdef"
    定义 可变 i: 整数
    i = 0
    当 i < 文本长度(name) 则 {
        定义 可变 b: 整数
        b = name[i]
        若 b < 128 则 {
            若 b == 95 则 {
                result = result + "_"
            } 否则 {
                result = result + 整数转字符(b)
            }
        } 否则 {
            定义 可变 hi: 整数
            hi = b / 16
            定义 可变 lo: 整数
            lo = b - hi * 16
            result = result + "u"
            result = result + 整数转字符(hex[hi])
            result = result + 整数转字符(hex[lo])
        }
        i = i + 1
    }
    返回 result
}
函数 getLLVMType(typeName: 文本): 文本 {
    若 typeName == "整数" || typeName == "长整数" 则 { 返回 "i64" }
    若 typeName == "浮点数" || typeName == "双精度" 则 { 返回 "double" }
    若 typeName == "布尔" 则 { 返回 "i1" }
    若 typeName == "文本" || typeName == "字符" 则 { 返回 "i8*" }
    若 typeName == "无返回" 则 { 返回 "void" }
    若 typeName == "任意" || typeName == "列表" 则 { 返回 "i8*" }
    返回 "i64"
}
函数 codegenInit(): Codegen {
    定义 可变 cg: Codegen
    cg.moduleName = "xuanyu_module"
    cg.tempCount = 0
    cg.labelCount = 0
    cg.funcCount = 0
    cg.output = ""
    cg.indent = 0
    cg.stringConstCount = 0
    cg.funcDefs = 列表()
    cg.currentFunc = ""
    cg.currentReturnType = "i64"
    cg.variableMap = 列表()
    cg.variableTypes = 列表()
    cg.stringConstants = 列表()
    cg.loopContextStack = 列表()
    cg.currentFunctionIndex = 0
    cg.functionIndexCounter = 0
    cg.stringConstDefs = ""
    返回 cg
}
函数 codegenEmitLine(cg: Codegen, line: 文本) {
    定义 可变 fullLine: 文本
    fullLine = ""
    定义 可变 i: 整数
    i = 0
    当 i < cg.indent 则 {
        fullLine = fullLine + "  "
        i = i + 1
    }
    fullLine = fullLine + line
    cg.output = cg.output + fullLine + "\n"
    打印(fullLine)
}
函数 codegenEmit(cg: Codegen, content: 文本) {
    codegenEmitLine(cg, content)
}
函数 codegenNewLabel(cg: Codegen): 文本 {
    定义 可变 num: 整数
    num = cg.labelCount
    cg.labelCount = cg.labelCount + 1
    定义 可变 result: 文本
    result = "L"
    定义 可变 numStr: 文本
    numStr = 整数转文本(num)
    result = result + numStr
    返回 result
}
函数 codegenNewTemp(cg: Codegen): 文本 {
    定义 可变 num: 整数
    num = cg.tempCount
    cg.tempCount = cg.tempCount + 1
    定义 可变 result: 文本
    result = "tmp"
    定义 可变 tmpStr: 文本
    tmpStr = 整数转文本(num)
    result = result + tmpStr
    返回 result
}
函数 codegen添加变量(cg: Codegen, varName: 文本, ssaValue: 文本, varType: 文本): 无返回 {
    列表追加(cg.variableMap, varName)
    列表追加(cg.variableMap, ssaValue)
    列表追加(cg.variableTypes, varName)
    列表追加(cg.variableTypes, varType)
}
函数 codegen查找变量(cg: Codegen, varName: 文本): 文本 {
    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(cg.variableMap) 则 {
        若 cg.variableMap[i] == varName 则 {
            返回 cg.variableMap[i + 1]
        }
        i = i + 2
    }
    返回 ""  // 未找到
}
函数 codegen查找变量类型(cg: Codegen, varName: 文本): 文本 {
    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(cg.variableTypes) 则 {
        若 cg.variableTypes[i] == varName 则 {
            返回 cg.variableTypes[i + 1]
        }
        i = i + 2
    }
    返回 "i64"  // 默认类型
}
函数 codegen清空变量(cg: Codegen): 无返回 {
    cg.variableMap = 列表()
    cg.variableTypes = 列表()
}
函数 codegen推入循环上下文(cg: Codegen, ctx: 循环上下文): 无返回 {
    列表追加(cg.loopContextStack, ctx)
}
函数 codegen弹出循环上下文(cg: Codegen): 循环上下文 {
    定义 可变 ctx: 循环上下文
    若 列表长度(cg.loopContextStack) > 0 则 {
        定义 可变 lastIdx: 整数
        lastIdx = 列表长度(cg.loopContextStack) - 1
        ctx = cg.loopContextStack[lastIdx]
    }
    返回 ctx
}
函数 codegen获取当前循环上下文(cg: Codegen): 循环上下文 {
    定义 可变 ctx: 循环上下文
    若 列表长度(cg.loopContextStack) > 0 则 {
        定义 可变 lastIdx: 整数
        lastIdx = 列表长度(cg.loopContextStack) - 1
        ctx = cg.loopContextStack[lastIdx]
    }
    返回 ctx
}
函数 codegen添加字符串常量(cg: Codegen, str: 文本): 文本 {
    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(cg.stringConstants) 则 {
        若 cg.stringConstants[i] == str 则 {
            返回 cg.stringConstants[i + 1]
        }
        i = i + 2
    }
    定义 可变 constName: 文本
    constName = "str"
    定义 可变 idxStr: 文本
    idxStr = 整数转文本(cg.stringConstCount)
    constName = constName + idxStr
    cg.stringConstCount = cg.stringConstCount + 1
    列表追加(cg.stringConstants, str)
    列表追加(cg.stringConstants, constName)
    返回 constName
}
函数 codegen查找字符串常量(cg: Codegen, str: 文本): 文本 {
    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(cg.stringConstants) 则 {
        若 cg.stringConstants[i] == str 则 {
            返回 cg.stringConstants[i + 1]
        }
        i = i + 2
    }
    返回 ""
}
函数 codegenLiteral(cg: Codegen, value: 文本, type: 整数): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    若 type == 1 则 {
        定义 可变 intTmp: 文本
        intTmp = codegenNewTemp(cg)
        codegenEmit(cg, "%" + intTmp + " = add i64 0, " + value)
        codegenEmit(cg, "%" + result + " = inttoptr i64 %" + intTmp + " to i8*")
    } 否则 {
        若 type == 2 则 {
            定义 可变 tmpPtr: 文本
            tmpPtr = codegenNewTemp(cg)
            codegenEmit(cg, "%" + tmpPtr + " = getelementptr [0 x i8], [0 x i8]* null, i64 0, i64 0")
            result = tmpPtr
        } 否则 {
            codegenEmit(cg, "%" + result + " = inttoptr i64 0 to i8*")
        }
    }
    返回 result
}
函数 codegenBinaryOp(cg: Codegen, op: 文本, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    定义 可变 llOp: 文本
    llOp = "add"
    若 op == "+" 则 { llOp = "add" }
    若 op == "-" 则 { llOp = "sub" }
    若 op == "*" 则 { llOp = "mul" }
    若 op == "/" 则 { llOp = "sdiv" }
    若 op == "%" 则 { llOp = "srem" }
    定义 可变 line: 文本
    line = "%" + result + " = " + llOp + " i64 %" + left + ", %" + right
    codegenEmit(cg, line)
    返回 result
}
函数 codegenCompare(cg: Codegen, op: 文本, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    定义 可变 llOp: 文本
    llOp = "eq"
    若 op == "==" 则 { llOp = "eq" }
    若 op == "!=" 则 { llOp = "ne" }
    若 op == "<" 则 { llOp = "slt" }
    若 op == ">" 则 { llOp = "sgt" }
    若 op == "<=" 则 { llOp = "sle" }
    若 op == ">=" 则 { llOp = "sge" }
    定义 可变 line: 文本
    line = "%" + result + " = icmp " + llOp + " i64 %" + left + ", %" + right
    codegenEmit(cg, line)
    返回 result
}
