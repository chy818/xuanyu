函数 parseMatchStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0
    定义 可变 node: AST节点
    node = parserCreateNode(25, "", "", line)  // match语句
    node.children = 列表()
    tok = parserPeekToken(p)
    若 tok.值 == "匹配" 则 {
        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }
    定义 可变 subjectNode: AST节点
    subjectNode = parseExpression(p)
    node.children.追加(subjectNode)
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    当 tok.值 != "}" && tok.值 != "" && tok.类型 != 6 则 {
        定义 可变 branchNode: AST节点
        branchNode = parserCreateNode(26, "", "", line)
        branchNode.children = 列表()
        若 tok.值 == "默认" 则 {
            p.pos = p.pos + 1
            tok = parserPeekToken(p)
            若 tok.值 == ":" 则 {
                p.pos = p.pos + 1
            }
            定义 可变 defaultBody: AST节点
            defaultBody = parseExpression(p)
            branchNode = parserCreateNode(27, "", "", line)  // match默认分支
            branchNode.children = 列表()
            branchNode.children.追加(defaultBody)
            node.children.追加(branchNode)
        } 否则 {
            若 tok.值 == "情况" 则 {
                p.pos = p.pos + 1
            }
            定义 可变 caseValue: 文本
            caseValue = ""
            tok = parserPeekToken(p)
            若 tok.类型 == 1 则 {
                caseValue = tok.值
                p.pos = p.pos + 1
            } 否则 {
                若 tok.类型 == 0 则 {
                    caseValue = tok.值
                    p.pos = p.pos + 1
                }
            }
            branchNode = parserCreateNode(26, caseValue, "", tok.行号)  // match分支
            branchNode.children = 列表()
            tok = parserPeekToken(p)
            若 tok.值 == ":" 则 {
                p.pos = p.pos + 1
            }
            定义 可变 branchBody: AST节点
            branchBody = parseExpression(p)
            branchNode.children.追加(branchBody)
            node.children.追加(branchNode)
        }
        tok = parserPeekToken(p)
        若 tok.值 == "," 则 {
            p.pos = p.pos + 1
        }
        tok = parserPeekToken(p)
    }
    tok = parserPeekToken(p)
    若 tok.值 == "}" 则 {
        p.pos = p.pos + 1
    }
    返回 node
}
函数 parseStructDefinition(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0
    定义 可变 node: AST节点
    node = parserCreateNode(21, "", "", line)  // 结构体定义
    node.children = 列表()
    tok = parserPeekToken(p)
    若 tok.值 == "结构体" 则 {
        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    当 tok.值 != "}" && tok.值 != "" && tok.类型 != 6 则 {
        若 tok.类型 == 0 则 {
            定义 可变 fieldNode: AST节点
            fieldNode = parserCreateNode(23, tok.值, "", tok.行号)  // 结构体字段
            p.pos = p.pos + 1
            tok = parserPeekToken(p)
            若 tok.值 == ":" 则 {
                p.pos = p.pos + 1
            }
            tok = parserPeekToken(p)
            若 tok.类型 == 3 则 {
                fieldNode.value = tok.值
                p.pos = p.pos + 1
            }
            node.children.追加(fieldNode)
            tok = parserPeekToken(p)
            若 tok.值 == "," 则 {
                p.pos = p.pos + 1
            }
        }
        tok = parserPeekToken(p)
    }
    tok = parserPeekToken(p)
    若 tok.值 == "}" 则 {
        p.pos = p.pos + 1
    }
    返回 node
}
