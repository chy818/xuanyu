        返回 0
    }
    返回 1
}
函数 lexerRun(源码: 文本): 整数 {
    打印("=== 词法分析 ===")
    定义 可变 lex: Lexer
    lex = lexerInit(源码, 文本长度(源码))
    定义 可变 count: 整数
    count = 0
    定义 可变 tok: Token
    tok.类型 = 0
    tok.值 = ""
    tok.行号 = 0
    tok.列号 = 0
    tok.开始位置 = 0
    tok.结束位置 = 0
    当 tok.类型 != 6 && count < 1000 则 {
        lex = lexerNextToken(lex)
        tok = lex.当前token
        若 tok.类型 == 7 则 {
            跳过
        }
        若 tok.类型 != 6 则 {
            count = count + 1
            打印("Token ")
            打印(count)
            打印(": ")
            打印(tok.值)
            打印(" (类型=")
            打印(tok.类型)
            打印(", 行=")
            打印(tok.行号)
            打印(")")
        }
    }
    打印("")
    打印("词法分析完成，共识别 ")
    打印(count)
    打印(" 个 Token")
    返回 count
}
函数 tokenize(源码: 文本): 列表 {
    定义 可变 lex: Lexer
    lex = lexerInit(源码, 文本长度(源码))
    定义 可变 tokens: 列表
    tokens = 列表()
    定义 可变 循环次数: 整数
    循环次数 = 0
    当 循环次数 < 50000 则 {
        若 lex.位置 >= lex.长度 则 {
            定义 可变 eofTok: Token
            eofTok.类型 = 6
            eofTok.值 = "EOF"
            eofTok.行号 = lex.行号
            eofTok.列号 = lex.列号
            eofTok.开始位置 = lex.位置
            eofTok.结束位置 = lex.位置
            列表追加(tokens, eofTok)
            跳出
        }
        lex = lexerNextToken(lex)
        定义 可变 tok: Token
        tok = lex.当前token
        若 tok.类型 == 6 则 {
            列表追加(tokens, tok)
            跳出
        }
        若 tok.类型 == 7 则 {
            循环次数 = 循环次数 + 1
            跳过
        }
        列表追加(tokens, tok)
        循环次数 = 循环次数 + 1
    }
    返回 tokens
}
函数 打印Tokens(tokens: 列表): 无返回 {
    定义 可变 i: 整数
    i = 0
    定义 可变 len: 整数
    len = 列表长度(tokens)
    打印("=== Token 列表 ===")
    当 i < len 则 {
        定义 可变 tok: Token
        tok = 列表获取(tokens, i)
        定义 可变 类型名: 文本
        类型名 = 获取Token类型名(tok.类型)
        打印("Token ")
        打印(i + 1)
        打印(": [")
        打印(类型名)
        打印("] '")
        打印(tok.值)
        打印("' (行:")
        打印(tok.行号)
        打印(", 列:")
        打印(tok.列号)
        打印(")")
        i = i + 1
    }
    打印("总计: ")
    打印(len)
    打印(" 个 tokens")
}
// ==== parser_s.xy ====
函数 是关键字(text: 文本): 整数 {
    若 text == "若" 则 { 返回 1 }
    若 text == "则" 则 { 返回 1 }
    若 text == "否则" 则 { 返回 1 }
    若 text == "当" 则 { 返回 1 }
    若 text == "循环" 则 { 返回 1 }
    若 text == "从" 则 { 返回 1 }
    若 text == "到" 则 { 返回 1 }
    若 text == "返回" 则 { 返回 1 }
    若 text == "定义" 则 { 返回 1 }
    若 text == "可变" 则 { 返回 1 }
    若 text == "函数" 则 { 返回 1 }
    若 text == "结构体" 则 { 返回 1 }
    若 text == "枚举" 则 { 返回 1 }
    若 text == "真" 则 { 返回 1 }
    若 text == "假" 则 { 返回 1 }
    若 text == "跳过" 则 { 返回 1 }
    若 text == "退出" 则 { 返回 1 }
    若 text == "引入" 则 { 返回 1 }
    若 text == "模块" 则 { 返回 1 }
    若 text == "导出" 则 { 返回 1 }
    返回 0
}
函数 getKeywordType(text: 文本): 整数 {
    若 text == "若" 则 { 返回 1 }     // IF
    若 text == "则" 则 { 返回 2 }     // THEN
    若 text == "否则" 则 { 返回 3 }   // ELSE
    若 text == "当" 则 { 返回 4 }    // WHILE
    若 text == "循环" 则 { 返回 5 }   // LOOP
    若 text == "从" 则 { 返回 6 }    // FROM
    若 text == "到" 则 { 返回 7 }    // TO
    若 text == "返回" 则 { 返回 8 }   // RETURN
    若 text == "定义" 则 { 返回 9 }   // LET
    若 text == "函数" 则 { 返回 10 }  // FUNC
    若 text == "真" 则 { 返回 11 }   // TRUE
    若 text == "假" 则 { 返回 12 }   // FALSE
    若 text == "跳过" 则 { 返回 13 }  // CONTINUE
    若 text == "退出" 则 { 返回 14 }  // BREAK
    若 text == "引入" 则 { 返回 15 }  // IMPORT
    若 text == "模块" 则 { 返回 16 }  // MODULE
    若 text == "导出" 则 { 返回 17 }  // EXPORT
    若 text == "整数" 则 { 返回 20 }  // TYPE_INT
    若 text == "浮点数" 则 { 返回 21 } // TYPE_FLOAT
    若 text == "双精度" 则 { 返回 22 } // TYPE_DOUBLE
    若 text == "布尔" 则 { 返回 23 }  // TYPE_BOOL
    若 text == "文本" 则 { 返回 24 }  // TYPE_STRING
    若 text == "无返回" 则 { 返回 25 } // TYPE_VOID
    若 text == "字符" 则 { 返回 26 }  // TYPE_CHAR
    若 text == "指针" 则 { 返回 27 }  // TYPE_POINTER
    若 text == "列表" 则 { 返回 28 }  // TYPE_LIST
    若 text == "长整数" 则 { 返回 29 } // TYPE_LONG
    返回 0
}
函数 parserInit(tokens: 列表): Parser {
    定义 可变 p: Parser
    p.pos = 0
    p.tokens = tokens
    p.errors = 列表()
    p.nodeCount = 0
    p.tokenCount = 列表长度(tokens)
    返回 p
}
函数 parserPeekToken(p: Parser): Token {
    定义 可变 tok: Token
    tok.类型 = 0
    tok.值 = ""
    tok.行号 = 0
    tok.列号 = 0
    tok.开始位置 = 0
    tok.结束位置 = 0
    若 p.pos < p.tokenCount 则 {
        定义 可变 t: Token
        t = p.tokens[p.pos]
        返回 t
    }
    tok.类型 = 6
    tok.值 = "EOF"
    返回 tok
}
函数 parserCheck(p: Parser, 值: 文本): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    若 tok.值 == 值 则 {
        返回 1
    }
    返回 0
}
函数 parserCheckType(p: Parser, 类型: 整数): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    若 tok.类型 == 类型 则 {
        返回 1
    }
    返回 0
}
函数 parserMatch(p: Parser, 值: 文本): 整数 {
    若 parserCheck(p, 值) == 1 则 {
        p.pos = p.pos + 1
        返回 1
    }
    返回 0
}
函数 parserNewNodeId(p: Parser): 整数 {
    p.nodeCount = p.nodeCount + 1
    返回 p.nodeCount
}
函数 parserCreateNode(kind: 整数, name: 文本, value: 文本, line: 整数): AST节点 {
    定义 可变 node: AST节点
    node.id = 0
    node.kind = kind
    node.name = name
    node.value = value
    node.intValue = 0
    node.line = line
    node.children = 列表()
    返回 node
}
函数 parsePrimary(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 node: AST节点
    node = parserCreateNode(0, "", "", tok.行号)
    若 tok.类型 == 0 则 {
        node.kind = 13
        node.name = tok.值
        node.value = tok.值
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
        若 tok.值 == "(" 则 {
            node = parseCall(p, node)
        }
        返回 node
    }
    若 tok.类型 == 1 则 {
        node.kind = 14
        node.value = tok.值
        node.intValue = 文本转整数(tok.值)
        p.pos = p.pos + 1
        返回 node
    }
    若 tok.类型 == 2 则 {
        node.kind = 14
        node.value = tok.值
        p.pos = p.pos + 1
        返回 node
    }
    若 tok.类型 == 3 则 {
        node.kind = 13
        node.name = tok.值
        node.value = tok.值
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
        若 tok.值 == "(" 则 {
            node = parseCall(p, node)
        }
        返回 node
    }
    若 tok.值 == "(" 则 {
        p.pos = p.pos + 1
        node = parseExpression(p)
        tok = parserPeekToken(p)
        若 tok.值 == ")" 则 {
            p.pos = p.pos + 1
        }
        返回 node
    }
    若 tok.值 == "-" 则 {
        p.pos = p.pos + 1
        定义 可变 operand: AST节点
        operand = parsePrimary(p)
        node.kind = 11
        node.name = "-"
        返回 node
    }
    返回 node
}
函数 parseCall(p: Parser, funcNode: AST节点): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    若 tok.值 == "(" 则 {
        p.pos = p.pos + 1
    } 否则 {
        parser报告错误(p, "期望 '('")
    }
    funcNode.kind = 12
    funcNode.children = 列表()
    循环 {
        tok = parserPeekToken(p)
        若 tok.值 == ")" 则 {
            跳出
        }
        若 tok.类型 == 6 则 {
            parser报告错误(p, "函数调用未闭合，期望 ')'")
            跳出
        }
        定义 可变 arg: AST节点
        arg = parseExpression(p)
        列表追加(funcNode.children, arg)
        tok = parserPeekToken(p)
        若 tok.值 == "," 则 {
            p.pos = p.pos + 1
        } 否则 若 tok.值 != ")" 则 {
            parser报告错误(p, "参数后期望逗号或右括号")
        }
    }
    tok = parserPeekToken(p)
    若 tok.值 == ")" 则 {
        p.pos = p.pos + 1
    } 否则 {
        parser报告错误(p, "期望 ')' 结束函数调用")
    }
    返回 funcNode
}
函数 parseUnary(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    若 tok.值 == "!" || tok.值 == "-" 则 {
        定义 可变 op: 文本
        op = tok.值
        p.pos = p.pos + 1
        定义 可变 operand: AST节点
        operand = parseUnary(p)
        定义 可变 node: AST节点
         node = parserCreateNode(11, op, "", tok.行号)
        列表追加(node.children, operand)
        返回 node
    }
    定义 可变 primary: AST节点
    primary = parsePrimary(p)
    返回 parsePostfix(p, primary)
}
函数 getOpPriority(op: 文本): 整数 {
    若 op == "||" 则 { 返回 1 }
    若 op == "&&" 则 { 返回 2 }
    若 op == "==" || op == "!=" 则 { 返回 3 }
    若 op == "<" || op == ">" || op == "<=" || op == ">=" 则 { 返回 4 }
    若 op == "+" || op == "-" 则 { 返回 5 }
    若 op == "*" || op == "/" || op == "%" 则 { 返回 6 }
    返回 0
}
函数 是右结合(op: 文本): 整数 {
    若 op == "=" 则 { 返回 1 }
    返回 0
}
函数 parseBinaryExpr(p: Parser, minPriority: 整数): AST节点 {
    定义 可变 left: AST节点
    left = parseUnary(p)
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 priority: 整数
    priority = getOpPriority(tok.值)
    当 priority >= minPriority && priority > 0 则 {
        定义 可变 op: 文本
        op = tok.值
        p.pos = p.pos + 1
        定义 可变 nextMinPriority: 整数
        nextMinPriority = priority + 1
        若 是右结合(op) == 1 则 {
            nextMinPriority = priority
        }
        定义 可变 right: AST节点
        right = parseBinaryExpr(p, nextMinPriority)
        定义 可变 node: AST节点
         node = parserCreateNode(10, op, "", tok.行号)
        列表追加(node.children, left)
        列表追加(node.children, right)
        left = node
        tok = parserPeekToken(p)
        priority = getOpPriority(tok.值)
    }
    返回 left
}
函数 isBinaryOp(text: 文本): 整数 {
    若 text == "+" || text == "-" || text == "*" || text == "/" 则 { 返回 1 }
    若 text == "%" || text == "==" || text == "!=" 则 { 返回 1 }
    若 text == "<" || text == ">" || text == "<=" || text == ">=" 则 { 返回 1 }
    若 text == "&&" || text == "||" 则 { 返回 1 }
    返回 0
}
函数 parseExpression(p: Parser): AST节点 {
    返回 parseBinaryExpr(p, 1)
}
函数 parseIndexAccess(p: Parser, base: AST节点): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 node: AST节点
    node = parserCreateNode(15, "", "", tok.行号)  // 复用类型转换节点kind=15
    node.children = 列表()
    node.children.追加(base)
    node.children.追加(空节点)
    若 tok.值 == "[" 则 {
        p.pos = p.pos + 1
        定义 可变 index: AST节点
        index = parseExpression(p)
        tok = parserPeekToken(p)
        若 tok.值 == "]" 则 {
            p.pos = p.pos + 1
        }
        node.children[1] = index
    }
    返回 node
}
函数 parseFieldAccess(p: Parser, base: AST节点): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 node: AST节点
    node = parserCreateNode(0, "", "", tok.行号)
    若 tok.值 == "." 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
        若 tok.类型 == 0 则 {
node.kind = 23
 node.name = tok.值
 列表追加(node.children, base)
 p.pos = p.pos + 1
        }
    }
    返回 node
}
函数 parsePostfix(p: Parser, base: AST节点): AST节点 {
    定义 可变 node: AST节点
    node = base
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    当 tok.值 == "(" || tok.值 == "[" || tok.值 == "." 则 {
        若 tok.值 == "(" 则 {
            node = parseCall(p, node)
        } 否则 {
            若 tok.值 == "[" 则 {
                node = parseIndexAccess(p, node)
            } 否则 {
                若 tok.值 == "." 则 {
                    node = parseFieldAccess(p, node)
                }
            }
        }
        tok = parserPeekToken(p)
    }
    返回 node
}
函数 parseAssignmentOrExpression(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 node: AST节点
    node = parserCreateNode(9, "", "", tok.行号)  // 表达式语句
    若 tok.类型 == 0 则 {
        定义 可变 nextTok: Token
        定义 可变 savedPos: 整数
        savedPos = p.pos
        p.pos = p.pos + 1
        nextTok = parserPeekToken(p)
        若 nextTok.值 == "=" 则 {
            p.pos = p.pos + 1
            定义 可变 valueNode: AST节点
            valueNode = parseExpression(p)
            node.kind = 19
            node.name = tok.值
            node.value = "="
            返回 node
        } 否则 {
            p.pos = savedPos
        }
    }
    node = parseExpression(p)
    返回 node
}
函数 parseAssignmentStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号
    定义 可变 node: AST节点
    node = parserCreateNode(4, "", "", line)  // 赋值语句
    tok = parserPeekToken(p)
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    定义 可变 op: 文本
    op = "="
    若 tok.值 == "=" 则 { op = "=" }
    若 tok.值 == "+=" 则 { op = "+=" }
    若 tok.值 == "-=" 则 { op = "-=" }
    若 tok.值 == "*=" 则 { op = "*=" }
    若 tok.值 == "/=" 则 { op = "/=" }
    若 tok.值 == "%=" 则 { op = "%=" }
    node.value = op
    p.pos = p.pos + 1
    定义 可变 valueNode: AST节点
    valueNode = parseExpression(p)
    tok = parserPeekToken(p)
    若 tok.值 == ";" 则 {
        p.pos = p.pos + 1
    }
    返回 node
}
函数 parseLetStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号
    定义 可变 node: AST节点
    node = parserCreateNode(3, "", "", line)  // 变量定义
    若 tok.值 == "定义" 则 {
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    若 tok.值 == "可变" 则 {
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    若 tok.值 == ":" 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
        node.value = tok.值
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    若 tok.值 == "=" 则 {
        p.pos = p.pos + 1
        定义 可变 expr: AST节点
        expr = parseExpression(p)
        列表追加(node.children, expr)
    }
    返回 node
}
函数 parseReturnStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号
    定义 可变 node: AST节点
    node = parserCreateNode(8, "", "", line)  // 返回语句
    若 tok.值 == "返回" 则 {
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    若 tok.值 != "}" 则 {
        定义 可变 expr: AST节点
        expr = parseExpression(p)
        列表追加(node.children, expr)
    }
    返回 node
}
函数 parseBreakStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号
    定义 可变 node: AST节点
    node = parserCreateNode(16, "", "", line)  // break语句
    若 tok.值 == "退出" 则 {
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    若 tok.值 == ";" 则 {
        p.pos = p.pos + 1
    }
    返回 node
}
函数 parseContinueStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号
    定义 可变 node: AST节点
    node = parserCreateNode(17, "", "", line)  // continue语句
    若 tok.值 == "跳过" 则 {
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    若 tok.值 == ";" 则 {
        p.pos = p.pos + 1
    }
    返回 node
}
函数 parseBlock(p: Parser): AST节点 {
    打印("[BLOCK ENTER]\n")
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号
    定义 可变 node: AST节点
    node = parserCreateNode(18, "", "", line)  // 块语句
    node.children = 列表()
    若 tok.值 == "{" 则 {
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    当 tok.值 != "}" && tok.值 != "" && tok.类型 != 6 则 {
        定义 可变 stmt: AST节点
        若 tok.值 == "定义" 则 {
            stmt = parseLetStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "返回" 则 {
            stmt = parseReturnStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "若" 则 {
            stmt = parseIfStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "当" 则 {
            stmt = parseWhileStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "循环" 则 {
            stmt = parseForStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "匹配" 则 {
            stmt = parseMatchStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "退出" 则 {
            stmt = parseBreakStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "跳过" 则 {
            stmt = parseContinueStatement(p)
            列表追加(node.children, stmt)
        } 否则 {
            stmt = parseAssignmentOrExpression(p)
            列表追加(node.children, stmt)
            tok = parserPeekToken(p)
            若 tok.值 == ";" 则 {
                p.pos = p.pos + 1
            }
        }
        tok = parserPeekToken(p)
    }
    若 tok.值 == "}" 则 {
        p.pos = p.pos + 1
    }
    返回 node
}
函数 parseIfStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0
    定义 可变 node: AST节点
    node = parserCreateNode(5, "", "", line)
    node.children = 列表()
    tok = parserPeekToken(p)
    若 tok.值 == "若" 则 {
        line = tok.行号
        p.pos = p.pos + 1
    }
    定义 可变 condNode: AST节点
    condNode = parseExpression(p)
    node.children.追加(condNode)
    tok = parserPeekToken(p)
    若 tok.值 == "则" 则 {
        p.pos = p.pos + 1
    }
    定义 可变 thenNode: AST节点
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        thenNode = parseBlock(p)
    } 否则 {
        thenNode = parseExpression(p)
    }
    node.children.追加(thenNode)
    tok = parserPeekToken(p)
    定义 可变 elseNode: AST节点
    elseNode = parserCreateNode(0, "", "", line)
    若 tok.值 == "否则若" 则 {
        p.pos = p.pos + 1
        elseNode = parseIfStatement(p)
    } 否则 若 tok.值 == "否则" 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
        若 tok.值 == "{" 则 {
            elseNode = parseBlock(p)
        } 否则 {
            elseNode = parseExpression(p)
        }
    }
    node.children.追加(elseNode)
    返回 node
}
