        返回 1
    }
    返回 0
}
函数 parser尝试恢复(p: Parser): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    若 tok.值 == "函数" 则 { 返回 1 }
    若 tok.值 == "定义" 则 { 返回 1 }
    若 tok.值 == "若" 则 { 返回 1 }
    若 tok.值 == "当" 则 { 返回 1 }
    若 tok.值 == "循环" 则 { 返回 1 }
    若 tok.值 == "返回" 则 { 返回 1 }
    若 tok.值 == "{" 则 { 返回 1 }
    若 tok.值 == "}" 则 { 返回 1 }
    返回 0
}
函数 parseTypeAnnotation(p: Parser): 文本 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 typeName: 文本
    typeName = ""
    若 tok.值 == ":" 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
        若 tok.类型 == 3 则 {
            typeName = tok.值
            p.pos = p.pos + 1
        }
    }
    返回 typeName
}
函数 parseDefaultValue(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 defaultNode: AST节点
    defaultNode = parserCreateNode(14, "", "", tok.行号)
    若 tok.值 == "=" 则 {
        p.pos = p.pos + 1
        defaultNode = parseExpression(p)
    }
    返回 defaultNode
}
函数 parseParameterList(p: Parser): 列表 {
    定义 可变 params: 列表
    params = 列表()
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    若 tok.值 == "(" 则 {
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    当 tok.值 != ")" && tok.值 != "" && tok.类型 != 6 则 {
        若 tok.类型 == 0 则 {
            定义 可变 paramNode: AST节点
            paramNode = parserCreateNode(2, tok.值, "", tok.行号)
            p.pos = p.pos + 1
            tok = parserPeekToken(p)
            若 tok.值 == ":" 则 {
                p.pos = p.pos + 1
                tok = parserPeekToken(p)
                若 tok.类型 == 3 则 {
                    paramNode.value = tok.值
                    p.pos = p.pos + 1
                }
            }
            tok = parserPeekToken(p)
            若 tok.值 == "=" 则 {
                定义 可变 defaultVal: AST节点
                defaultVal = parseDefaultValue(p)
                paramNode.children = defaultVal
            }
        }
        tok = parserPeekToken(p)
        若 tok.值 == "," 则 {
            p.pos = p.pos + 1
        }
        tok = parserPeekToken(p)
    }
    若 tok.值 == ")" 则 {
        p.pos = p.pos + 1
    }
    返回 params
}
函数 parseAttribute(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 attrNode: AST节点
    attrNode = parserCreateNode(0, "", "", tok.行号)
    若 tok.值 == "@" 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
        attrNode.name = tok.值
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
        若 tok.值 == "(" 则 {
            p.pos = p.pos + 1
            tok = parserPeekToken(p)
            当 tok.值 != ")" && tok.值 != "" 则 {
                p.pos = p.pos + 1
                tok = parserPeekToken(p)
            }
            若 tok.值 == ")" 则 {
                p.pos = p.pos + 1
            }
        }
    }
    返回 attrNode
}
函数 parseWhereClause(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
