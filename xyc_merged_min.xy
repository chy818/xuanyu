}
函数 lexer验证数字(lex: Lexer): 整数 {
    定义 可变 ch: 整数
    ch = lex.当前位置
    定义 可变 hasDot: 整数
    hasDot = 0
    定义 可变 hasExp: 整数
    hasExp = 0
    当 ch != 0 && ch != 32 && ch != 9 && ch != 10 && ch != 13 则 {
        若 ch == 46 则 {
            hasDot = hasDot + 1
            若 hasDot > 1 则 {
                返回 0
            }
        } 否则 {
            若 ch == 101 || ch == 69 则 {
                hasExp = hasExp + 1
                若 hasExp > 1 则 {
                    返回 0
                }
            } 否则 {
                若 ch < 48 || ch > 57 则 {
                    若 ch != 95 则 {
                        返回 0
                    }
                }
            }
        }
        ch = lex.当前位置
    }
    返回 1
}
函数 lexer验证字符串(lex: Lexer): 整数 {
    定义 可变 ch: 整数
    ch = lex.当前位置
    定义 可变 inEscape: 整数
    inEscape = 0
    当 ch != 0 则 {
        若 inEscape == 1 则 {
            inEscape = 0
        } 否则 {
            若 ch == 92 则 {
                inEscape = 1
            } 否则 {
                若 ch == 34 则 {
                    返回 1
                }
            }
        }
        ch = lex.当前位置
    }
    返回 0
}
函数 lexer验证字符(lex: Lexer): 整数 {
    定义 可变 ch: 整数
    ch = lex.当前位置
    若 ch == 39 则 {
        返回 1
    }
    定义 可变 charLen: 整数
    charLen = 0
    当 ch != 39 && ch != 0 && ch != 10 则 {
        charLen = charLen + 1
        ch = lex.当前位置
    }
    若 charLen == 0 则 {
        返回 0
    }
    若 ch == 39 则 {
        返回 1
    }
    返回 0
}
函数 lexer错误恢复(lex: Lexer): Lexer {
    打印("词法分析错误恢复")
    定义 可变 恢复模式: 整数
    恢复模式 = 0
    当 lex.当前位置 < lex.长度 && lex.当前位置 >= 0 则 {
        定义 可变 ch: 整数
        ch = lex.当前位置
        若 ch == 32 || ch == 9 || ch == 10 || ch == 13 则 {
            若 恢复模式 == 1 则 {
                恢复模式 = 2
            }
            lex.当前位置 = lex.当前位置 + 1
            若 ch == 10 则 {
                lex.列号 = 0
                lex.行号 = lex.行号 + 1
            }
            若 恢复模式 == 2 则 {
                返回 lex
            }
        } 否则 {
            若 恢复模式 == 0 则 {
                恢复模式 = 1
                打印("  跳过错误字符")
            }
            lex.当前位置 = lex.当前位置 + 1
        }
    }
    lex.列号 = 0
    lex.行号 = lex.行号 + 1
    返回 lex
}
函数 lexer跳到位置(lex: Lexer, 目标位置: 整数): Lexer {
    若 目标位置 >= 0 && 目标位置 < lex.长度 则 {
        lex.当前位置 = 目标位置
    }
    返回 lex
}
函数 lexer查找安全点(lex: Lexer): 整数 {
    定义 可变 pos: 整数
    pos = lex.当前位置
    当 pos < lex.长度 && pos >= 0 则 {
        定义 可变 ch: 整数
        ch = lex.当前位置
        若 ch == 59 || ch == 32 || ch == 10 || ch == 9 则 {
            返回 pos
        }
        pos = pos + 1
    }
    返回 pos
}
