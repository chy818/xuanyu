        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        p.pos = p.pos + 1
    }
    tok = parserPeekToken(p)
    当 tok.值 != "}" && tok.值 != "" && tok.类型 != 6 则 {
        若 tok.值 == "函数" 则 {
            定义 可变 funcNode: AST节点
            funcNode = parseFunction(p)
            列表追加(node.children, funcNode)
        } 否则 若 tok.值 == "引入" 则 {
            定义 可变 importNode: AST节点
            importNode = parseImportStatement(p)
            列表追加(node.children, importNode)
        } 否则 {
            p.pos = p.pos + 1
        }
        tok = parserPeekToken(p)
    }
    若 tok.值 == "}" 则 {
        p.pos = p.pos + 1
    }
    返回 node
}
