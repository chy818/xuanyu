函数 提取子串(源码: 文本, 开始: 整数, 结束: 整数): 文本 {
    定义 可变 结果: 文本
    结果 = 文本切片(源码, 开始, 结束)
    返回 结果
}
函数 获取字符(lex: Lexer): 整数 {
    若 lex.位置 < lex.长度 则 {
        定义 可变 ch: 整数
        ch = 字符编码(文本获取字符(lex.源码, lex.位置))
        返回 ch
    }
    返回 0
}
函数 lexerInit(源码: 文本, 长度: 整数): Lexer {
    定义 可变 lex: Lexer
    lex.源码 = 源码
    lex.位置 = 0
    lex.长度 = 长度
    lex.行号 = 1
    lex.列号 = 1
    lex.开始位置 = 0
    lex.当前位置 = 0
    lex.当前字符 = 获取字符(lex)
    返回 lex
}
函数 lexer前进(lex: Lexer): Lexer {
    定义 可变 步长: 整数
    步长 = utf8字节长度(lex.当前字符)
    lex.位置 = lex.位置 + 步长
    lex.列号 = lex.列号 + 1
    若 lex.位置 < lex.长度 则 {
        lex.当前字符 = 字符编码(文本获取字符(lex.源码, lex.位置))
    } 否则 {
        lex.当前字符 = 0
    }
    若 lex.当前字符 == 10 则 {
        lex.行号 = lex.行号 + 1
        lex.列号 = 1
    }
    返回 lex
}
函数 lexer跳过空白(lex: Lexer): Lexer {
    当 是空白(lex.当前字符) == 1 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }
    lex.开始位置 = lex.位置
    返回 lex
}
函数 lexer读取注释(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置
    tok.类型 = 7
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始
                lex = lexer前进(lex)
                lex = lexer前进(lex)
                当 lex.当前字符 != 0 则 {
                    若 lex.位置 + 1 >= lex.长度 则 {
                        跳出
                    }
                    若 lex.当前字符 == 42 && 字符编码(文本获取字符(lex.源码, lex.位置 + 1)) == 47 则 {
                        lex = lexer前进(lex)
                        lex = lexer前进(lex)
                        跳出
                    }
                    lex = lexer前进(lex)
                }
            } 否则 {
                lex = lexer前进(lex)
                tok.类型 = 4
            }
        }
    }
    tok.结束位置 = lex.位置
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值
    lex.当前token = tok
    返回 lex
}
函数 lexer读取字符(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置
    tok.类型 = 8
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始
    lex = lexer前进(lex)
    若 lex.当前字符 == 92 则 {
        lex = lexer前进(lex)
        若 lex.当前字符 == 110 则 {
            lex = lexer前进(lex)
        } 否则 {
            若 lex.当前字符 == 116 则 {
                lex = lexer前进(lex)
            } 否则 {
                若 lex.当前字符 == 92 则 {
                    lex = lexer前进(lex)
                } 否则 {
                    若 lex.当前字符 == 39 则 {
                        lex = lexer前进(lex)
                    }
                }
            }
        }
    } 否则 {
        若 lex.当前字符 != 39 && lex.当前字符 != 0 则 {
            lex = lexer前进(lex)
        }
    }
    若 lex.当前字符 == 39 则 {
        lex = lexer前进(lex)
    }
    tok.结束位置 = lex.位置
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值
    lex.当前token = tok
    返回 lex
}
函数 lexer读取复合运算符(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置
    tok.类型 = 10
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始
    定义 可变 firstCh: 整数
    firstCh = lex.当前字符
    lex = lexer前进(lex)
    定义 可变 nextCh: 整数
    nextCh = lex.当前字符
    定义 可变 op: 文本
    op = ""
    若 firstCh == 61 && nextCh == 61 则 {
        op = "=="
        lex = lexer前进(lex)
    } 否则 {
        若 firstCh == 33 && nextCh == 61 则 {
            op = "!="
            lex = lexer前进(lex)
        } 否则 {
            若 firstCh == 60 && nextCh == 61 则 {
                op = "<="
                lex = lexer前进(lex)
            } 否则 {
                若 firstCh == 62 && nextCh == 61 则 {
                    op = ">="
                    lex = lexer前进(lex)
                } 否则 {
                    若 firstCh == 38 && nextCh == 38 则 {
                        op = "&&"
                        tok.类型 = 11
                        lex = lexer前进(lex)
                    } 否则 {
                        若 firstCh == 124 && nextCh == 124 则 {
                            op = "||"
                            tok.类型 = 11
                            lex = lexer前进(lex)
                        } 否则 {
                            若 firstCh == 61 则 { op = "=" }
                            若 firstCh == 60 则 { op = "<" }
                            若 firstCh == 62 则 { op = ">" }
                            若 firstCh == 33 则 { op = "!" }
                        }
                    }
                }
            }
        }
    }
    tok.结束位置 = lex.位置
    tok.值 = op
    lex.当前token = tok
    返回 lex
}
函数 lexer读取标识符(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置
    tok.类型 = 0
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始
    当 是字母或数字(lex.当前字符) == 1 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }
    tok.结束位置 = lex.位置
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值
    若 是关键字(提取的值) == 1 则 {
        tok.类型 = 3
    }
    lex.当前token = tok
    返回 lex
}
函数 lexer读取数字(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置
    tok.类型 = 1
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始
    当 是数字(lex.当前字符) == 1 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }
    tok.结束位置 = lex.位置
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值
    lex.当前token = tok
    返回 lex
}
函数 lexer读取字符串(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置
    tok.类型 = 2
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始
    lex = lexer前进(lex)
    当 lex.当前字符 != 34 && lex.当前字符 != 0 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }
    若 lex.当前字符 == 34 则 {
        lex = lexer前进(lex)
    }
    tok.结束位置 = lex.位置
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值
    lex.当前token = tok
    返回 lex
}
函数 lexer读取运算符(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置
    tok.类型 = 4
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始
    当 是运算符(lex.当前字符) == 1 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }
    tok.结束位置 = lex.位置
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值
    lex.当前token = tok
    返回 lex
}
函数 lexer读取符号(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置
    tok.类型 = 5
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始
    tok.结束位置 = lex.位置 + 1
    定义 可变 结束位置: 整数
    结束位置 = lex.位置 + 1
    若 结束位置 > lex.长度 则 {
        结束位置 = lex.长度
    }
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, 结束位置)
    tok.值 = 提取的值
    lex = lexer前进(lex)
    lex.当前token = tok
    返回 lex
}
函数 lexerNextToken(lex: Lexer): Lexer {
    定义 可变 tok: Token
    tok.类型 = 6
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = lex.位置
    tok.结束位置 = lex.位置
    lex = lexer跳过空白(lex)
    定义 可变 ch: 整数
    ch = lex.当前字符
    tok.开始位置 = lex.开始位置
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    若 ch == 0 则 {
        tok.类型 = 6
        tok.值 = "EOF"
        lex.当前token = tok
        返回 lex
    }
    若 ch == 34 则 {
        lex = lexer读取字符串(lex)
        返回 lex
    }
    若 ch == 39 则 {
        lex = lexer读取字符(lex)
        返回 lex
    }
    若 ch == 47 则 {
        定义 可变 nextCh: 整数
        nextCh = 0
        若 lex.位置 + 1 < lex.长度 则 {
            nextCh = 字符编码(文本获取字符(lex.源码, lex.位置 + 1))
        }
        若 nextCh == 47 || nextCh == 42 则 {
            lex = lexer读取注释(lex)
            返回 lex
        }
    }
    若 是比较起始(ch) == 1 则 {
        lex = lexer读取复合运算符(lex)
        返回 lex
    }
    若 是字母(ch) == 1 则 {
        lex = lexer读取标识符(lex)
        返回 lex
    }
    若 是数字(ch) == 1 则 {
        lex = lexer读取数字(lex)
        返回 lex
    }
    若 是运算符(ch) == 1 则 {
        lex = lexer读取运算符(lex)
        返回 lex
    }
    若 是符号(ch) == 1 则 {
        lex = lexer读取符号(lex)
        返回 lex
    }
    lex = lexer前进(lex)
    tok.类型 = 12
    tok.值 = "UNKNOWN"
    tok.结束位置 = lex.位置
    lex.当前token = tok
    返回 lex
}
