函数 sema遍历AST(sema: Sema, ast: AST节点): 整数 {
    打印("=== 开始语义分析 ===")
    sema.错误计数 = 0
    sema.警告计数 = 0
    定义 可变 errorCount: 整数
    errorCount = 0
    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(ast.children) 则 {
        定义 可变 child: AST节点
        child = 列表获取(ast.children, i)
        若 child.kind == 1 则 {
            定义 可变 result: 整数
            result = sema遍历函数定义(sema, child)
            若 result < 0 则 {
                errorCount = errorCount + 1
            }
        } 否则 若 child.kind == 3 则 {
            定义 可变 result: 整数
            result = sema遍历变量定义(sema, child)
            若 result < 0 则 {
                errorCount = errorCount + 1
            }
        } 否则 若 child.kind == 21 则 {
            定义 可变 result: 整数
            result = sema遍历结构体定义(sema, child)
            若 result < 0 则 {
                errorCount = errorCount + 1
            }
        } 否则 若 child.kind == 22 则 {
            定义 可变 result: 整数
            result = sema遍历枚举定义(sema, child)
            若 result < 0 则 {
                errorCount = errorCount + 1
            }
        } 否则 若 child.kind == 30 则 {
            打印("跳过外部声明")
        } 否则 {
            打印("未知顶层声明类型: ")
            打印(child.kind)
        }
        i = i + 1
    }
    打印("=== 语义分析完成 ===")
    打印("错误数: ")
    打印(sema.错误计数)
    打印("警告数: ")
    打印(sema.警告计数)
    返回 errorCount
}
函数 sema遍历结构体定义(sema: Sema, structNode: AST节点): 整数 {
    定义 可变 structName: 文本
    structName = structNode.name
    打印("分析结构体定义: ")
    打印(structName)
    定义 可变 scopeIdx: 整数
    scopeIdx = 创建作用域(sema, structName)
    定义 可变 result: 整数
    result = 添加符号(sema, structName, 10, 0)
    打印("结构体字段数量: ")
    打印(列表长度(structNode.children))
    退出作用域(sema)
    返回 result
}
