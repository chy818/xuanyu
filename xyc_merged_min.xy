    }
    返回 lex
}
函数 是合法标识符起始(ch: 整数): 整数 {
    若 ch >= 65 && ch <= 90 则 { 返回 1 }
    若 ch >= 97 && ch <= 122 则 { 返回 1 }
    若 ch == 95 则 { 返回 1 }
    若 ch >= 0xE4 则 { 返回 1 }
    返回 0
}
函数 是合法标识符字符(ch: 整数): 整数 {
    若 是合法标识符起始(ch) == 1 则 { 返回 1 }
    若 ch >= 48 && ch <= 57 则 { 返回 1 }
    返回 0
}
函数 lexer验证标识符(lex: Lexer): 整数 {
    定义 可变 ch: 整数
    ch = lex.当前位置
    若 是合法标识符起始(ch) == 0 则 {
        返回 0
    }
    定义 可变 pos: 整数
    pos = lex.位置 + 1
    当 pos < lex.长度 则 {
        ch = lex.当前位置
        若 是合法标识符字符(ch) == 0 则 {
            跳出
        }
        pos = pos + 1
    }
    返回 1
}
