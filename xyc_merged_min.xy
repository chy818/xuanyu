    result = 添加符号(sema, "整数转文本", 3, 0)
    result = 添加符号(sema, "整数转文本内部", 3, 0)
    result = 添加符号(sema, "文本获取字符", 3, 0)
    result = 添加符号(sema, "字符编码", 0, 0)
    result = 添加符号(sema, "文本切片", 3, 0)
    result = 添加符号(sema, "列表", 7, 0)
    result = 添加符号(sema, "列表长度", 0, 0)
    result = 添加符号(sema, "列表追加", 5, 0)
    result = 添加符号(sema, "列表获取", 7, 0)
    result = 添加符号(sema, "列表设置", 5, 0)
    result = 添加符号(sema, "追加", 5, 0)
    result = 添加符号(sema, "获取", 7, 0)
    result = 添加符号(sema, "设置", 5, 0)
    result = 添加符号(sema, "读取文件", 3, 0)
    result = 添加符号(sema, "写入文件", 0, 0)
    result = 添加符号(sema, "文件存在", 2, 0)
    result = 添加符号(sema, "删除文件", 0, 0)
    result = 添加符号(sema, "执行命令", 0, 0)
    result = 添加符号(sema, "参数个数", 0, 0)
    result = 添加符号(sema, "命令行参数", 3, 0)
    result = 添加符号(sema, "获取参数个数", 0, 0)
    result = 添加符号(sema, "获取参数", 3, 0)
    result = 添加符号(sema, "utf8字节长度", 0, 0)
    result = 添加符号(sema, "是utf8首字节", 2, 0)
    result = 添加符号(sema, "是utf8续字节", 2, 0)
    result = 添加符号(sema, "是空格", 2, 0)
    result = 添加符号(sema, "是数字", 2, 0)
    result = 添加符号(sema, "是字母", 2, 0)
    result = 添加符号(sema, "是字母数字", 2, 0)
    result = 添加符号(sema, "运行时错误", 5, 0)
}
函数 分析变量定义(sema: Sema, 名称: 文本, 类型: 整数): 整数 {
    打印("分析变量定义: ")
    打印(名称)
    定义 可变 existing: 整数
    existing = 查找符号(sema, 名称)
    若 existing >= 0 则 {
        打印("错误: 变量 ")
        打印(名称)
        打印(" 已定义")
        返回 -1
    }
    定义 可变 result: 整数
    result = 添加符号(sema, 名称, 类型, 0)
    返回 result
}
函数 分析函数调用(sema: Sema, 函数名: 文本, 参数个数: 整数): 整数 {
    打印("分析函数调用: ")
    打印(函数名)
    打印(" (参数个数=")
    打印(参数个数)
    打印(")")
    定义 可变 funcIdx: 整数
    funcIdx = 查找符号(sema, 函数名)
    若 funcIdx < 0 则 {
        报告错误(sema, "函数未定义: " + 函数名, 0)
        返回 -1
    }
    返回 0
}
函数 分析二元表达式(sema: Sema, 左类型: 整数, 右类型: 整数, 运算符: 文本): 整数 {
    打印("分析二元表达式: ")
    打印(运算符)
    若 类型兼容(左类型, 右类型) == 0 则 {
        打印("警告: 类型不匹配")
    }
    若 运算符 == "+" || 运算符 == "-" || 运算符 == "*" || 运算符 == "/" || 运算符 == "%" 则 {
        若 左类型 == 1 || 右类型 == 1 则 {
            返回 1
        }
        返回 0
    }
    若 运算符 == "==" || 运算符 == "!=" || 运算符 == "<" || 运算符 == ">" || 运算符 == "<=" || 运算符 == ">=" 则 {
        返回 2
    }
    若 运算符 == "&&" || 运算符 == "||" 则 {
        若 左类型 != 2 || 右类型 != 2 则 {
            报告警告(sema, "逻辑运算需要布尔操作数", 0)
        }
        返回 2
    }
    返回 0
}
函数 分析一元表达式(sema: Sema, 操作数类型: 整数, 运算符: 文本): 整数 {
    打印("分析一元表达式: ")
    打印(运算符)
    若 运算符 == "-" 则 {
        若 操作数类型 == 2 则 {
            报告警告(sema, "布尔类型取负无意义", 0)
        }
        返回 操作数类型
    }
    若 运算符 == "!" 则 {
        若 操作数类型 != 2 则 {
            报告警告(sema, "逻辑非需要布尔操作数", 0)
        }
        返回 2
    }
    返回 操作数类型
}
函数 分析If语句(sema: Sema, 条件类型: 整数): 整数 {
    打印("分析 if 语句")
    若 条件类型 != 2 则 {
        打印("警告: if 条件应为布尔类型")
    }
    返回 0
}
函数 分析While语句(sema: Sema, 条件类型: 整数): 整数 {
    打印("分析 while 语句")
    若 条件类型 != 2 则 {
        打印("警告: while 条件应为布尔类型")
    }
    返回 0
}
函数 分析For语句(sema: Sema, 起始类型: 整数, 结束类型: 整数): 整数 {
    打印("分析 for 语句")
    若 起始类型 != 0 && 起始类型 != 1 则 {
        报告警告(sema, "for 循环起始值应为数值类型", 0)
    }
    若 结束类型 != 0 && 结束类型 != 1 则 {
        报告警告(sema, "for 循环结束值应为数值类型", 0)
    }
    返回 0
}
函数 分析返回语句(sema: Sema, 返回类型: 整数, 表达式类型: 整数): 整数 {
    打印("分析 return 语句")
    若 返回类型 == 5 则 {
        若 表达式类型 != 5 && 表达式类型 >= 0 则 {
            报告警告(sema, "void 函数不应有返回值", 0)
        }
        返回 0
    }
    若 表达式类型 < 0 则 {
        报告错误(sema, "return 语句缺少表达式", 0)
        返回 -1
    }
    若 检查赋值兼容性(返回类型, 表达式类型) == 0 则 {
        报告错误(sema, "返回值类型不匹配", 0)
        返回 -1
    }
    返回 0
}
