    } 否则 若 funcName == "文本查找" 则 {
        映射后的函数名 = "rt_string_indexOf"
    } 否则 若 funcName == "文本转大写" 则 {
        映射后的函数名 = "rt_string_toUpperCase"
    } 否则 若 funcName == "文本转小写" 则 {
        映射后的函数名 = "rt_string_toLowerCase"
    } 否则 若 funcName == "创建列表" 则 {
