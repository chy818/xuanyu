函数 codegen遍历函数定义(cg: Codegen, funcNode: AST节点): 无返回 {
    定义 可变 funcName: 文本
    funcName = funcNode.name
    定义 可变 returnType: 文本
    returnType = "i64"
    打印("生成函数: ")
    打印(funcName)
    定义 可变 fullFuncName: 文本
    若 funcName == "主" 则 {
        fullFuncName = "xy_main"
    } 否则 {
        fullFuncName = cg.moduleName + "_" + funcName
    }
    cg.currentFunc = fullFuncName
    cg.currentFunctionIndex = cg.functionIndexCounter
    cg.functionIndexCounter = cg.functionIndexCounter + 1
    codegen清空变量(cg)
    codegenEmit(cg, "")
    定义 可变 bodyIdx: 整数
    bodyIdx = 0
    定义 可变 paramStr: 文本
    paramStr = ""
    若 列表长度(funcNode.children) > 1 则 {
        定义 可变 paramNode: AST节点
        paramNode = 列表获取(funcNode.children, 0)
        若 paramNode.kind == 2 则 {
            bodyIdx = 1
            定义 可变 i: 整数
            i = 0
            当 i < 列表长度(paramNode.children) 则 {
                定义 可变 param: AST节点
                param = paramNode.children[i]
                若 i > 0 则 {
                    paramStr = paramStr + ", "
                }
                paramStr = paramStr + "i64 %" + param.name
                i = i + 1
            }
        }
    }
    定义 可变 fullFuncName: 文本
    若 funcName == "主" 则 {
        fullFuncName = "xy_main"
    } 否则 {
        fullFuncName = cg.moduleName + "_" + funcName
    }
    codegenEmit(cg, "define " + returnType + " @" + fullFuncName + "(" + paramStr + ") {")
    cg.indent = cg.indent + 1
    若 bodyIdx < 列表长度(funcNode.children) 则 {
        定义 可变 body: AST节点
        body = 列表获取(funcNode.children, bodyIdx)
        定义 可变 bodyHasReturn: 整数
        bodyHasReturn = codegen块语句有返回语句(cg, body)
        若 body.kind == 18 则 {
            codegen遍历块语句(cg, body)
            若 bodyHasReturn == 0 则 {
                codegenEmit(cg, "  %tmp0 = add i64 0, 0")
                codegenEmit(cg, "  ret i64 %tmp0")
            }
        } 否则 {
            定义 可变 result: 文本
            result = codegen遍历表达式(cg, body)
            若 body.kind != 8 则 {
                codegenEmit(cg, "  ret i64 %" + result)
            }
        }
    } 否则 {
        codegenEmit(cg, "  %tmp0 = add i64 0, 0")
        codegenEmit(cg, "  ret i64 %tmp0")
    }
    cg.indent = cg.indent - 1
    codegenEmit(cg, "}")
    cg.funcCount = cg.funcCount + 1
}
函数 codegen块语句有返回语句(cg: Codegen, block: AST节点): 整数 {
    若 block.kind != 18 则 {
        若 block.kind == 8 则 {
            返回 1
        } 否则 {
            返回 0
        }
    }
    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(block.children) && i < 50 则 {
        定义 可变 stmt: AST节点
        stmt = block.children[i]
        若 stmt.kind == 8 则 {
            返回 1
        }
        若 stmt.kind == 5 则 {
            定义 可变 thenBlock: AST节点
            thenBlock = 列表获取(stmt.children, 1)
            若 codegen块语句有返回语句(cg, thenBlock) == 1 则 {
                返回 1
            }
        }
        若 stmt.kind == 6 则 {
            定义 可变 body: AST节点
            body = 列表获取(stmt.children, 1)
            若 codegen块语句有返回语句(cg, body) == 1 则 {
                返回 1
            }
        }
        若 stmt.kind == 20 则 {
            定义 可变 body: AST节点
            body = 列表获取(stmt.children, 3)
            若 codegen块语句有返回语句(cg, body) == 1 则 {
                返回 1
            }
        }
        i = i + 1
    }
    返回 0
}
函数 codegen遍历块语句(cg: Codegen, block: AST节点): 无返回 {
    若 block.kind != 18 则 {
        codegen遍历语句(cg, block)
        返回
    }
    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(block.children) && i < 50 则 {
        定义 可变 stmt: AST节点
        stmt = block.children[i]
        codegen遍历语句(cg, stmt)
        若 stmt.kind == 8 则 {
            跳出循环
        }
        i = i + 1
    }
}
函数 codegen遍历语句(cg: Codegen, stmt: AST节点): 无返回 {
    若 stmt.kind == 3 则 {
        codegen遍历变量定义(cg, stmt)
    } 否则 {
        若 stmt.kind == 4 则 {
            codegen遍历赋值语句(cg, stmt)
        } 否则 {
            若 stmt.kind == 5 则 {
                codegen遍历If语句(cg, stmt)
            } 否则 {
                若 stmt.kind == 6 则 {
                    codegen遍历While语句(cg, stmt)
                } 否则 {
                    若 stmt.kind == 20 则 {
                        codegen遍历For语句(cg, stmt)
                    } 否则 {
                        若 stmt.kind == 8 则 {
                            codegen遍历返回语句(cg, stmt)
                        } 否则 {
                            若 stmt.kind == 16 则 {
                                codegen遍历Break语句(cg, stmt)
                            } 否则 {
                                若 stmt.kind == 17 则 {
                                    codegen遍历Continue语句(cg, stmt)
                                } 否则 {
                                    若 stmt.kind == 9 则 {
                                        定义 可变 result: 文本
                                        result = codegen遍历表达式(cg, stmt)
                                    } 否则 {
                                        若 stmt.kind == 12 则 {
                                            定义 可变 result: 文本
                                            result = codegen遍历函数调用(cg, stmt.name, stmt.children)
                                        } 否则 {
                                            若 stmt.kind == 18 则 {
                                                codegen遍历块语句(cg, stmt)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
函数 codegen遍历变量定义(cg: Codegen, varNode: AST节点): 无返回 {
    定义 可变 varName: 文本
    varName = varNode.name
    定义 可变 slotCount: 整数
    slotCount = 1
    定义 可变 varTypeTag: 文本
    varTypeTag = varNode.value  // type annotation like "Token", "Lexer", "整数" etc
    若 varTypeTag == "Token" 则 { slotCount = 6 }
    否则 若 varTypeTag == "Lexer" 则 { slotCount = 10 }
    否则 若 varTypeTag == "Sema" 则 { slotCount = 11 }
    否则 若 varTypeTag == "Codegen" 则 { slotCount = 12 }
    否则 若 varTypeTag == "Parser" 则 { slotCount = 9 }
    否则 若 varTypeTag == "AST节点" 则 { slotCount = 7 }
    否则 若 varTypeTag == "循环上下文" 则 { slotCount = 4 }
    否则 若 varTypeTag == "循环状态" 则 { slotCount = 2 }
    定义 可变 slotVar: 文本
    slotVar = codegenNewTemp(cg)
    定义 可变 tmpPtr: 文本
    tmpPtr = slotVar
    定义 可变 i: 整数
    i = 0
    当 i < slotCount 则 {
        定义 可变 slotName: 文本
        若 i == 0 则 {
            slotName = slotVar
        } 否则 {
            slotName = slotVar + "_" + 整数转文本(i)
        }
        codegenEmit(cg, "  %" + slotName + " = alloca i64, align 8")
        i = i + 1
    }
    codegen添加变量(cg, varName, tmpPtr, varTypeTag)
    若 列表长度(varNode.children) > 0 则 {
        定义 可变 initNode: AST节点
        initNode = 列表获取(varNode.children, 0)
        定义 可变 initVal: 文本
        initVal = codegen遍历表达式(cg, initNode)
        codegenEmit(cg, "  store i64 %" + initVal + ", i64* %" + tmpPtr)
    }
}
函数 codegen查找结构体字段(结构体名: 文本, 字段名: 文本): 文本 {
    若 结构体名 == "Token" 则 {
        若 字段名 == "类型" 则 { 返回 "0|i64" }
        若 字段名 == "值" 则 { 返回 "8|i8*" }
        若 字段名 == "行号" 则 { 返回 "16|i64" }
        若 字段名 == "列号" 则 { 返回 "24|i64" }
        若 字段名 == "开始位置" 则 { 返回 "32|i64" }
        若 字段名 == "结束位置" 则 { 返回 "40|i64" }
    }
    若 结构体名 == "Lexer" 则 {
        若 字段名 == "源码" 则 { 返回 "0|i8*" }
        若 字段名 == "位置" 则 { 返回 "8|i64" }
        若 字段名 == "长度" 则 { 返回 "16|i64" }
        若 字段名 == "行号" 则 { 返回 "24|i64" }
        若 字段名 == "列号" 则 { 返回 "32|i64" }
        若 字段名 == "当前字符" 则 { 返回 "40|i64" }
        若 字段名 == "开始位置" 则 { 返回 "48|i64" }
        若 字段名 == "当前位置" 则 { 返回 "56|i64" }
    }
    若 结构体名 == "AST节点" 则 {
        若 字段名 == "id" 则 { 返回 "0|i64" }
        若 字段名 == "kind" 则 { 返回 "8|i64" }
        若 字段名 == "name" 则 { 返回 "16|i8*" }
        若 字段名 == "value" 则 { 返回 "24|i8*" }
        若 字段名 == "intValue" 则 { 返回 "32|i64" }
        若 字段名 == "line" 则 { 返回 "40|i64" }
        若 字段名 == "children" 则 { 返回 "48|i8*" }
    }
    若 结构体名 == "Codegen" 则 {
        若 字段名 == "output" 则 { 返回 "24|i8*" }
        若 字段名 == "indent" 则 { 返回 "32|i64" }
    }
    若 结构体名 == "Sema" 则 {
        若 字段名 == "错误计数" 则 { 返回 "56|i64" }
        若 字段名 == "警告计数" 则 { 返回 "64|i64" }
    }
    返回 ""
}
函数 codegen遍历赋值语句(cg: Codegen, assignNode: AST节点): 无返回 {
    定义 可变 varName: 文本
    varName = assignNode.name
    定义 可变 isFieldAssign: 整数
    isFieldAssign = 0
    定义 可变 baseName: 文本
    baseName = ""
    定义 可变 fieldName: 文本
    fieldName = ""
    若 文本长度(varName) > 2 则 {
        定义 可变 ch1: 文本
        ch1 = 文本获取字符(varName, 0)
        若 ch1 == "t" 则 {
            若 文本长度(varName) > 5 则 {
                定义 可变 ch2: 文本
                ch2 = 文本获取字符(varName, 1)
                若 ch2 == "o" 则 {
                    isFieldAssign = 1
                    baseName = "tok"
                    fieldName = 文本获取字符(varName, 4) + 文本获取字符(varName, 5)
                }
            }
        } 否则 若 ch1 == "l" 则 {
            isFieldAssign = 1
            baseName = "lex"
            fieldName = 文本获取字符(varName, 4) + 文本获取字符(varName, 5)
        } 否则 若 ch1 == "c" 则 {
            isFieldAssign = 1
            baseName = "cg"
            fieldName = 文本获取字符(varName, 3) + 文本获取字符(varName, 4)
        } 否则 若 ch1 == "p" 则 {
            isFieldAssign = 1
            baseName = "p"
            fieldName = 文本获取字符(varName, 2) + 文本获取字符(varName, 3)
        } 否则 若 ch1 == "a" 则 {
            isFieldAssign = 1
            baseName = "ast"
            fieldName = 文本获取字符(varName, 4) + 文本获取字符(varName, 5)
        }
    }
    若 isFieldAssign == 1 则 {
        定义 可变 basePtr: 文本
        basePtr = codegen查找变量(cg, baseName)
        若 basePtr != "" 则 {
            定义 可变 fieldOffset: 文本
            fieldOffset = ""
            定义 可变 fieldType: 文本
            fieldType = ""
            若 baseName == "tok" 则 {
                若 fieldName == "类型" 则 { fieldOffset = "0"; fieldType = "i64" }
                否则 若 fieldName == "值" 则 { fieldOffset = "8"; fieldType = "i8*" }
                否则 若 fieldName == "行号" 则 { fieldOffset = "16"; fieldType = "i64" }
                否则 若 fieldName == "列号" 则 { fieldOffset = "24"; fieldType = "i64" }
                否则 若 fieldName == "开始位置" 则 { fieldOffset = "32"; fieldType = "i64" }
                否则 若 fieldName == "结束位置" 则 { fieldOffset = "40"; fieldType = "i64" }
            }
            若 baseName == "lex" 则 {
                若 fieldName == "源码" 则 { fieldOffset = "0"; fieldType = "i8*" }
                否则 若 fieldName == "位置" 则 { fieldOffset = "8"; fieldType = "i64" }
                否则 若 fieldName == "长度" 则 { fieldOffset = "16"; fieldType = "i64" }
                否则 若 fieldName == "行号" 则 { fieldOffset = "24"; fieldType = "i64" }
                否则 若 fieldName == "列号" 则 { fieldOffset = "32"; fieldType = "i64" }
                否则 若 fieldName == "当前字符" 则 { fieldOffset = "40"; fieldType = "i64" }
                否则 若 fieldName == "开始位置" 则 { fieldOffset = "48"; fieldType = "i64" }
                否则 若 fieldName == "当前位置" 则 { fieldOffset = "56"; fieldType = "i64" }
            }
            若 baseName == "cg" 则 {
                若 fieldName == "output" 则 { fieldOffset = "24"; fieldType = "i8*" }
                否则 若 fieldName == "indent" 则 { fieldOffset = "32"; fieldType = "i64" }
                否则 若 fieldName == "tempCount" 则 { fieldOffset = "8"; fieldType = "i64" }
                否则 若 fieldName == "labelCount" 则 { fieldOffset = "16"; fieldType = "i64" }
                否则 若 fieldName == "funcCount" 则 { fieldOffset = "40"; fieldType = "i64" }
            }
            若 baseName == "sema" 则 {
                若 fieldName == "错误计数" 则 { fieldOffset = "56"; fieldType = "i64" }
                否则 若 fieldName == "警告计数" 则 { fieldOffset = "64"; fieldType = "i64" }
            }
            若 fieldOffset != "" 则 {
                若 列表长度(assignNode.children) > 0 则 {
                    定义 可变 rightNode: AST节点
                    rightNode = 列表获取(assignNode.children, 0)
                    定义 可变 rightVal: 文本
                    rightVal = codegen遍历表达式(cg, rightNode)
                    定义 可变 gepLabel: 文本
                    gepLabel = codegenNewTemp(cg)
                    codegenEmit(cg, "  %" + gepLabel + " = getelementptr i8, i8* %" + basePtr + ", i32 " + fieldOffset)
                    定义 可变 typedPtr: 文本
                    typedPtr = codegenNewTemp(cg)
                    codegenEmit(cg, "  %" + typedPtr + " = bitcast i8* %" + gepLabel + " to " + fieldType + "*")
                    codegenEmit(cg, "  store " + fieldType + " %" + rightVal + ", " + fieldType + "* %" + typedPtr)
                }
                返回
            }
        }
    }
    定义 可变 tmpPtr: 文本
    tmpPtr = codegen查找变量(cg, varName)
    若 tmpPtr == "" 则 {
        tmpPtr = varName + "_slot"
    }
    定义 可变 varType: 文本
    varType = codegen查找变量类型(cg, varName)
    若 varType == "" 则 {
        varType = "i64"
    }
    若 列表长度(assignNode.children) > 0 则 {
        定义 可变 rightNode: AST节点
        rightNode = 列表获取(assignNode.children, 0)
        定义 可变 rightVal: 文本
        rightVal = codegen遍历表达式(cg, rightNode)
        codegenEmit(cg, "  store " + varType + " %" + rightVal + ", " + varType + "* %" + tmpPtr)
    }
}
函数 codegen遍历Break语句(cg: Codegen, breakNode: AST节点): 无返回 {
    定义 可变 ctx: 循环上下文
    ctx = codegen获取当前循环上下文(cg)
    若 ctx.结束标签 != "" 则 {
        codegenEmit(cg, "  br label %" + ctx.结束标签)
    }
}
函数 codegen遍历Continue语句(cg: Codegen, continueNode: AST节点): 无返回 {
    定义 可变 ctx: 循环上下文
    ctx = codegen获取当前循环上下文(cg)
    若 ctx.continue标签 != "" 则 {
        codegenEmit(cg, "  br label %" + ctx.continue标签)
    }
}
函数 codegen遍历If语句(cg: Codegen, ifNode: AST节点): 无返回 {
    定义 可变 thenLabel: 文本
    thenLabel = codegenNewLabel(cg)
    定义 可变 elseLabel: 文本
    elseLabel = codegenNewLabel(cg)
    定义 可变 endLabel: 文本
    endLabel = codegenNewLabel(cg)
    定义 可变 cond: AST节点
    cond = 列表获取(ifNode.children, 0)
    定义 可变 condVar: 文本
    condVar = codegen遍历表达式(cg, cond)
    codegenEmit(cg, "  br i1 %" + condVar + ", label %" + thenLabel + ", label %" + elseLabel)
    codegenEmit(cg, thenLabel + ":")
    定义 可变 thenBlock: AST节点
    thenBlock = 列表获取(ifNode.children, 1)
    定义 可变 thenHasReturn: 整数
    thenHasReturn = codegen块语句有返回语句(cg, thenBlock)
    codegen遍历块语句(cg, thenBlock)
    若 thenHasReturn == 0 则 {
        codegenEmit(cg, "  br label %" + endLabel)
    }
    codegenEmit(cg, elseLabel + ":")
    定义 可变 childrenLen: 整数
    childrenLen = 列表长度(ifNode.children)
    若 childrenLen >= 3 则 {
        定义 可变 elseBlock: AST节点
        elseBlock = 列表获取(ifNode.children, 2)
        定义 可变 elseHasReturn: 整数
        elseHasReturn = codegen块语句有返回语句(cg, elseBlock)
        codegen遍历块语句(cg, elseBlock)
        若 elseHasReturn == 0 则 {
            codegenEmit(cg, "  br label %" + endLabel)
        }
    } 否则 {
        codegenEmit(cg, "  br label %" + endLabel)
    }
    codegenEmit(cg, endLabel + ":")
    codegenEmit(cg, "  %tmp_end = add i64 0, 0")
}
函数 codegen遍历While语句(cg: Codegen, whileNode: AST节点): 无返回 {
    定义 可变 condLabel: 文本
    condLabel = codegenNewLabelWithPrefix(cg, "while_cond_")
    定义 可变 bodyLabel: 文本
    bodyLabel = codegenNewLabelWithPrefix(cg, "while_body_")
    定义 可变 endLabel: 文本
    endLabel = codegenNewLabelWithPrefix(cg, "while_end_")
    定义 可变 ctx: 循环上下文
    ctx.循环开始标签 = condLabel
    ctx.循环体标签 = bodyLabel
    ctx.continue标签 = condLabel
    ctx.结束标签 = endLabel
    codegen推入循环上下文(cg, ctx)
    codegenEmit(cg, "  br label %" + condLabel)
    cg.indent = cg.indent - 1
    codegenEmit(cg, condLabel + ":")
    cg.indent = cg.indent + 1
    定义 可变 cond: AST节点
    cond = 列表获取(whileNode.children, 0)
    定义 可变 condVar: 文本
    condVar = codegen遍历表达式(cg, cond)
    codegenEmit(cg, "  br i1 %" + condVar + ", label %" + bodyLabel + ", label %" + endLabel)
    cg.indent = cg.indent - 1
    codegenEmit(cg, bodyLabel + ":")
    cg.indent = cg.indent + 1
    定义 可变 body: AST节点
    body = 列表获取(whileNode.children, 1)
    codegen遍历块语句(cg, body)
    codegenEmit(cg, "  br label %" + condLabel)
    cg.indent = cg.indent - 1
    codegenEmit(cg, endLabel + ":")
    cg.indent = cg.indent + 1
    codegenEmit(cg, "  %tmp_end = add i64 0, 0")
    codegen弹出循环上下文(cg)
}
函数 codegen遍历For语句(cg: Codegen, forNode: AST节点): 无返回 {
    定义 可变 initLabel: 文本
    initLabel = codegenNewLabel(cg)
    定义 可变 condLabel: 文本
    condLabel = codegenNewLabel(cg)
    定义 可变 bodyLabel: 文本
    bodyLabel = codegenNewLabel(cg)
    定义 可变 incLabel: 文本
    incLabel = codegenNewLabel(cg)
    定义 可变 endLabel: 文本
    endLabel = codegenNewLabel(cg)
    codegenEmit(cg, "  br label %" + initLabel)
    codegenEmit(cg, initLabel + ":")
    定义 可变 init: AST节点
    init = 列表获取(forNode.children, 0)
    codegen遍历表达式(cg, init)
    codegenEmit(cg, "  br label %" + condLabel)
    codegenEmit(cg, condLabel + ":")
    定义 可变 cond: AST节点
    cond = 列表获取(forNode.children, 1)
    定义 可变 condVar: 文本
    condVar = codegen遍历表达式(cg, cond)
    codegenEmit(cg, "  br i1 %" + condVar + ", label %" + bodyLabel + ", label %" + endLabel)
    codegenEmit(cg, bodyLabel + ":")
    定义 可变 body: AST节点
    body = 列表获取(forNode.children, 2)
    codegen遍历块语句(cg, body)
    codegenEmit(cg, "  br label %" + incLabel)
    codegenEmit(cg, incLabel + ":")
    定义 可变 inc: AST节点
    inc = 列表获取(forNode.children, 1)
    codegen遍历表达式(cg, inc)
    codegenEmit(cg, "  br label %" + condLabel)
    codegenEmit(cg, endLabel + ":")
}
函数 codegen遍历返回语句(cg: Codegen, retNode: AST节点): 无返回 {
    若 列表长度(retNode.children) > 0 则 {
        定义 可变 result: 文本
        result = codegen遍历表达式(cg, retNode.children[0])
        codegenEmit(cg, "  ret i64 %" + result)
    } 否则 {
        codegenEmit(cg, "  ret void")
    }
}
函数 codegen遍历表达式(cg: Codegen, expr: AST节点): 文本 {
    定义 可变 result: 文本
    result = ""
    若 expr.kind == 13 则 {
        result = codegen遍历标识符(cg, expr.name)
    } 否则 {
        若 expr.kind == 14 则 {
            result = codegen遍历字面量(cg, expr.value)
        } 否则 {
            若 expr.kind == 10 则 {
                若 列表长度(expr.children) >= 2 则 {
                    定义 可变 leftChild: AST节点
                    定义 可变 rightChild: AST节点
                    leftChild = 列表获取(expr.children, 0)
                    rightChild = 列表获取(expr.children, 1)
                    result = codegen遍历二元表达式(cg, expr.name, leftChild, rightChild)
                } 否则 {
                    result = codegenNewTemp(cg)
                    codegenEmit(cg, "  %" + result + " = add i64 0, 0")
                }
            } 否则 {
                若 expr.kind == 11 则 {
                    若 列表长度(expr.children) >= 1 则 {
                        定义 可变 operand: AST节点
                        operand = 列表获取(expr.children, 0)
                        result = codegen遍历一元表达式(cg, expr.name, operand)
                    } 否则 {
                        result = codegenNewTemp(cg)
                        codegenEmit(cg, "  %" + result + " = add i64 0, 0")
                    }
                } 否则 {
                    若 expr.kind == 12 则 {
                        result = codegen遍历函数调用(cg, expr.name, expr.children)
                    } 否则 {
                        若 expr.kind == 19 则 {
                            若 列表长度(expr.children) >= 2 则 {
                                定义 可变 leftChild: AST节点
                                定义 可变 rightChild: AST节点
                                leftChild = 列表获取(expr.children, 0)
                                rightChild = 列表获取(expr.children, 1)
                                result = codegen遍历表达式(cg, rightChild)
                                若 leftChild.kind == 13 则 {
                                    定义 可变 varName: 文本
                                    定义 可变 tmpPtr: 文本
                                    定义 可变 varType: 文本
                                    varName = leftChild.name
                                    tmpPtr = codegen查找变量(cg, varName)
                                    若 tmpPtr == "" 则 {
                                        tmpPtr = varName + "_slot"
                                    }
                                    varType = codegen查找变量类型(cg, varName)
                                    若 varType == "" 则 {
                                        varType = "i64"
                                    }
                                    codegenEmit(cg, "  store " + varType + " %" + result + ", " + varType + "* %" + tmpPtr)
                                } 否则 {
                                    若 leftChild.kind == 15 则 {
                                        若 列表长度(leftChild.children) >= 2 则 {
                                            定义 可变 baseNode: AST节点
                                            定义 可变 indexNode: AST节点
                                            baseNode = 列表获取(leftChild.children, 0)
                                            indexNode = 列表获取(leftChild.children, 1)
                                            定义 可变 listVal: 文本
                                            定义 可变 indexVal: 文本
                                            listVal = codegen遍历表达式(cg, baseNode)
                                            indexVal = codegen遍历表达式(cg, indexNode)
                                            codegenEmit(cg, "  call void @rt_list_set(i8* %" + listVal + ", i64 %" + indexVal + ", i8* %" + result + ")")
                                        }
                                    }
                                }
                            } 否则 {
                                result = codegenNewTemp(cg)
                                codegenEmit(cg, "  %" + result + " = add i64 0, 0")
                            }
                        } 否则 {
                            若 expr.kind == 15 则 {
                                若 列表长度(expr.children) >= 2 则 {
                                    定义 可变 baseNode: AST节点
                                    定义 可变 indexNode: AST节点
                                    baseNode = 列表获取(expr.children, 0)
                                    indexNode = 列表获取(expr.children, 1)
                                    定义 可变 listVal: 文本
                                    定义 可变 indexVal: 文本
                                    listVal = codegen遍历表达式(cg, baseNode)
                                    indexVal = codegen遍历表达式(cg, indexNode)
                                    result = codegenNewTemp(cg)
                                    codegenEmit(cg, "  %" + result + " = call i8* @rt_list_get(i8* %" + listVal + ", i64 %" + indexVal + ")")
                                } 否则 {
                                    result = codegenNewTemp(cg)
                                    codegenEmit(cg, "  %" + result + " = add i64 0, 0")
                                }
                            } 否则 {
                                result = codegenNewTemp(cg)
                                codegenEmit(cg, "  %" + result + " = add i64 0, 0")
                            }
                            }
                        }
                    }
                }
             }
        }
    返回 result
}
函数 codegen遍历标识符(cg: Codegen, name: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    定义 可变 slotName: 文本
    slotName = codegen查找变量(cg, name)
    若 slotName == "" 则 {
        slotName = escapeLLVM标识符(name) + "_slot"
    }
    定义 可变 varType: 文本
    varType = codegen查找变量类型(cg, name)
    若 varType == "i8*" 则 {
        codegenEmit(cg, "  %" + result + " = load i8*, i8** %" + slotName)
    } 否则 {
        codegenEmit(cg, "  %" + result + " = load i64, i64* %" + slotName)
    }
    返回 result
}
函数 codegen遍历字面量(cg: Codegen, value: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    定义 可变 是字符串: 整数
    是字符串 = 0
    定义 可变 i: 整数
    i = 0
    当 i < 文本长度(value) 则 {
        若 value[i] == 34 则 {
            是字符串 = 1
            跳出
        }
        i = i + 1
    }
    若 是字符串 == 1 则 {
        定义 可变 strContent: 文本
        strContent = ""
        i = 1
        当 i < 文本长度(value) - 1 则 {
            strContent = strContent + 整数转字符(value[i])
            i = i + 1
        }
        定义 可变 constName: 文本
        constName = "str"
        定义 可变 idxStr: 文本
        idxStr = 整数转文本(cg.stringConstCount)
        constName = constName + idxStr
        cg.stringConstCount = cg.stringConstCount + 1
        定义 可变 len: 整数
        len = 文本长度(strContent) + 1
        定义 可变 constLine: 文本
        constLine = "@" + constName + " = private constant [" + 整数转文本(len) + " x i8] c\"" + strContent + "\\00\"\n"
        cg.stringConstDefs = cg.stringConstDefs + constLine
        定义 可变 ptrResult: 文本
        ptrResult = codegenNewTemp(cg)
        codegenEmit(cg, "%" + ptrResult + " = getelementptr [" + 整数转文本(len) + " x i8], [" + 整数转文本(len) + " x i8]* @" + constName + ", i64 0, i64 0")
        返回 ptrResult
    } 否则 {
        定义 可变 numValue: 整数
        numValue = 文本转整数(value)
        codegenEmit(cg, "%" + result + " = add i64 0, " + 整数转文本(numValue))
    }
    返回 result
}
函数 codegen遍历二元表达式(cg: Codegen, op: 文本, left: AST节点, right: AST节点): 文本 {
    定义 可变 leftVal: 文本
    leftVal = codegen遍历表达式(cg, left)
    定义 可变 rightVal: 文本
    rightVal = codegen遍历表达式(cg, right)
    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    定义 可变 llOp: 文本
    定义 可变 resultType: 文本
    llOp = "add"
    resultType = "i64"
    若 op == "+" 则 { llOp = "add"; resultType = "i64" }
    若 op == "-" 则 { llOp = "sub"; resultType = "i64" }
    若 op == "*" 则 { llOp = "mul"; resultType = "i64" }
    若 op == "/" 则 { llOp = "sdiv"; resultType = "i64" }
    若 op == "%" 则 { llOp = "srem"; resultType = "i64" }
    若 op == "==" 则 { llOp = "icmp eq"; resultType = "i64" }
    若 op == "!=" 则 { llOp = "icmp ne"; resultType = "i64" }
    若 op == "<" 则 { llOp = "icmp slt"; resultType = "i64" }
    若 op == ">" 则 { llOp = "icmp sgt"; resultType = "i64" }
    若 op == "<=" 则 { llOp = "icmp sle"; resultType = "i64" }
    若 op == ">=" 则 { llOp = "icmp sge"; resultType = "i64" }
    若 op == "&&" 则 { llOp = "and"; resultType = "i1" }
    若 op == "||" 则 { llOp = "or"; resultType = "i1" }
    若 op == "&" 则 { llOp = "and"; resultType = "i64" }
    若 op == "|" 则 { llOp = "or"; resultType = "i64" }
    若 op == "^" 则 { llOp = "xor"; resultType = "i64" }
    若 op == "<<" 则 { llOp = "shl"; resultType = "i64" }
    若 op == ">>" 则 { llOp = "lshr"; resultType = "i64" }
    codegenEmit(cg, "  %" + result + " = " + llOp + " " + resultType + " %" + leftVal + ", %" + rightVal)
    返回 result
}
函数 codegen遍历一元表达式(cg: Codegen, op: 文本, operand: AST节点): 文本 {
    定义 可变 operandVal: 文本
    operandVal = codegen遍历表达式(cg, operand)
    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    若 op == "-" 则 {
        codegenEmit(cg, "  %" + result + " = sub i64 0, %" + operandVal)
    } 否则 {
        若 op == "!" 则 {
            codegenEmit(cg, "  %" + result + " = xor i1 %" + operandVal + ", true")
        }
    }
    返回 result
}
