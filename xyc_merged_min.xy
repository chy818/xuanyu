函数 emitOptimizationHint(cg: Codegen, level: 整数): 无返回 {
    定义 可变 line: 文本
    line = "; llvm. opts: "
    若 level == 0 则 {
        line = line + "O0"
    } 否则 {
        若 level == 1 则 {
            line = line + "O1"
        } 否则 {
            若 level == 2 则 {
                line = line + "O2"
            } 否则 {
                若 level == 3 则 {
                    line = line + "O3"
                } 否则 {
                    line = line + "Os"
                }
            }
        }
    }
    codegenEmit(cg, line)
}
