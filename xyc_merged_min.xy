    定义 可变 ctx: LexerContext
    ctx.状态 = 状态开始
    ctx.起始位置 = 0
    ctx.当前位置 = 0
    ctx.行号 = 1
    ctx.列号 = 0
    ctx.错误信息 = ""
    ctx.是否错误 = 0
    返回 ctx
}
函数 lexer上下文中获取字符(ctx: LexerContext, 源码: 文本): 整数 {
    若 ctx.当前位置 >= 文本长度(源码) 则 {
        返回 0
    }
    定义 可变 ch: 整数
    ch = 字符编码(文本获取字符(源码, ctx.当前位置))
    返回 ch
}
函数 lexer状态转换(ctx: LexerContext, ch: 整数): 整数 {
    定义 可变 下一状态: 整数
    下一状态 = ctx.状态
    若 ctx.状态 == 状态开始 则 {
        若 ch == 0 则 {
            下一状态 = 状态结束
        } 否则 {
            若 是空白(ch) == 1 则 {
                下一状态 = 状态开始
            } 否则 {
                若 是字母(ch) == 1 则 {
                    下一状态 = 状态标识符
                } 否则 {
                    若 是数字(ch) == 1 则 {
                        下一状态 = 状态数字
                    } 否则 {
                        若 ch == 34 则 {
                            下一状态 = 状态字符串
                        } 否则 {
                            若 ch == 39 则 {
                                下一状态 = 状态字符
                            } 否则 {
                                若 ch == 47 则 {
                                    下一状态 = 状态注释
                                } 否则 {
                                    下一状态 = 状态运算符
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    返回 下一状态
}
