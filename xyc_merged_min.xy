函数 codegen遍历AST(ast: AST节点): 文本 {
    定义 可变 cg: Codegen
    cg = codegenInit()
    打印("=== 开始 AST 遍历 ===")
    定义 可变 line: 文本
    line = "; Module: xuanyu_program"
    codegenEmit(cg, line)
    emitModuleHeader(cg, "xuanyu_program")
    emitTargetData(cg)
    emitBuiltinDecls(cg)
    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(ast.children) 则 {
        定义 可变 child: AST节点
        child = 列表获取(ast.children, i)
        若 child.kind == 1 则 {
            codegen遍历函数定义(cg, child)
        } 否则 {
            若 child.kind == 21 则 {
                codegen遍历结构体定义(cg, child)
            } 否则 {
                若 child.kind == 22 则 {
                    codegen遍历枚举定义(cg, child)
                } 否则 {
                    若 child.kind == 29 则 {
                        codegen遍历模块定义(cg, child)
                    } 否则 {
                        若 child.kind == 28 则 {
                            codegen遍历导入语句(cg, child)
                        } 否则 {
                            若 child.kind == 30 则 {
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    emitMainWrapper(cg)
    若 cg.stringConstDefs != "" 则 {
        cg.output = cg.output + "\n; === 字符串常量 ===\n" + cg.stringConstDefs
    }
    打印("=== AST 遍历完成 ===")
    打印("共生成 ")
    打印(cg.funcCount)
    打印(" 个函数")
    返回 cg.output
}
