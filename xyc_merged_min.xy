}
函数 获取Token类型名(类型: 整数): 文本 {
    若 类型 == 0 则 { 返回 "标识符" }
    若 类型 == 1 则 { 返回 "数字" }
    若 类型 == 2 则 { 返回 "字符串" }
    若 类型 == 3 则 { 返回 "关键字" }
    若 类型 == 4 则 { 返回 "运算符" }
    若 类型 == 5 则 { 返回 "符号" }
    若 类型 == 6 则 { 返回 "结束" }
    若 类型 == 7 则 { 返回 "注释" }
    若 类型 == 8 则 { 返回 "字符" }
    若 类型 == 9 则 { 返回 "赋值" }
    若 类型 == 10 则 { 返回 "比较" }
    若 类型 == 11 则 { 返回 "逻辑" }
    若 类型 == 12 则 { 返回 "错误" }
    返回 "未知"
}
函数 lexer验证Tokens(tokens: 列表): 整数 {
