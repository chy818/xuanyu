枚举 TokenType {
    标识符,     // 0 - Id
    数字,       // 1 - Num
    字符串,     // 2 - Str
    关键字,     // 3 - Kw
    运算符,     // 4 - Op
    符号,       // 5 - Sym
    结束,       // 6 - Eof
    注释,       // 7 - Comment
    字符,       // 8 - Char
    赋值,       // 9 - Assign
    比较,       // 10 - Compare
    逻辑,       // 11 - Logical
    错误        // 12 - Error
}

/* ============ Token 结构 ============ */

结构体 Token {
    类型: 整数,      // TokenType
    值: 文本,        // token 文本值
    行号: 整数,      // 所在行
    
函数 主(): 整数 { 返回 0 }
