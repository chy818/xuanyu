    若 text == "函数" 则 { 返回 1 }
    若 text == "结构体" 则 { 返回 1 }
    若 text == "枚举" 则 { 返回 1 }
    若 text == "真" 则 { 返回 1 }
    若 text == "假" 则 { 返回 1 }
    若 text == "跳过" 则 { 返回 1 }
    若 text == "退出" 则 { 返回 1 }
    若 text == "整数" 则 { 返回 1 }
    若 text == "浮点数" 则 { 返回 1 }
    若 text == "双精度" 则 { 返回 1 }
    若 text == "布尔" 则 { 返回 1 }
    若 text == "文本" 则 { 返回 1 }
    若 text == "无返回" 则 { 返回 1 }
    若 text == "字符" 则 { 返回 1 }
    若 text == "指针" 则 { 返回 1 }
    若 text == "列表" 则 { 返回 1 }
    若 text == "长整数" 则 { 返回 1 }
    若 text == "引入" 则 { 返回 1 }
    若 text == "模块" 则 { 返回 1 }
    若 text == "导出" 则 { 返回 1 }
    /* ========== 控制流 (英文) ========== */
    若 text == "if" 则 { 返回 1 }
