    若 text == "proc" 则 { 返回 1 }
    若 text == "return" 则 { 返回 1 }
    若 text == "async" 则 { 返回 1 }
    若 text == "await" 则 { 返回 1 }
    若 text == "spawn" 则 { 返回 1 }

    /* ========== 数据类型 (英文别名) ========== */
    若 text == "int" 则 { 返回 1 }
    若 text == "i64" 则 { 返回 1 }
    若 text == "long" 则 { 返回 1 }
    若 text == "float" 则 { 返回 1 }
    若 text == "f64" 则 { 返回 1 }
    若 text == "double" 则 { 返回 1 }
    若 text == "bool" 则 { 返回 1 }
    若 text == "string" 则 { 返回 1 }
    若 text == "str" 则 { 返回 1 }
    若 text == "char" 则 { 返回 1 }
    若 text == "void" 则 { 返回 1 }
    若 text == "ptr" 则 { 返回 1 }
    若 text == "pointer" 则 { 返回 1 }
    若 text == "list" 则 { 返回 1 }
    若 text == "Option" 则 { 返回 1 }

    /* ========== 内存安全与所有权 (英文别名) ========== */
    若 text == "let" 则 { 返回 1 }
    若 text == "mut" 则 { 返回 1 }
    若 text == "ref" 则 { 返回 1 }
    若 text == "borrow" 则 { 返回 1 }
    若 text == "mut_ref" 则 { 返回 1 }
    若 text == "move" 则 { 返回 1 }
    若 text == "own" 则 { 返回 1 }
    若 text == "manual" 则 { 返回 1 }
    若 text == "unsafe" 则 { 返回 1 }

    /* ========== 可见性与修饰符 (英文别名) ========== */
    若 text == "public" 则 { 返回 1 }
    若 text == "private" 则 { 返回 1 }
    若 text == "const" 则 { 返回 1 }
    若 text == "static" 则 { 返回 1 }
    若 text == "extern" 则 { 返回 1 }

    /* ========== 模块系统 (英文别名) ========== */
    若 text == "module" 则 { 返回 1 }
    若 text == "import" 则 { 返回 1 }
    若 text == "use" 则 { 返回 1 }
    若 text == "export" 则 { 返回 1 }
    若 text == "pub" 则 { 返回 1 }

    /* ========== 错误处理 (英文别名) ========== */
    若 text == "try" 则 { 返回 1 }
    若 text == "catch" 则 { 返回 1 }
    若 text == "throw" 则 { 返回 1 }
    若 text == "finally" 则 { 返回 1 }

    /* ========== 元编程 (英文别名) ========== */
    若 text == "macro" 则 { 返回 1 }
    若 text == "expand" 则 { 返回 1 }

    /* ========== 复合数据类型 (英文别名) ========== */
    若 text == "struct" 则 { 返回 1 }
    若 text == "enum" 则 { 返回 1 }
    若 text == "union" 则 { 返回 1 }
    若 text == "type" 则 { 返回 1 }

    /* ========== 任意类型 (英文别名) ========== */
    若 text == "Any" 则 { 返回 1 }

    返回 0
}

/* ============ 字符串切片函数 ============ */

/**
 * 提取子字符串
 * 使用运行时函数文本切片
 */
函数 提取子串(源码: 文本, 开始: 整数, 结束: 整数): 文本 {
    定义 可变 结果: 文本
    打印("DEBUG 提取子串: 开始=")
    打印整数(开始)
    打印(" 结束=")
    打印整数(结束)
    结果 = 文本切片(源码, 开始, 结束)
    打印(" 结果长度=")
    定义 可变 len: 整数
    len = 文本长度(结果)
    打印整数(len)
    打印(" 内容:")
    定义 可变 i: 整数
    i = 0
    当 i < len 则 {
        定义 可变 ch: 文本
        ch = 文本获取字符(结果, i)
        定义 可变 code: 整数
        code = 字符编码(ch)
        打印整数(code)
        打印(" ")
        i = i + 1
    }
    打印("\n")
    返回 结果
}

/* ============ Lexer 核心函数 ============ */

/**
 * 获取字符
 */
函数 获取字符(lex: Lexer): 整数 {
    若 lex.位置 < lex.长度 则 {
        定义 可变 ch: 整数
        ch = 字符编码(文本获取字符(lex.源码, lex.位置))
        返回 ch
    }
    返回 0
}

/**
 * 初始化词法分析器
 */
函数 lexerInit(源码: 文本, 长度: 整数): Lexer {
    定义 可变 lex: Lexer
    lex.源码 = 源码
    lex.位置 = 0
    lex.长度 = 长度
    打印("DEBUG lexerInit: 源码长度=")
    打印整数(lex.长度)
    打印("\n")
    lex.行号 = 1
    lex.列号 = 1
    lex.开始位置 = 0
    lex.当前位置 = 0
    打印("DEBUG lexerInit: 调用获取字符\n")
    lex.当前字符 = 获取字符(lex)
    打印("DEBUG lexerInit: 当前字符=")
    打印整数(lex.当前字符)
    打印("\n")
    返回 lex
}

/**
 * 前进到下一个字符（支持UTF-8多字节字符）
 */
函数 lexer前进(lex: Lexer): Lexer {
    定义 可变 步长: 整数
    步长 = utf8字节长度(lex.当前字符)

    lex.位置 = lex.位置 + 步长
    lex.列号 = lex.列号 + 1

    若 lex.位置 < lex.长度 则 {
        lex.当前字符 = 字符编码(文本获取字符(lex.源码, lex.位置))
    } 否则 {
        lex.当前字符 = 0
    }

    若 lex.当前字符 == 10 则 {
        lex.行号 = lex.行号 + 1
        lex.列号 = 1
    }

    返回 lex
}

/**
 * 跳过空白字符
 */
函数 lexer跳过空白(lex: Lexer): Lexer {
    当 是空白(lex.当前字符) == 1 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }
    lex.开始位置 = lex.位置
    返回 lex
}

