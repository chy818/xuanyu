/**
 * 遍历模块定义
 */
函数 codegen遍历模块定义(cg: Codegen, moduleNode: AST节点): 无返回 {
    定义 可变 moduleName: 文本
    moduleName = moduleNode.name

    打印("遍历模块: ")
    打印(moduleName)

    定义 可变 line: 文本
    line = "; 模块: " + moduleName
    codegenEmit(cg, line)

    /* 遍历模块内容 */
    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(moduleNode.children) && i < 50 则 {
        定义 可变 child: AST节点
        child = moduleNode.children[i]

        若 child.kind == 1 则 {
            codegen遍历函数定义(cg, child)
        }
        i = i + 1
    }
}

/**
 * 遍历函数定义
 */
函数 codegen遍历函数定义(cg: Codegen, funcNode: AST节点): 无返回 {
    定义 可变 funcName: 文本
    funcName = funcNode.name

    定义 可变 returnType: 文本
    returnType = "i64"

    打印("生成函数: ")
    打印(funcName)

    /* 保存当前状态 */
    定义 可变 fullFuncName: 文本
    若 funcName == "主" 则 {
        fullFuncName = "xy_main"
    } 否则 {
        fullFuncName = cg.moduleName + "_" + funcName
    }
    cg.currentFunc = fullFuncName
    cg.currentFunctionIndex = cg.functionIndexCounter
    cg.functionIndexCounter = cg.functionIndexCounter + 1

    /* 清空变量映射，进入新作用域 */
    codegen清空变量(cg)

    /* 生成函数头 */
    codegenEmit(cg, "")

    /* 处理参数列表 */
    定义 可变 bodyIdx: 整数
    bodyIdx = 0
    定义 可变 paramStr: 文本
    paramStr = ""

    若 列表长度(funcNode.children) > 1 则 {
        /* 可能有参数列表，先处理参数 */
        定义 可变 paramNode: AST节点
        paramNode = 列表获取(funcNode.children, 0)
        若 paramNode.kind == 2 则 {
            /* 参数列表 */
            bodyIdx = 1
            /* 生成参数声明 */
            定义 可变 i: 整数
            i = 0
            当 i < 列表长度(paramNode.children) 则 {
                定义 可变 param: AST节点
                param = paramNode.children[i]
                若 i > 0 则 {
                    paramStr = paramStr + ", "
                }
                paramStr = paramStr + "i64 %" + param.name
                i = i + 1
            }
        }
    }

    /* 生成函数定义 - 添加模块名前缀以避免重复符号 */
    定义 可变 fullFuncName: 文本
    若 funcName == "主" 则 {
        fullFuncName = "xy_main"
    } 否则 {
        fullFuncName = cg.moduleName + "_" + funcName
    }
    codegenEmit(cg, "define " + returnType + " @" + fullFuncName + "(" + paramStr + ") {")
    cg.indent = cg.indent + 1

    /* 生成函数体 */

    /* 处理函数体 */
    若 bodyIdx < 列表长度(funcNode.children) 则 {
        定义 可变 body: AST节点
        body = 列表获取(funcNode.children, bodyIdx)

        /* 检查函数体是否有返回语句 */
        定义 可变 bodyHasReturn: 整数
        bodyHasReturn = codegen块语句有返回语句(cg, body)

        若 body.kind == 18 则 {
            /* 块语句 */
            codegen遍历块语句(cg, body)
            /* 只有当块语句没有返回语句时，才添加默认返回 */
            若 bodyHasReturn == 0 则 {
                codegenEmit(cg, "  %tmp0 = add i64 0, 0")
                codegenEmit(cg, "  ret i64 %tmp0")
            }
        } 否则 {
            /* 单表达式函数体 */
            定义 可变 result: 文本
            result = codegen遍历表达式(cg, body)
            /* 只有当函数体不是返回语句时，才添加返回 */
            若 body.kind != 8 则 {
                codegenEmit(cg, "  ret i64 %" + result)
            }
        }
    } 否则 {
        /* 空函数体，返回 0 */
        codegenEmit(cg, "  %tmp0 = add i64 0, 0")
        codegenEmit(cg, "  ret i64 %tmp0")
    }

    cg.indent = cg.indent - 1
    codegenEmit(cg, "}")
    cg.funcCount = cg.funcCount + 1
}

/**
 * 检查块语句是否有返回语句（递归检查嵌套结构）
 * @param cg 代码生成器
 * @param block 块语句节点
 * @return 如果有返回语句返回1，否则返回0
 */
函数 codegen块语句有返回语句(cg: Codegen, block: AST节点): 整数 {
    /* 检查是否是块语句，如果不是，直接检查 */
    若 block.kind != 18 则 {
        /* 不是块语句，直接检查是否是返回语句 */
        若 block.kind == 8 则 {
            返回 1
        } 否则 {
            返回 0
        }
    }

    定义 可变 i: 整数
    i = 0

    当 i < 列表长度(block.children) && i < 50 则 {
        定义 可变 stmt: AST节点
        stmt = block.children[i]

        /* 检查是否是返回语句 */
        若 stmt.kind == 8 则 {
            返回 1
        }

        /* 检查是否是 if 语句 - 递归检查 then 块 */
        若 stmt.kind == 5 则 {
            定义 可变 thenBlock: AST节点
            thenBlock = 列表获取(stmt.children, 1)
            若 codegen块语句有返回语句(cg, thenBlock) == 1 则 {
                返回 1
            }
        }

        /* 检查是否是 while 语句 - 递归检查 body */
        若 stmt.kind == 6 则 {
            定义 可变 body: AST节点
            body = 列表获取(stmt.children, 1)
            若 codegen块语句有返回语句(cg, body) == 1 则 {
                返回 1
            }
        }

        /* 检查是否是 for 语句 - 递归检查 body */
        若 stmt.kind == 20 则 {
            定义 可变 body: AST节点
            body = 列表获取(stmt.children, 3)
            若 codegen块语句有返回语句(cg, body) == 1 则 {
                返回 1
            }
        }

        i = i + 1
    }

    返回 0
}

/**
 * 遍历块语句
 */
函数 codegen遍历块语句(cg: Codegen, block: AST节点): 无返回 {
    /* 检查是否是块语句，如果不是，直接遍历 */
    若 block.kind != 18 则 {
        /* 不是块语句，直接遍历 */
        codegen遍历语句(cg, block)
        返回
    }

    定义 可变 i: 整数
    i = 0

    当 i < 列表长度(block.children) && i < 50 则 {
        定义 可变 stmt: AST节点
        stmt = block.children[i]

        codegen遍历语句(cg, stmt)

        /* 如果是返回语句，停止遍历，因为返回语句之后的代码是不可达的 */
        若 stmt.kind == 8 则 {
            跳出循环
        }

        i = i + 1
    }
}

/**
 * 遍历语句
 */
函数 codegen遍历语句(cg: Codegen, stmt: AST节点): 无返回 {
    打印("DBG cg语句 kind=")
    打印整数(stmt.kind)
    若 stmt.kind == 3 则 {
        /* 变量定义 */
        codegen遍历变量定义(cg, stmt)
    } 否则 {
        若 stmt.kind == 4 则 {
            /* 赋值语句 */
            codegen遍历赋值语句(cg, stmt)
        } 否则 {
            若 stmt.kind == 5 则 {
                /* if 语句 */
                codegen遍历If语句(cg, stmt)
            } 否则 {
                若 stmt.kind == 6 则 {
                    /* while 语句 */
                    codegen遍历While语句(cg, stmt)
                } 否则 {
                    若 stmt.kind == 20 则 {
                        /* for 语句 */
                        codegen遍历For语句(cg, stmt)
                    } 否则 {
                        若 stmt.kind == 8 则 {
                            /* return 语句 */
                            codegen遍历返回语句(cg, stmt)
                        } 否则 {
                            若 stmt.kind == 16 则 {
                                /* break 语句 */
                                codegen遍历Break语句(cg, stmt)
                            } 否则 {
                                若 stmt.kind == 17 则 {
                                    /* continue 语句 */
                                    codegen遍历Continue语句(cg, stmt)
                                } 否则 {
                                    若 stmt.kind == 9 则 {
                                        /* 表达式语句 */
                                        定义 可变 result: 文本
                                        result = codegen遍历表达式(cg, stmt)
                                    } 否则 {
                                        若 stmt.kind == 12 则 {
                                            /* 函数调用作为语句（如 打印(...)） */
                                            定义 可变 result: 文本
                                            result = codegen遍历函数调用(cg, stmt.name, stmt.children)
                                        } 否则 {
                                            若 stmt.kind == 18 则 {
                                                /* 块语句 */
                                                codegen遍历块语句(cg, stmt)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

/**
 * 遍历变量定义
 */
函数 codegen遍历变量定义(cg: Codegen, varNode: AST节点): 无返回 {
    定义 可变 varName: 文本
    varName = varNode.name

    /* 确定变量的 LLVM 分配大小（以 i64 为单位） */
    定义 可变 slotCount: 整数
    slotCount = 1  // 默认 1 个 i64 槽（8 字节）
    定义 可变 varTypeTag: 文本
    varTypeTag = varNode.value  // type annotation like "Token", "Lexer", "整数" etc

    若 varTypeTag == "Token" 则 { slotCount = 6 }
    否则 若 varTypeTag == "Lexer" 则 { slotCount = 10 }
    否则 若 varTypeTag == "Sema" 则 { slotCount = 11 }
    否则 若 varTypeTag == "Codegen" 则 { slotCount = 12 }
    否则 若 varTypeTag == "Parser" 则 { slotCount = 9 }
    否则 若 varTypeTag == "AST节点" 则 { slotCount = 7 }
    否则 若 varTypeTag == "循环上下文" 则 { slotCount = 4 }
    否则 若 varTypeTag == "循环状态" 则 { slotCount = 2 }

    /* 分配所有槽位 */
    /* 使用临时变量编号作为 LLVM 标识符，避免中文变量名问题 */
    定义 可变 slotVar: 文本
    slotVar = codegenNewTemp(cg)
    定义 可变 tmpPtr: 文本
    tmpPtr = slotVar
    定义 可变 i: 整数
    i = 0
    当 i < slotCount 则 {
        定义 可变 slotName: 文本
        若 i == 0 则 {
            slotName = slotVar
        } 否则 {
            slotName = slotVar + "_" + 整数转文本(i)
        }
        codegenEmit(cg, "  %" + slotName + " = alloca i64, align 8")
        i = i + 1
    }

    /* 只把第一个槽位加入变量映射（用于查找变量） */
    codegen添加变量(cg, varName, tmpPtr, varTypeTag)

    /* 初始化（只对第一个槽位） */
    若 列表长度(varNode.children) > 0 则 {
        定义 可变 initNode: AST节点
        initNode = 列表获取(varNode.children, 0)
        定义 可变 initVal: 文本
        initVal = codegen遍历表达式(cg, initNode)
        codegenEmit(cg, "  store i64 %" + initVal + ", i64* %" + tmpPtr)
        打印("DBG cg变量定义 init完成 init=")
        打印(initVal)
    }
}

/**
 * 获取结构体字段字节偏移和类型（用于 GEP 访问）
 * 返回格式: "byte_offset|type"，如 "0|i64" 或 "" 表示未找到
 */
函数 codegen查找结构体字段(结构体名: 文本, 字段名: 文本): 文本 {
    /* Token 结构体: 类型=i64(0), 值=i8*(8), 行号=i64(16), 列号=i64(24), 开始位置=i64(32), 结束位置=i64(40) */
    若 结构体名 == "Token" 则 {
        若 字段名 == "类型" 则 { 返回 "0|i64" }
        若 字段名 == "值" 则 { 返回 "8|i8*" }
        若 字段名 == "行号" 则 { 返回 "16|i64" }
        若 字段名 == "列号" 则 { 返回 "24|i64" }
        若 字段名 == "开始位置" 则 { 返回 "32|i64" }
        若 字段名 == "结束位置" 则 { 返回 "40|i64" }
    }
    /* Lexer 结构体 */
    若 结构体名 == "Lexer" 则 {
        若 字段名 == "源码" 则 { 返回 "0|i8*" }
        若 字段名 == "位置" 则 { 返回 "8|i64" }
        若 字段名 == "长度" 则 { 返回 "16|i64" }
        若 字段名 == "行号" 则 { 返回 "24|i64" }
        若 字段名 == "列号" 则 { 返回 "32|i64" }
        若 字段名 == "当前字符" 则 { 返回 "40|i64" }
        若 字段名 == "开始位置" 则 { 返回 "48|i64" }
        若 字段名 == "当前位置" 则 { 返回 "56|i64" }
    }
    /* AST节点 结构体 */
    若 结构体名 == "AST节点" 则 {
        若 字段名 == "id" 则 { 返回 "0|i64" }
        若 字段名 == "kind" 则 { 返回 "8|i64" }
        若 字段名 == "name" 则 { 返回 "16|i8*" }
        若 字段名 == "value" 则 { 返回 "24|i8*" }
        若 字段名 == "intValue" 则 { 返回 "32|i64" }
        若 字段名 == "line" 则 { 返回 "40|i64" }
        若 字段名 == "children" 则 { 返回 "48|i8*" }
    }
    若 结构体名 == "Codegen" 则 {
        若 字段名 == "output" 则 { 返回 "24|i8*" }
        若 字段名 == "indent" 则 { 返回 "32|i64" }
    }
    若 结构体名 == "Sema" 则 {
        若 字段名 == "错误计数" 则 { 返回 "56|i64" }
        若 字段名 == "警告计数" 则 { 返回 "64|i64" }
    }
    返回 ""
}

/**
 * 遍历赋值语句
 */
函数 codegen遍历赋值语句(cg: Codegen, assignNode: AST节点): 无返回 {
    定义 可变 varName: 文本
    varName = assignNode.name

    /* 检查是否是结构体字段赋值 (如 tok.类型 = 0)
       通过硬编码的常见前缀进行匹配 */
    定义 可变 isFieldAssign: 整数
    isFieldAssign = 0
    定义 可变 baseName: 文本
    baseName = ""
    定义 可变 fieldName: 文本
    fieldName = ""

    /* 常见的结构体变量名 + . + 字段名的模式匹配 */
    若 文本长度(varName) > 2 则 {
        定义 可变 ch1: 文本
        ch1 = 文本获取字符(varName, 0)
        若 ch1 == "t" 则 {
            若 文本长度(varName) > 5 则 {
                定义 可变 ch2: 文本
                ch2 = 文本获取字符(varName, 1)
                若 ch2 == "o" 则 {
                    /* tok.xxx */
                    isFieldAssign = 1
                    baseName = "tok"
                    fieldName = 文本获取字符(varName, 4) + 文本获取字符(varName, 5)
                }
            }
        } 否则 若 ch1 == "l" 则 {
            /* lex.xxx */
            isFieldAssign = 1
            baseName = "lex"
            fieldName = 文本获取字符(varName, 4) + 文本获取字符(varName, 5)
        } 否则 若 ch1 == "c" 则 {
            /* cg.xxx 或 compiler 相关 */
            isFieldAssign = 1
            baseName = "cg"
            fieldName = 文本获取字符(varName, 3) + 文本获取字符(varName, 4)
        } 否则 若 ch1 == "p" 则 {
            /* p.xxx */
            isFieldAssign = 1
            baseName = "p"
            fieldName = 文本获取字符(varName, 2) + 文本获取字符(varName, 3)
        } 否则 若 ch1 == "a" 则 {
            /* ast.xxx */
            isFieldAssign = 1
            baseName = "ast"
            fieldName = 文本获取字符(varName, 4) + 文本获取字符(varName, 5)
        }
    }

    若 isFieldAssign == 1 则 {
        定义 可变 basePtr: 文本
        basePtr = codegen查找变量(cg, baseName)
        若 basePtr != "" 则 {
            定义 可变 fieldOffset: 文本
            fieldOffset = ""
            定义 可变 fieldType: 文本
            fieldType = ""
            /* 根据基础变量名 + 字段名查表 */
            /* Token fields */
            若 baseName == "tok" 则 {
                若 fieldName == "类型" 则 { fieldOffset = "0"; fieldType = "i64" }
                否则 若 fieldName == "值" 则 { fieldOffset = "8"; fieldType = "i8*" }
                否则 若 fieldName == "行号" 则 { fieldOffset = "16"; fieldType = "i64" }
                否则 若 fieldName == "列号" 则 { fieldOffset = "24"; fieldType = "i64" }
                否则 若 fieldName == "开始位置" 则 { fieldOffset = "32"; fieldType = "i64" }
                否则 若 fieldName == "结束位置" 则 { fieldOffset = "40"; fieldType = "i64" }
            }
            /* Lexer fields */
            若 baseName == "lex" 则 {
                若 fieldName == "源码" 则 { fieldOffset = "0"; fieldType = "i8*" }
                否则 若 fieldName == "位置" 则 { fieldOffset = "8"; fieldType = "i64" }
                否则 若 fieldName == "长度" 则 { fieldOffset = "16"; fieldType = "i64" }
                否则 若 fieldName == "行号" 则 { fieldOffset = "24"; fieldType = "i64" }
                否则 若 fieldName == "列号" 则 { fieldOffset = "32"; fieldType = "i64" }
                否则 若 fieldName == "当前字符" 则 { fieldOffset = "40"; fieldType = "i64" }
                否则 若 fieldName == "开始位置" 则 { fieldOffset = "48"; fieldType = "i64" }
                否则 若 fieldName == "当前位置" 则 { fieldOffset = "56"; fieldType = "i64" }
            }
            /* Codegen fields */
            若 baseName == "cg" 则 {
                若 fieldName == "output" 则 { fieldOffset = "24"; fieldType = "i8*" }
                否则 若 fieldName == "indent" 则 { fieldOffset = "32"; fieldType = "i64" }
                否则 若 fieldName == "tempCount" 则 { fieldOffset = "8"; fieldType = "i64" }
                否则 若 fieldName == "labelCount" 则 { fieldOffset = "16"; fieldType = "i64" }
                否则 若 fieldName == "funcCount" 则 { fieldOffset = "40"; fieldType = "i64" }
            }
            /* Sema fields */
            若 baseName == "sema" 则 {
                若 fieldName == "错误计数" 则 { fieldOffset = "56"; fieldType = "i64" }
                否则 若 fieldName == "警告计数" 则 { fieldOffset = "64"; fieldType = "i64" }
            }
            若 fieldOffset != "" 则 {
                若 列表长度(assignNode.children) > 0 则 {
                    定义 可变 rightNode: AST节点
                    rightNode = 列表获取(assignNode.children, 0)
                    定义 可变 rightVal: 文本
                    rightVal = codegen遍历表达式(cg, rightNode)
                    定义 可变 gepLabel: 文本
                    gepLabel = codegenNewTemp(cg)
                    codegenEmit(cg, "  %" + gepLabel + " = getelementptr i8, i8* %" + basePtr + ", i32 " + fieldOffset)
                    定义 可变 typedPtr: 文本
                    typedPtr = codegenNewTemp(cg)
                    codegenEmit(cg, "  %" + typedPtr + " = bitcast i8* %" + gepLabel + " to " + fieldType + "*")
                    codegenEmit(cg, "  store " + fieldType + " %" + rightVal + ", " + fieldType + "* %" + typedPtr)
                }
                返回
            }
        }
    }

    /* 原有逻辑：简单变量赋值 */
    定义 可变 tmpPtr: 文本
    tmpPtr = codegen查找变量(cg, varName)
    若 tmpPtr == "" 则 {
        tmpPtr = varName + "_slot"
    }

    定义 可变 varType: 文本
    varType = codegen查找变量类型(cg, varName)
    若 varType == "" 则 {
        varType = "i64"
    }

    若 列表长度(assignNode.children) > 0 则 {
        定义 可变 rightNode: AST节点
        rightNode = 列表获取(assignNode.children, 0)
        定义 可变 rightVal: 文本
        rightVal = codegen遍历表达式(cg, rightNode)
        codegenEmit(cg, "  store " + varType + " %" + rightVal + ", " + varType + "* %" + tmpPtr)
    }
}

/**
 * 遍历 break 语句
 */
函数 codegen遍历Break语句(cg: Codegen, breakNode: AST节点): 无返回 {
    定义 可变 ctx: 循环上下文
    ctx = codegen获取当前循环上下文(cg)
    若 ctx.结束标签 != "" 则 {
        codegenEmit(cg, "  br label %" + ctx.结束标签)
    }
}

/**
 * 遍历 continue 语句
 */
函数 codegen遍历Continue语句(cg: Codegen, continueNode: AST节点): 无返回 {
    定义 可变 ctx: 循环上下文
    ctx = codegen获取当前循环上下文(cg)
    若 ctx.continue标签 != "" 则 {
        codegenEmit(cg, "  br label %" + ctx.continue标签)
    }
}

/**
 * 遍历 if 语句
 */
函数 codegen遍历If语句(cg: Codegen, ifNode: AST节点): 无返回 {
    定义 可变 thenLabel: 文本
    thenLabel = codegenNewLabel(cg)
    定义 可变 elseLabel: 文本
    elseLabel = codegenNewLabel(cg)
    定义 可变 endLabel: 文本
    endLabel = codegenNewLabel(cg)

    /* 条件表达式 */
    定义 可变 cond: AST节点
    cond = 列表获取(ifNode.children, 0)
    定义 可变 condVar: 文本
    condVar = codegen遍历表达式(cg, cond)

    /* 条件跳转 */
    codegenEmit(cg, "  br i1 %" + condVar + ", label %" + thenLabel + ", label %" + elseLabel)

    /* then 块 */
    codegenEmit(cg, thenLabel + ":")
    定义 可变 thenBlock: AST节点
    thenBlock = 列表获取(ifNode.children, 1)
    定义 可变 thenHasReturn: 整数
    thenHasReturn = codegen块语句有返回语句(cg, thenBlock)
    codegen遍历块语句(cg, thenBlock)
    若 thenHasReturn == 0 则 {
        codegenEmit(cg, "  br label %" + endLabel)
    }

    /* else 块 */
    codegenEmit(cg, elseLabel + ":")
    定义 可变 childrenLen: 整数
    childrenLen = 列表长度(ifNode.children)
    若 childrenLen >= 3 则 {
        定义 可变 elseBlock: AST节点
        elseBlock = 列表获取(ifNode.children, 2)
        定义 可变 elseHasReturn: 整数
        elseHasReturn = codegen块语句有返回语句(cg, elseBlock)
        codegen遍历块语句(cg, elseBlock)
        若 elseHasReturn == 0 则 {
            codegenEmit(cg, "  br label %" + endLabel)
        }
    } 否则 {
        codegenEmit(cg, "  br label %" + endLabel)
    }

    /* 结束 */
    codegenEmit(cg, endLabel + ":")
    /* 生成一个空操作，避免LLVM IR语法错误 */
    codegenEmit(cg, "  %tmp_end = add i64 0, 0")
}

/**
 * 遍历 while 语句
 */
函数 codegen遍历While语句(cg: Codegen, whileNode: AST节点): 无返回 {
    定义 可变 condLabel: 文本
    condLabel = codegenNewLabelWithPrefix(cg, "while_cond_")
    定义 可变 bodyLabel: 文本
    bodyLabel = codegenNewLabelWithPrefix(cg, "while_body_")
    定义 可变 endLabel: 文本
    endLabel = codegenNewLabelWithPrefix(cg, "while_end_")

    /* 创建循环上下文 */
    定义 可变 ctx: 循环上下文
    ctx.循环开始标签 = condLabel
    ctx.循环体标签 = bodyLabel
    ctx.continue标签 = condLabel
    ctx.结束标签 = endLabel
    codegen推入循环上下文(cg, ctx)

    /* 跳转到条件 */
    codegenEmit(cg, "  br label %" + condLabel)

    /* 条件 */
    cg.indent = cg.indent - 1
    codegenEmit(cg, condLabel + ":")
    cg.indent = cg.indent + 1

    定义 可变 cond: AST节点
    cond = 列表获取(whileNode.children, 0)
    定义 可变 condVar: 文本
    condVar = codegen遍历表达式(cg, cond)

    /* 条件跳转 */
    codegenEmit(cg, "  br i1 %" + condVar + ", label %" + bodyLabel + ", label %" + endLabel)

    /* 循环体 */
    cg.indent = cg.indent - 1
    codegenEmit(cg, bodyLabel + ":")
    cg.indent = cg.indent + 1

    定义 可变 body: AST节点
    body = 列表获取(whileNode.children, 1)
    codegen遍历块语句(cg, body)
    codegenEmit(cg, "  br label %" + condLabel)

    /* 结束 */
    cg.indent = cg.indent - 1
    codegenEmit(cg, endLabel + ":")
    cg.indent = cg.indent + 1
    /* 生成一个空操作，避免LLVM IR语法错误 */
    codegenEmit(cg, "  %tmp_end = add i64 0, 0")

    /* 弹出循环上下文 */
    codegen弹出循环上下文(cg)
}

/**
 * 遍历 for 语句
 */
函数 codegen遍历For语句(cg: Codegen, forNode: AST节点): 无返回 {
    定义 可变 initLabel: 文本
    initLabel = codegenNewLabel(cg)
    定义 可变 condLabel: 文本
    condLabel = codegenNewLabel(cg)
    定义 可变 bodyLabel: 文本
    bodyLabel = codegenNewLabel(cg)
    定义 可变 incLabel: 文本
    incLabel = codegenNewLabel(cg)
    定义 可变 endLabel: 文本
    endLabel = codegenNewLabel(cg)

    /* 初始化 */
    codegenEmit(cg, "  br label %" + initLabel)
    codegenEmit(cg, initLabel + ":")

    定义 可变 init: AST节点
    init = 列表获取(forNode.children, 0)
    codegen遍历表达式(cg, init)

    /* 跳转到条件 */
    codegenEmit(cg, "  br label %" + condLabel)

    /* 条件 */
    codegenEmit(cg, condLabel + ":")
    定义 可变 cond: AST节点
    cond = 列表获取(forNode.children, 1)
    定义 可变 condVar: 文本
    condVar = codegen遍历表达式(cg, cond)

    /* 条件跳转 */
    codegenEmit(cg, "  br i1 %" + condVar + ", label %" + bodyLabel + ", label %" + endLabel)

    /* 循环体 */
    codegenEmit(cg, bodyLabel + ":")
    定义 可变 body: AST节点
    body = 列表获取(forNode.children, 2)
    codegen遍历块语句(cg, body)
    codegenEmit(cg, "  br label %" + incLabel)

    /* 递增 */
    codegenEmit(cg, incLabel + ":")
    定义 可变 inc: AST节点
    inc = 列表获取(forNode.children, 1)
    codegen遍历表达式(cg, inc)
    codegenEmit(cg, "  br label %" + condLabel)

    /* 结束 */
    codegenEmit(cg, endLabel + ":")
}

/**
 * 遍历返回语句
 */
函数 codegen遍历返回语句(cg: Codegen, retNode: AST节点): 无返回 {
    若 列表长度(retNode.children) > 0 则 {
        定义 可变 result: 文本
        result = codegen遍历表达式(cg, retNode.children[0])
        codegenEmit(cg, "  ret i64 %" + result)
    } 否则 {
        codegenEmit(cg, "  ret void")
    }
}

/**
 * 遍历表达式
 */
函数 codegen遍历表达式(cg: Codegen, expr: AST节点): 文本 {
    打印("DBG ex表达")
    打印整数(expr.kind)
    定义 可变 result: 文本
    result = ""

    若 expr.kind == 13 则 {
        /* 标识符表达式 */
        result = codegen遍历标识符(cg, expr.name)
    } 否则 {
        若 expr.kind == 14 则 {
            /* 字面量表达式 */
            result = codegen遍历字面量(cg, expr.value)
        } 否则 {
            若 expr.kind == 10 则 {
                /* 二元表达式 - children[0] 是左操作数, children[1] 是右操作数 */
                若 列表长度(expr.children) >= 2 则 {
                    定义 可变 leftChild: AST节点
                    定义 可变 rightChild: AST节点
                    leftChild = 列表获取(expr.children, 0)
                    rightChild = 列表获取(expr.children, 1)
                    result = codegen遍历二元表达式(cg, expr.name, leftChild, rightChild)
                } 否则 {
                    /* 二元表达式子节点不足，返回默认值 */
                    result = codegenNewTemp(cg)
                    codegenEmit(cg, "  %" + result + " = add i64 0, 0")
                }
            } 否则 {
                若 expr.kind == 11 则 {
                    /* 一元表达式 - children[0] 是操作数 */
                    若 列表长度(expr.children) >= 1 则 {
                        定义 可变 operand: AST节点
                        operand = 列表获取(expr.children, 0)
                        result = codegen遍历一元表达式(cg, expr.name, operand)
                    } 否则 {
                        /* 一元表达式子节点不足，返回默认值 */
                        result = codegenNewTemp(cg)
                        codegenEmit(cg, "  %" + result + " = add i64 0, 0")
                    }
                } 否则 {
                    若 expr.kind == 12 则 {
                        /* 调用表达式 */
                        result = codegen遍历函数调用(cg, expr.name, expr.children)
                        打印("DBG 12完成=")
                        打印(result)
                    } 否则 {
                        若 expr.kind == 19 则 {
                            /* 赋值表达式 - 将右值存储到左边的变量槽或列表元素 */
                            若 列表长度(expr.children) >= 2 则 {
                                定义 可变 leftChild: AST节点
                                定义 可变 rightChild: AST节点
                                leftChild = 列表获取(expr.children, 0)
                                rightChild = 列表获取(expr.children, 1)
                                /* 遍历右边表达式获取值 */
                                result = codegen遍历表达式(cg, rightChild)
                                /* 根据左边类型处理赋值 */
                                若 leftChild.kind == 13 则 {
                                    /* 简单变量赋值 */
                                    定义 可变 varName: 文本
                                    定义 可变 tmpPtr: 文本
                                    定义 可变 varType: 文本
                                    varName = leftChild.name
                                    tmpPtr = codegen查找变量(cg, varName)
                                    若 tmpPtr == "" 则 {
                                        tmpPtr = varName + "_slot"
                                    }
                                    varType = codegen查找变量类型(cg, varName)
                                    若 varType == "" 则 {
                                        varType = "i64"
                                    }
                                    /* 生成 store 指令将结果写回变量槽 */
                                    codegenEmit(cg, "  store " + varType + " %" + result + ", " + varType + "* %" + tmpPtr)
                                } 否则 {
                                    若 leftChild.kind == 15 则 {
                                        /* 列表元素赋值: list[index] = value */
                                        若 列表长度(leftChild.children) >= 2 则 {
                                            定义 可变 baseNode: AST节点
                                            定义 可变 indexNode: AST节点
                                            baseNode = 列表获取(leftChild.children, 0)
                                            indexNode = 列表获取(leftChild.children, 1)
                                            /* 遍历获取列表和索引 */
                                            定义 可变 listVal: 文本
                                            定义 可变 indexVal: 文本
                                            listVal = codegen遍历表达式(cg, baseNode)
                                            indexVal = codegen遍历表达式(cg, indexNode)
                                            /* 调用 rt_list_set 设置元素 */
                                            codegenEmit(cg, "  call void @rt_list_set(i8* %" + listVal + ", i64 %" + indexVal + ", i8* %" + result + ")")
                                        }
                                    }
                                }
                            } 否则 {
                                result = codegenNewTemp(cg)
                                codegenEmit(cg, "  %" + result + " = add i64 0, 0")
                            }
                        } 否则 {
                            若 expr.kind == 15 则 {
                                /* 索引访问 expr.children[0]=base, expr.children[1]=index */
                                若 列表长度(expr.children) >= 2 则 {
                                    定义 可变 baseNode: AST节点
                                    定义 可变 indexNode: AST节点
                                    baseNode = 列表获取(expr.children, 0)
                                    indexNode = 列表获取(expr.children, 1)
                                    /* 遍历获取列表和索引 */
                                    定义 可变 listVal: 文本
                                    定义 可变 indexVal: 文本
                                    listVal = codegen遍历表达式(cg, baseNode)
                                    indexVal = codegen遍历表达式(cg, indexNode)
                                    /* 调用 rt_list_get 获取元素 */
                                    result = codegenNewTemp(cg)
                                    codegenEmit(cg, "  %" + result + " = call i8* @rt_list_get(i8* %" + listVal + ", i64 %" + indexVal + ")")
                                } 否则 {
                                    result = codegenNewTemp(cg)
                                    codegenEmit(cg, "  %" + result + " = add i64 0, 0")
                                }
                            } 否则 {
                                /* 默认: 返回临时变量 */
                                打印("DBG 默认case kind=")
                                打印整数(expr.kind)
                                result = codegenNewTemp(cg)
                                codegenEmit(cg, "  %" + result + " = add i64 0, 0")
                            }
                            }
                        }
                    }
                }
             }
        }

    打印("DBG 表达返回=")
    打印(result)
    返回 result
}

/**
 * 遍历标识符
 * 注意：需要根据变量类型生成正确的加载指令
 */
函数 codegen遍历标识符(cg: Codegen, name: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    /* 查找变量槽位名称（已在 codegen遍历变量定义 中生成） */
    定义 可变 slotName: 文本
    slotName = codegen查找变量(cg, name)
    若 slotName == "" 则 {
        /* 未找到槽位，回退使用 escapeLLVM标识符 + _slot */
        slotName = escapeLLVM标识符(name) + "_slot"
    }

    /* 查找变量类型 */
    定义 可变 varType: 文本
    varType = codegen查找变量类型(cg, name)

    /* 根据类型生成加载指令 */
    若 varType == "i8*" 则 {
        /* 指针类型（列表、字符串等）- 从 i8** 加载 */
        codegenEmit(cg, "  %" + result + " = load i8*, i8** %" + slotName)
    } 否则 {
        /* 默认整数类型 - 从 i64* 加载 */
        codegenEmit(cg, "  %" + result + " = load i64, i64* %" + slotName)
    }

    返回 result
}

/**
 * 遍历字面量
 * 处理整数、字符串、浮点数等字面量
 * 注意：字符串字面量需要返回指针类型 (i8*)
 */
函数 codegen遍历字面量(cg: Codegen, value: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    /* 检查是否是字符串字面量（以 " 开头） */
    定义 可变 是字符串: 整数
    是字符串 = 0
    定义 可变 i: 整数
    i = 0
    当 i < 文本长度(value) 则 {
        若 value[i] == 34 则 {  /* 34 是双引号 " 的 ASCII/Unicode 码点 */
            是字符串 = 1
            跳出
        }
        i = i + 1
    }

    若 是字符串 == 1 则 {
        /* 字符串字面量：创建全局字符串常量并返回指针 */
        /* 去除引号，保留内部转义序列（LLVM IR 的 c"..." 原生支持 \n \t 等） */
        定义 可变 strContent: 文本
        strContent = ""
        i = 1
        当 i < 文本长度(value) - 1 则 {
            strContent = strContent + 整数转字符(value[i])
            i = i + 1
        }

        /* 生成字符串常量名 */
        定义 可变 constName: 文本
        constName = "str"
        定义 可变 idxStr: 文本
        idxStr = 整数转文本(cg.stringConstCount)
        constName = constName + idxStr
        cg.stringConstCount = cg.stringConstCount + 1

        定义 可变 len: 整数
        len = 文本长度(strContent) + 1

        /* 发射全局字符串常量定义到延迟缓冲区 */
        定义 可变 constLine: 文本
        constLine = "@" + constName + " = private constant [" + 整数转文本(len) + " x i8] c\"" + strContent + "\\00\"\n"
        cg.stringConstDefs = cg.stringConstDefs + constLine

        /* 生成 getelementptr 获取字符串指针 */
        定义 可变 ptrResult: 文本
        ptrResult = codegenNewTemp(cg)
        codegenEmit(cg, "%" + ptrResult + " = getelementptr [" + 整数转文本(len) + " x i8], [" + 整数转文本(len) + " x i8]* @" + constName + ", i64 0, i64 0")

        返回 ptrResult
    } 否则 {
        /* 整数或数字字面量 */
        定义 可变 numValue: 整数
        numValue = 文本转整数(value)
        codegenEmit(cg, "%" + result + " = add i64 0, " + 整数转文本(numValue))
    }

    返回 result
}

/**
 * 遍历二元表达式
 * 支持运算符：
 *   算术: +, -, *, /, %
 *   关系: ==, !=, <, >, <=, >=
 *   逻辑: &&, ||
 *   位运算: &, |, ^, <<, >>
 */
函数 codegen遍历二元表达式(cg: Codegen, op: 文本, left: AST节点, right: AST节点): 文本 {
    定义 可变 leftVal: 文本
    leftVal = codegen遍历表达式(cg, left)

    定义 可变 rightVal: 文本
    rightVal = codegen遍历表达式(cg, right)

    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 llOp: 文本
    定义 可变 resultType: 文本
    llOp = "add"
    resultType = "i64"

    /* 算术运算符 */
    若 op == "+" 则 { llOp = "add"; resultType = "i64" }
    若 op == "-" 则 { llOp = "sub"; resultType = "i64" }
    若 op == "*" 则 { llOp = "mul"; resultType = "i64" }
    若 op == "/" 则 { llOp = "sdiv"; resultType = "i64" }
    若 op == "%" 则 { llOp = "srem"; resultType = "i64" }

    /* 关系运算符（操作数为 i64，结果隐含为 i1） */
    若 op == "==" 则 { llOp = "icmp eq"; resultType = "i64" }
    若 op == "!=" 则 { llOp = "icmp ne"; resultType = "i64" }
    若 op == "<" 则 { llOp = "icmp slt"; resultType = "i64" }
    若 op == ">" 则 { llOp = "icmp sgt"; resultType = "i64" }
    若 op == "<=" 则 { llOp = "icmp sle"; resultType = "i64" }
    若 op == ">=" 则 { llOp = "icmp sge"; resultType = "i64" }

    /* 逻辑运算符（返回 i1） */
    若 op == "&&" 则 { llOp = "and"; resultType = "i1" }
    若 op == "||" 则 { llOp = "or"; resultType = "i1" }

    /* 位运算符（返回 i64） */
    若 op == "&" 则 { llOp = "and"; resultType = "i64" }
    若 op == "|" 则 { llOp = "or"; resultType = "i64" }
    若 op == "^" 则 { llOp = "xor"; resultType = "i64" }
    若 op == "<<" 则 { llOp = "shl"; resultType = "i64" }
    若 op == ">>" 则 { llOp = "lshr"; resultType = "i64" }

    /* 生成 IR */
    codegenEmit(cg, "  %" + result + " = " + llOp + " " + resultType + " %" + leftVal + ", %" + rightVal)

    返回 result
}

/**
 * 遍历一元表达式
 */
函数 codegen遍历一元表达式(cg: Codegen, op: 文本, operand: AST节点): 文本 {
    定义 可变 operandVal: 文本
    operandVal = codegen遍历表达式(cg, operand)

    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    若 op == "-" 则 {
        codegenEmit(cg, "  %" + result + " = sub i64 0, %" + operandVal)
    } 否则 {
        若 op == "!" 则 {
            codegenEmit(cg, "  %" + result + " = xor i1 %" + operandVal + ", true")
        }
    }

    返回 result
}

/**
 * 遍历函数调用
 * 注意：需要根据函数签名确定参数类型
 */
函数 codegen遍历函数调用(cg: Codegen, funcName: 文本, args: 列表): 文本 {
    打印("DBG codegen调用: ")
    打印(funcName)
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    /* 中文函数名到C运行时函数名的映射 */
    定义 可变 映射后的函数名: 文本
    映射后的函数名 = funcName

    若 funcName == "文本长度" 则 {
        映射后的函数名 = "rt_string_len"
    } 否则 若 funcName == "文本拼接" 则 {
        映射后的函数名 = "rt_string_concat"
    } 否则 若 funcName == "列表长度" 则 {
        映射后的函数名 = "rt_list_len"
    } 否则 若 funcName == "列表" 则 {
        映射后的函数名 = "rt_list_new"
    } 否则 若 funcName == "列表追加" 则 {
        映射后的函数名 = "rt_list_append"
    } 否则 若 funcName == "列表获取" 则 {
        映射后的函数名 = "rt_list_get"
    } 否则 若 funcName == "列表设置" 则 {
        映射后的函数名 = "rt_list_set"
    } 否则 若 funcName == "追加" 则 {
        映射后的函数名 = "rt_list_append"
    } 否则 若 funcName == "获取" 则 {
        映射后的函数名 = "rt_list_get"
    } 否则 若 funcName == "设置" 则 {
        映射后的函数名 = "rt_list_set"
    } 否则 若 funcName == "长度" 则 {
        映射后的函数名 = "rt_list_len"
    } 否则 若 funcName == "获取参数" 则 {
        映射后的函数名 = "argv"
    } 否则 若 funcName == "获取参数个数" 则 {
        映射后的函数名 = "argc"
    } 否则 若 funcName == "打印" 则 {
        映射后的函数名 = "print"
    } 否则 若 funcName == "打印整数" 则 {
        映射后的函数名 = "print_int"
    } 否则 若 funcName == "输入整数" 则 {
        映射后的函数名 = "rt_input_int"
    } 否则 若 funcName == "输入文本" 则 {
        映射后的函数名 = "rt_input_text"
    } 否则 若 funcName == "读取文件" 则 {
        映射后的函数名 = "file_read"
    } 否则 若 funcName == "写入文件" 则 {
        映射后的函数名 = "file_write"
    } 否则 若 funcName == "文件存在" 则 {
        映射后的函数名 = "file_exists"
    } 否则 若 funcName == "删除文件" 则 {
        映射后的函数名 = "file_delete"
    } 否则 若 funcName == "执行命令" 则 {
        映射后的函数名 = "exec_cmd"
    } 否则 若 funcName == "命令行参数" 则 {
        映射后的函数名 = "argv"
    } 否则 若 funcName == "参数个数" 则 {
        映射后的函数名 = "argc"
    } 否则 若 funcName == "运行时错误" 则 {
        映射后的函数名 = "rt_error"
    } 否则 若 funcName == "是空格" 则 {
        映射后的函数名 = "is_space"
    } 否则 若 funcName == "是数字" 则 {
        映射后的函数名 = "is_digit"
    } 否则 若 funcName == "是字母" 则 {
        映射后的函数名 = "is_alpha"
    } 否则 若 funcName == "是字母数字" 则 {
        映射后的函数名 = "is_alnum"
    } 否则 若 funcName == "utf8字节长度" 则 {
        映射后的函数名 = "rt_utf8_byte_length"
    } 否则 若 funcName == "是utf8首字节" 则 {
        映射后的函数名 = "rt_is_utf8_leader"
    } 否则 若 funcName == "是utf8续字节" 则 {
        映射后的函数名 = "rt_is_utf8_continuation"
    } 否则 若 funcName == "字符串拼接" 则 {
        映射后的函数名 = "rt_string_concat"
    } 否则 若 funcName == "整数转文本" 则 {
        映射后的函数名 = "rt_int_to_str"
    } 否则 若 funcName == "文本转整数" 则 {
        映射后的函数名 = "rt_str_to_int"
    } 否则 若 funcName == "取文本长度" 则 {
        映射后的函数名 = "rt_string_len"
    } 否则 若 funcName == "文本连接" 则 {
        映射后的函数名 = "rt_string_concat"
    } 否则 若 funcName == "文本截取" 则 {
        映射后的函数名 = "rt_string_substring"
    } 否则 若 funcName == "文本查找" 则 {
        映射后的函数名 = "rt_string_indexOf"
    } 否则 若 funcName == "文本转大写" 则 {
        映射后的函数名 = "rt_string_toUpperCase"
    } 否则 若 funcName == "文本转小写" 则 {
        映射后的函数名 = "rt_string_toLowerCase"
    } 否则 若 funcName == "创建列表" 则 {
        映射后的函数名 = "rt_list_new"
    } 否则 若 funcName == "取列表长度" 则 {
        映射后的函数名 = "rt_list_len"
    } 否则 若 funcName == "列表添加" 则 {
        映射后的函数名 = "rt_list_append"
    } 否则 若 funcName == "列表清空" 则 {
        映射后的函数名 = "rt_list_clear"
    } 否则 若 funcName == "列表克隆" 则 {
        映射后的函数名 = "rt_list_clone"
    } 否则 若 funcName == "文件读取" 则 {
        映射后的函数名 = "file_read"
    } 否则 若 funcName == "文件写入" 则 {
        映射后的函数名 = "file_write"
    } 否则 若 funcName == "取参数个数" 则 {
        映射后的函数名 = "argc"
    } 否则 若 funcName == "取参数" 则 {
        映射后的函数名 = "argv"
    } 否则 若 funcName == "取时间戳" 则 {
        映射后的函数名 = "rt_time"
    } 否则 若 funcName == "执行系统命令" 则 {
        映射后的函数名 = "exec_cmd"
    } 否则 若 funcName == "命令输出" 则 {
        映射后的函数名 = "cmd_output"
    } 否则 若 funcName == "退出" 则 {
        映射后的函数名 = "rt_exit"
    } 否则 若 funcName == "申请内存" 则 {
        映射后的函数名 = "rt_malloc"
    } 否则 若 funcName == "释放内存块" 则 {
        映射后的函数名 = "rt_free"
    }

    /* 内置函数返回类型映射表 */
    定义 可变 returnType: 文本
    returnType = "i64"

    若 funcName == "_u6574_u6570_u8f6c_u6587_u672c_u90e8" 则 {
        returnType = "double"
    } 否则 {
        若 funcName == "print_float" 则 {
            returnType = "double"
        }
    }

    /* void返回函数 */
    若 funcName == "打印" || funcName == "打印整数" ||
       funcName == "列表追加" || funcName == "列表设置" ||
       funcName == "列表清空" || funcName == "运行时错误" ||
       funcName == "退出" || funcName == "释放内存块" ||
       funcName == "列表添加" 则 {
        returnType = "void"
    }

    /* i8*指针返回函数 */
    若 funcName == "文本拼接" || funcName == "文本连接" ||
       funcName == "列表" || funcName == "列表获取" ||
       funcName == "文件读取" || funcName == "命令行参数" ||
       funcName == "输入文本" || funcName == "申请内存" ||
       funcName == "文本截取" || funcName == "文本转大写" ||
       funcName == "文本转小写" || funcName == "创建列表" ||
       funcName == "列表克隆" || funcName == "命令输出" ||
       funcName == "取列表元素" || funcName == "添加列表元素" ||
       funcName == "获取参数" || funcName == "获取命令输出" 则 {
        returnType = "i8*"
    }

    /* 处理函数参数 - 根据函数名确定参数类型 */
    定义 可变 argStr: 文本
    argStr = ""
    打印("DBG 列表长度(args)=")
    打印整数(列表长度(args))
    若 列表长度(args) > 0 则 {
        定义 可变 i: 整数
        i = 0
        打印("DBG args长度=")
        打印整数(列表长度(args))
        当 i < 列表长度(args) 则 {
            定义 可变 argNode: AST节点
            argNode = 列表获取(args, i)

            /* 遍历参数表达式获取 SSA 值 */
            定义 可变 argValue: 文本
            argValue = codegen遍历表达式(cg, argNode)

            /* 根据映射后的函数名和参数索引确定参数类型 */
            定义 可变 paramType: 文本
            paramType = codegen获取参数类型(映射后的函数名, i)

            /* 将参数值添加到参数列表 */
            若 i > 0 则 {
                argStr = argStr + ", "
            }
            argStr = argStr + paramType + " %" + argValue

            i = i + 1
        }
    }

    /* 生成函数调用 IR */
    若 returnType == "void" 则 {
        /* void函数不需要返回值 */
        若 argStr != "" 则 {
            codegenEmit(cg, "  call void @" + 映射后的函数名 + "(" + argStr + ")")
        } 否则 {
            codegenEmit(cg, "  call void @" + 映射后的函数名 + "()")
        }
        result = ""
    } 否则 {
        若 argStr != "" 则 {
            codegenEmit(cg, "  %" + result + " = call " + returnType + " @" + 映射后的函数名 + "(" + argStr + ")")
        } 否则 {
            codegenEmit(cg, "  %" + result + " = call " + returnType + " @" + 映射后的函数名 + "()")
        }
    }

    返回 result
}

/**
 * 获取函数参数类型
 * 根据函数名和参数索引返回正确的 LLVM 类型
 */
函数 codegen获取参数类型(funcName: 文本, paramIndex: 整数): 文本 {
    /* rt_list_append(i8*, i8*) - 两个参数都是指针 */
    若 funcName == "rt_list_append" 则 {
        返回 "i8*"
    }

    /* rt_list_set(i8*, i64, i8*) - 第一和第三个参数是指针 */
    若 funcName == "rt_list_set" 则 {
        若 paramIndex == 0 || paramIndex == 2 则 {
            返回 "i8*"
        }
        若 paramIndex == 1 则 {
            返回 "i64"
        }
    }

    /* rt_list_get(i8*, i64) - 第一个参数是指针 */
    若 funcName == "rt_list_get" 则 {
        若 paramIndex == 0 则 {
            返回 "i8*"
        }
        若 paramIndex == 1 则 {
            返回 "i64"
        }
    }

    /* rt_list_len(i8*) - 唯一参数是指针 */
    若 funcName == "rt_list_len" 则 {
        返回 "i8*"
    }

    /* rt_string_len(i8*) - 指针参数 */
    若 funcName == "rt_string_len" 则 {
        返回 "i8*"
    }

    /* rt_string_concat(i8*, i8*) - 两个参数都是指针 */
    若 funcName == "rt_string_concat" 则 {
        返回 "i8*"
    }

    /* rt_string_slice(i8*, i64, i64) - 第一个是指针，后续是整数 */
    若 funcName == "rt_string_slice" 则 {
        若 paramIndex == 0 则 {
            返回 "i8*"
        }
        返回 "i64"
    }

    /* rt_str_new(i8*) - 指针参数 */
    若 funcName == "rt_str_new" 则 {
        返回 "i8*"
    }

    /* 打印函数 - 指针参数 */
    若 funcName == "print" || funcName == "rt_print" 则 {
        返回 "i8*"
    }

    /* 打印字符串函数 */
    若 funcName == "print_string" 则 {
        返回 "i8*"
    }

    /* rt_list_new() - 无参数 */
    若 funcName == "rt_list_new" 则 {
        返回 "i64"
    }

    /* file_read(i8*) - 文件路径是指针 */
    若 funcName == "file_read" 则 {
        返回 "i8*"
    }

    /* file_write(i8*, i8*) - 路径和内容都是指针 */
    若 funcName == "file_write" 则 {
        返回 "i8*"
    }

    /* file_exists(i8*) - 文件路径是指针 */
    若 funcName == "file_exists" 则 {
        返回 "i8*"
    }

    /* file_delete(i8*) - 文件路径是指针 */
    若 funcName == "file_delete" 则 {
        返回 "i8*"
    }

    /* exec_cmd(i8*) - 命令字符串是指针 */
    若 funcName == "exec_cmd" 则 {
        返回 "i8*"
    }

    /* argv(i64) - 索引是整数 */
    若 funcName == "argv" 则 {
        返回 "i64"
    }

    /* argc() - 无参数 */
    若 funcName == "argc" 则 {
        返回 "i64"
    }

    /* rt_error(i8*) - 错误消息是指针 */
    若 funcName == "rt_error" 则 {
        返回 "i8*"
    }

    /* rt_input_int() - 无参数 */
    若 funcName == "rt_input_int" 则 {
        返回 "i64"
    }

    /* rt_input_text() - 无参数 */
    若 funcName == "rt_input_text" 则 {
        返回 "i64"
    }

    /* print_int(i64) - 整数参数 */
    若 funcName == "print_int" || funcName == "rt_print_int" 则 {
        返回 "i64"
    }

    /* rt_int_to_str(i64) - 整数参数 */
    若 funcName == "rt_int_to_str" 则 {
        返回 "i64"
    }

    /* rt_str_to_int(i8*) - 字符串参数 */
    若 funcName == "rt_str_to_int" 则 {
        返回 "i8*"
    }

    /* is_space(i8*) - 字符是指针 */
    若 funcName == "is_space" 则 {
        返回 "i8*"
    }

    /* is_digit(i8*) - 字符是指针 */
    若 funcName == "is_digit" 则 {
        返回 "i8*"
    }

    /* is_alpha(i8*) - 字符是指针 */
    若 funcName == "is_alpha" 则 {
        返回 "i8*"
    }

    /* is_alnum(i8*) - 字符是指针 */
    若 funcName == "is_alnum" 则 {
        返回 "i8*"
    }

    /* rt_utf8_byte_length(i64) - 整数参数 */
    若 funcName == "rt_utf8_byte_length" 则 {
        返回 "i64"
    }

    /* rt_is_utf8_leader(i64) - 整数参数 */
    若 funcName == "rt_is_utf8_leader" 则 {
        返回 "i64"
    }

    /* rt_is_utf8_continuation(i64) - 整数参数 */
    若 funcName == "rt_is_utf8_continuation" 则 {
        返回 "i64"
    }

    /* rt_string_substring(i8*, i64, i64) - 第一个是指针，后续是整数 */
    若 funcName == "rt_string_substring" 则 {
        若 paramIndex == 0 则 {
            返回 "i8*"
        }
        返回 "i64"
    }

    /* rt_string_indexOf(i8*, i8*) - 两个都是指针 */
    若 funcName == "rt_string_indexOf" 则 {
        返回 "i8*"
    }

    /* rt_string_toUpperCase(i8*) - 指针参数 */
    若 funcName == "rt_string_toUpperCase" 则 {
        返回 "i8*"
    }

    /* rt_string_toLowerCase(i8*) - 指针参数 */
    若 funcName == "rt_string_toLowerCase" 则 {
        返回 "i8*"
    }

    /* rt_list_clear(i8*) - 指针参数 */
    若 funcName == "rt_list_clear" 则 {
        返回 "i8*"
    }

    /* rt_list_clone(i8*) - 指针参数 */
    若 funcName == "rt_list_clone" 则 {
        返回 "i8*"
    }

    /* rt_time() - 无参数 */
    若 funcName == "rt_time" 则 {
        返回 "i64"
    }

    /* cmd_output(i8*) - 指针参数 */
    若 funcName == "cmd_output" 则 {
        返回 "i8*"
    }

    /* rt_exit(i64) - 整数参数 */
    若 funcName == "rt_exit" 则 {
        返回 "i64"
    }

    /* rt_malloc(i64) - 整数参数 */
    若 funcName == "rt_malloc" 则 {
        返回 "i64"
    }

    /* rt_free(i8*) - 指针参数 */
    若 funcName == "rt_free" 则 {
        返回 "i8*"
    }

    /* 默认返回 i64 */
    返回 "i64"
}



/**
 * 生成带前缀的新标签
 */
函数 codegenNewLabelWithPrefix(cg: Codegen, prefix: 文本): 文本 {
    定义 可变 num: 整数
    num = cg.labelCount
    cg.labelCount = cg.labelCount + 1
    定义 可变 result: 文本
    result = prefix
    定义 可变 numStr: 文本
    numStr = 整数转文本(num)
    result = result + numStr
    返回 result
}

/* ============ AST 遍历和 IR 生成 ============ */

/**
 * 遍历 AST 节点生成 IR
 */
函数 codegen遍历节点(cg: Codegen, nodeKind: 整数, nodeName: 文本): 文本 {
    打印("遍历节点: kind=")
    打印(nodeKind)
    打印(", name=")
    打印(nodeName)

    定义 可变 result: 文本
    result = ""

    若 nodeKind == 0 则 {
        result = codegen生成标识符(cg, nodeName)
    } 否则 {
        若 nodeKind == 2 则 {
            result = codegen生成变量声明(cg, nodeName)
        } 否则 {
            若 nodeKind == 5 则 {
                result = codegen生成函数调用(cg, nodeName, 0)
            } 否则 {
                若 nodeKind == 10 则 {
                    result = codegen生成二元表达式(cg, nodeName, "", "")
                } 否则 {
                    若 nodeKind == 14 则 {
                        result = codegen生成字面量(cg, nodeName)
                    }
                }
            }
        }
    }

    返回 result
}

/**
 * 生成标识符 IR
 */
函数 codegen生成标识符(cg: Codegen, name: 文本): 文本 {
    定义 可变 result: 文本
    result = name + "_val"

    定义 可变 line: 文本
    line = "%" + result + " = load i64, i64* %" + name + "_slot"
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成变量声明 IR
 */
函数 codegen生成变量声明(cg: Codegen, name: 文本): 文本 {
    定义 可变 tmpPtr: 文本
    tmpPtr = name + "_slot"

    定义 可变 line: 文本
    line = "%" + tmpPtr + " = alloca i64"
    codegenEmit(cg, line)

    返回 tmpPtr
}

/**
 * 生成函数调用 IR
 */
函数 codegen生成函数调用(cg: Codegen, funcName: 文本, argCount: 整数): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本

    /* 特殊处理列表操作函数 */
    若 funcName == "_u5217_u8868_u8ffd_u52a0" 则 {
        /* 列表添加/追加 */
        line = "%" + result + " = call i64 @_u5217_u8868_u8ffd_u52a0(i8* null, i64 0)"
        codegenEmit(cg, line)
        返回 result
    }
    若 funcName == "_u5217_u8868_u8bbe_u7f6e" 则 {
        /* 列表设置 */
        line = "call void @_u5217_u8868_u8bbe_u7f6e(i8* null, i64 0, i64 0)"
        codegenEmit(cg, line)
        返回 result
    }
    若 funcName == "_u5217_u8868_u83b7_u53d6" 则 {
        /* 列表获取 */
        line = "%" + result + " = call i64 @_u5217_u8868_u83b7_u53d6(i8* null, i64 0)"
        codegenEmit(cg, line)
        返回 result
    }
    若 funcName == "_u5217_u8868_u957f_u5ea6" 则 {
        /* 列表长度 */
        line = "%" + result + " = call i64 @_u5217_u8868_u957f_u5ea6(i8* null)"
        codegenEmit(cg, line)
        返回 result
    }
    /* 特殊处理 rt_list_new 函数 */
    若 funcName == "rt_list_new" 则 {
        /* 列表创建 */
        line = "%" + result + " = call i8* @rt_list_new()"
        codegenEmit(cg, line)
        返回 result
    }
    /* 其他函数 */
    line = "%" + result + " = call i64 @" + funcName + "()"
    codegenEmit(cg, line)
    返回 result
}

/**
 * 生成二元表达式 IR
 */
函数 codegen生成二元表达式(cg: Codegen, op: 文本, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 llOp: 文本
    llOp = "add"

    若 op == "+" 则 { llOp = "add" }
    若 op == "-" 则 { llOp = "sub" }
    若 op == "*" 则 { llOp = "mul" }
    若 op == "/" 则 { llOp = "sdiv" }
    若 op == "%" 则 { llOp = "srem" }

    定义 可变 line: 文本
    line = "%" + result + " = " + llOp + " i64 %" + left + ", %" + right
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成字面量 IR
 */
函数 codegen生成字面量(cg: Codegen, value: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = add i64 0, " + value
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成赋值 IR
 */
函数 codegen生成赋值IR(cg: Codegen, varName: 文本, value: 文本): 无返回 {
    定义 可变 tmpPtr: 文本
    tmpPtr = varName + "_slot"

    定义 可变 line: 文本
    line = "store i64 %" + value + ", i64* %" + tmpPtr
    codegenEmit(cg, line)
}

/**
 * 生成 if 语句 IR
 */
函数 codegen生成If语句(cg: Codegen, condVar: 文本, thenLabel: 文本, elseLabel: 文本, endLabel: 文本): 无返回 {
    定义 可变 line: 文本
    line = "br i1 %" + condVar + ", label %" + thenLabel + ", label %" + elseLabel
    codegenEmit(cg, line)
}

/**
 * 生成 while 循环 IR
 */
函数 codegen生成While循环(cg: Codegen, condVar: 文本, bodyLabel: 文本, endLabel: 文本): 无返回 {
    定义 可变 line: 文本
    line = "br i1 %" + condVar + ", label %" + bodyLabel + ", label %" + endLabel
    codegenEmit(cg, line)
}

/**
 * 生成 for 循环 IR
 */
函数 codegen生成For循环(cg: Codegen, varName: 文本, startVal: 整数, endVal: 整数, bodyLabel: 文本, incLabel: 文本, endLabel: 文本): 无返回 {
    定义 可变 tmpPtr: 文本
    tmpPtr = varName + "_slot"

    定义 可变 startTmp: 文本
    startTmp = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + startTmp + " = add i64 0, " + 整数转文本(startVal)
    codegenEmit(cg, line)

    line = "store i64 %" + startTmp + ", i64* %" + tmpPtr
    codegenEmit(cg, line)

    line = "br label %" + incLabel
    codegenEmit(cg, line)
}

/**
 * 生成 match 语句 IR
 */
函数 codegen生成Match语句(cg: Codegen, subjectVar: 文本, branchCount: 整数): 无返回 {
    打印("生成 match 语句 IR, subject=")
    打印(subjectVar)
    打印(", 分支数=")
    打印(branchCount)
}

/**
 * 生成返回语句 IR
 */
函数 codegen生成返回IR(cg: Codegen, value: 文本): 无返回 {
    定义 可变 line: 文本
    line = "ret i64 %" + value
    codegenEmit(cg, line)
}

/**
 * 生成 break 语句 IR
 */
函数 codegen生成BreakIR(cg: Codegen, endLabel: 文本): 无返回 {
    定义 可变 line: 文本
    line = "br label %" + endLabel
    codegenEmit(cg, line)
}

/**
 * 生成 continue 语句 IR
 */
函数 codegen生成ContinueIR(cg: Codegen, loopLabel: 文本): 无返回 {
    定义 可变 line: 文本
    line = "br label %" + loopLabel
    codegenEmit(cg, line)
}

/**
 * 生成比较表达式 IR
 */
函数 codegen生成比较IR(cg: Codegen, op: 文本, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 llOp: 文本
    llOp = "eq"

    若 op == "==" 则 { llOp = "eq" }
    若 op == "!=" 则 { llOp = "ne" }
    若 op == "<" 则 { llOp = "slt" }
    若 op == ">" 则 { llOp = "sgt" }
    若 op == "<=" 则 { llOp = "sle" }
    若 op == ">=" 则 { llOp = "sge" }

    定义 可变 line: 文本
    line = "%" + result + " = icmp " + llOp + " i64 %" + left + ", %" + right
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成逻辑与 IR
 */
函数 codegen生成逻辑与(cg: Codegen, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = and i1 %" + left + ", %" + right
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成逻辑或 IR
 */
函数 codegen生成逻辑或(cg: Codegen, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = or i1 %" + left + ", %" + right
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成逻辑非 IR
 */
函数 codegen生成逻辑非(cg: Codegen, operand: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = xor i1 %" + operand + ", true"
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成一元负 IR
 */
函数 codegen生成负值(cg: Codegen, operand: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = sub i64 0, %" + operand
    codegenEmit(cg, line)

    返回 result
}

/* ============ 代码生成统计 ============ */

/**
 * 代码生成统计信息
 */

/**
 * 创建代码生成统计
 */
函数 codegen创建统计(): CodegenStats {
    定义 可变 stats: CodegenStats
    stats.生成的指令数 = 0
    stats.生成的分支数 = 0
    stats.生成的函数数 = 0
    stats.生成的全局变量数 = 0
    stats.总内存分配 = 0
    返回 stats
}

/**
 * 打印代码生成统计
 */
函数 codegen打印统计(stats: CodegenStats): 无返回 {
    打印("=== 代码生成统计 ===")
    打印("  生成的指令数: ")
    打印(stats.生成的指令数)
    打印("  生成的分支数: ")
    打印(stats.生成的分支数)
    打印("  生成的函数数: ")
    打印(stats.生成的函数数)
    打印("  生成的全局变量数: ")
    打印(stats.生成的全局变量数)
    打印("  总内存分配: ")
    打印(stats.总内存分配)
    打印("  bytes")
}

/* ============ 测试函数 ============ */

/**
 * 创建一个简单的测试 AST
 * 用于测试代码生成器
 */
函数 codegen创建测试AST(): AST节点 {
    定义 可变 root: AST节点
    root.kind = 0  // 程序节点
    root.name = "测试程序"
    root.children = 列表()

    /* 创建主函数 */
    定义 可变 mainFunc: AST节点
    mainFunc.kind = 1  // 函数定义
    mainFunc.name = "主"
    mainFunc.children = 列表()

    /* 创建函数体（块语句） */
    定义 可变 body: AST节点
    body.kind = 18  // 块语句
    body.children = 列表()

    /* 添加变量定义：x = 42 */
    定义 可变 varX: AST节点
    varX.kind = 3  // 变量定义
    varX.name = "x"
    varX.children = 列表()

    /* 添加字面量 42 */
    定义 可变 lit42: AST节点
    lit42.kind = 14  // 字面量表达式
    lit42.value = "42"
    列表追加(varX.children, lit42)
    列表追加(body.children, varX)

    /* 添加返回语句 */
    定义 可变 retStmt: AST节点
    retStmt.kind = 8  // 返回语句
    retStmt.children = 列表()

    /* 添加标识符 x */
    定义 可变 idX: AST节点
    idX.kind = 13  // 标识符表达式
    idX.name = "x"
    列表追加(retStmt.children, idX)
    列表追加(body.children, retStmt)

    /* 把函数体添加到函数 */
    列表追加(mainFunc.children, body)

    /* 把主函数添加到根节点 */
    列表追加(root.children, mainFunc)

    返回 root
}

/**
 * 测试代码生成器
 */
函数 codegen测试(): 整数 {
    打印("=== 代码生成器测试 ===")

    /* 创建测试 AST */
    定义 可变 testAST: AST节点
    testAST = codegen创建测试AST()

    /* 遍历 AST 生成 IR */
    打印("正在生成 LLVM IR...")
    定义 可变 moduleName: 文本
    moduleName = codegen遍历AST(testAST)

    打印("=== 测试完成 ===")
    打印("生成的模块: ")
    打印(moduleName)

    返回 1
}

/**
 * 测试字符串常量管理
 */
函数 codegen测试字符串常量(): 整数 {
    打印("=== 字符串常量测试 ===")

    定义 可变 cg: Codegen
    cg = codegenInit()

    /* 添加一些字符串常量 */
    定义 可变 str1: 文本
    str1 = codegen添加字符串常量(cg, "Hello, World!")
    定义 可变 str2: 文本
    str2 = codegen添加字符串常量(cg, "测试字符串")
    定义 可变 str3: 文本
    str3 = codegen添加字符串常量(cg, "Hello, World!")  // 重复的字符串

    打印("字符串1: ")
    打印(str1)
    打印("字符串2: ")
    打印(str2)
    打印("字符串3 (重复): ")
    打印(str3)

    /* 查找字符串 */
    定义 可变 found1: 文本
    found1 = codegen查找字符串常量(cg, "Hello, World!")
    定义 可变 found2: 文本
    found2 = codegen查找字符串常量(cg, "不存在的字符串")

    打印("查找 'Hello, World!': ")
    打印(found1)
    打印("查找 '不存在的字符串': ")
    打印(found2)

    打印("=== 字符串常量测试完成 ===")
    返回 1
}

/**
 * 测试变量映射管理
 */
函数 codegen测试变量映射(): 整数 {
    打印("=== 变量映射测试 ===")

    定义 可变 cg: Codegen
    cg = codegenInit()

    /* 添加变量 */
    codegen添加变量(cg, "x", "x_slot", "整数")
    codegen添加变量(cg, "y", "y_slot", "浮点数")
    codegen添加变量(cg, "name", "name_slot", "文本")

    /* 查找变量 */
    定义 可变 ssaX: 文本
    ssaX = codegen查找变量(cg, "x")
    定义 可变 typeX: 文本
    typeX = codegen查找变量类型(cg, "x")
    定义 可变 ssaY: 文本
    ssaY = codegen查找变量(cg, "y")
    定义 可变 typeY: 文本
    typeY = codegen查找变量类型(cg, "y")
    定义 可变 ssaNotFound: 文本
    ssaNotFound = codegen查找变量(cg, "不存在的变量")

    打印("变量 x - SSA: ")
    打印(ssaX)
    打印(", 类型: ")
    打印(typeX)
    打印("变量 y - SSA: ")
    打印(ssaY)
    打印(", 类型: ")
    打印(typeY)
    打印("变量 '不存在的变量': ")
    打印(ssaNotFound)

    /* 清空变量映射 */
    codegen清空变量(cg)
    打印("清空后变量映射大小: ")
    打印(列表长度(cg.variableMap))

    打印("=== 变量映射测试完成 ===")
    返回 1
}

/**
 * 主测试函数
 */
函数 codegen运行所有测试(): 整数 {
    打印("")
    打印("========================================")
    打印("   玄语 L2 编译器 - 代码生成器测试")
    打印("========================================")
    打印("")

    定义 可变 success: 整数
    success = 1

    /* 测试变量映射 */
    若 codegen测试变量映射() != 1 则 { success = 0 }
    打印("")

    /* 测试字符串常量 */
    若 codegen测试字符串常量() != 1 则 { success = 0 }
    打印("")

    /* 测试完整代码生成 */
    若 codegen测试() != 1 则 { success = 0 }
    打印("")

    打印("========================================")
    若 success == 1 则 {
        打印("   所有测试通过 ✓")
    } 否则 {
        打印("   部分测试失败 ✗")
    }
    打印("========================================")
    打印("")

    返回 success
}

/* ======== 模块: compiler_new.xy ======== */

/**
 * @file compiler_new.xy
 * @brief 玄语L2编译器 - 整合驱动
 * @description 整合词法分析、语法分析、语义分析、代码生成（使用引入替代外部）
 */

/* ============ 模块导入 ============ */


/* ============ 常量定义 ============ */

常量 退出成功 = 0
常量 退出失败 = 1

/* ============ 打印函数 ============ */

函数 打印换行(): 无返回 {
    打印("")
}

函数 打印横线(): 无返回 {
    打印("========================================")
}

函数 打印编译器名称(): 无返回 {
    打印("玄语L2编译器")
}

函数 打印版本信息(): 无返回 {
    打印("版本 0.1.0")
}

函数 打印用法(): 无返回 {
    打印横线()
    打印编译器名称()
    打印版本信息()
    打印横线()
    打印换行()
    打印("用法: xyc <源文件> [选项]")
    打印换行()
    打印("选项:")
    打印("  -o <输出>   指定输出文件名")
    打印("  --ir        输出LLVM IR")
    打印("  --run       编译后运行")
    打印("  -h, --help  显示帮助")
    打印("  -v, --version 显示版本")
    打印换行()
}

/* ============ 词法分析阶段 ============ */

函数 执行词法分析(源码: 文本): 列表 {
    打印("=== 词法分析 ===")
    打印("DEBUG 执行词法分析: 源码长度=")
    打印整数(文本长度(源码))
    打印("\n")
    定义 可变 tokens: 列表
    tokens = tokenize(源码)
    打印("词法分析完成，共 ")
    打印整数(列表长度(tokens))
    打印(" 个 Token")
    打印换行()
    返回 tokens
}

/* ============ 语法分析阶段 ============ */

函数 执行语法分析(tokens: 列表, 源码: 文本): AST节点 {
    打印("=== 语法分析 ===")
    打印("DEBUG 执行语法分析: 调用 parser分析Tokens")
    定义 可变 ast: AST节点
    ast = parser分析Tokens(tokens, 源码)
    打印("语法分析完成，共 ")
    打印整数(列表长度(ast.children))
    打印(" 个顶层声明")
    打印换行()
    打印换行()
    返回 ast
}

/* ============ 语义分析阶段 ============ */

函数 执行语义分析(ast: AST节点): 整数 {
    打印("=== 语义分析 ===")
    定义 可变 sema: Sema
    sema = semaInit("")
    定义 可变 错误数: 整数
    错误数 = sema分析AST(sema, ast)
    若 错误数 > 0 则 {
        打印("语义分析发现 ")
        打印整数(错误数)
        打印(" 个错误")
    } 否则 {
        打印("语义分析完成，无错误")
    }
    打印换行()
    返回 错误数
}

/* ============ 代码生成阶段 ============ */

函数 执行代码生成(ast: AST节点): 文本 {
    打印("=== 代码生成 ===")
    定义 可变 ir: 文本
    ir = codegen遍历AST(ast)
    打印("代码生成完成")
    打印换行()
    返回 ir
}

/* ============ 编译单个源文件 ============ */

函数 编译源文件(源文件路径: 文本, ir文件路径: 文本): 整数 {
    打印("DEBUG: 进入编译源文件函数\n")

    定义 可变 源码: 文本
    源码 = 读取文件(源文件路径)
    打印("DEBUG: 文件读取完成，长度: ")
    打印整数(文本长度(源码))
    打印("\n")

    若 文本长度(源码) == 0 则 {
        打印("ERROR: 文件为空\n")
        返回 退出失败
    }

    // 阶段1: 词法分析
    定义 可变 tokens: 列表
    tokens = 执行词法分析(源码)

    // 阶段2: 语法分析
    打印("DEBUG: tokens list has ")
    打印整数(列表长度(tokens))
    打印(" elements\n")
    打印("DEBUG: 准备调用执行语法分析\n")
    定义 可变 ast: AST节点
    ast = 执行语法分析(tokens, 源码)
    打印("DEBUG: 语法分析完成\n")

    // 阶段3: 语义分析
    打印("DEBUG: 准备调用执行语义分析\n")
    定义 可变 错误数: 整数
    错误数 = 执行语义分析(ast)
    打印("DEBUG: 语义分析完成\n")

    若 错误数 > 0 则 {
        打印横线()
        打印("编译失败: 发现 ")
        打印整数(错误数)
        打印(" 个语义错误")
        打印横线()
        返回 退出失败
    }

    // 阶段4: 代码生成
    打印("DEBUG: 准备调用执行代码生成\n")
    定义 可变 ir: 文本
    ir = 执行代码生成(ast)
    打印("DEBUG: 代码生成完成\n")

    // 输出IR
    若 ir文件路径 == "" 则 {
        打印横线()
        打印("生成的LLVM IR:")
        打印横线()
        打印(ir)
        打印横线()
    } 否则 {
        写入文件(ir文件路径, ir)
        打印("IR 已写入: ")
        打印(ir文件路径)
        打印换行()
    }

    打印("编译成功!")
    打印横线()

    返回 退出成功
}

/* ============ 主函数 ============ */

函数 主(): 整数 {
    打印("DEBUG[主]: 进入主函数\n")
    定义 可变 i: 整数
    定义 可变 显示帮助: 整数
    定义 可变 显示版本: 整数
    定义 可变 源文件: 文本
    定义 可变 输出模式: 文本
    定义 可变 ir文件路径: 文本

    打印("DEBUG[主]: 初始化变量\n")
    i = 0
    显示帮助 = 0
    显示版本 = 0
    源文件 = ""
    输出模式 = "ir"
    ir文件路径 = ""

    定义 可变 参数个数: 整数
    参数个数 = 获取参数个数()
    打印("DEBUG[主]: 参数个数: ")
    打印整数(参数个数)
    打印("\n")

    i = 1
    当 i < 参数个数 则 {
        定义 可变 参数: 文本
        参数 = 获取参数(i)

        打印("DEBUG[主]: 参数 ")
        打印整数(i)
        打印(": ")
        打印(参数)
        打印("\n")

        若 参数 == "-h" || 参数 == "--help" 则 {
            显示帮助 = 1
        } 否则 {
            若 参数 == "-v" || 参数 == "--version" 则 {
                显示版本 = 1
            } 否则 {
                若 参数 == "--ir" 则 {
                    输出模式 = "ir"
                } 否则 {
                    若 参数 == "--run" 则 {
                        输出模式 = "run"
                    } 否则 {
                        若 参数 == "-o" 则 {
                            i = i + 1
                        } 否则 {
                            若 参数 == "--ir-file" 则 {
                                i = i + 1
                                若 i < 参数个数 则 {
                                    ir文件路径 = 获取参数(i)
                                }
                            } 否则 {
                                源文件 = 参数
                            }
                        }
                    }
                }
            }
        }

        i = i + 1
    }

    若 显示帮助 == 1 则 {
        打印用法()
        返回 退出成功
    }

    若 显示版本 == 1 则 {
        打印横线()
        打印编译器名称()
        打印版本信息()
        打印横线()
        返回 退出成功
    }

    若 源文件 == "" 则 {
        打印("DEBUG: 未指定源文件\n")
        打印用法()
        返回 退出失败
    }

    打印("DEBUG: 源文件路径: ")
    打印(源文件)
    打印("\n")
    打印("DEBUG: IR输出路径: ")
    打印(ir文件路径)
    打印("\n")

    打印("DEBUG: 准备调用编译源文件\n")
    定义 可变 结果: 整数
    结果 = 编译源文件(源文件, ir文件路径)
    打印("DEBUG: 编译完成，返回: ")
    打印整数(结果)
    打印("\n")

    返回 结果
}

