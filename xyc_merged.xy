外部 函数 文本切片(s: 文本, 开始: 整数, 结束: 整数): 文本

函数 运行时初始化(): 无返回 {
    返回
}

/* ======== 模块: utils_s.xy ======== */


/**
 * @file utils.xy
 * @brief 工具函数模块
 * @description 提供错误报告、调试等辅助函数
 */

/* ============ 列表操作函数 ============ */
/* 注意：列表操作函数由 C 运行时库提供（rt_list_* 系列函数）
   在 runtime.xy 中声明为外部函数，无需在此重新定义 */

/**
 * 错误级别
 */

/**
 * 报告错误
 */
函数 报告错误(级别: 错误级别, 消息: 文本) {
    若 级别 == 错误级别.错误 则 {
        打印("错误: " + 消息)
    }
    否则若 级别 == 错误级别.致命错误 则 {
        打印("致命错误: " + 消息)
    }
}

/**
 * 报告词法错误
 */
函数 报告词法错误(消息: 文本, 行号: 整数, 列号: 整数) {
    定义 msg = "词法错误 at " + 整数转文本(行号) + ":" + 整数转文本(列号) + " - " + 消息
    报告错误(错误级别.错误, msg)
}

/**
 * 报告语法错误
 */
函数 报告语法错误(消息: 文本, 行号: 整数, 列号: 整数) {
    定义 msg = "语法错误 at " + 整数转文本(行号) + ":" + 整数转文本(列号) + " - " + 消息
    报告错误(错误级别.错误, msg)
}

/**
 * 报告语义错误
 */
函数 报告语义错误(消息: 文本, 行号: 整数, 列号: 整数) {
    定义 msg = "语义错误 at " + 整数转文本(行号) + ":" + 整数转文本(列号) + " - " + 消息
    报告错误(错误级别.错误, msg)
}

/**
 * 调试打印
 */
函数 调试打印(消息: 文本) {
    打印("[调试] " + 消息)
}


/* ======== 模块: lexer_s.xy ======== */


/**
 * @file lexer.xy
 * @brief 词法分析器 - 自展编译器
 * @description 完整的词法扫描功能，支持 token 列表构建
 */

/* ============ 字符分类函数 ============ */

/**
 * 判断是否为空白字符
 */
函数 是空白(ch: 整数): 整数 {
    若 ch == 32 则 { 返回 1 }
    若 ch == 9  则 { 返回 1 }
    若 ch == 10 则 { 返回 1 }
    若 ch == 13 则 { 返回 1 }
    返回 0
}

/**
 * 判断是否为字母（包括中文）
 */
函数 是字母(ch: 整数): 整数 {
    // ASCII 字母
    若 ch >= 65 && ch <= 90 则 { 返回 1 }
    若 ch >= 97 && ch <= 122 则 { 返回 1 }
    若 ch == 95 则 { 返回 1 }
    // UTF-8 首字节范围（向后兼容旧版字节模式）
    若 ch >= 192 && ch <= 255 则 { 返回 1 }
    // CJK 统一表意文字 (U+4E00 - U+9FFF)
    若 ch >= 19968 && ch <= 40959 则 { 返回 1 }
    // CJK 扩展 A (U+3400 - U+4DBF)
    若 ch >= 13312 && ch <= 19903 则 { 返回 1 }
    // CJK 扩展 B+ (U+20000 - U+2A6DF) — 超出 i64 16位但仍在范围内
    若 ch >= 131072 && ch <= 173791 则 { 返回 1 }
    // 全角符号/平假名/片假名 (U+FF00 - U+FFEF, U+3040 - U+30FF)
    若 ch >= 65280 && ch <= 65519 则 { 返回 1 }
    若 ch >= 12352 && ch <= 12543 则 { 返回 1 }
    // CJK 标点符号 (U+3000 - U+303F)
    若 ch >= 12288 && ch <= 12351 则 { 返回 1 }
    返回 0
}

/**
 * 判断是否为数字
 */
函数 是数字(ch: 整数): 整数 {
    若 ch >= 48 && ch <= 57 则 { 返回 1 }
    返回 0
}

/**
 * 判断是否为字母或数字
 */
函数 是字母或数字(ch: 整数): 整数 {
    若 是字母(ch) == 1 则 { 返回 1 }
    若 是数字(ch) == 1 则 { 返回 1 }
    返回 0
}

/**
 * 判断是否为运算符字符
 */
函数 是运算符(ch: 整数): 整数 {
    若 ch == 43 则 { 返回 1 }  // +
    若 ch == 45 则 { 返回 1 }  // -
    若 ch == 42 则 { 返回 1 }  // *
    若 ch == 47 则 { 返回 1 }  // /
    若 ch == 37 则 { 返回 1 }  // %
    若 ch == 61 则 { 返回 1 }  // =
    若 ch == 33 则 { 返回 1 }  // !
    若 ch == 60 则 { 返回 1 }  // <
    若 ch == 62 则 { 返回 1 }  // >
    若 ch == 38 则 { 返回 1 }  // &
    若 ch == 124 则 { 返回 1 } // |
    若 ch == 94 则 { 返回 1 }  // ^
    若 ch == 126 则 { 返回 1 } // ~
    返回 0
}

/**
 * 判断是否为符号字符
 */
函数 是符号(ch: 整数): 整数 {
    若 ch == 40 则 { 返回 1 }  // (
    若 ch == 41 则 { 返回 1 }  // )
    若 ch == 123 则 { 返回 1 } // {
    若 ch == 125 则 { 返回 1 } // }
    若 ch == 91 则 { 返回 1 }  // [
    若 ch == 93 则 { 返回 1 }  // ]
    若 ch == 59 则 { 返回 1 }  // ;
    若 ch == 58 则 { 返回 1 }  // :
    若 ch == 44 则 { 返回 1 }  // ,
    若 ch == 46 则 { 返回 1 }  // .
    若 ch == 34 则 { 返回 1 }  // "
    若 ch == 39 则 { 返回 1 }  // '
    若 ch == 10 则 { 返回 1 }  // 换行符
    返回 0
}

/**
 * 判断是否为比较运算符起始字符
 */
函数 是比较起始(ch: 整数): 整数 {
    若 ch == 61 则 { 返回 1 }  // =
    若 ch == 33 则 { 返回 1 }  // !
    若 ch == 60 则 { 返回 1 }  // <
    若 ch == 62 则 { 返回 1 }  // >
    返回 0
}

/* ============ 关键字识别 ============ */

/**
 * 判断是否为关键字
 */
函数 是关键字(text: 文本): 整数 {
    /* ========== 控制流 (中文) ========== */
    若 text == "若" 则 { 返回 1 }
    若 text == "则" 则 { 返回 1 }
    若 text == "否则" 则 { 返回 1 }
    若 text == "当" 则 { 返回 1 }
    若 text == "循环" 则 { 返回 1 }
