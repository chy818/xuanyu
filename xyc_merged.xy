/**
 * 分析分支预测提示
 */
函数 分析分支预测(condFreq: 浮点数): 文本 {
    若 condFreq > 0.9 则 { 返回 "likely_taken" }
    若 condFreq < 0.1 则 { 返回 "unlikely_taken" }
    返回 "unpredictable"
}

/**
 * 检查内存分配大小
 */
函数 检查内存分配大小(size: 整数): 整数 {
    若 size <= 0 则 {
        打印("错误: 内存分配大小必须为正数")
        返回 -1
    }
    若 size > 1073741824 则 {
        打印("警告: 内存分配大小超过 1GB")
        返回 1
    }
    返回 0
}

/**
 * 检查指针运算有效性
 */
函数 检查指针运算(ptrType: 整数, offset: 整数): 整数 {
    若 ptrType != 6 && ptrType != 3 则 {
        打印("错误: 非指针类型不能进行指针运算")
        返回 0
    }
    返回 1
}

/**
 * 检查函数类型兼容性
 */
函数 检查函数类型兼容性(signature1: 文本, signature2: 文本): 整数 {
    若 signature1 == signature2 则 { 返回 1 }
    打印("警告: 函数类型签名不匹配")
    返回 0
}

/**
 * 检查结构体字段访问
 */
函数 检查结构体字段访问(structName: 文本, fieldName: 文本): 整数 {
    若 structName == "" || fieldName == "" 则 {
        返回 0
    }
    打印("检查结构体字段: " + structName + "." + fieldName)
    返回 1
}

/**
 * 获取默认类型值
 */
函数 获取默认值(typeName: 整数): 文本 {
    若 typeName == 0 则 { 返回 "0" }
    若 typeName == 1 则 { 返回 "0.0" }
    若 typeName == 2 则 { 返回 "假" }
    若 typeName == 3 则 { 返回 "\"\"" }
    若 typeName == 4 则 { 返回 "'\\0'" }
    返回 "null"
}

/**
 * 检查整数溢出
 */
函数 检查整数溢出(op: 文本, left: 整数, right: 整数): 整数 {
    若 op == "+" 则 {
        若 left > 0 && right > 0 && left > 9223372036854775807 - right 则 {
            打印("警告: 整数加法可能溢出")
            返回 1
        }
    }
    若 op == "*" 则 {
        若 left != 0 && right > 9223372036854775807 / left 则 {
            打印("警告: 整数乘法可能溢出")
            返回 1
        }
    }
    返回 0
}

/**
 * 初始化语义分析器
 */
函数 semaInit(源码: 文本): Sema {
    定义 可变 sema: Sema
    sema.源码 = 源码
    sema.当前作用域 = -1
    sema.作用域栈 = 列表()
    sema.错误列表 = 列表()
    sema.警告列表 = 列表()
    sema.当前行号 = 1
    sema.错误计数 = 0
    sema.警告计数 = 0
    sema.全局作用域 = -1
    sema.当前函数名 = ""
    sema.当前函数返回类型 = -1

    /* 初始化循环状态 */
    sema.循环状态.激活 = 0
    sema.循环状态.循环层级 = 0

    /* 创建全局作用域 */
    定义 可变 globalScopeIdx: 整数
    globalScopeIdx = 创建作用域(sema, "全局")
    sema.全局作用域 = globalScopeIdx

    /* 注册内置函数 */
    注册内置函数(sema)

    返回 sema
}

/**
 * 运行语义分析（完整版本，接受 AST 根节点）
 */
函数 sema分析AST(sema: Sema, ast: AST节点): 整数 {
    打印("=== 开始语义分析 ===")

    sema.错误计数 = 0
    sema.警告计数 = 0

    定义 可变 errorCount: 整数
    errorCount = sema遍历AST(sema, ast)

    打印("=== 语义分析完成 ===")
    打印("错误数: ")
    打印(sema.错误计数)
    打印("警告数: ")
    打印(sema.警告计数)

    返回 errorCount
}

/**
 * 打印符号表（调试用）
 */
函数 打印符号表(sema: Sema): 无返回 {
    打印("=== 符号表 ===")

    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(sema.作用域栈) 则 {
        定义 可变 scope: 作用域
        scope = 列表获取(sema.作用域栈, i)

        打印("作用域 ")
        打印(i)
        打印(": ")
        打印(scope.名称)
        打印(" (层级=")
        打印(scope.层级)
        打印(")")

        定义 可变 j: 整数
        j = 0
        当 j < 列表长度(scope.符号表) 则 {
            定义 可变 sym: 符号
            sym = 列表获取(scope.符号表, j)
            打印("  符号: ")
            打印(sym.名称)
            打印(" 类型: ")
            打印(类型转文本(sym.类型))
            打印(" 可变: ")
            若 sym.可变 == 1 则 { 打印("是") } 否则 { 打印("否") }
            j = j + 1
        }
        i = i + 1
    }
    打印("=== 符号表结束 ===")
}

/* ============ 测试函数 ============ */

/**
 * 创建简单的测试 AST 用于验证语义分析器
 */
函数 创建测试AST(): AST节点 {
    定义 可变 root: AST节点
    root.kind = 0  /* 程序 */
    root.name = "测试程序"
    root.children = 列表()

    /* 创建变量定义 */
    定义 可变 varNode: AST节点
    varNode.kind = 3  /* 变量定义 */
    varNode.name = "x"
    varNode.intValue = 0  /* 整数类型 */
    varNode.line = 1
    varNode.children = 列表()

    /* 添加到根节点 */
    列表追加(root.children, varNode)

    /* 创建函数定义 */
    定义 可变 funcNode: AST节点
    funcNode.kind = 1  /* 函数定义 */
    funcNode.name = "测试函数"
    funcNode.line = 3
    funcNode.children = 列表()

    /* 创建函数体块语句 */
    定义 可变 blockNode: AST节点
    blockNode.kind = 18  /* 块语句 */
    blockNode.line = 4
    blockNode.children = 列表()

    /* 添加函数参数和体到函数 */
    列表追加(funcNode.children, blockNode)

    /* 添加函数到根节点 */
    列表追加(root.children, funcNode)

    返回 root
}

/**
 * 运行语义分析器测试
 */
函数 测试语义分析(): 整数 {
    打印("=== 开始语义分析器测试 ===")

    /* 初始化语义分析器 */
    定义 可变 sema: Sema
    sema = semaInit("测试源码")

    /* 创建测试 AST */
    定义 可变 testAST: AST节点
    testAST = 创建测试AST()

    /* 运行语义分析 */
    定义 可变 errorCount: 整数
    errorCount = sema分析AST(sema, testAST)

    /* 打印符号表 */
    打印符号表(sema)

    打印("=== 测试完成 ===")
    打印("错误数: ")
    打印(errorCount)

    返回 errorCount
}

/* ======== 模块: codegen_s.xy ======== */


/**
 * @file codegen.xy
 * @brief 代码生成器 - 自展编译器
 * @description 生成 LLVM IR 指令，实现真实 AST 遍历
 */


/* ============ AST 节点类型 (与 parser.xy 和 sema.xy 一致) ============ */


/* ============ AST 节点结构体 ============ */


/* ============ 循环上下文（用于 break/continue） ============ */


/* ============ Codegen 结构 ============ */


/* ============ LLVM 标识符转义 ============ */

/**
 * 转义 LLVM 标识符中的非 ASCII 字符为 uXX 格式（按字节转义）
 * 注意：XY 的 文本[i] 返回字节值，非 Unicode 码点
 * 简化版：仅用整数运算生成十六进制
 */
函数 escapeLLVM标识符(name: 文本): 文本 {
    定义 可变 result: 文本
    result = ""
    定义 可变 hex: 文本
    hex = "0123456789abcdef"
    定义 可变 i: 整数
    i = 0
    当 i < 文本长度(name) 则 {
        定义 可变 b: 整数
        b = name[i]
        若 b < 128 则 {
            /* ASCII 字符直接追加 */
            若 b == 95 则 {  /* '_' */
                result = result + "_"
            } 否则 {
                result = result + 整数转字符(b)
            }
        } 否则 {
            /* 非 ASCII 字节转为 uXX 格式 */
            定义 可变 hi: 整数
            hi = b / 16
            定义 可变 lo: 整数
            lo = b - hi * 16
            result = result + "u"
            result = result + 整数转字符(hex[hi])
            result = result + 整数转字符(hex[lo])
        }
        i = i + 1
    }
    返回 result
}

/* ============ LLVM 类型映射 ============ */

函数 getLLVMType(typeName: 文本): 文本 {
    若 typeName == "整数" || typeName == "长整数" 则 { 返回 "i64" }
    若 typeName == "浮点数" || typeName == "双精度" 则 { 返回 "double" }
    若 typeName == "布尔" 则 { 返回 "i1" }
    若 typeName == "文本" || typeName == "字符" 则 { 返回 "i8*" }
    若 typeName == "无返回" 则 { 返回 "void" }
    若 typeName == "任意" || typeName == "列表" 则 { 返回 "i8*" }
    返回 "i64"
}

/* ============ 初始化 ============ */

函数 codegenInit(): Codegen {
    定义 可变 cg: Codegen
    cg.moduleName = "xuanyu_module"
    cg.tempCount = 0
    cg.labelCount = 0
    cg.funcCount = 0
    cg.output = ""
    cg.indent = 0
    cg.stringConstCount = 0
    cg.funcDefs = 列表()
    cg.currentFunc = ""
    cg.currentReturnType = "i64"
    // 初始化新增字段
    cg.variableMap = 列表()
    cg.variableTypes = 列表()
    cg.stringConstants = 列表()
    cg.loopContextStack = 列表()
    cg.currentFunctionIndex = 0
    cg.functionIndexCounter = 0
    cg.stringConstDefs = ""
    返回 cg
}

/* ============ 输出函数 ============ */

函数 codegenEmitLine(cg: Codegen, line: 文本) {
    定义 可变 fullLine: 文本
    fullLine = ""
    定义 可变 i: 整数
    i = 0
    当 i < cg.indent 则 {
        fullLine = fullLine + "  "
        i = i + 1
    }
    fullLine = fullLine + line
    cg.output = cg.output + fullLine + "\n"
    打印(fullLine)  // 同时输出到控制台用于调试
}

函数 codegenEmit(cg: Codegen, content: 文本) {
    codegenEmitLine(cg, content)
}

/* ============ 标签和临时变量 ============ */

函数 codegenNewLabel(cg: Codegen): 文本 {
    定义 可变 num: 整数
    num = cg.labelCount
    cg.labelCount = cg.labelCount + 1
    定义 可变 result: 文本
    result = "L"
    定义 可变 numStr: 文本
    numStr = 整数转文本(num)
    result = result + numStr
    返回 result
}

函数 codegenNewTemp(cg: Codegen): 文本 {
    定义 可变 num: 整数
    num = cg.tempCount
    cg.tempCount = cg.tempCount + 1
    定义 可变 result: 文本
    result = "tmp"
    定义 可变 tmpStr: 文本
    tmpStr = 整数转文本(num)
    result = result + tmpStr
    返回 result
}

/* ============ 变量映射管理 ============ */

/**
 * 添加变量到映射表
 */
函数 codegen添加变量(cg: Codegen, varName: 文本, ssaValue: 文本, varType: 文本): 无返回 {
    // 变量名和值作为一对添加到列表
    列表追加(cg.variableMap, varName)
    列表追加(cg.variableMap, ssaValue)

    // 变量名和类型作为一对添加到列表
    列表追加(cg.variableTypes, varName)
    列表追加(cg.variableTypes, varType)
}

/**
 * 查找变量的 SSA 值
 */
函数 codegen查找变量(cg: Codegen, varName: 文本): 文本 {
    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(cg.variableMap) 则 {
        若 cg.variableMap[i] == varName 则 {
            返回 cg.variableMap[i + 1]
        }
        i = i + 2
    }
    返回 ""  // 未找到
}

/**
 * 查找变量的类型
 */
函数 codegen查找变量类型(cg: Codegen, varName: 文本): 文本 {
    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(cg.variableTypes) 则 {
        若 cg.variableTypes[i] == varName 则 {
            返回 cg.variableTypes[i + 1]
        }
        i = i + 2
    }
    返回 "i64"  // 默认类型
}

/**
 * 清空变量映射（进入新作用域时使用）
 */
函数 codegen清空变量(cg: Codegen): 无返回 {
    cg.variableMap = 列表()
    cg.variableTypes = 列表()
}

/* ============ 循环上下文管理 ============ */

/**
 * 推入循环上下文
 */
函数 codegen推入循环上下文(cg: Codegen, ctx: 循环上下文): 无返回 {
    列表追加(cg.loopContextStack, ctx)
}

/**
 * 弹出循环上下文
 */
函数 codegen弹出循环上下文(cg: Codegen): 循环上下文 {
    定义 可变 ctx: 循环上下文
    若 列表长度(cg.loopContextStack) > 0 则 {
        定义 可变 lastIdx: 整数
        lastIdx = 列表长度(cg.loopContextStack) - 1
        ctx = cg.loopContextStack[lastIdx]
        // 注意：这里简化处理，因为玄语不支持从列表中删除元素
        // 实际使用时，需要用更复杂的数据结构
    }
    返回 ctx
}

/**
 * 获取当前循环上下文
 */
函数 codegen获取当前循环上下文(cg: Codegen): 循环上下文 {
    定义 可变 ctx: 循环上下文
    若 列表长度(cg.loopContextStack) > 0 则 {
        定义 可变 lastIdx: 整数
        lastIdx = 列表长度(cg.loopContextStack) - 1
        ctx = cg.loopContextStack[lastIdx]
    }
    返回 ctx
}

/* ============ 字符串常量管理 ============ */

/**
 * 添加字符串常量
 */
函数 codegen添加字符串常量(cg: Codegen, str: 文本): 文本 {
    // 先检查是否已存在
    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(cg.stringConstants) 则 {
        若 cg.stringConstants[i] == str 则 {
            返回 cg.stringConstants[i + 1]
        }
        i = i + 2
    }

    // 创建新的字符串常量
    定义 可变 constName: 文本
    constName = "str"
    定义 可变 idxStr: 文本
    idxStr = 整数转文本(cg.stringConstCount)
    constName = constName + idxStr
    cg.stringConstCount = cg.stringConstCount + 1

    // 添加到常量表
    列表追加(cg.stringConstants, str)
    列表追加(cg.stringConstants, constName)

    返回 constName
}

/**
 * 查找字符串常量
 */
函数 codegen查找字符串常量(cg: Codegen, str: 文本): 文本 {
    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(cg.stringConstants) 则 {
        若 cg.stringConstants[i] == str 则 {
            返回 cg.stringConstants[i + 1]
        }
        i = i + 2
    }
    返回 ""
}

/* ============ AST 遍历和 IR 生成函数 ============ */

/**
 * 生成字面量值 IR
 */
函数 codegenLiteral(cg: Codegen, value: 文本, type: 整数): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    若 type == 1 则 {
        // 整数 - 但由于返回类型是文本，我们需要返回指针类型
        // 我们将 i64 转换为 i8* (inttoptr)
        定义 可变 intTmp: 文本
        intTmp = codegenNewTemp(cg)
        codegenEmit(cg, "%" + intTmp + " = add i64 0, " + value)
        codegenEmit(cg, "%" + result + " = inttoptr i64 %" + intTmp + " to i8*")
    } 否则 {
        若 type == 2 则 {
            // 字符串 - 直接返回指针
            定义 可变 tmpPtr: 文本
            tmpPtr = codegenNewTemp(cg)
            codegenEmit(cg, "%" + tmpPtr + " = getelementptr [0 x i8], [0 x i8]* null, i64 0, i64 0")
            result = tmpPtr
        } 否则 {
            // 默认 - 返回空指针
            codegenEmit(cg, "%" + result + " = inttoptr i64 0 to i8*")
        }
    }

    返回 result
}

/**
 * 生成二元表达式 IR
 */
函数 codegenBinaryOp(cg: Codegen, op: 文本, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 llOp: 文本
    llOp = "add"

    若 op == "+" 则 { llOp = "add" }
    若 op == "-" 则 { llOp = "sub" }
    若 op == "*" 则 { llOp = "mul" }
    若 op == "/" 则 { llOp = "sdiv" }
    若 op == "%" 则 { llOp = "srem" }

    定义 可变 line: 文本
    line = "%" + result + " = " + llOp + " i64 %" + left + ", %" + right
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成比较表达式 IR
 */
函数 codegenCompare(cg: Codegen, op: 文本, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 llOp: 文本
    llOp = "eq"

    若 op == "==" 则 { llOp = "eq" }
    若 op == "!=" 则 { llOp = "ne" }
    若 op == "<" 则 { llOp = "slt" }
    若 op == ">" 则 { llOp = "sgt" }
    若 op == "<=" 则 { llOp = "sle" }
    若 op == ">=" 则 { llOp = "sge" }

    定义 可变 line: 文本
    line = "%" + result + " = icmp " + llOp + " i64 %" + left + ", %" + right
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成逻辑与 (&&) IR
 */
函数 codegenLogicalAnd(cg: Codegen, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = and i1 %" + left + ", %" + right
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成逻辑或 (||) IR
 */
函数 codegenLogicalOr(cg: Codegen, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = or i1 %" + left + ", %" + right
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成逻辑非 (!) IR
 */
函数 codegenLogicalNot(cg: Codegen, value: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = xor i1 %" + value + ", 1"
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成一元减法 IR
 */
函数 codegenNegate(cg: Codegen, value: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = sub i64 0, %" + value
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成符号扩展 IR
 */
函数 codegenSignExt(cg: Codegen, value: 文本, fromType: 文本, toType: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = sext " + fromType + " %" + value + " to " + toType
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成零扩展 IR
 */
函数 codegenZeroExt(cg: Codegen, value: 文本, fromType: 文本, toType: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = zext " + fromType + " %" + value + " to " + toType
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成截断 IR
 */
函数 codegenTrunc(cg: Codegen, value: 文本, fromType: 文本, toType: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = trunc " + fromType + " %" + value + " to " + toType
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成浮点到整数的转换 IR
 */
函数 codegenFptoSI(cg: Codegen, value: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = fptosi double %" + value + " to i64"
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成整数到浮点的转换 IR
 */
函数 codegenSIToFP(cg: Codegen, value: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = sitofp i64 %" + value + " to double"
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成数组分配 IR
 */
函数 codegenArrayAlloca(cg: Codegen, elementType: 文本, numElements: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = alloca " + elementType + ", i64 %" + numElements
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成数组元素访问 IR
 */
函数 codegenArrayAccess(cg: Codegen, arrayPtr: 文本, index: 文本, elementType: 文本): 文本 {
    定义 可变 tmpPtr: 文本
    tmpPtr = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + tmpPtr + " = getelementptr " + elementType + ", " + elementType + "* %" + arrayPtr + ", i64 %" + index
    codegenEmit(cg, line)

    定义 可变 value: 文本
    value = codegenNewTemp(cg)
    line = "%" + value + " = load " + elementType + ", " + elementType + "* %" + tmpPtr
    codegenEmit(cg, line)

    返回 value
}

/**
 * 生成数组元素存储 IR
 */
函数 codegenArrayStore(cg: Codegen, arrayPtr: 文本, index: 文本, value: 文本, elementType: 文本): 无返回 {
    定义 可变 tmpPtr: 文本
    tmpPtr = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + tmpPtr + " = getelementptr " + elementType + ", " + elementType + "* %" + arrayPtr + ", i64 %" + index
    codegenEmit(cg, line)

    line = "store " + elementType + " %" + value + ", " + elementType + "* %" + tmpPtr
    codegenEmit(cg, line)
}

/**
 * 生成结构体分配 IR
 */
函数 codegenStructAlloca(cg: Codegen, structType: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = alloca " + structType
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成结构体字段访问 IR (使用字段索引)
 */
函数 codegenStructFieldAccess(cg: Codegen, structPtr: 文本, fieldIndex: 整数, fieldType: 文本): 文本 {
    定义 可变 tmpPtr: 文本
    tmpPtr = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + tmpPtr + " = getelementptr " + fieldType + ", " + fieldType + "* %" + structPtr + ", i32 0, i32 " + 整数转文本(fieldIndex)
    codegenEmit(cg, line)

    定义 可变 value: 文本
    value = codegenNewTemp(cg)
    line = "%" + value + " = load " + fieldType + ", " + fieldType + "* %" + tmpPtr
    codegenEmit(cg, line)

    返回 value
}

/**
 * 生成结构体字段存储 IR
 */
函数 codegenStructFieldStore(cg: Codegen, structPtr: 文本, fieldIndex: 整数, value: 文本, fieldType: 文本): 无返回 {
    定义 可变 tmpPtr: 文本
    tmpPtr = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + tmpPtr + " = getelementptr " + fieldType + ", " + fieldType + "* %" + structPtr + ", i32 0, i32 " + 整数转文本(fieldIndex)
    codegenEmit(cg, line)

    line = "store " + fieldType + " %" + value + ", " + fieldType + "* %" + tmpPtr
    codegenEmit(cg, line)
}

/**
 * 生成空指针检查 IR
 */
函数 codegenNullCheck(cg: Codegen, tmpPtr: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = icmp ne i8* %" + tmpPtr + ", null"
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成全局变量声明 IR
 */
函数 codegenGlobalString(cg: Codegen, strValue: 文本, name: 文本): 文本 {
    定义 可变 line: 文本
    line = "@" + name + " = private constant [0 x i8] c\"" + strValue + "\\00\""
    codegenEmit(cg, line)

    返回 name
}

/**
 * 生成全局变量声明 IR (整数)
 */
函数 codegenGlobalInt(cg: Codegen, value: 整数, name: 文本): 文本 {
    定义 可变 line: 文本
    line = "@" + name + " = global i64 " + 整数转文本(value)
    codegenEmit(cg, line)

    返回 name
}

/**
 * 生成选择性 IR (cond ? then : else)
 */
函数 codegenSelect(cg: Codegen, cond: 文本, thenValue: 文本, elseValue: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = select i1 %" + cond + ", i64 %" + thenValue + ", i64 %" + elseValue
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成位旋转 IR (左移后带符号扩展)
 */
函数 codegenShl(cg: Codegen, value: 文本, amount: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = shl i64 %" + value + ", %" + amount
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成算术右移 IR
 */
函数 codegenAShr(cg: Codegen, value: 文本, amount: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = ashr i64 %" + value + ", %" + amount
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成逻辑右移 IR
 */
函数 codegenLShr(cg: Codegen, value: 文本, amount: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = lshr i64 %" + value + ", %" + amount
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成按位与 IR
 */
函数 codegenAnd(cg: Codegen, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = and i64 %" + left + ", %" + right
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成按位或 IR
 */
函数 codegenOr(cg: Codegen, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = or i64 %" + left + ", %" + right
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成按位异或 IR
 */
函数 codegenXor(cg: Codegen, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = xor i64 %" + left + ", %" + right
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成按位取反 IR
 */
函数 codegenNot(cg: Codegen, value: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = xor i64 %" + value + ", -1"
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成函数入口标注
 */
函数 codegenFunctionEntry(cg: Codegen, funcName: 文本): 无返回 {
    定义 可变 line: 文本
    line = "; 函数入口: " + funcName
    codegenEmit(cg, line)
}

/**
 * 生成代码块标注
 */
函数 codegenBlockLabel(cg: Codegen, blockName: 文本): 无返回 {
    定义 可变 line: 文本
    line = "; 代码块: " + blockName
    codegenEmit(cg, line)
}

/**
 * 生成注释
 */
函数 codegenComment(cg: Codegen, comment: 文本): 无返回 {
    定义 可变 line: 文本
    line = "; " + comment
    codegenEmit(cg, line)
}

/**
 * 生成 unreachable 指令 IR
 */
函数 codegenUnreachable(cg: Codegen): 无返回 {
    codegenEmit(cg, "unreachable")
}

/**
 * 生成 switch 指令 IR (用于 match 语句)
 */
函数 codegenSwitch(cg: Codegen, value: 文本, defaultLabel: 文本, numCases: 整数) {
    定义 可变 line: 文本
    line = "switch i64 %" + value + ", label %" + defaultLabel
    codegenEmit(cg, line)
}

/**
 * 生成 case 分支 IR
 */
函数 codegenCase(cg: Codegen, caseValue: 文本, caseLabel: 文本) {
    定义 可变 line: 文本
    line = "i64 " + caseValue + ", label %" + caseLabel
    codegenEmit(cg, line)
}

/**
 * 生成 match 语句 IR
 */
函数 codegenMatch(cg: Codegen, subjectValue: 文本, caseCount: 整数, hasDefault: 整数): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 endLabel: 文本
    endLabel = codegenNewLabel(cg)

    定义 可变 defaultLabel: 文本
    defaultLabel = codegenNewLabel(cg)

    定义 可变 line: 文本
    line = "switch i64 %" + subjectValue + ", label %" + defaultLabel
    codegenEmit(cg, line)

    定义 可变 i: 整数
    i = 0
    当 i < caseCount 则 {
        定义 可变 caseLabel: 文本
        caseLabel = codegenNewLabel(cg)
        line = "i64 " + 整数转文本(i) + ", label %" + caseLabel
        codegenEmit(cg, line)
        i = i + 1
    }

    /* 默认标签 */
    cg.indent = cg.indent - 1
    codegenEmit(cg, defaultLabel + ":")
    cg.indent = cg.indent + 1

    若 hasDefault == 0 则 {
        codegenEmit(cg, "unreachable")
    }

    /* 结束标签 */
    cg.indent = cg.indent - 1
    codegenEmit(cg, endLabel + ":")
    cg.indent = cg.indent + 1

    返回 result
}

/**
 * 生成 phi 节点 IR (用于 match 分支的值合并)
 */
函数 codegenPhi(cg: Codegen, numValues: 整数): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = phi i64"
    定义 可变 i: 整数
    i = 0
    当 i < numValues 则 {
        定义 可变 label: 文本
        label = codegenNewLabel(cg)
        line = line + " [%tmp" + 整数转文本(i) + ", %L" + 整数转文本(i) + "]"
        若 i < numValues - 1 则 {
            line = line + ","
        }
        i = i + 1
    }
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成 if 语句 IR
 */
函数 codegenIf(cg: Codegen, condVar: 文本, thenLabel: 文本, elseLabel: 文本, endLabel: 文本) {
    定义 可变 line: 文本
    line = "br i1 %" + condVar + ", label %" + thenLabel + ", label %" + elseLabel
    codegenEmit(cg, line)

    cg.indent = cg.indent - 1
    codegenEmit(cg, thenLabel + ":")
    cg.indent = cg.indent + 1
}

/**
 * 生成 while 循环 IR
 */
函数 codegenWhile(cg: Codegen, condVar: 文本, bodyLabel: 文本, endLabel: 文本) {
    定义 可变 line: 文本
    line = "br i1 %" + condVar + ", label %" + bodyLabel + ", label %" + endLabel
    codegenEmit(cg, line)

    cg.indent = cg.indent - 1
    codegenEmit(cg, bodyLabel + ":")
    cg.indent = cg.indent + 1
}

/**
 * 生成 for 循环 IR
 */
函数 codegenFor(cg: Codegen, varName: 文本, startVal: 整数, endVal: 整数, bodyLabel: 文本, condLabel: 文本, endLabel: 文本) {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = add i64 0, " + 整数转文本(startVal)
    codegenEmit(cg, line)

    定义 可变 alloca: 文本
    alloca = varName + "_alloca"
    codegenEmit(cg, "%" + alloca + " = alloca i64")
    codegenEmit(cg, "store i64 %" + result + ", i64* %" + alloca)

    cg.indent = cg.indent - 1
    codegenEmit(cg, condLabel + ":")
    cg.indent = cg.indent + 1

    定义 可变 cmpResult: 文本
    cmpResult = codegenNewTemp(cg)
    line = "%" + cmpResult + " = icmp sle i64 %" + result + ", " + 整数转文本(endVal)
    codegenEmit(cg, line)
    line = "br i1 %" + cmpResult + ", label %" + bodyLabel + ", label %" + endLabel
    codegenEmit(cg, line)

    cg.indent = cg.indent - 1
    codegenEmit(cg, bodyLabel + ":")
    cg.indent = cg.indent + 1
}

/**
 * 生成 break 跳转 IR
 */
函数 codegenBreak(cg: Codegen, endLabel: 文本) {
    定义 可变 line: 文本
    line = "br label %" + endLabel
    codegenEmit(cg, line)
}

/**
 * 生成 continue 跳转 IR
 */
函数 codegenContinue(cg: Codegen, condLabel: 文本) {
    定义 可变 line: 文本
    line = "br label %" + condLabel
    codegenEmit(cg, line)
}

/**
 * 生成赋值 IR
 */
函数 codegenAssign(cg: Codegen, varName: 文本, value: 文本, varType: 文本) {
    定义 可变 llType: 文本
    llType = getLLVMType(varType)

    定义 可变 alloca: 文本
    alloca = varName + "_slot"

    定义 可变 line: 文本
    line = "%" + alloca + " = alloca " + llType
    codegenEmit(cg, line)

    line = "store " + llType + " %" + value + ", " + llType + "* %" + alloca
    codegenEmit(cg, line)
}

/**
 * 生成复合赋值 IR (+=, -=, *=, /=, %=)
 */
函数 codegenCompoundAssign(cg: Codegen, varName: 文本, op: 文本, value: 文本, varType: 文本): 文本 {
    定义 可变 llType: 文本
    llType = getLLVMType(varType)

    定义 可变 alloca: 文本
    alloca = varName + "_slot"

    定义 可变 line: 文本
    line = "%" + alloca + " = alloca " + llType
    codegenEmit(cg, line)

    定义 可变 llOp: 文本
    llOp = "add"

    若 op == "+=" 则 { llOp = "add" }
    若 op == "-=" 则 { llOp = "sub" }
    若 op == "*=" 则 { llOp = "mul" }
    若 op == "/=" 则 { llOp = "sdiv" }
    若 op == "%=" 则 { llOp = "srem" }

    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    line = "%" + result + " = " + llOp + " " + llType + " %" + value + ", %" + value
    codegenEmit(cg, line)

    line = "store " + llType + " %" + result + ", " + llType + "* %" + alloca
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成 return 语句 IR
 */
函数 codegenReturn(cg: Codegen, value: 文本) {
    定义 可变 line: 文本
    若 cg.currentReturnType == "void" 则 {
        line = "ret void"
    } 否则 {
        line = "ret i64 %" + value
    }
    codegenEmit(cg, line)
}

/**
 * 生成函数调用 IR
 */
函数 codegenCall(cg: Codegen, funcName: 文本, returnType: 文本): 文本 {
    定义 可变 result: 文本
    result = ""

    若 returnType != "void" 则 {
        定义 可变 tmp: 文本
        tmp = codegenNewTemp(cg)
        codegenEmit(cg, "%" + tmp + " = call " + returnType + " @" + funcName + "()")
        result = tmp
    } 否则 {
        codegenEmit(cg, "call " + returnType + " @" + funcName + "()")
    }

    返回 result
}

/**
 * 生成函数调用 IR（带参数）
 */
函数 codegenCallWithArgs(cg: Codegen, funcName: 文本, argCount: 整数, returnType: 文本): 文本 {
    定义 可变 result: 文本
    result = ""

    若 returnType != "void" 则 {
        定义 可变 tmp: 文本
        tmp = codegenNewTemp(cg)
        定义 可变 line: 文本
        line = "%" + tmp + " = call " + returnType + " @" + funcName + "("
        /* 简化：参数列表留空 */
        line = line + ")"
        codegenEmit(cg, line)
        result = tmp
    } 否则 {
        codegenEmit(cg, "call " + returnType + " @" + funcName + "()")
    }

    返回 result
}

/**
 * 生成字符串长度调用 IR
 */
函数 codegenStringLen(cg: Codegen, strPtr: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = call i64 @rt_string_len(i8* %" + strPtr + ")"
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成字符串拼接调用 IR
 */
函数 codegenStringConcat(cg: Codegen, str1: 文本, str2: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = call i8* @rt_string_concat(i8* %" + str1 + ", i8* %" + str2 + ")"
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成字符串切片调用 IR
 */
函数 codegenStringSlice(cg: Codegen, strPtr: 文本, start: 文本, end: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = call i8* @rt_string_slice(i8* %" + strPtr + ", i64 %" + start + ", i64 %" + end + ")"
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成列表创建调用 IR
 */
函数 codegenListNew(cg: Codegen): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = call i8* @rt_list_new()"
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成列表追加调用 IR
 */
函数 codegenListAppend(cg: Codegen, list: 文本, value: 文本): 无返回 {
    定义 可变 line: 文本
    line = "call void @rt_list_append(i8* %" + list + ", i8* %" + value + ")"
    codegenEmit(cg, line)
}

/**
 * 生成列表获取调用 IR
 */
函数 codegenListGet(cg: Codegen, list: 文本, index: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = call i8* @rt_list_get(i8* %" + list + ", i64 %" + index + ")"
    codegenEmit(cg, line)

    返回 result
}

/* ============ IR 生成函数 ============ */

/**
 * 生成模块头
 */
函数 emitModuleHeader(cg: Codegen, name: 文本) {
    codegenEmit(cg, "; ============================================")
    codegenEmit(cg, "; 玄语编译器 v0.2 - 自展版本")
    codegenEmit(cg, "; LLVM IR 生成")
    codegenEmit(cg, "; ============================================")
    codegenEmit(cg, "")
    codegenEmit(cg, "source_filename = \"" + name + "\"")
    codegenEmit(cg, "")
}

/**
 * 生成目标数据声明
 */
函数 emitTargetData(cg: Codegen) {
    codegenEmit(cg, "target datalayout = \"e-m:w-p64:64:64-i32:32-i64:64-i128:128-n32:64-S128\"")
    codegenEmit(cg, "target triple = \"x86_64-pc-windows-msvc\"")
    打印("")
}

/**
 * 生成函数头
 */
函数 emitFunctionHeader(cg: Codegen, name: 文本, paramCount: 整数, returnType: 文本): 文本 {
    定义 可变 llName: 文本
    llName = name

    定义 可变 line: 文本
    line = "define " + returnType + " @" + llName + "() {"

    codegenEmitLine(cg, line)

    cg.indent = cg.indent + 1
    返回 name
}

/**
 * 生成变量分配
 */
函数 emitAlloca(cg: Codegen, varName: 文本, typeName: 文本) {
    定义 可变 llType: 文本
    llType = getLLVMType(typeName)
    定义 可变 line: 文本
    line = "%" + varName + " = alloca " + llType
    codegenEmit(cg, line)
}

/**
 * 生成存储指令
 */
函数 emitStore(cg: Codegen, value: 文本, varName: 文本, typeName: 文本) {
    定义 可变 llType: 文本
    llType = getLLVMType(typeName)
    定义 可变 line: 文本
    line = "store " + llType + " %" + value + ", " + llType + "* %" + varName
    codegenEmit(cg, line)
}

/**
 * 生成加载指令
 */
函数 emitLoad(cg: Codegen, varName: 文本, typeName: 文本): 文本 {
    定义 可变 llType: 文本
    llType = getLLVMType(typeName)
    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    定义 可变 line: 文本
    line = "%" + result + " = load " + llType + ", " + llType + "* %" + varName
    codegenEmit(cg, line)
    返回 result
}

/**
 * 生成整数常量
 */
函数 emitIntegerLiteral(cg: Codegen, value: 整数): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    定义 可变 line: 文本
    line = "%" + result + " = add i64 0, " + 整数转文本(value)
    codegenEmit(cg, line)
    返回 result
}

/**
 * 生成字符串常量
 */
函数 emitStringLiteral(cg: Codegen, strValue: 文本): 文本 {
    定义 可变 constName: 文本
    constName = "str"
    定义 可变 idxStr: 文本
    idxStr = 整数转文本(cg.stringConstCount)
    constName = constName + idxStr
    cg.stringConstCount = cg.stringConstCount + 1

    定义 可变 line: 文本
    line = "@" + constName + " = private constant [" + 整数转文本(文本长度(strValue)) + " x i8] c\"" + strValue + "\\00\""
    codegenEmit(cg, line)

    定义 可变 ptrResult: 文本
    ptrResult = codegenNewTemp(cg)
    line = "%" + ptrResult + " = getelementptr [" + 整数转文本(文本长度(strValue)) + " x i8], [" + 整数转文本(文本长度(strValue)) + " x i8]* @" + constName + ", i64 0, i64 0"
    codegenEmit(cg, line)

    返回 ptrResult
}

/**
 * 生成二元运算
 */
函数 emitBinaryOp(cg: Codegen, op: 文本, left: 文本, right: 文本, leftType: 文本, rightType: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 llOp: 文本
    llOp = "+"
    若 op == "-" 则 { llOp = "sub" }
    若 op == "*" 则 { llOp = "mul" }
    若 op == "/" 则 { llOp = "sdiv" }
    若 op == "%" 则 { llOp = "srem" }

    定义 可变 llType: 文本
    llType = getLLVMType(leftType)

    定义 可变 line: 文本
    line = "%" + result + " = " + llOp + " " + llType + " %" + left + ", %" + right
    codegenEmit(cg, line)
    返回 result
}

/**
 * 生成比较指令
 */
函数 emitCompare(cg: Codegen, op: 文本, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 llOp: 文本
    llOp = "eq"
    若 op == ">" 则 { llOp = "sgt" }
    若 op == "<" 则 { llOp = "slt" }
    若 op == ">=" 则 { llOp = "sge" }
    若 op == "<=" 则 { llOp = "sle" }
    若 op == "!=" 则 { llOp = "ne" }

    定义 可变 line: 文本
    line = "%" + result + " = icmp " + llOp + " i64 %" + left + ", %" + right
    codegenEmit(cg, line)
    返回 result
}

/**
 * 生成条件分支
 */
函数 emitBr(cg: Codegen, condVar: 文本, thenLabel: 文本, elseLabel: 文本) {
    定义 可变 line: 文本
    line = "br i1 %" + condVar + ", label %" + thenLabel + ", label %" + elseLabel
    codegenEmit(cg, line)
}

/**
 * 生成无条件跳转
 */
函数 emitJump(cg: Codegen, labelName: 文本) {
    定义 可变 line: 文本
    line = "br label %" + labelName
    codegenEmit(cg, line)
}

/**
 * 生成标签
 */
函数 emitLabel(cg: Codegen, labelName: 文本) {
    cg.indent = cg.indent - 1
    定义 可变 line: 文本
    line = labelName + ":"
    codegenEmitLine(cg, line)
    cg.indent = cg.indent + 1
}

/**
 * 生成返回指令
 */
函数 emitReturn(cg: Codegen, valueName: 文本, returnType: 文本) {
    定义 可变 line: 文本
    若 returnType == "void" 则 {
        line = "ret void"
    } 否则 {
        line = "ret i64 %" + valueName
    }
    codegenEmit(cg, line)
}

/**
 * 生成函数调用
 */
函数 emitCall(cg: Codegen, funcName: 文本, argCount: 整数, returnType: 文本): 文本 {
    定义 可变 result: 文本
    result = ""

    若 returnType != "void" 则 {
        result = codegenNewTemp(cg)
        定义 可变 line: 文本
        line = "%" + result + " = call " + returnType + " @" + funcName + "()"
        codegenEmit(cg, line)
    } 否则 {
        codegenEmit(cg, "call " + returnType + " @" + funcName + "()")
    }

    返回 result
}

/* ============ 内置函数声明 ============ */

函数 emitBuiltinDecls(cg: Codegen) {
    codegenEmit(cg, "; ==================== 内置函数声明 ====================")
    codegenEmit(cg, "declare void @print(i8*)")
    codegenEmit(cg, "declare i64 @print_int(i64)")
    codegenEmit(cg, "declare double @print_float(double)")
    codegenEmit(cg, "declare i8* @print_string(i8*)")
    codegenEmit(cg, "declare i64 @str_to_int(i8*)")
    codegenEmit(cg, "declare double @_u6574_u6570_u8f6c_u6587_u672c_u90e8(i64)")
    codegenEmit(cg, "declare i64 @rt_string_len(i8*)")
    codegenEmit(cg, "declare i8* @rt_string_concat(i8*, i8*)")
    codegenEmit(cg, "declare i8* @rt_string_slice(i8*, i64, i64)")
    codegenEmit(cg, "declare i64 @argc()")
    codegenEmit(cg, "declare i8* @argv(i64)")
    codegenEmit(cg, "declare i8* @rt_readline()")
    codegenEmit(cg, "declare i8* @rt_list_new()")
    codegenEmit(cg, "declare void @rt_list_append(i8*, i8*)")
    codegenEmit(cg, "declare void @rt_list_set(i8*, i64, i8*)")
    codegenEmit(cg, "declare i8* @rt_list_get(i8*, i64)")
    codegenEmit(cg, "declare i64 @rt_list_len(i8*)")

    /* 文件 I/O 函数 */
    codegenEmit(cg, "declare i8* @file_read(i8*)")
    codegenEmit(cg, "declare i32 @file_write(i8*, i8*)")
    codegenEmit(cg, "declare i32 @file_exists(i8*)")
    codegenEmit(cg, "declare i32 @file_delete(i8*)")

    /* 命令执行函数 */
    codegenEmit(cg, "declare i32 @exec_cmd(i8*)")
    codegenEmit(cg, "declare i8* @cmd_output(i8*)")

    /* 输入函数 */
    codegenEmit(cg, "declare i64 @input_int()")
    codegenEmit(cg, "declare i8* @input_text()")

    /* 运行时初始化 */
    codegenEmit(cg, "declare void @init_args(i32, i8**)")

    codegenEmit(cg, "")
}

/* ============ 模块和导入支持 ============ */

/**
 * 生成模块声明
 */
函数 emitModuleDecl(cg: Codegen, moduleName: 文本) {
    定义 可变 line: 文本
    line = "; 模块: " + moduleName
    codegenEmit(cg, line)
}

/**
 * 生成导入声明
 */
函数 emitImportDecl(cg: Codegen, path: 文本) {
    定义 可变 line: 文本
    line = "; 导入: " + path
    codegenEmit(cg, line)
}

/**
 * 生成模块函数前缀
 */
函数 getModuleFuncName(moduleName: 文本, funcName: 文本): 文本 {
    若 moduleName == "" 则 {
        返回 funcName
    }
    返回 moduleName + "_" + funcName
}

/**
 * 生成外部函数声明
 */
函数 emitExternalFuncDecl(cg: Codegen, funcName: 文本, returnType: 文本, paramTypes: 列表) {
    定义 可变 line: 文本
    line = "declare " + returnType + " @" + funcName + "()"
    codegenEmit(cg, line)
}

/**
 * 生成模块入口标注
 */
函数 emitModuleEntry(cg: Codegen, moduleName: 文本): 无返回 {
    定义 可变 line: 文本
    line = "; 模块入口: " + moduleName
    codegenEmit(cg, line)
}

/**
 * 生成模块退出标注
 */
函数 emitModuleExit(cg: Codegen, moduleName: 文本): 无返回 {
    定义 可变 line: 文本
    line = "; 模块退出: " + moduleName
    codegenEmit(cg, line)
}

/* ============ 优化和提示 ============ */

/**
 * 生成优化级别标注
 */
函数 emitOptimizationHint(cg: Codegen, level: 整数): 无返回 {
    定义 可变 line: 文本
    line = "; llvm. opts: "
    若 level == 0 则 {
        line = line + "O0"
    } 否则 {
        若 level == 1 则 {
            line = line + "O1"
        } 否则 {
            若 level == 2 则 {
                line = line + "O2"
            } 否则 {
                若 level == 3 则 {
                    line = line + "O3"
                } 否则 {
                    line = line + "Os"
                }
            }
        }
    }
    codegenEmit(cg, line)
}

/**
 * 生成冷函数标注
 */
函数 emitColdFunctionHint(cg: Codegen): 无返回 {
    codegenEmit(cg, "; Function Attrs: cold")
    codegenEmit(cg, "; llvm.pure.const")
}

/**
 * 生成内联始终标注
 */
函数 emitAlwaysInlineHint(cg: Codegen): 无返回 {
    codegenEmit(cg, "; Function Attrs: alwaysinline")
}

/**
 * 生成无返回标注
 */
函数 emitNoReturnHint(cg: Codegen): 无返回 {
    codegenEmit(cg, "; Function Attrs: noreturn")
}

/**
 * 生成只读标注
 */
函数 emitReadOnlyHint(cg: Codegen): 无返回 {
    codegenEmit(cg, "; Function Attrs: readnone")
}

/**
 * 生成纯函数标注
 */
函数 emitPureFunctionHint(cg: Codegen): 无返回 {
    codegenEmit(cg, "; Function Attrs: readonly")
}

/**
 * 生成热点函数标注
 */
函数 emitHotFunctionHint(cg: Codegen): 无返回 {
    codegenEmit(cg, "; Function Attrs: hot")
}

/**
 * 生成内存访问模式标注
 */
函数 emitAlignmentHint(cg: Codegen, alignment: 整数): 无返回 {
    定义 可变 line: 文本
    line = "; Memory['"
    line = line + 整数转文本(alignment)
    line = line + "']"
    codegenEmit(cg, line)
}

/**
 * 生成向量宽度提示
 */
函数 emitVectorWidthHint(cg: Codegen, width: 整数): 无返回 {
    若 width > 1 则 {
        定义 可变 line: 文本
        line = "; Vector['"
        line = line + 整数转文本(width)
        line = line + "']"
        codegenEmit(cg, line)
    }
}

/**
 * 生成窥孔优化提示
 */
函数 emitPeepholeHint(cg: Codegen): 无返回 {
    codegenEmit(cg, "; Tails duplicated")
}

/* ============ 调试信息生成 ============ */

/**
 * 生成源文件信息
 */
函数 emitSourceFile(cg: Codegen, filename: 文本): 无返回 {
    定义 可变 line: 文本
    line = "source_filename = \"" + filename + "\""
    codegenEmit(cg, line)
}

/**
 * 生成目标数据布局
 */
函数 emitDataLayout(cg: Codegen, layout: 文本): 无返回 {
    定义 可变 line: 文本
    line = "target datalayout = \"" + layout + "\""
    codegenEmit(cg, line)
}

/**
 * 生成目标三元组
 */
函数 emitTargetTriple(cg: Codegen, triple: 文本): 无返回 {
    定义 可变 line: 文本
    line = "target triple = \"" + triple + "\""
    codegenEmit(cg, line)
}

/**
 * 生成调试版本
 */
函数 emitDwarfVersion(cg: Codegen, version: 整数): 无返回 {
    定义 可变 line: 文本
    line = "!llvm.module.flags = !{!0}"
    codegenEmit(cg, line)
    line = "!0 = !{i32 2, !\"Dwarf Version\", i32 " + 整数转文本(version) + "}"
    codegenEmit(cg, line)
}

/* ============ SIMD 和向量化支持 ============ */

/**
 * 生成向量相加 IR
 */
函数 codegenVectorAdd(cg: Codegen, lhs: 文本, rhs: 文本, width: 整数): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = add <" + 整数转文本(width) + " x i64> %" + lhs + ", %" + rhs
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成向量广播 IR
 */
函数 codegenVectorBroadcast(cg: Codegen, value: 文本, width: 整数): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = insertelement <" + 整数转文本(width) + " x i64> undef, i64 %" + value + ", i32 0"
    codegenEmit(cg, line)

    返回 result
}

/* ============ 异常处理支持 ============ */

/**
 * 生成异常抛出 IR
 */
函数 codegenThrow(cg: Codegen, exceptionType: 文本, message: 文本): 无返回 {
    定义 可变 line: 文本
    line = "call void @llvm.trap()"
    codegenEmit(cg, line)
}

/**
 * 生成异常捕获 IR
 */
函数 codegenCatch(cg: Codegen, handlerLabel: 文本): 无返回 {
    定义 可变 line: 文本
    line = "br label %" + handlerLabel
    codegenEmit(cg, line)
}

/**
 * 生成清理块 IR
 */
函数 codegenCleanup(cg: Codegen): 无返回 {
    codegenEmit(cg, "; 清理块")
}

/* ============ 内存模型支持 ============ */

/**
 * 生成内存屏障 IR
 */
函数 codegenMemoryBarrier(cg: Codegen): 无返回 {
    codegenEmit(cg, "call void @llvm.mem fence(i8 1)")
}

/**
 * 生成 volatile 加载 IR
 */
函数 codegenVolatileLoad(cg: Codegen, tmpPtr: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = load volatile i64, i64* %" + tmpPtr
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成 volatile 存储 IR
 */
函数 codegenVolatileStore(cg: Codegen, value: 文本, tmpPtr: 文本): 无返回 {
    定义 可变 line: 文本
    line = "store volatile i64 %" + value + ", i64* %" + tmpPtr
    codegenEmit(cg, line)
}

/* ============ 链接器和符号支持 ============ */

/**
 * 生成外部符号引用
 */
函数 emitExternalSymbol(cg: Codegen, name: 文本, 类型: 文本): 无返回 {
    定义 可变 line: 文本
    line = "@" + name + " = external " + 类型
    codegenEmit(cg, line)
}

/**
 * 生成全局符号定义
 */
函数 emitGlobalSymbol(cg: Codegen, name: 文本, 类型: 文本, value: 文本): 无返回 {
    定义 可变 line: 文本
    line = "@" + name + " = global " + 类型 + " " + value
    codegenEmit(cg, line)
}

/**
 * 生成弱符号定义
 */
函数 emitWeakSymbol(cg: Codegen, name: 文本, 类型: 文本): 无返回 {
    定义 可变 line: 文本
    line = "@" + name + " = weak " + 类型
    codegenEmit(cg, line)
}

/* ============ 属性标注 ============ */

/**
 * 生成函数属性
 */
函数 emitFunctionAttrs(cg: Codegen, attrs: 文本): 无返回 {
    定义 可变 line: 文本
    line = "; Function Attrs: " + attrs
    codegenEmit(cg, line)
}

/**
 * 生成 noinline 属性
 */
函数 emitNoInlineAttr(cg: Codegen): 无返回 {
    codegenEmit(cg, "; Function Attrs: noinline")
}

/**
 * 生成 alwaysinline 属性
 */
函数 emitAlwaysInlineAttr(cg: Codegen): 无返回 {
    codegenEmit(cg, "; Function Attrs: alwaysinline")
}

/**
 * 生成 cold 属性
 */
函数 emitColdAttr(cg: Codegen): 无返回 {
    codegenEmit(cg, "; Function Attrs: cold")
}

/**
 * 生成 returns_twice 属性
 */
函数 emitReturnsTwiceAttr(cg: Codegen): 无返回 {
    codegenEmit(cg, "; Function Attrs: returns_twice")
}

/**
 * 生成 noreturn 属性
 */
函数 emitNoReturnAttr(cg: Codegen): 无返回 {
    codegenEmit(cg, "; Function Attrs: noreturn")
}

/**
 * 生成 nounwind 属性
 */
函数 emitNoUnwindAttr(cg: Codegen): 无返回 {
    codegenEmit(cg, "; Function Attrs: nounwind")
}

/**
 * 生成 readonly 属性
 */
函数 emitReadOnlyAttr(cg: Codegen): 无返回 {
    codegenEmit(cg, "; Function Attrs: readonly")
}

/**
 * 生成 readnone 属性
 */
函数 emitReadNoneAttr(cg: Codegen): 无返回 {
    codegenEmit(cg, "; Function Attrs: readnone")
}

/* ============ 元数据 ============ */

/**
 * 生成调试位置
 */
函数 emitDebugLocation(cg: Codegen, line: 整数, col: 整数): 无返回 {
    定义 可变 debugStr: 文本
    debugStr = "!DILocation(line: " + 整数转文本(line) + ", column: " + 整数转文本(col) + ")"
    codegenEmit(cg, debugStr)
}

/**
 * 生成调试变量
 */
函数 emitDebugVariable(cg: Codegen, name: 文本, type: 文本): 无返回 {
    定义 可变 line: 文本
    line = "!DILocalVariable(name: \"" + name + "\", type: !" + type + ")"
    codegenEmit(cg, line)
}

/**
 * 生成行号标注
 */
函数 emitLineNumber(cg: Codegen, line: 整数): 无返回 {
    定义 可变 lineStr: 文本
    lineStr = "; 行号: " + 整数转文本(line)
    codegenEmit(cg, lineStr)
}

/* ============ 主函数 ============ */

/**
 * 生成完整的函数 IR
 */
函数 emitFunction(cg: Codegen, funcName: 文本, returnType: 文本, nodeCount: 整数) {
    codegenEmit(cg, "")
    codegenEmit(cg, "define " + returnType + " @" + funcName + "() {")

    cg.indent = cg.indent + 1
    cg.currentFunc = funcName
    cg.currentReturnType = returnType

    /* 变量分配 */
    codegenEmit(cg, "%result = alloca i64")

    /* 函数体 - 根据函数名生成不同 IR */

    若 funcName == "主" 则 {
        /* 主函数: 返回 0 */
        codegenEmit(cg, "%tmp0 = add i64 0, 0")
        codegenEmit(cg, "ret i64 %tmp0")
    } 否则 {
        /* 默认返回 0 */
        codegenEmit(cg, "%tmp0 = add i64 0, 0")
        codegenEmit(cg, "ret i64 %tmp0")
    }

    cg.indent = cg.indent - 1
    codegenEmit(cg, "}")
}

/**
 * 生成 main 函数包装
 */
函数 emitMainWrapper(cg: Codegen) {
    codegenEmit(cg, "")
    codegenEmit(cg, "define i32 @main(i32 %argc, i8** %argv) {")
    cg.indent = 1

    codegenEmit(cg, "call void @init_args(i32 %argc, i8** %argv)")

    定义 可变 result: 文本
    result = codegenNewTemp(cg)
    codegenEmit(cg, "%" + result + " = call i64 @xy_main()")
    定义 可变 truncVal: 文本
    truncVal = codegenNewTemp(cg)
    codegenEmit(cg, "%" + truncVal + " = trunc i64 %" + result + " to i32")

    codegenEmit(cg, "ret i32 %" + truncVal)
    codegenEmit(cg, "}")
}

/* ============ AST 遍历和语句生成 ============ */

/**
 * 生成表达式 IR
 */
函数 codegen生成表达式(cg: Codegen, exprKind: 整数, value: 文本, left: 文本, right: 文本): 文本 {
    定义 可变 result: 文本
    result = ""

    若 exprKind == 10 则 {
        /* 二元表达式 */
        定义 可变 llOp: 文本
        llOp = "add"
        若 value == "-" 则 { llOp = "sub" }
        若 value == "*" 则 { llOp = "mul" }
        若 value == "/" 则 { llOp = "sdiv" }
        若 value == "%" 则 { llOp = "srem" }

        result = codegenNewTemp(cg)
        定义 可变 line: 文本
        line = "%" + result + " = " + llOp + " i64 %" + left + ", %" + right
        codegenEmit(cg, line)
    } 否则 {
        若 exprKind == 14 则 {
            /* 字面量 */
            result = codegenNewTemp(cg)
            定义 可变 line: 文本
            line = "%" + result + " = add i64 0, " + value
            codegenEmit(cg, line)
        } 否则 {
            若 exprKind == 13 则 {
                /* 标识符 - 加载变量 */
                result = codegenNewTemp(cg)
                定义 可变 line: 文本
                line = "%" + result + " = load i64, i64* %" + value
                codegenEmit(cg, line)
            }
        }
    }

    返回 result
}

/**
 * 生成变量分配
 */
函数 codegen生成变量(cg: Codegen, varName: 文本, typeName: 文本): 文本 {
    定义 可变 tmpPtr: 文本
    tmpPtr = varName + "_slot"

    定义 可变 line: 文本
    line = "%" + tmpPtr + " = alloca " + getLLVMType(typeName)
    codegenEmit(cg, line)

    返回 tmpPtr
}

/**
 * 生成赋值语句
 */
函数 codegen生成赋值(cg: Codegen, varName: 文本, value: 文本, varType: 文本): 无返回 {
    定义 可变 tmpPtr: 文本
    tmpPtr = varName + "_slot"

    定义 可变 line: 文本
    line = "store " + getLLVMType(varType) + " %" + value + ", " + getLLVMType(varType) + "* %" + tmpPtr
    codegenEmit(cg, line)
}

/**
 * 生成 if 语句
 */
函数 codegen生成If(cg: Codegen, condVar: 文本, thenLabel: 文本, elseLabel: 文本, endLabel: 文本): 无返回 {
    定义 可变 line: 文本
    line = "br i1 %" + condVar + ", label %" + thenLabel + ", label %" + elseLabel
    codegenEmit(cg, line)

    cg.indent = cg.indent - 1
    codegenEmit(cg, thenLabel + ":")
    cg.indent = cg.indent + 1
}

/**
 * 生成 while 循环
 */
函数 codegen生成While(cg: Codegen, condVar: 文本, bodyLabel: 文本, endLabel: 文本): 无返回 {
    定义 可变 line: 文本
    line = "br i1 %" + condVar + ", label %" + bodyLabel + ", label %" + endLabel
    codegenEmit(cg, line)

    cg.indent = cg.indent - 1
    codegenEmit(cg, bodyLabel + ":")
    cg.indent = cg.indent + 1
}

/**
 * 生成 for 循环
 */
函数 codegen生成For(cg: Codegen, varName: 文本, startVal: 整数, endVal: 整数): 无返回 {
    定义 可变 iterVar: 文本
    iterVar = codegen生成变量(cg, varName, "整数")

    定义 可变 startTmp: 文本
    startTmp = codegenNewTemp(cg)
    定义 可变 line: 文本
    line = "%" + startTmp + " = add i64 0, " + 整数转文本(startVal)
    codegenEmit(cg, line)
    line = "store i64 %" + startTmp + ", i64* %" + iterVar
    codegenEmit(cg, line)
}

/**
 * 生成返回语句
 */
函数 codegen生成返回(cg: Codegen, value: 文本, returnType: 文本): 无返回 {
    定义 可变 line: 文本
    若 returnType == "void" 则 {
        line = "ret void"
    } 否则 {
        line = "ret i64 %" + value
    }
    codegenEmit(cg, line)
}

/**
 * 生成函数调用（带参数）
 */
函数 codegen生成调用(cg: Codegen, funcName: 文本, argCount: 整数, returnType: 文本): 文本 {
    定义 可变 result: 文本
    result = ""

    若 returnType != "void" 则 {
        定义 可变 tmp: 文本
        tmp = codegenNewTemp(cg)
        定义 可变 line: 文本
        line = "%" + tmp + " = call " + returnType + " @" + funcName + "()"
        codegenEmit(cg, line)
        result = tmp
    } 否则 {
        codegenEmit(cg, "call " + returnType + " @" + funcName + "()")
    }

    返回 result
}

/**
 * 生成比较表达式并跳转
 */
函数 codegen生成条件跳转(cg: Codegen, op: 文本, left: 文本, right: 文本, trueLabel: 文本, falseLabel: 文本): 无返回 {
    定义 可变 cmpResult: 文本
    cmpResult = codegenNewTemp(cg)

    定义 可变 llOp: 文本
    llOp = "eq"
    若 op == ">" 则 { llOp = "sgt" }
    若 op == "<" 则 { llOp = "slt" }
    若 op == ">=" 则 { llOp = "sge" }
    若 op == "<=" 则 { llOp = "sle" }
    若 op == "!=" 则 { llOp = "ne" }

    定义 可变 line: 文本
    line = "%" + cmpResult + " = icmp " + llOp + " i64 %" + left + ", %" + right
    codegenEmit(cg, line)

    line = "br i1 %" + cmpResult + ", label %" + trueLabel + ", label %" + falseLabel
    codegenEmit(cg, line)
}

/**
 * 生成 break 语句
 */
函数 codegen生成Break(cg: Codegen, endLabel: 文本): 无返回 {
    定义 可变 line: 文本
    line = "br label %" + endLabel
    codegenEmit(cg, line)
}

/**
 * 生成 continue 语句
 */
函数 codegen生成Continue(cg: Codegen, condLabel: 文本): 无返回 {
    定义 可变 line: 文本
    line = "br label %" + condLabel
    codegenEmit(cg, line)
}

/**
 * 生成打印调用
 */
函数 codegen生成打印(cg: Codegen, value: 文本, valueType: 文本): 无返回 {
    定义 可变 line: 文本
    若 valueType == "i64" 则 {
        line = "call void @print_int(i64 %" + value + ")"
    } 否则 {
        若 valueType == "i8*" 则 {
            line = "call void @print(i8* %" + value + ")"
        }
    }
    codegenEmit(cg, line)
}

/**
 * 生成输入调用
 */
函数 codegen生成输入(cg: Codegen, inputType: 文本): 文本 {
    定义 可变 result: 文本
    result = ""

    定义 可变 tmp: 文本
    tmp = codegenNewTemp(cg)

    定义 可变 line: 文本
    若 inputType == "i64" 则 {
        line = "%" + tmp + " = call i64 @str_to_int(i8* @rt_readline())"
        codegenEmit(cg, line)
        result = tmp
    } 否则 {
        若 inputType == "i8*" 则 {
            line = "%" + tmp + " = call i8* @rt_readline()"
            codegenEmit(cg, line)
            result = tmp
        }
    }

    返回 result
}

/**
 * 生成列表创建
 */
函数 codegen生成列表创建(cg: Codegen): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = call i8* @rt_list_new()"
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成列表追加
 */
函数 codegen生成列表追加(cg: Codegen, list: 文本, value: 文本): 无返回 {
    定义 可变 line: 文本
    line = "call void @rt_list_append(i8* %" + list + ", i8* %" + value + ")"
    codegenEmit(cg, line)
}

/**
 * 生成列表获取
 */
函数 codegen生成列表获取(cg: Codegen, list: 文本, index: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = call i8* @rt_list_get(i8* %" + list + ", i64 %" + index + ")"
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成字符串长度
 */
函数 codegen生成字符串长度(cg: Codegen, strPtr: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = call i64 @rt_string_len(i8* %" + strPtr + ")"
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成字符串拼接
 */
函数 codegen生成字符串拼接(cg: Codegen, str1: 文本, str2: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = call i8* @rt_string_concat(i8* %" + str1 + ", i8* %" + str2 + ")"
    codegenEmit(cg, line)

    返回 result
}

/**
 * 执行代码生成
 */
函数 codegenRun(astNodeCount: 整数): 整数 {
    打印("=== 代码生成 ===")

    定义 可变 cg: Codegen
    cg = codegenInit()

    /* 生成模块头 */
    emitModuleHeader(cg, "xuanyu_source")

    /* 生成目标数据 */
    emitTargetData(cg)

    /* 生成内置函数声明 */
    emitBuiltinDecls(cg)

    /* 生成用户函数 */
    打印("; ==================== 用户函数 ====================")
    emitFunction(cg, "主", "i64", 10)

    /* 生成 main 包装 */
    emitMainWrapper(cg)

    打印("")
    打印("代码生成完成!")

    返回 1
}

/* ============ 高级 IR 生成函数 ============ */

/**
 * 生成结构体字面量 IR
 */
函数 codegenStructLiteral(cg: Codegen, structName: 文本, fieldCount: 整数): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = alloca %" + structName
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成空联合 IR
 */
函数 codegenZeroInit(cg: Codegen, typeName: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = bitcast " + typeName + " null to " + typeName
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成条件选择 IR (使用 select)
 */
函数 codegenSelectOp(cg: Codegen, cond: 文本, trueVal: 文本, falseVal: 文本, resultType: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = select i1 %" + cond + ", " + resultType + " %" + trueVal + ", " + resultType + " %" + falseVal
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成 freeze IR (固定值)
 */
函数 codegenFreeze(cg: Codegen, value: 文本, valueType: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = freeze " + valueType + " %" + value
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成 extractvalue IR (从聚合值提取)
 */
函数 codegenExtractValue(cg: Codegen, aggregate: 文本, index: 整数, aggregateType: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = extractvalue " + aggregateType + " %" + aggregate + ", " + 整数转文本(index)
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成 insertvalue IR (向聚合值插入)
 */
函数 codegenInsertValue(cg: Codegen, aggregate: 文本, value: 文本, index: 整数, aggregateType: 文本, valueType: 文本): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = insertvalue " + aggregateType + " %" + aggregate + ", " + valueType + " %" + value + ", " + 整数转文本(index)
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成 extractelement IR (从向量提取元素)
 */
函数 codegenExtractElement(cg: Codegen, vector: 文本, index: 文本, vectorWidth: 整数): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = extractelement <" + 整数转文本(vectorWidth) + " x i64> %" + vector + ", i64 %" + index
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成 insertelement IR (向向量插入元素)
 */
函数 codegenInsertElement(cg: Codegen, vector: 文本, value: 文本, index: 文本, vectorWidth: 整数): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = insertelement <" + 整数转文本(vectorWidth) + " x i64> %" + vector + ", i64 %" + value + ", i64 %" + index
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成 shufflevector IR (向量混洗)
 */
函数 codegenShuffleVector(cg: Codegen, v1: 文本, v2: 文本, mask: 文本, width: 整数): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = shufflevector <" + 整数转文本(width) + " x i64> %" + v1 + ", <" + 整数转文本(width) + " x i64> %" + v2 + ", <" + 整数转文本(width) + " x i32> %" + mask
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成 icmp 并转换为整数 IR
 */
函数 codegenIcmpToInt(cg: Codegen, op: 文本, left: 文本, right: 文本): 文本 {
    定义 可变 cmpResult: 文本
    cmpResult = codegenCompare(cg, op, left, right)

    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = zext i1 %" + cmpResult + " to i64"
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成快速调用 IR (无返回值的调用)
 */
函数 codegenFastCall(cg: Codegen, funcName: 文本): 无返回 {
    codegenEmit(cg, "call void @" + funcName + "()")
}

/**
 * 生成 tail 调用提示 IR
 */
函数 codegenTailCallHint(cg: Codegen): 无返回 {
    codegenEmit(cg, "; tail call hint")
}

/**
 * 生成 musttail 调用提示 IR
 */
函数 codegenMustTailCall(cg: Codegen): 无返回 {
    codegenEmit(cg, "; musttail call")
}

/**
 * 生成捕获异常 IR
 */
函数 codegenCatchSwitch(cg: Codegen, parentPad: 文本, defaultLabel: 文本, numHandlers: 整数): 文本 {
    定义 可变 result: 文本
    result = codegenNewTemp(cg)

    定义 可变 line: 文本
    line = "%" + result + " = catchswitch within %" + parentPad + " [label %" + defaultLabel + "] to label %" + defaultLabel
    codegenEmit(cg, line)

    返回 result
}

/**
 * 生成清理返回 IR
 */
函数 codegenCleanupRet(cg: Codegen, catchPad: 文本, targetLabel: 文本): 无返回 {
    定义 可变 line: 文本
    line = "cleanupret from %" + catchPad + " unwind label %" + targetLabel
    codegenEmit(cg, line)
}

/**
 * 生成分支权重元数据
 */
函数 emitBranchWeights(cg: Codegen, trueWeight: 整数, falseWeight: 整数): 无返回 {
    定义 可变 line: 文本
    line = "!prof !{i64 " + 整数转文本(trueWeight) + ", i64 " + 整数转文本(falseWeight) + "}"
    codegenEmit(cg, line)
}

