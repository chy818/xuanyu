    若 text == "expand" 则 { 返回 1 }

    /* ========== 复合数据类型 (英文别名) ========== */
    若 text == "struct" 则 { 返回 1 }
    若 text == "enum" 则 { 返回 1 }
    若 text == "union" 则 { 返回 1 }
    若 text == "type" 则 { 返回 1 }

    /* ========== 任意类型 (英文别名) ========== */
    若 text == "Any" 则 { 返回 1 }

    返回 0
}

/* ============ 字符串切片函数 ============ */

/**
 * 提取子字符串
 * 使用运行时函数文本切片
 */
函数 提取子串(源码: 文本, 开始: 整数, 结束: 整数): 文本 {
    定义 可变 结果: 文本
/*[DBG]     打印("DEBUG 提取子串: 开始=") */
/*[DBG]     打印整数(开始) */
/*[DBG]     打印(" 结束=") */
/*[DBG]     打印整数(结束) */
    结果 = 文本切片(源码, 开始, 结束)
    返回 结果
}

/* ============ Lexer 核心函数 ============ */

/**
 * 获取字符
 */
函数 获取字符(lex: Lexer): 整数 {
    若 lex.位置 < lex.长度 则 {
        定义 可变 ch: 整数
        ch = 字符编码(文本获取字符(lex.源码, lex.位置))
        返回 ch
    }
    返回 0
}

/**
 * 初始化词法分析器
 */
函数 lexerInit(源码: 文本, 长度: 整数): Lexer {
    定义 可变 lex: Lexer
    lex.源码 = 源码
    lex.位置 = 0
    lex.长度 = 长度
/*[DBG]     打印("DEBUG lexerInit: 源码长度=") */
/*[DBG]     打印整数(lex.长度) */
/*[DBG]     打印("\n") */
    lex.行号 = 1
    lex.列号 = 1
    lex.开始位置 = 0
    lex.当前位置 = 0
/*[DBG]     打印("DEBUG lexerInit: 调用获取字符\n") */
    lex.当前字符 = 获取字符(lex)
/*[DBG]     打印("DEBUG lexerInit: 当前字符=") */
/*[DBG]     打印整数(lex.当前字符) */
/*[DBG]     打印("\n") */
    返回 lex
}

/**
 * 前进到下一个字符（支持UTF-8多字节字符）
 */
函数 lexer前进(lex: Lexer): Lexer {
    定义 可变 步长: 整数
    步长 = utf8字节长度(lex.当前字符)

    lex.位置 = lex.位置 + 步长
    lex.列号 = lex.列号 + 1

    若 lex.位置 < lex.长度 则 {
        lex.当前字符 = 字符编码(文本获取字符(lex.源码, lex.位置))
    } 否则 {
        lex.当前字符 = 0
    }

    若 lex.当前字符 == 10 则 {
        lex.行号 = lex.行号 + 1
        lex.列号 = 1
    }

    返回 lex
}

/**
 * 跳过空白字符
 */
函数 lexer跳过空白(lex: Lexer): Lexer {
    当 是空白(lex.当前字符) == 1 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }
    lex.开始位置 = lex.位置
    返回 lex
}

/**
 * 读取注释
 */
函数 lexer读取注释(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 7  // 注释
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    // 检查是 // 还是 /*
    若 lex.当前字符 == 47 则 {  // /
        定义 可变 nextCh: 整数
        nextCh = 0
        若 lex.位置 + 1 < lex.长度 则 {
            nextCh = 字符编码(文本获取字符(lex.源码, lex.位置 + 1))
        }

        若 nextCh == 47 则 {
            // 单行注释 // ... 一直到换行
            当 lex.当前字符 != 10 && lex.当前字符 != 0 则 {
                lex = lexer前进(lex)
            }
        } 否则 {
            若 nextCh == 42 则 {
                // 多行注释 /* ... */
                lex = lexer前进(lex)  // 跳过 /
                lex = lexer前进(lex)  // 跳过 *
                当 lex.当前字符 != 0 则 {
                    // 检查是否到达文件末尾，避免越界访问
                    若 lex.位置 + 1 >= lex.长度 则 {
                        跳出
                    }
                    若 lex.当前字符 == 42 && 字符编码(文本获取字符(lex.源码, lex.位置 + 1)) == 47 则 {
                        lex = lexer前进(lex)  // 跳过 *
                        lex = lexer前进(lex)  // 跳过 /
                        跳出
                    }
                    lex = lexer前进(lex)
                }
            } 否则 {
                // 单独的 / 是除法运算符，不是注释
                lex = lexer前进(lex)
                tok.类型 = 4  // 运算符
            }
        }
    }

    tok.结束位置 = lex.位置

    // 提取注释内容
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    lex.当前token = tok
    返回 lex
}

/**
 * 读取字符字面量
 */
函数 lexer读取字符(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 8  // 字符
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    // 跳过开始的单引号
    lex = lexer前进(lex)

    // 读取字符内容（支持转义）
    若 lex.当前字符 == 92 则 {  // 反斜杠 \
        lex = lexer前进(lex)  // 跳过反斜杠
        // 处理转义字符
        若 lex.当前字符 == 110 则 {  // \n
            lex = lexer前进(lex)
        } 否则 {
            若 lex.当前字符 == 116 则 {  // \t
                lex = lexer前进(lex)
            } 否则 {
                若 lex.当前字符 == 92 则 {  // \\
                    lex = lexer前进(lex)
                } 否则 {
                    若 lex.当前字符 == 39 则 {  // \'
                        lex = lexer前进(lex)
                    }
                }
            }
        }
    } 否则 {
        若 lex.当前字符 != 39 && lex.当前字符 != 0 则 {
            lex = lexer前进(lex)
        }
    }

    // 跳过结束的单引号
    若 lex.当前字符 == 39 则 {
        lex = lexer前进(lex)
    }

    tok.结束位置 = lex.位置

    // 提取字符值（包括引号）
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    lex.当前token = tok
    返回 lex
}

/**
 * 读取复合运算符（==, !=, <=, >=, &&, ||）
 */
函数 lexer读取复合运算符(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 10  // 比较
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    定义 可变 firstCh: 整数
    firstCh = lex.当前字符

    lex = lexer前进(lex)
    定义 可变 nextCh: 整数
    nextCh = lex.当前字符

    定义 可变 op: 文本
    op = ""

    // 双字符运算符
    若 firstCh == 61 && nextCh == 61 则 {
        op = "=="
        lex = lexer前进(lex)
    } 否则 {
        若 firstCh == 33 && nextCh == 61 则 {
            op = "!="
            lex = lexer前进(lex)
        } 否则 {
            若 firstCh == 60 && nextCh == 61 则 {
                op = "<="
                lex = lexer前进(lex)
            } 否则 {
                若 firstCh == 62 && nextCh == 61 则 {
                    op = ">="
                    lex = lexer前进(lex)
                } 否则 {
                    若 firstCh == 38 && nextCh == 38 则 {
                        op = "&&"
                        tok.类型 = 11  // 逻辑
                        lex = lexer前进(lex)
                    } 否则 {
                        若 firstCh == 124 && nextCh == 124 则 {
                            op = "||"
                            tok.类型 = 11  // 逻辑
                            lex = lexer前进(lex)
                        } 否则 {
                            // 单字符运算符
                            若 firstCh == 61 则 { op = "=" }
                            若 firstCh == 60 则 { op = "<" }
                            若 firstCh == 62 则 { op = ">" }
                            若 firstCh == 33 则 { op = "!" }
                        }
                    }
                }
            }
        }
    }

    tok.结束位置 = lex.位置
    tok.值 = op

    lex.当前token = tok
    返回 lex
}

/**
 * 读取标识符或关键字
 */
函数 lexer读取标识符(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 0
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    当 是字母或数字(lex.当前字符) == 1 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }

    tok.结束位置 = lex.位置

    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    若 是关键字(提取的值) == 1 则 {
        tok.类型 = 3
    }

    lex.当前token = tok
    返回 lex
}

/**
 * 读取数字
 */
函数 lexer读取数字(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 1
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    当 是数字(lex.当前字符) == 1 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }

    tok.结束位置 = lex.位置

    // 使用文本切片提取实际 token 值
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    lex.当前token = tok
    返回 lex
}

/**
 * 读取字符串
 */
函数 lexer读取字符串(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 2
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    // 跳过开始的双引号
    lex = lexer前进(lex)

    当 lex.当前字符 != 34 && lex.当前字符 != 0 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }

    若 lex.当前字符 == 34 则 {
        lex = lexer前进(lex)
    }

    tok.结束位置 = lex.位置

    // 使用文本切片提取实际 token 值（包括引号）
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    lex.当前token = tok
    返回 lex
}

/**
 * 读取运算符
 */
函数 lexer读取运算符(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 4
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    当 是运算符(lex.当前字符) == 1 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }

    tok.结束位置 = lex.位置

    // 使用文本切片提取实际 token 值
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    lex.当前token = tok
    返回 lex
}

/**
 * 读取符号
 */
函数 lexer读取符号(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 5
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始
    tok.结束位置 = lex.位置 + 1

    定义 可变 结束位置: 整数
    结束位置 = lex.位置 + 1
    若 结束位置 > lex.长度 则 {
        结束位置 = lex.长度
    }

    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, 结束位置)
    tok.值 = 提取的值

    lex = lexer前进(lex)

    lex.当前token = tok
    返回 lex
}

/**
 * 读取下一个 Token
 * 返回更新后的 Lexer（token存储在 lex.当前token 中）
 */
函数 lexerNextToken(lex: Lexer): Lexer {
    定义 可变 tok: Token
    tok.类型 = 6
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = lex.位置
    tok.结束位置 = lex.位置

/*[DBG]     打印("DEBUG lexerNextToken: 位置=") */
/*[DBG]     打印整数(lex.位置) */
/*[DBG]     打印(" 长度=") */
/*[DBG]     打印整数(lex.长度) */
/*[DBG]     打印(" 当前字符=") */
/*[DBG]     打印整数(lex.当前字符) */
/*[DBG]     打印("\n") */

    lex = lexer跳过空白(lex)

    定义 可变 ch: 整数
    ch = lex.当前字符

    tok.开始位置 = lex.开始位置
    tok.行号 = lex.行号
    tok.列号 = lex.列号

    // 文件结束
    若 ch == 0 则 {
        tok.类型 = 6
        tok.值 = "EOF"
        lex.当前token = tok
        返回 lex
    }

    // 字符串
    若 ch == 34 则 {
        lex = lexer读取字符串(lex)
        返回 lex
    }

    // 字符字面量
    若 ch == 39 则 {
        lex = lexer读取字符(lex)
        返回 lex
    }

    // 注释
    若 ch == 47 则 {
        定义 可变 nextCh: 整数
        nextCh = 0
        若 lex.位置 + 1 < lex.长度 则 {
            nextCh = 字符编码(文本获取字符(lex.源码, lex.位置 + 1))
        }
        若 nextCh == 47 || nextCh == 42 则 {
            lex = lexer读取注释(lex)
            返回 lex
        }
    }

    // 复合运算符 (==, !=, <=, >=, &&, ||)
    若 是比较起始(ch) == 1 则 {
        lex = lexer读取复合运算符(lex)
        返回 lex
    }

    // 字母开头 -> 标识符或关键字
    若 是字母(ch) == 1 则 {
        lex = lexer读取标识符(lex)
        返回 lex
    }

    // 数字开头 -> 数字
    若 是数字(ch) == 1 则 {
        lex = lexer读取数字(lex)
        返回 lex
    }

    // 单字符运算符 (+, -, *, /, %, etc.)
    若 是运算符(ch) == 1 则 {
        lex = lexer读取运算符(lex)
        返回 lex
    }

    // 符号
    若 是符号(ch) == 1 则 {
        lex = lexer读取符号(lex)
        返回 lex
    }

    // 未知字符
    lex = lexer前进(lex)
    tok.类型 = 12
    tok.值 = "UNKNOWN"
    tok.结束位置 = lex.位置
    lex.当前token = tok
    返回 lex
}

/* ============ 错误恢复和优化 ============ */

/**
 * 报告词法错误
 */
函数 lexer报告错误(lex: Lexer, 消息: 文本): 无返回 {
    打印("词法错误 (行")
    打印(lex.行号)
    打印(", 列")
    打印(lex.列号)
    打印("): ")
    打印(消息)
}

/**
 * 跳过到下一行
 */
函数 lexer跳到下一行(lex: Lexer): Lexer {
    当 lex.位置 < lex.长度 && lex.当前字符 != 10 则 {
        lex = lexer前进(lex)
    }
    若 lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }
    返回 lex
}

/**
 * 跳过当前 token
 */
函数 lexer跳过当前(lex: Lexer): Lexer {
    当 是空白(lex.当前字符) == 0 && lex.当前字符 != 0 则 {
        lex = lexer前进(lex)
    }
    返回 lex
}

/**
 * 检查是否为合法标识符起始字符
 */
函数 是合法标识符起始(ch: 整数): 整数 {
    若 ch >= 65 && ch <= 90 则 { 返回 1 }  // A-Z
    若 ch >= 97 && ch <= 122 则 { 返回 1 }  // a-z
    若 ch == 95 则 { 返回 1 }  // _
    若 ch >= 0xE4 则 { 返回 1 }  // 中文范围
    返回 0
}

/**
 * 检查是否为合法标识符字符
 */
函数 是合法标识符字符(ch: 整数): 整数 {
    若 是合法标识符起始(ch) == 1 则 { 返回 1 }
    若 ch >= 48 && ch <= 57 则 { 返回 1 }  // 0-9
    返回 0
}

/**
 * 验证标识符
 */
函数 lexer验证标识符(lex: Lexer): 整数 {
    定义 可变 ch: 整数
    ch = lex.当前位置

    若 是合法标识符起始(ch) == 0 则 {
        返回 0
    }

    定义 可变 pos: 整数
    pos = lex.位置 + 1

    当 pos < lex.长度 则 {
        ch = lex.当前位置
        若 是合法标识符字符(ch) == 0 则 {
            跳出
        }
        pos = pos + 1
    }

    返回 1
}

/**
 * 统计 token 类型分布
 */
函数 lexer统计Token分布(tokens: 列表): 列表 {
    定义 可变 统计: 列表
    统计 = 列表()

    打印("Token 类型分布:")

    返回 统计
}

/* ============ 词法分析器状态机 ============ */

/**
 * 创建词法分析器上下文
 */
函数 lexer创建上下文(源码: 文本): LexerContext {
    定义 可变 ctx: LexerContext
    ctx.状态 = 状态开始
    ctx.起始位置 = 0
    ctx.当前位置 = 0
    ctx.行号 = 1
    ctx.列号 = 0
    ctx.错误信息 = ""
    ctx.是否错误 = 0
    返回 ctx
}

/**
 * 从上下文获取下一个字符
 */
函数 lexer上下文中获取字符(ctx: LexerContext, 源码: 文本): 整数 {
    若 ctx.当前位置 >= 文本长度(源码) 则 {
        返回 0  // EOF
    }
    定义 可变 ch: 整数
    ch = 字符编码(文本获取字符(源码, ctx.当前位置))
    返回 ch
}

/**
 * 词法分析器状态转换
 */
函数 lexer状态转换(ctx: LexerContext, ch: 整数): 整数 {
    定义 可变 下一状态: 整数
    下一状态 = ctx.状态

    若 ctx.状态 == 状态开始 则 {
        若 ch == 0 则 {
            下一状态 = 状态结束
        } 否则 {
            若 是空白(ch) == 1 则 {
                下一状态 = 状态开始
            } 否则 {
                若 是字母(ch) == 1 则 {
                    下一状态 = 状态标识符
                } 否则 {
                    若 是数字(ch) == 1 则 {
                        下一状态 = 状态数字
                    } 否则 {
                        若 ch == 34 则 {
                            下一状态 = 状态字符串
                        } 否则 {
                            若 ch == 39 则 {
                                下一状态 = 状态字符
                            } 否则 {
                                若 ch == 47 则 {
                                    下一状态 = 状态注释
                                } 否则 {
                                    下一状态 = 状态运算符
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    返回 下一状态
}

/**
 * 处理字符串字面量（带转义）
 */
函数 lexer处理转义字符串(lex: Lexer): 文本 {
    定义 可变 结果: 文本
    结果 = ""

    打印("处理转义字符串")

    返回 结果
}

/**
 * 处理 Unicode 字符
 */
函数 lexer处理Unicode字符(lex: Lexer): 文本 {
    定义 可变 结果: 文本
    结果 = ""

    定义 可变 ch: 整数
    ch = lex.当前位置

    若 ch >= 0xE4 则 {
        定义 可变 bytes: 列表
        bytes = 列表()
        打印("处理 Unicode 字符")
    }

    返回 结果
}

/**
 * 验证数字字面量格式
 */
函数 lexer验证数字(lex: Lexer): 整数 {
    定义 可变 ch: 整数
    ch = lex.当前位置

    定义 可变 hasDot: 整数
    hasDot = 0
    定义 可变 hasExp: 整数
    hasExp = 0

    当 ch != 0 && ch != 32 && ch != 9 && ch != 10 && ch != 13 则 {
        若 ch == 46 则 {
            hasDot = hasDot + 1
            若 hasDot > 1 则 {
                返回 0  // 多个小数点
            }
        } 否则 {
            若 ch == 101 || ch == 69 则 {
                hasExp = hasExp + 1
                若 hasExp > 1 则 {
                    返回 0  // 多个指数
                }
            } 否则 {
                若 ch < 48 || ch > 57 则 {
                    若 ch != 95 则 {
                        返回 0  // 非法字符
                    }
                }
            }
        }
        ch = lex.当前位置
    }

    返回 1
}

/**
 * 验证字符串字面量
 */
函数 lexer验证字符串(lex: Lexer): 整数 {
    定义 可变 ch: 整数
    ch = lex.当前位置

    定义 可变 inEscape: 整数
    inEscape = 0

    当 ch != 0 则 {
        若 inEscape == 1 则 {
            inEscape = 0
        } 否则 {
            若 ch == 92 则 {
                inEscape = 1
            } 否则 {
                若 ch == 34 则 {
                    返回 1  // 找到结束引号
                }
            }
        }
        ch = lex.当前位置
    }

    返回 0  // 未找到结束引号
}

/**
 * 验证字符字面量
 */
函数 lexer验证字符(lex: Lexer): 整数 {
    定义 可变 ch: 整数
    ch = lex.当前位置

    若 ch == 39 则 {
        返回 1  // 空字符
    }

    定义 可变 charLen: 整数
    charLen = 0

    当 ch != 39 && ch != 0 && ch != 10 则 {
        charLen = charLen + 1
        ch = lex.当前位置
    }

    若 charLen == 0 则 {
        返回 0
    }

    若 ch == 39 则 {
        返回 1
    }

    返回 0
}

/**
 * 词法分析错误恢复
 */
函数 lexer错误恢复(lex: Lexer): Lexer {
    打印("词法分析错误恢复")

    定义 可变 恢复模式: 整数
    恢复模式 = 0

    // 安全恢复点
    当 lex.当前位置 < lex.长度 && lex.当前位置 >= 0 则 {
        定义 可变 ch: 整数
        ch = lex.当前位置

        // 遇到空白字符（空格、tab、换行）则停止
        若 ch == 32 || ch == 9 || ch == 10 || ch == 13 则 {
            若 恢复模式 == 1 则 {
                // 如果是在恢复模式中遇到空白，说明已经跳过了错误区域
                恢复模式 = 2
            }
            lex.当前位置 = lex.当前位置 + 1
            若 ch == 10 则 {
                lex.列号 = 0
                lex.行号 = lex.行号 + 1
            }
            若 恢复模式 == 2 则 {
                // 遇到空白且已经过错误区域，恢复解析
                返回 lex
            }
        } 否则 {
            // 非空白字符
            若 恢复模式 == 0 则 {
                // 开始恢复
                恢复模式 = 1
                打印("  跳过错误字符")
            }
            lex.当前位置 = lex.当前位置 + 1
        }
    }

    lex.列号 = 0
    lex.行号 = lex.行号 + 1

    返回 lex
}

/**
 * 跳过到指定位置
 */
函数 lexer跳到位置(lex: Lexer, 目标位置: 整数): Lexer {
    若 目标位置 >= 0 && 目标位置 < lex.长度 则 {
        lex.当前位置 = 目标位置
    }
    返回 lex
}

/**
 * 获取下一个安全恢复点
 */
函数 lexer查找安全点(lex: Lexer): 整数 {
    定义 可变 pos: 整数
    pos = lex.当前位置

    // 向前查找直到遇到空白或分号
    当 pos < lex.长度 && pos >= 0 则 {
        定义 可变 ch: 整数
        ch = lex.当前位置
        若 ch == 59 || ch == 32 || ch == 10 || ch == 9 则 {
            返回 pos
        }
        pos = pos + 1
    }

    返回 pos
}

/**
 * 词法分析器诊断信息
 */
函数 lexer诊断(lex: Lexer): 无返回 {
    打印("=== 词法分析器诊断 ===")
    打印("  位置: ")
    打印(lex.位置)
    打印("/")
    打印(lex.长度)
    打印("  行号: ")
    打印(lex.行号)
    打印("  列号: ")
    打印(lex.列号)
    打印("  当前字符: '")
    打印(lex.当前字符)
    打印("'")
    打印("  源码长度: ")
    打印(lex.长度)
}

/**
 * 获取 Token 类型名称
 */
函数 获取Token类型名(类型: 整数): 文本 {
    若 类型 == 0 则 { 返回 "标识符" }
    若 类型 == 1 则 { 返回 "数字" }
    若 类型 == 2 则 { 返回 "字符串" }
    若 类型 == 3 则 { 返回 "关键字" }
    若 类型 == 4 则 { 返回 "运算符" }
    若 类型 == 5 则 { 返回 "符号" }
    若 类型 == 6 则 { 返回 "结束" }
    若 类型 == 7 则 { 返回 "注释" }
    若 类型 == 8 则 { 返回 "字符" }
    若 类型 == 9 则 { 返回 "赋值" }
    若 类型 == 10 则 { 返回 "比较" }
    若 类型 == 11 则 { 返回 "逻辑" }
    若 类型 == 12 则 { 返回 "错误" }
    返回 "未知"
}

/**
 * 验证 token 序列
 */
函数 lexer验证Tokens(tokens: 列表): 整数 {
    若 列表长度(tokens) == 0 则 {
        返回 0
    }
    返回 1
}

/* ============ 主函数 ============ */

/**
 * 执行词法分析
 */
函数 lexerRun(源码: 文本): 整数 {
    打印("=== 词法分析 ===")

    定义 可变 lex: Lexer
    lex = lexerInit(源码, 文本长度(源码))

    定义 可变 count: 整数
    count = 0

    定义 可变 tok: Token
    tok.类型 = 0
    tok.值 = ""
    tok.行号 = 0
    tok.列号 = 0
    tok.开始位置 = 0
    tok.结束位置 = 0

    当 tok.类型 != 6 && count < 1000 则 {
        lex = lexerNextToken(lex)
        tok = lex.当前token

        // 跳过注释
        若 tok.类型 == 7 则 {
            跳过
        }

        若 tok.类型 != 6 则 {
            count = count + 1
            打印("Token ")
            打印(count)
            打印(": ")
            打印(tok.值)
            打印(" (类型=")
            打印(tok.类型)
            打印(", 行=")
            打印(tok.行号)
            打印(")")
        }
    }

    打印("")
    打印("词法分析完成，共识别 ")
    打印(count)
    打印(" 个 Token")

    返回 count
}

/**
 * 完整的 tokenize 函数 - 将源码转换为 token 列表
 * @param 源码 输入的源代码文本
 * @return token 列表
 */
函数 tokenize(源码: 文本): 列表 {
    定义 可变 lex: Lexer
    lex = lexerInit(源码, 文本长度(源码))
/*[DBG]     打印("DEBUG tokenize: lexerInit 完成\n") */

    定义 可变 tokens: 列表
    tokens = 列表()
/*[DBG]     打印("DEBUG tokenize: 创建列表完成\n") */

    定义 可变 循环次数: 整数
    循环次数 = 0

    当 循环次数 < 50000 则 {
        若 lex.位置 >= lex.长度 则 {
            定义 可变 eofTok: Token
            eofTok.类型 = 6
            eofTok.值 = "EOF"
            eofTok.行号 = lex.行号
            eofTok.列号 = lex.列号
            eofTok.开始位置 = lex.位置
            eofTok.结束位置 = lex.位置
            列表追加(tokens, eofTok)
            跳出
        }

        lex = lexerNextToken(lex)
        定义 可变 tok: Token
        tok = lex.当前token

        若 tok.类型 == 6 则 {
            列表追加(tokens, tok)
            跳出
        }

        若 tok.类型 == 7 则 {
            循环次数 = 循环次数 + 1
            跳过
        }

        列表追加(tokens, tok)
/*[DBG]         打印("DEBUG Token: 类型=") */
/*[DBG]         打印整数(tok.类型) */
/*[DBG]         打印(", 值='") */
/*[DBG]         打印(tok.值) */
/*[DBG]         打印("'\n") */
        循环次数 = 循环次数 + 1
    }

    返回 tokens
}

/**
 * 打印 token 列表
 * @param tokens token 列表
 */
函数 打印Tokens(tokens: 列表): 无返回 {
    定义 可变 i: 整数
    i = 0
    定义 可变 len: 整数
    len = 列表长度(tokens)

    打印("=== Token 列表 ===")

    当 i < len 则 {
        定义 可变 tok: Token
        tok = 列表获取(tokens, i)

        定义 可变 类型名: 文本
        类型名 = 获取Token类型名(tok.类型)

        打印("Token ")
        打印(i + 1)
        打印(": [")
        打印(类型名)
        打印("] '")
        打印(tok.值)
        打印("' (行:")
        打印(tok.行号)
        打印(", 列:")
        打印(tok.列号)
        打印(")")

        i = i + 1
    }

    打印("总计: ")
    打印(len)
    打印(" 个 tokens")
}


/**
 * @file parser.xy
 * @brief 语法解析器 - 自展编译器
 * @description 递归下降解析器，实现表达式、语句、函数的解析
 */

/* ============ 关键字表 ============ */

/* 关键字识别 */
函数 是关键字(text: 文本): 整数 {
    若 text == "若" 则 { 返回 1 }
    若 text == "则" 则 { 返回 1 }
    若 text == "否则" 则 { 返回 1 }
    若 text == "当" 则 { 返回 1 }
    若 text == "循环" 则 { 返回 1 }
    若 text == "从" 则 { 返回 1 }
    若 text == "到" 则 { 返回 1 }
    若 text == "返回" 则 { 返回 1 }
    若 text == "定义" 则 { 返回 1 }
    若 text == "可变" 则 { 返回 1 }
    若 text == "函数" 则 { 返回 1 }
    若 text == "结构体" 则 { 返回 1 }
    若 text == "枚举" 则 { 返回 1 }
    若 text == "真" 则 { 返回 1 }
    若 text == "假" 则 { 返回 1 }
    若 text == "跳过" 则 { 返回 1 }
    若 text == "退出" 则 { 返回 1 }
    若 text == "引入" 则 { 返回 1 }
    若 text == "模块" 则 { 返回 1 }
    若 text == "导出" 则 { 返回 1 }
    返回 0
}

/* 获取关键字类型 */
函数 getKeywordType(text: 文本): 整数 {
    若 text == "若" 则 { 返回 1 }     // IF
    若 text == "则" 则 { 返回 2 }     // THEN
    若 text == "否则" 则 { 返回 3 }   // ELSE
    若 text == "当" 则 { 返回 4 }    // WHILE
    若 text == "循环" 则 { 返回 5 }   // LOOP
    若 text == "从" 则 { 返回 6 }    // FROM
    若 text == "到" 则 { 返回 7 }    // TO
    若 text == "返回" 则 { 返回 8 }   // RETURN
    若 text == "定义" 则 { 返回 9 }   // LET
    若 text == "函数" 则 { 返回 10 }  // FUNC
    若 text == "真" 则 { 返回 11 }   // TRUE
    若 text == "假" 则 { 返回 12 }   // FALSE
    若 text == "跳过" 则 { 返回 13 }  // CONTINUE
    若 text == "退出" 则 { 返回 14 }  // BREAK
    若 text == "引入" 则 { 返回 15 }  // IMPORT
    若 text == "模块" 则 { 返回 16 }  // MODULE
    若 text == "导出" 则 { 返回 17 }  // EXPORT
    若 text == "整数" 则 { 返回 20 }  // TYPE_INT
    若 text == "浮点数" 则 { 返回 21 } // TYPE_FLOAT
    若 text == "双精度" 则 { 返回 22 } // TYPE_DOUBLE
    若 text == "布尔" 则 { 返回 23 }  // TYPE_BOOL
    若 text == "文本" 则 { 返回 24 }  // TYPE_STRING
    若 text == "无返回" 则 { 返回 25 } // TYPE_VOID
    若 text == "字符" 则 { 返回 26 }  // TYPE_CHAR
    若 text == "指针" 则 { 返回 27 }  // TYPE_POINTER
    若 text == "列表" 则 { 返回 28 }  // TYPE_LIST
    若 text == "长整数" 则 { 返回 29 } // TYPE_LONG
    返回 0
}

/* ============ 初始化 ============ */

函数 parserInit(tokens: 列表): Parser {
    定义 可变 p: Parser
    p.pos = 0
    p.tokens = tokens
    p.errors = 列表()
    p.nodeCount = 0
    p.tokenCount = 列表长度(tokens)
    返回 p
}

/* ============ Token 访问辅助函数 ============ */

/* 获取当前 token */
函数 parserPeekToken(p: Parser): Token {
    定义 可变 tok: Token
    tok.类型 = 0
    tok.值 = ""
    tok.行号 = 0
    tok.列号 = 0
    tok.开始位置 = 0
    tok.结束位置 = 0

    若 p.pos < p.tokenCount 则 {
        定义 可变 t: Token
        t = p.tokens[p.pos]
        返回 t
    }

    tok.类型 = 6  // 结束
    tok.值 = "EOF"
    返回 tok
}

/* 检查当前 token 是否为指定值 */
函数 parserCheck(p: Parser, 值: 文本): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    若 tok.值 == 值 则 {
        返回 1
    }
    返回 0
}

/* 检查当前 token 是否为指定类型 */
函数 parserCheckType(p: Parser, 类型: 整数): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    若 tok.类型 == 类型 则 {
        返回 1
    }
    返回 0
}

/* 匹配并消费 token */
函数 parserMatch(p: Parser, 值: 文本): 整数 {
    若 parserCheck(p, 值) == 1 则 {
        p.pos = p.pos + 1
        返回 1
    }
    返回 0
}

/* 生成新的 AST 节点 ID */
函数 parserNewNodeId(p: Parser): 整数 {
    p.nodeCount = p.nodeCount + 1
    返回 p.nodeCount
}

/* 创建 AST 节点 */
函数 parserCreateNode(kind: 整数, name: 文本, value: 文本, line: 整数): AST节点 {
    定义 可变 node: AST节点
    node.id = 0
    node.kind = kind
    node.name = name
    node.value = value
    node.intValue = 0
    node.line = line
    node.children = 列表()
/*[DBG]     打印("DEBUG parseBlock: end, children=") */
/*[DBG]     打印整数(列表长度(node.children)) */
/*[DBG]     打印("\n") */
    返回 node
}

/* ============ 表达式解析 ============ */

/* 解析主表达式 (标识符、数字、字符串、括号) */
函数 parsePrimary(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 node: AST节点
    node = parserCreateNode(0, "", "", tok.行号)

    /* 标识符 */
    若 tok.类型 == 0 则 {
        node.kind = 13  // 标识符表达式
        node.name = tok.值
        node.value = tok.值
        p.pos = p.pos + 1

        /* 检查是否是函数调用 */
        tok = parserPeekToken(p)
        若 tok.值 == "(" 则 {
            node = parseCall(p, node)
        }
        返回 node
    }

    /* 数字 */
    若 tok.类型 == 1 则 {
        node.kind = 14  // 字面量表达式
        node.value = tok.值
        node.intValue = 文本转整数(tok.值)
        p.pos = p.pos + 1
        返回 node
    }

    /* 字符串 */
    若 tok.类型 == 2 则 {
        node.kind = 14  // 字面量表达式
        node.value = tok.值
        p.pos = p.pos + 1
        返回 node
    }

    /* 类型关键字作为构造函数: 列表(), 整数() 等（也用作标识符） */
    若 tok.类型 == 3 则 {
        node.kind = 13  // 标识符表达式
        node.name = tok.值
        node.value = tok.值
        p.pos = p.pos + 1

        /* 检查是否是函数调用 */
        tok = parserPeekToken(p)
        若 tok.值 == "(" 则 {
            node = parseCall(p, node)
        }
        返回 node
    }

    /* 左括号 - 括号表达式 */
    若 tok.值 == "(" 则 {
        p.pos = p.pos + 1
        node = parseExpression(p)
        tok = parserPeekToken(p)
        若 tok.值 == ")" 则 {
            p.pos = p.pos + 1
        }
        返回 node
    }

    /* 一元减号 */
    若 tok.值 == "-" 则 {
        p.pos = p.pos + 1
        定义 可变 operand: AST节点
        operand = parsePrimary(p)
        node.kind = 11  // 一元表达式
        node.name = "-"
        返回 node
    }

    /* 空表达式 */
    返回 node
}

/* 解析函数调用 */
函数 parseCall(p: Parser, funcNode: AST节点): AST节点 {
    定义 可变 tok: Token

    /* 消费 ( */
    tok = parserPeekToken(p)
    若 tok.值 == "(" 则 {
        p.pos = p.pos + 1
    } 否则 {
        parser报告错误(p, "期望 '('")
    }

    funcNode.kind = 12  // 调用表达式
    funcNode.children = 列表()

    /* 循环解析参数 */
    循环 {
        tok = parserPeekToken(p)
/*[DBG]         打印("DEBUG parseCall: tok='") */
/*[DBG]         打印(tok.值) */
/*[DBG]         打印("' type=") */
/*[DBG]         打印整数(tok.类型) */
/*[DBG]         打印(" pos=") */
/*[DBG]         打印整数(p.pos) */
/*[DBG]         打印("\n") */

        // 结束条件：遇到 )
        若 tok.值 == ")" 则 {
            跳出
        }

        // 文件末尾，缺少 )
        若 tok.类型 == 6 则 {
            parser报告错误(p, "函数调用未闭合，期望 ')'")
            跳出
        }

        // 解析一个参数
        定义 可变 arg: AST节点
        arg = parseExpression(p)
        列表追加(funcNode.children, arg)

        // 看下一个 token：逗号 or 结束
        tok = parserPeekToken(p)
        若 tok.值 == "," 则 {
            p.pos = p.pos + 1  // 吃掉逗号，继续下一个参数
        } 否则 若 tok.值 != ")" 则 {
            parser报告错误(p, "参数后期望逗号或右括号")
        }
    }

    /* 消费 ) */
    tok = parserPeekToken(p)
    若 tok.值 == ")" 则 {
        p.pos = p.pos + 1
    } 否则 {
        parser报告错误(p, "期望 ')' 结束函数调用")
    }

    返回 funcNode
}

/* 解析一元表达式 */
函数 parseUnary(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    /* 一元运算符 */
    若 tok.值 == "!" || tok.值 == "-" 则 {
        定义 可变 op: 文本
        op = tok.值
        p.pos = p.pos + 1
        定义 可变 operand: AST节点
        operand = parseUnary(p)
        定义 可变 node: AST节点
         node = parserCreateNode(11, op, "", tok.行号)
        列表追加(node.children, operand)
        返回 node
    }

    /* 先解析基本表达式，再处理后缀（调用、索引、字段访问） */
    定义 可变 primary: AST节点
    primary = parsePrimary(p)
    返回 parsePostfix(p, primary)
}

/* 获取运算符优先级 */
函数 getOpPriority(op: 文本): 整数 {
    若 op == "||" 则 { 返回 1 }
    若 op == "&&" 则 { 返回 2 }
    若 op == "==" || op == "!=" 则 { 返回 3 }
    若 op == "<" || op == ">" || op == "<=" || op == ">=" 则 { 返回 4 }
    若 op == "+" || op == "-" 则 { 返回 5 }
    若 op == "*" || op == "/" || op == "%" 则 { 返回 6 }
    返回 0
}

/* 是右结合运算符 */
函数 是右结合(op: 文本): 整数 {
    若 op == "=" 则 { 返回 1 }
    返回 0
}

/* 解析带优先级的二元表达式 (Pratt Parser) */
函数 parseBinaryExpr(p: Parser, minPriority: 整数): AST节点 {
    定义 可变 left: AST节点
    left = parseUnary(p)

    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 priority: 整数
    priority = getOpPriority(tok.值)

    当 priority >= minPriority && priority > 0 则 {
        定义 可变 op: 文本
        op = tok.值
        p.pos = p.pos + 1

        定义 可变 nextMinPriority: 整数
        nextMinPriority = priority + 1
        若 是右结合(op) == 1 则 {
            nextMinPriority = priority
        }

        定义 可变 right: AST节点
        right = parseBinaryExpr(p, nextMinPriority)

        定义 可变 node: AST节点
         node = parserCreateNode(10, op, "", tok.行号)
        列表追加(node.children, left)
        列表追加(node.children, right)

        left = node
        tok = parserPeekToken(p)
        priority = getOpPriority(tok.值)
    }

    返回 left
}

/* 是二元运算符 */
函数 isBinaryOp(text: 文本): 整数 {
    若 text == "+" || text == "-" || text == "*" || text == "/" 则 { 返回 1 }
    若 text == "%" || text == "==" || text == "!=" 则 { 返回 1 }
    若 text == "<" || text == ">" || text == "<=" || text == ">=" 则 { 返回 1 }
    若 text == "&&" || text == "||" 则 { 返回 1 }
    返回 0
}

/* 解析二元表达式 */
函数 parseExpression(p: Parser): AST节点 {
    返回 parseBinaryExpr(p, 1)
}

/* 解析索引访问表达式 */
/* 索引访问: base[index] -> children[0]=base, children[1]=index */
函数 parseIndexAccess(p: Parser, base: AST节点): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 node: AST节点
    node = parserCreateNode(15, "", "", tok.行号)  // 复用类型转换节点kind=15
    node.children = 列表()
    node.children.追加(base)  // children[0] = 被索引对象
    node.children.追加(空节点)  // children[1] = 索引（稍后填充）

    /* 消费 '[' */
    若 tok.值 == "[" 则 {
        p.pos = p.pos + 1

        /* 解析索引 */
        定义 可变 index: AST节点
        index = parseExpression(p)

        /* 消费 ']' */
        tok = parserPeekToken(p)
        若 tok.值 == "]" 则 {
            p.pos = p.pos + 1
        }

        /* 设置索引 */
        node.children[1] = index
    }

    返回 node
}

/* 解析字段访问表达式 */
函数 parseFieldAccess(p: Parser, base: AST节点): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 node: AST节点
    node = parserCreateNode(0, "", "", tok.行号)

    /* 消费 '.' */
    若 tok.值 == "." 则 {
        p.pos = p.pos + 1

        /* 获取字段名 */
        tok = parserPeekToken(p)
        若 tok.类型 == 0 则 {
node.kind = 23  // 结构体字段节点
 node.name = tok.值
 列表追加(node.children, base)
 p.pos = p.pos + 1
        }
    }

    返回 node
}

/* 解析后缀表达式（索引、调用、字段访问） */
函数 parsePostfix(p: Parser, base: AST节点): AST节点 {
    定义 可变 node: AST节点
    node = base

    定义 可变 tok: Token
    tok = parserPeekToken(p)

    当 tok.值 == "(" || tok.值 == "[" || tok.值 == "." 则 {
        若 tok.值 == "(" 则 {
            node = parseCall(p, node)
        } 否则 {
            若 tok.值 == "[" 则 {
                node = parseIndexAccess(p, node)
            } 否则 {
                若 tok.值 == "." 则 {
                    node = parseFieldAccess(p, node)
                }
            }
        }
        tok = parserPeekToken(p)
    }

/*[DBG]     打印("DEBUG parseBlock: end, children=") */
/*[DBG]     打印整数(列表长度(node.children)) */
/*[DBG]     打印("\n") */
    返回 node
}

/* ============ 语句解析 ============ */

/* 解析赋值语句或表达式语句 */
函数 parseAssignmentOrExpression(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 node: AST节点
    node = parserCreateNode(9, "", "", tok.行号)  // 表达式语句

    // 检查是否是赋值
    若 tok.类型 == 0 则 {
        定义 可变 nextTok: Token
        定义 可变 savedPos: 整数
        savedPos = p.pos

        // 消费标识符
        p.pos = p.pos + 1
        nextTok = parserPeekToken(p)

        // 如果下一个是 =、+=、-=、*=、/=、%= 则为赋值
        若 nextTok.值 == "=" 则 {
            p.pos = p.pos + 1  // 消费 =
            定义 可变 valueNode: AST节点
            valueNode = parseExpression(p)
            node.kind = 19  // 赋值表达式
            node.name = tok.值
            node.value = "="
            返回 node
        } 否则 {
            // 不是赋值，回退
            p.pos = savedPos
        }
    }

    // 作为表达式解析
    node = parseExpression(p)
    返回 node
}

/* 解析赋值语句 */
函数 parseAssignmentStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号

    定义 可变 node: AST节点
    node = parserCreateNode(4, "", "", line)  // 赋值语句

    // 获取变量名
    tok = parserPeekToken(p)
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    // 获取赋值运算符
    tok = parserPeekToken(p)
    定义 可变 op: 文本
    op = "="

    若 tok.值 == "=" 则 { op = "=" }
    若 tok.值 == "+=" 则 { op = "+=" }
    若 tok.值 == "-=" 则 { op = "-=" }
    若 tok.值 == "*=" 则 { op = "*=" }
    若 tok.值 == "/=" 则 { op = "/=" }
    若 tok.值 == "%=" 则 { op = "%=" }

    node.value = op
    p.pos = p.pos + 1

    // 解析右侧表达式
    定义 可变 valueNode: AST节点
    valueNode = parseExpression(p)

    // 消费分号（如果有）
    tok = parserPeekToken(p)
    若 tok.值 == ";" 则 {
        p.pos = p.pos + 1
    }

    返回 node
}

/* 解析变量定义语句: 定义 可变 变量名: 类型 = 值 */
函数 parseLetStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号

    定义 可变 node: AST节点
    node = parserCreateNode(3, "", "", line)  // 变量定义

    /* 消费 '定义' */
    若 tok.值 == "定义" 则 {
        p.pos = p.pos + 1
    }

    /* 处理可选的 '可变' 关键字 */
    tok = parserPeekToken(p)
    若 tok.值 == "可变" 则 {
        p.pos = p.pos + 1
    }

    /* 获取变量名 */
    tok = parserPeekToken(p)
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    /* 消费 ':' (可选) */
    tok = parserPeekToken(p)
    若 tok.值 == ":" 则 {
        p.pos = p.pos + 1
        /* 消费类型 */
        tok = parserPeekToken(p)
        node.value = tok.值
        p.pos = p.pos + 1
    }

    /* 消费 '=' */
    tok = parserPeekToken(p)
    若 tok.值 == "=" 则 {
        p.pos = p.pos + 1
        /* 解析初始值表达式 */
        定义 可变 expr: AST节点
        expr = parseExpression(p)
        列表追加(node.children, expr)  // 设置初始值作为子节点
    }

    返回 node
}

/* 解析返回语句 */
函数 parseReturnStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号

    定义 可变 node: AST节点
    node = parserCreateNode(8, "", "", line)  // 返回语句

    /* 消费 '返回' */
    若 tok.值 == "返回" 则 {
        p.pos = p.pos + 1
    }

    /* 解析返回值（可选） */
    tok = parserPeekToken(p)
    若 tok.值 != "}" 则 {
        定义 可变 expr: AST节点
        expr = parseExpression(p)
        列表追加(node.children, expr)  // 设置返回值作为子节点
    }

    返回 node
}

/* 解析 break 语句 */
函数 parseBreakStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号

    定义 可变 node: AST节点
    node = parserCreateNode(16, "", "", line)  // break语句

    /* 消费 '退出' */
    若 tok.值 == "退出" 则 {
        p.pos = p.pos + 1
    }

    /* 消费 ';' */
    tok = parserPeekToken(p)
    若 tok.值 == ";" 则 {
        p.pos = p.pos + 1
    }

    返回 node
}

/* 解析 continue 语句 */
函数 parseContinueStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号

    定义 可变 node: AST节点
    node = parserCreateNode(17, "", "", line)  // continue语句

    /* 消费 '跳过' */
    若 tok.值 == "跳过" 则 {
        p.pos = p.pos + 1
    }

    /* 消费 ';' */
    tok = parserPeekToken(p)
    若 tok.值 == ";" 则 {
        p.pos = p.pos + 1
    }

    返回 node
}

/* 解析块语句 */
函数 parseBlock(p: Parser): AST节点 {
    打印("[BLOCK ENTER]\n")
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号

    定义 可变 node: AST节点
    node = parserCreateNode(18, "", "", line)  // 块语句
    node.children = 列表()

/*[DBG]     打印("DEBUG parseBlock: start\n") */
    /* 消费 '{' */
    若 tok.值 == "{" 则 {
        p.pos = p.pos + 1
    }

    /* 循环解析语句 */
    tok = parserPeekToken(p)
/*[DBG]     打印("DEBUG parseBlock: first body tok='") */
/*[DBG]     打印(tok.值) */
/*[DBG]     打印("' type=") */
/*[DBG]     打印整数(tok.类型) */
/*[DBG]     打印("\n") */
    当 tok.值 != "}" && tok.值 != "" && tok.类型 != 6 则 {
/*[DBG]         打印("DEBUG blk: tok=") */
/*[DBG]         打印(tok.值) */
/*[DBG]         打印(" type=") */
/*[DBG]         打印整数(tok.类型) */
/*[DBG]         打印("\n") */
        定义 可变 stmt: AST节点

        若 tok.值 == "定义" 则 {
            stmt = parseLetStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "返回" 则 {
            stmt = parseReturnStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "若" 则 {
            stmt = parseIfStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "当" 则 {
            stmt = parseWhileStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "循环" 则 {
            stmt = parseForStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "匹配" 则 {
            stmt = parseMatchStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "退出" 则 {
            stmt = parseBreakStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "跳过" 则 {
            stmt = parseContinueStatement(p)
            列表追加(node.children, stmt)
        } 否则 {
            stmt = parseAssignmentOrExpression(p)
            列表追加(node.children, stmt)
            // 消费分号
            tok = parserPeekToken(p)
            若 tok.值 == ";" 则 {
                p.pos = p.pos + 1
            }
        }

        tok = parserPeekToken(p)
    }

    /* 消费 '}' */
    若 tok.值 == "}" 则 {
        p.pos = p.pos + 1
    }

    返回 node
}

/* 解析 if 语句 */
/* 支持: 若 expr 则 { ... }
 *       若 expr 则 { ... } 否则若 expr 则 { ... }
 *       若 expr 则 { ... } 否则 { ... }
 */
函数 parseIfStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(5, "", "", line)
    node.children = 列表()

    /* 消费 '若' */
    tok = parserPeekToken(p)
    若 tok.值 == "若" 则 {
        line = tok.行号
        p.pos = p.pos + 1
    }

    /* 解析条件表达式 */
    定义 可变 condNode: AST节点
    condNode = parseExpression(p)
    node.children.追加(condNode)

    /* 消费 '则' */
    tok = parserPeekToken(p)
    若 tok.值 == "则" 则 {
        p.pos = p.pos + 1
    }

    /* 解析 then 分支（块或单语句） */
    定义 可变 thenNode: AST节点
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        thenNode = parseBlock(p)
    } 否则 {
        thenNode = parseExpression(p)
    }
    node.children.追加(thenNode)

    /* 检查 '否则' 或 '否则若' */
    tok = parserPeekToken(p)
    定义 可变 elseNode: AST节点
    elseNode = parserCreateNode(0, "", "", line)

    若 tok.值 == "否则若" 则 {
        /* 否则若 - 递归解析嵌套的 if 语句 */
        p.pos = p.pos + 1
        elseNode = parseIfStatement(p)
    } 否则 若 tok.值 == "否则" 则 {
        p.pos = p.pos + 1
        /* 解析普通 else 块 */
        tok = parserPeekToken(p)
        若 tok.值 == "{" 则 {
            elseNode = parseBlock(p)
        } 否则 {
            /* 否则后是单语句（简化处理，解析为表达式） */
            elseNode = parseExpression(p)
        }
    }
    node.children.追加(elseNode)

    返回 node
}

/* 解析 while 语句 */
函数 parseWhileStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(6, "", "", line)
    node.children = 列表()

    /* 消费 '当' */
    tok = parserPeekToken(p)
    若 tok.值 == "当" 则 {
        line = tok.行号
        p.pos = p.pos + 1
    }

    /* 解析条件表达式 */
    定义 可变 condNode: AST节点
    condNode = parseExpression(p)
    node.children.追加(condNode)

    /* 解析循环体（块或单语句） */
    定义 可变 bodyNode: AST节点
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        bodyNode = parseBlock(p)
    } 否则 {
        bodyNode = parseExpression(p)
    }
    node.children.追加(bodyNode)

    返回 node
}

/* 解析 for 循环语句: 循环 变量 从 起始 到 结束 遍历 */
函数 parseForStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(20, "", "", line)
    node.children = 列表()

    /* 消费 '循环' */
    tok = parserPeekToken(p)
    若 tok.值 == "循环" 则 {
        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }

    /* 获取循环变量名 */
    tok = parserPeekToken(p)
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    /* 消费 '从' */
    tok = parserPeekToken(p)
    若 tok.值 == "从" 则 {
        p.pos = p.pos + 1
    }

    /* 解析起始值 */
    定义 可变 startNode: AST节点
    startNode = parseExpression(p)
    node.children.追加(startNode)

    /* 消费 '到' */
    tok = parserPeekToken(p)
    若 tok.值 == "到" 则 {
        p.pos = p.pos + 1
    }

    /* 解析结束值 */
    定义 可变 endNode: AST节点
    endNode = parseExpression(p)
    node.children.追加(endNode)

    /* 解析循环体（块或单语句） */
    定义 可变 bodyNode: AST节点
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        bodyNode = parseBlock(p)
    } 否则 {
        bodyNode = parseExpression(p)
    }
    node.children.追加(bodyNode)

    返回 node
}

/* 解析 match 语句: 匹配 表达式 { case 值: 语句, default: 语句 } */
函数 parseMatchStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(25, "", "", line)  // match语句
    node.children = 列表()

    /* 消费 '匹配' */
    tok = parserPeekToken(p)
    若 tok.值 == "匹配" 则 {
        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }

    /* 解析被匹配的值并添加到 children */
    定义 可变 subjectNode: AST节点
    subjectNode = parseExpression(p)
    node.children.追加(subjectNode)

    /* 消费 '{' */
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        p.pos = p.pos + 1
    }

    /* 解析分支 */
    tok = parserPeekToken(p)
    当 tok.值 != "}" && tok.值 != "" && tok.类型 != 6 则 {
        定义 可变 branchNode: AST节点
        branchNode = parserCreateNode(26, "", "", line)
        branchNode.children = 列表()

        /* 检查是否是 default 分支 */
        若 tok.值 == "默认" 则 {
            /* 默认分支 */
            p.pos = p.pos + 1
            tok = parserPeekToken(p)
            若 tok.值 == ":" 则 {
                p.pos = p.pos + 1
            }
            定义 可变 defaultBody: AST节点
            defaultBody = parseExpression(p)
            branchNode = parserCreateNode(27, "", "", line)  // match默认分支
            branchNode.children = 列表()
            branchNode.children.追加(defaultBody)
            node.children.追加(branchNode)
        } 否则 {
            /* case 分支 */
            若 tok.值 == "情况" 则 {
                p.pos = p.pos + 1
            }

            /* 解析 case 值 */
            定义 可变 caseValue: 文本
            caseValue = ""
            tok = parserPeekToken(p)
            若 tok.类型 == 1 则 {
                caseValue = tok.值
                p.pos = p.pos + 1
            } 否则 {
                若 tok.类型 == 0 则 {
                    caseValue = tok.值
                    p.pos = p.pos + 1
                }
            }

            branchNode = parserCreateNode(26, caseValue, "", tok.行号)  // match分支
            branchNode.children = 列表()

            /* 消费 ':' */
            tok = parserPeekToken(p)
            若 tok.值 == ":" 则 {
                p.pos = p.pos + 1
            }

            /* 解析分支体并添加到 children */
            定义 可变 branchBody: AST节点
            branchBody = parseExpression(p)
            branchNode.children.追加(branchBody)
            node.children.追加(branchNode)
        }

        /* 消费 ',' || ';' */
        tok = parserPeekToken(p)
        若 tok.值 == "," 则 {
            p.pos = p.pos + 1
        }

        tok = parserPeekToken(p)
    }

    /* 消费 '}' */
    tok = parserPeekToken(p)
    若 tok.值 == "}" 则 {
        p.pos = p.pos + 1
    }

/*[DBG]     打印("DEBUG parseBlock: end, children=") */
/*[DBG]     打印整数(列表长度(node.children)) */
/*[DBG]     打印("\n") */
    返回 node
}

/* ============ 函数解析 ============ */

/* 解析结构体定义: 结构体 结构体名 { 字段1: 类型1, 字段2: 类型2 } */
函数 parseStructDefinition(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(21, "", "", line)  // 结构体定义
    node.children = 列表()

    /* 消费 '结构体' */
    tok = parserPeekToken(p)
    若 tok.值 == "结构体" 则 {
        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }

    /* 获取结构体名 */
    tok = parserPeekToken(p)
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    /* 消费 '{' */
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        p.pos = p.pos + 1
    }

    /* 解析字段列表 */
    tok = parserPeekToken(p)
    当 tok.值 != "}" && tok.值 != "" && tok.类型 != 6 则 {
        /* 获取字段名 */
        若 tok.类型 == 0 则 {
            定义 可变 fieldNode: AST节点
            fieldNode = parserCreateNode(23, tok.值, "", tok.行号)  // 结构体字段
            p.pos = p.pos + 1

            /* 消费 ':' */
            tok = parserPeekToken(p)
            若 tok.值 == ":" 则 {
                p.pos = p.pos + 1
            }

            /* 获取字段类型 */
            tok = parserPeekToken(p)
            若 tok.类型 == 3 则 {
                fieldNode.value = tok.值
                p.pos = p.pos + 1
            }

            node.children.追加(fieldNode)

            /* 消费 ',' || '}' */
            tok = parserPeekToken(p)
            若 tok.值 == "," 则 {
                p.pos = p.pos + 1
            }
        }

        tok = parserPeekToken(p)
    }

    /* 消费 '}' */
    tok = parserPeekToken(p)
    若 tok.值 == "}" 则 {
        p.pos = p.pos + 1
    }

    返回 node
}

函数 parseImportStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(28, "", "", line)  // 导入语句
    node.children = 列表()

    /* 消费 '引入' */
    tok = parserPeekToken(p)
    若 tok.值 == "引入" 则 {
        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }

    /* 解析模块路径 */
    tok = parserPeekToken(p)
    若 tok.类型 == 2 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    /* 消费分号（可选） */
    tok = parserPeekToken(p)
    若 tok.值 == ";" 则 {
        p.pos = p.pos + 1
    }

    返回 node
}

/* 解析模块定义: 模块 模块名 { ... } */
函数 parseModuleDefinition(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(29, "", "", line)  // 模块定义
    node.children = 列表()

    /* 消费 '模块' */
    tok = parserPeekToken(p)
    若 tok.值 == "模块" 则 {
        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }

    /* 获取模块名 */
    tok = parserPeekToken(p)
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    /* 消费 '{' */
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        p.pos = p.pos + 1
    }

    /* 解析模块内容（函数定义列表） */
    tok = parserPeekToken(p)
    当 tok.值 != "}" && tok.值 != "" && tok.类型 != 6 则 {
        若 tok.值 == "函数" 则 {
            定义 可变 funcNode: AST节点
            funcNode = parseFunction(p)
            列表追加(node.children, funcNode)
        } 否则 若 tok.值 == "引入" 则 {
            定义 可变 importNode: AST节点
            importNode = parseImportStatement(p)
            列表追加(node.children, importNode)
        } 否则 {
            p.pos = p.pos + 1
        }
        tok = parserPeekToken(p)
    }

    /* 消费 '}' */
    若 tok.值 == "}" 则 {
        p.pos = p.pos + 1
    }

    返回 node
}

/* 解析枚举定义: 枚举 枚举名 { 成员1, 成员2, 成员3 } */
函数 parseEnumDefinition(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(22, "", "", line)  // 枚举定义
    node.children = 列表()

    /* 消费 '枚举' */
    tok = parserPeekToken(p)
    若 tok.值 == "枚举" 则 {
        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }

    /* 获取枚举名 */
    tok = parserPeekToken(p)
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    /* 消费 '{' */
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        p.pos = p.pos + 1
    }

    /* 解析成员列表 */
    tok = parserPeekToken(p)
    当 tok.值 != "}" && tok.值 != "" && tok.类型 != 6 则 {
        若 tok.类型 == 0 则 {
            定义 可变 memberNode: AST节点
            memberNode = parserCreateNode(24, tok.值, "", tok.行号)
            node.children.追加(memberNode)
            p.pos = p.pos + 1

            /* 消费 ',' || '}' */
            tok = parserPeekToken(p)
            若 tok.值 == "," 则 {
                p.pos = p.pos + 1
            }
        }

        tok = parserPeekToken(p)
    }

    /* 消费 '}' */
    tok = parserPeekToken(p)
    若 tok.值 == "}" 则 {
        p.pos = p.pos + 1
    }

    返回 node
}

/* 解析函数签名: 函数 函数名(参数): 返回类型 */
函数 parseFunctionSignature(p: Parser): AST节点 {
    打印("[SIG enter]\n")
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(1, "", "", line)  // 函数定义
    打印("[SIG node created]\n")
    node.children = 列表()
    打印("[SIG about to peek func]\n")

    /* 消费 '函数' */
    tok = parserPeekToken(p)
    打印("[SIG peeked func] val=")
    打印(tok.值)
    打印("\n")
    若 tok.值 == "函数" 则 {
        line = tok.行号
        打印("[SIG consuming func]\n")
        p.pos = p.pos + 1
        打印("[SIG consumed func]\n")
    }

    /* 获取函数名 */
    打印("[SIG before peek name] pos=")
    打印整数(p.pos)
    打印("\n")
    tok = parserPeekToken(p)
    打印("[SIG peeked name] val=")
    打印(tok.值)
    打印("\n")
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    /* 消费 '(' */
    tok = parserPeekToken(p)
    若 tok.值 == "(" 则 {
        p.pos = p.pos + 1
    }

    /* 解析参数列表 (简化) */
    tok = parserPeekToken(p)
    当 tok.值 != ")" && tok.值 != "" && tok.类型 != 6 则 {
        /* 解析参数名 */
        若 tok.类型 == 0 则 {
            p.pos = p.pos + 1
            /* 消费 ':' */
            tok = parserPeekToken(p)
            若 tok.值 == ":" 则 {
                p.pos = p.pos + 1
                /* 消费参数类型 */
                tok = parserPeekToken(p)
                若 tok.类型 == 3 则 {
                    p.pos = p.pos + 1
                }
            }
        }
        /* 消费 ',' */
        tok = parserPeekToken(p)
        若 tok.值 == "," 则 {
            p.pos = p.pos + 1
        }
        tok = parserPeekToken(p)
    }

    /* 消费 ')' */
    打印("[SIG before )]\n")
    tok = parserPeekToken(p)
    若 tok.值 == ")" 则 {
        p.pos = p.pos + 1
    }
    打印("[SIG after )]\n")

    /* 消费返回类型 ':' 和类型 */
    tok = parserPeekToken(p)
    若 tok.值 == ":" 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
        node.value = tok.值  // 返回类型
        p.pos = p.pos + 1
    }

    打印("[SIG returning]\n")
    node.line = line
    返回 node
}

/* 解析函数定义 */
函数 parseFunction(p: Parser): AST节点 {
    打印("[PFUNC enter]\n")
    /* 解析函数签名 */
    定义 可变 funcNode: AST节点
    funcNode = parseFunctionSignature(p)
    打印("[PFUNC sig done]\n")

    /* 解析函数体 */
    定义 可变 bodyNode: AST节点
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    打印("[PARSEFUNC: peeked='")
    打印(tok.值)
    打印("' type=")
    打印整数(tok.类型)
    打印("]\n")
    若 tok.值 == "{" 则 {
        打印("[PARSEFUNC: calling parseBlock]\n")
        bodyNode = parseBlock(p)
    } 否则 {
        打印("[PARSEFUNC: calling parseExpression]\n")
        bodyNode = parseExpression(p)
    }

    打印("解析函数: ")
    打印(funcNode.name)

    定义 可变 funcChildren: 列表
    funcChildren = 列表()
    打印("[PFUNC appending body]\n")
    funcChildren.追加(bodyNode)
    打印("[PFUNC appended ok]\n")
    funcNode.children = funcChildren
    打印("[PFUNC returning funcNode]\n")
    返回 funcNode
}

/* ============ 语法错误恢复 ============ */

/**
 * 报告语法错误
 */
函数 parser报告错误(p: Parser, 消息: 文本): 无返回 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    打印("语法错误 (行")
    打印(tok.行号)
    打印(", 列")
    打印(tok.列号)
    打印("): ")
    打印(消息)
}

/**
 * 跳过到指定 token
 */
函数 parser跳过到(p: Parser, target: 文本): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    当 tok.值 != target && tok.类型 != 6 && tok.值 != "" 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
    }

    若 tok.值 == target 则 {
        返回 1
    }
    返回 0
}

/**
 * 跳过到指定类型
 */
函数 parser跳过到类型(p: Parser, 类型: 整数): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    当 tok.类型 != 类型 && tok.类型 != 6 && tok.值 != "" 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
    }

    若 tok.类型 == 类型 则 {
        返回 1
    }
    返回 0
}

/**
 * 同步到函数开始
 */
/**
 * 检查下一个 token 是否为指定值
 */
函数 parser预览(p: Parser, 值: 文本): 整数 {
    定义 可变 savedPos: 整数
    savedPos = p.pos

    定义 可变 tok: Token
    tok = parserPeekToken(p)
    p.pos = p.pos + 1

    p.pos = savedPos

    若 tok.值 == 值 则 {
        返回 1
    }
    返回 0
}

/**
 * 检查下一个 token 是否为指定类型
 */
函数 parser预览类型(p: Parser, 类型: 整数): 整数 {
    定义 可变 savedPos: 整数
    savedPos = p.pos

    定义 可变 tok: Token
    tok = parserPeekToken(p)
    p.pos = p.pos + 1

    p.pos = savedPos

    若 tok.类型 == 类型 则 {
        返回 1
    }
    返回 0
}

/**
 * 尝试恢复解析
 */
函数 parser尝试恢复(p: Parser): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    /* 常见恢复点 */
    若 tok.值 == "函数" 则 { 返回 1 }
    若 tok.值 == "定义" 则 { 返回 1 }
    若 tok.值 == "若" 则 { 返回 1 }
    若 tok.值 == "当" 则 { 返回 1 }
    若 tok.值 == "循环" 则 { 返回 1 }
    若 tok.值 == "返回" 则 { 返回 1 }
    若 tok.值 == "{" 则 { 返回 1 }
    若 tok.值 == "}" 则 { 返回 1 }

    /* 无法恢复 */
    返回 0
}

/**
 * 解析类型注解
 */
函数 parseTypeAnnotation(p: Parser): 文本 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 typeName: 文本
    typeName = ""

    /* 消费 ':' */
    若 tok.值 == ":" 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
        若 tok.类型 == 3 则 {
            typeName = tok.值
            p.pos = p.pos + 1
        }
    }

    返回 typeName
}

/**
 * 解析默认参数值
 */
函数 parseDefaultValue(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 defaultNode: AST节点
    defaultNode = parserCreateNode(14, "", "", tok.行号)

    /* 检查 '=' */
    若 tok.值 == "=" 则 {
        p.pos = p.pos + 1
        defaultNode = parseExpression(p)
    }

    返回 defaultNode
}

/**
 * 解析参数列表
 */
函数 parseParameterList(p: Parser): 列表 {
    定义 可变 params: 列表
    params = 列表()

    定义 可变 tok: Token
    tok = parserPeekToken(p)

    /* 消费 '(' */
    若 tok.值 == "(" 则 {
        p.pos = p.pos + 1
    }

    /* 解析参数 */
    tok = parserPeekToken(p)
    当 tok.值 != ")" && tok.值 != "" && tok.类型 != 6 则 {
        /* 获取参数名 */
        若 tok.类型 == 0 则 {
            定义 可变 paramNode: AST节点
            paramNode = parserCreateNode(2, tok.值, "", tok.行号)
            p.pos = p.pos + 1

            /* 解析类型注解 */
            tok = parserPeekToken(p)
            若 tok.值 == ":" 则 {
                p.pos = p.pos + 1
                tok = parserPeekToken(p)
                若 tok.类型 == 3 则 {
                    paramNode.value = tok.值
                    p.pos = p.pos + 1
                }
            }

            /* 解析默认值 */
            tok = parserPeekToken(p)
            若 tok.值 == "=" 则 {
                定义 可变 defaultVal: AST节点
                defaultVal = parseDefaultValue(p)
                paramNode.children = defaultVal
            }
        }

        /* 消费 ',' */
        tok = parserPeekToken(p)
        若 tok.值 == "," 则 {
            p.pos = p.pos + 1
        }

        tok = parserPeekToken(p)
    }

    /* 消费 ')' */
    若 tok.值 == ")" 则 {
        p.pos = p.pos + 1
    }

    返回 params
}

/**
 * 解析特性注解
 */
函数 parseAttribute(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 attrNode: AST节点
    attrNode = parserCreateNode(0, "", "", tok.行号)

    /* 消费 '@' */
    若 tok.值 == "@" 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
        attrNode.name = tok.值
        p.pos = p.pos + 1

        /* 消费 '(' 如果有参数 */
        tok = parserPeekToken(p)
        若 tok.值 == "(" 则 {
            p.pos = p.pos + 1
            tok = parserPeekToken(p)
            当 tok.值 != ")" && tok.值 != "" 则 {
                p.pos = p.pos + 1
                tok = parserPeekToken(p)
            }
            若 tok.值 == ")" 则 {
                p.pos = p.pos + 1
            }
        }
    }

    返回 attrNode
}

/**
 * 解析 where 子句
 */
函数 parseWhereClause(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 whereNode: AST节点
    whereNode = parserCreateNode(0, "", "", tok.行号)

    /* 消费 'where' */
    若 tok.值 == "where" 则 {
        p.pos = p.pos + 1
        /* 解析约束条件 */
        tok = parserPeekToken(p)
        当 tok.值 != "{" && tok.值 != "" && tok.类型 != 6 则 {
            p.pos = p.pos + 1
            tok = parserPeekToken(p)
        }
    }

    返回 whereNode
}

/* ============ 错误恢复机制 ============ */

/**
 * 创建错误恢复上下文
 */
函数 parser创建错误恢复(): ErrorRecovery {
    定义 可变 recovery: ErrorRecovery
    recovery.已恢复 = 0
    recovery.跳过Token数 = 0
    recovery.恢复点 = 0
    返回 recovery
}

/**
 * 找到同步恢复点
 */
函数 parser找到恢复点(p: Parser): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    /* 优先级恢复点 */
    若 tok.值 == "函数" 则 { 返回 1 }
    若 tok.值 == "定义" 则 { 返回 1 }
    若 tok.值 == "若" 则 { 返回 1 }
    若 tok.值 == "当" 则 { 返回 1 }
    若 tok.值 == "循环" 则 { 返回 1 }
    若 tok.值 == "返回" 则 { 返回 1 }
    若 tok.值 == "{" 则 { 返回 1 }
    若 tok.值 == "}" 则 { 返回 1 }
    若 tok.值 == "结构体" 则 { 返回 1 }
    若 tok.值 == "枚举" 则 { 返回 1 }
    若 tok.值 == "模块" 则 { 返回 1 }
    若 tok.值 == "导入" 则 { 返回 1 }

    返回 0
}

/**
 * 跳过错误token直到恢复点
 */
函数 parser跳过到恢复点(p: Parser): Parser {
    定义 可变 recovery: ErrorRecovery
    recovery = parser创建错误恢复()

    当 p.pos < p.tokenCount && recovery.已恢复 == 0 则 {
        定义 可变 tok: Token
        tok = parserPeekToken(p)

        若 parser找到恢复点(p) == 1 则 {
            recovery.已恢复 = 1
        } 否则 {
            p.pos = p.pos + 1
            recovery.跳过Token数 = recovery.跳过Token数 + 1
        }
    }

    返回 p
}

/**
 * 报告解析错误并尝试恢复
 */
函数 parser错误报告恢复(p: Parser, 消息: 文本): Parser {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    打印("解析错误 [行 ")
    打印(tok.行号)
    打印("]: ")
    打印(消息)

    /* 尝试恢复 */
    p = parser跳过到恢复点(p)

    返回 p
}

/**
 * 检查是否需要插入缺失的 token
 */
函数 parser检查缺失Token(p: Parser, expected: 文本): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    若 tok.值 == expected 则 {
        返回 1
    }

    打印("警告: 期望 '")
    打印(expected)
    打印("'，实际 '")
    打印(tok.值)
    打印("'")

    返回 0
}

/**
 * 插入缺失的 token
 */
函数 parser插入缺失Token(p: Parser, tokenType: 整数, tokenValue: 文本): Token {
    定义 可变 inserted: Token
    inserted.类型 = tokenType
    inserted.值 = tokenValue
    inserted.行号 = p.当前行号
    inserted.列号 = p.当前列号
    inserted.开始位置 = p.当前位置
    inserted.结束位置 = p.当前位置

    打印("插入缺失 token: ")
    打印(tokenValue)

    返回 inserted
}

/**
 * 同步到函数边界
 */
函数 parser同步到函数(p: Parser): Parser {
    定义 可变 depth: 整数
    depth = 0

    当 p.pos < p.tokenCount 则 {
        定义 可变 tok: Token
        tok = parserPeekToken(p)

        若 tok.值 == "函数" && depth == 0 则 {
            返回 p
        }

        若 tok.值 == "{" 则 {
            depth = depth + 1
        } 否则 {
            若 tok.值 == "}" 则 {
                depth = depth - 1
            }
        }

        p.pos = p.pos + 1
    }

    返回 p
}

/**
 * 同步到语句边界
 */
函数 parser同步到语句(p: Parser): Parser {
    当 p.当前位置 < p.源码长度 则 {
        定义 可变 tok: Token
        tok = parserPeekToken(p)

        /* 语句开始关键字 */
        若 tok.值 == "若" 则 { 返回 p }
        若 tok.值 == "当" 则 { 返回 p }
        若 tok.值 == "循环" 则 { 返回 p }
        若 tok.值 == "定义" 则 { 返回 p }
        若 tok.值 == "返回" 则 { 返回 p }
        若 tok.值 == "打印" 则 { 返回 p }
        若 tok.值 == "{" 则 { 返回 p }
        若 tok.值 == "}" 则 { 返回 p }
        若 tok.类型 == 6 则 { 返回 p }

        p.pos = p.pos + 1
    }

    返回 p
}

/**
 * 解析器 panic 模式恢复
 */
函数 parserPanic恢复(p: Parser): Parser {
    打印("进入 panic 模式恢复...")

    p = parser同步到函数(p)

    打印("panic 模式恢复完成")

    返回 p
}

/**
 * 记录解析边界
 */
函数 parser记录边界(p: Parser): 无返回 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    打印("解析位置: 行 ")
    打印(tok.行号)
    打印(", 列 ")
    打印(tok.列号)
}

/**
 * 解析器诊断信息
 */
函数 parser诊断(p: Parser): 无返回 {
    打印("=== 解析器诊断 ===")
    打印("  当前位置: ")
    打印(p.pos)
    打印("/")
    打印(p.tokenCount)
    打印("  节点计数: ")
    打印(p.nodeCount)
    打印("  错误列表长度: ")
    打印(列表长度(p.errors))
}

/**
 * 打印 AST 节点（递归）
 */
函数 打印AST节点(node: AST节点, 缩进: 整数): 无返回 {
    定义 可变 i: 整数
    i = 0

    /* 打印缩进 */
    当 i < 缩进 则 {
        打印("  ")
        i = i + 1
    }

    /* 打印节点类型 */
    定义 可变 类型名: 文本
    类型名 = ""
    若 node.kind == 0 则 { 类型名 = "程序" }
    若 node.kind == 1 则 { 类型名 = "函数定义" }
    若 node.kind == 2 则 { 类型名 = "参数列表" }
    若 node.kind == 3 则 { 类型名 = "变量定义" }
    若 node.kind == 4 则 { 类型名 = "赋值语句" }
    若 node.kind == 5 则 { 类型名 = "if语句" }
    若 node.kind == 6 则 { 类型名 = "while语句" }
    若 node.kind == 7 则 { 类型名 = "循环语句" }
    若 node.kind == 8 则 { 类型名 = "返回语句" }
    若 node.kind == 9 则 { 类型名 = "表达式语句" }
    若 node.kind == 10 则 { 类型名 = "二元表达式" }
    若 node.kind == 11 则 { 类型名 = "一元表达式" }
    若 node.kind == 12 则 { 类型名 = "调用表达式" }
    若 node.kind == 13 则 { 类型名 = "标识符表达式" }
    若 node.kind == 14 则 { 类型名 = "字面量表达式" }
    若 node.kind == 15 则 { 类型名 = "类型转换" }
    若 node.kind == 16 则 { 类型名 = "break语句" }
    若 node.kind == 17 则 { 类型名 = "continue语句" }
    若 node.kind == 18 则 { 类型名 = "块语句" }
    若 node.kind == 19 则 { 类型名 = "赋值表达式" }
    若 node.kind == 20 则 { 类型名 = "for循环" }
    若 node.kind == 21 则 { 类型名 = "结构体定义" }
    若 node.kind == 22 则 { 类型名 = "枚举定义" }
    若 node.kind == 23 则 { 类型名 = "结构体字段" }
    若 node.kind == 24 则 { 类型名 = "枚举成员" }
    若 node.kind == 25 则 { 类型名 = "match语句" }
    若 node.kind == 26 则 { 类型名 = "match分支" }
    若 node.kind == 27 则 { 类型名 = "match默认分支" }
    若 node.kind == 28 则 { 类型名 = "导入语句" }
    若 node.kind == 29 则 { 类型名 = "模块定义" }
    若 node.kind == 30 则 { 类型名 = "外部声明" }

    打印("[")
    打印(类型名)
    打印("]")

    若 node.name != "" 则 {
        打印(" 名称: ")
        打印(node.name)
    }

    若 node.value != "" 则 {
        打印(" 值: '")
        打印(node.value)
        打印("'")
    }

    若 node.line > 0 则 {
        打印(" 行: ")
        打印(node.line)
    }

    打印("")

    /* 递归打印子节点 */
    定义 可变 childCount: 整数
    childCount = 列表长度(node.children)
    i = 0
    当 i < childCount 则 {
        定义 可变 child: AST节点
        child = 列表获取(node.children, i)
        打印AST节点(child, 缩进 + 1)
        i = i + 1
    }
}

/**
 * 打印完整的 AST
 */
函数 打印AST(root: AST节点): 无返回 {
    打印("=== AST 树 ===")
    打印AST节点(root, 0)
    打印("=== AST 结束 ===")
}

/* ============ 解析统计和调试 ============ */

/**
 * 获取解析统计信息
 */
函数 parser获取统计(p: Parser): 列表 {
    定义 可变 stats: 列表
    stats = 列表()
    返回 stats
}

/**
 * 打印解析进度
 */
函数 parser打印进度(p: Parser): 无返回 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    详细输出("解析进度: 位置=")
    详细输出(整数转文本(p.pos))
    详细输出("/")
    详细输出(整数转文本(p.tokenCount))
    详细输出(", 当前Token=")
    详细输出(tok.值)
}

/**
 * 验证解析器状态
 */
函数 parser验证状态(p: Parser): 整数 {
    若 p.pos < 0 则 { 返回 0 }
    若 p.pos > p.tokenCount 则 { 返回 0 }
    返回 1
}

/* ============ 主解析循环 ============ */

函数 parserRun(tokens: 列表): 整数 {
    打印("=== 语法分析 ===")

    定义 可变 p: Parser
    p = parserInit(tokens)

    定义 可变 funcCount: 整数
    funcCount = 0

    定义 可变 tok: Token
    tok = parserPeekToken(p)

    /* 循环解析直到文件结束 */
    当 tok.类型 != 6 && tok.值 != "" && funcCount < 100 则 {
        若 tok.值 == "函数" 则 {
            定义 可变 funcNode: AST节点
            funcNode = parseFunction(p)
            funcCount = funcCount + 1
        } 否则 {
            若 tok.值 == "结构体" 则 {
                定义 可变 structNode: AST节点
                structNode = parseStructDefinition(p)
                打印("解析结构体: ")
                打印(structNode.name)
            } 否则 {
                若 tok.值 == "枚举" 则 {
                    定义 可变 enumNode: AST节点
                    enumNode = parseEnumDefinition(p)
                    打印("解析枚举: ")
                    打印(enumNode.name)
                } 否则 {
                    若 tok.值 == "引入" 则 {
                        定义 可变 importNode: AST节点
                        importNode = parseImportStatement(p)
                        打印("解析导入: ")
                        打印(importNode.name)
                    } 否则 {
                        若 tok.值 == "模块" 则 {
                            定义 可变 moduleNode: AST节点
                            moduleNode = parseModuleDefinition(p)
                            打印("解析模块: ")
                            打印(moduleNode.name)
                        } 否则 {
                            /* 跳过未知 token */
                            p.pos = p.pos + 1
                        }
                    }
                }
            }
        }

        tok = parserPeekToken(p)
    }

    打印("语法分析完成，共解析 ")
    打印(funcCount)
    打印(" 个函数")
    打印("生成 ")
    打印(p.nodeCount)
    打印(" 个 AST 节点")

    返回 funcCount
}

/* ============ AST 构建入口函数 ============ */

/**
 * 分析 Token 列表并返回 AST 根节点
 * 这是解析器的外部入口函数
 */
函数 parser分析Tokens(tokens: 列表, source: 文本): AST节点 {
/*[DBG]     打印("DEBUG parser入口: tokensPtr=") */
/*[DBG]     打印(tokens) */
/*[DBG]     打印(" srcLen=") */
/*[DBG]     打印整数(文本长度(source)) */
/*[DBG]     打印("\n") */
    定义 可变 p: Parser
    p = parserInit(tokens)

    定义 可变 progNode: AST节点
    progNode = parserCreateNode(0, "程序", "", 0)  // kind=0 表示程序节点
    progNode.children = 列表()

    定义 可变 tok: Token
/*[DBG]     打印("DEBUG parser: pos=") 打印整数(p.pos) 打印(" count=") 打印整数(p.tokenCount) 打印("\n") */
/*[DBG]     打印("DEBUG parser: about to peek\n") */
    tok = parserPeekToken(p)
/*[DBG]     打印("DEBUG parser: peek done, type=") */
/*[DBG]     打印整数(tok.类型) */
/*[DBG]     打印(" value='") */
/*[DBG]     打印(tok.值) */
/*[DBG]     打印("'\n") */
/*[DBG]     打印("DEBUG parser: entering loop\n") */

    /* 循环解析直到文件结束 */
    当 tok.类型 != 6 && tok.值 != "" 则 {
/*[DBG]         打印("DEBUG parser loop: tok=") */
/*[DBG]         打印(tok.值) */
/*[DBG]         打印(" type=") */
/*[DBG]         打印整数(tok.类型) */
/*[DBG]         打印("\n") */
        若 tok.值 == "函数" || tok.值 == "function" 则 {
/*[DBG]             打印("DEBUG: calling parseFunction\n") */
            定义 可变 funcNode: AST节点
            funcNode = parseFunction(p)
            progNode.children.追加(funcNode)
/*[DBG]             打印("DEBUG: parseFunction returned\n") */
        } 否则 若 tok.值 == "结构体" || tok.值 == "struct" 则 {
            定义 可变 structNode: AST节点
            structNode = parseStructDefinition(p)
            progNode.children.追加(structNode)
        } 否则 若 tok.值 == "枚举" || tok.值 == "enum" 则 {
            定义 可变 enumNode: AST节点
            enumNode = parseEnumDefinition(p)
            progNode.children.追加(enumNode)
        } 否则 若 tok.值 == "引入" || tok.值 == "import" 则 {
            定义 可变 importNode: AST节点
            importNode = parseImportStatement(p)
            progNode.children.追加(importNode)
        } 否则 若 tok.值 == "模块" || tok.值 == "module" 则 {
            定义 可变 moduleNode: AST节点
            moduleNode = parseModuleDefinition(p)
            progNode.children.追加(moduleNode)
        } 否则 若 tok.值 == "外部" || tok.值 == "extern" 则 {
            定义 可变 externalNode: AST节点
            externalNode = parseExternalDeclaration(p)
            progNode.children.追加(externalNode)
        } 否则 {
            /* 跳过未知 token */
            p.pos = p.pos + 1
        }
        打印("[LOOP next tok='")
        打印(tok.值)
        打印("' type=")
        打印整数(tok.类型)
        打印("\n")
        tok = parserPeekToken(p)
    }

    打印("[PARSER DONE] children=")
    打印整数(列表长度(progNode.children))
    打印("\n")
    返回 progNode
}

/* ============ 外部声明解析 ============ */

/**
 * 解析外部函数声明
 * 语法: 外部 "C函数名"
 */
函数 parseExternalDeclaration(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(30, "", "", line)
    node.children = 列表()

    /* 消费 '外部' */
    tok = parserPeekToken(p)
    若 tok.值 == "外部" 则 {
        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }

    /* 获取函数名字符串 */
    tok = parserPeekToken(p)
    若 tok.类型 == 2 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    返回 node
}


/**
 * @file sema.xy
 * @brief 语义分析器 - 自展编译器
 * @description 作用域管理、类型检查、标识符解析、错误报告
 */



/* ============ AST 节点类型 (与 parser.xy 一致) ============ */


/* ============ AST 节点结构体 ============ */


/* ============ 类型定义 ============ */

/**
 * 基本类型枚举
 */

/* ============ 循环状态管理 ============ */

/**
 * 循环状态 - 用于管理 break/continue 语句的上下文
 */

/* ============ 符号表条目 ============ */


/* ============ 作用域结构 ============ */


/* ============ Sema 状态 ============ */


/* ============ 作用域操作 ============ */

/**
 * 创建新的作用域
 */
函数 创建作用域(sema: Sema, 名称: 文本): 整数 {
    定义 可变 scope: 作用域
    scope.名称 = 名称
    scope.符号表 = 列表()
    scope.层级 = 列表长度(sema.作用域栈)

    若 列表长度(sema.作用域栈) > 0 则 {
        scope.父作用域 = sema.当前作用域
    } 否则 {
        scope.父作用域 = -1
    }

    定义 可变 idx: 整数
    idx = 列表长度(sema.作用域栈)

    /* 将新作用域添加到作用域栈 */
    列表追加(sema.作用域栈, scope)

    sema.当前作用域 = idx

    返回 idx
}

/**
 * 退出当前作用域
 */
函数 退出作用域(sema: Sema): 整数 {
    定义 可变 prevScope: 整数
    prevScope = -1

    若 列表长度(sema.作用域栈) > 0 则 {
        定义 可变 currentScope: 作用域
        currentScope = sema.作用域栈[sema.当前作用域]
        prevScope = currentScope.父作用域
    }

    若 prevScope >= 0 则 {
        sema.当前作用域 = prevScope
    }

    返回 prevScope
}

/* ============ 符号操作 ============ */

/**
 * 查找符号（从当前作用域向上查找）
 */
函数 查找符号(sema: Sema, 名称: 文本): 整数 {
    定义 可变 scopeIdx: 整数
    scopeIdx = sema.当前作用域

    定义 可变 result: 整数
    result = -1  // 未找到

    当 scopeIdx >= 0 && scopeIdx < 列表长度(sema.作用域栈) 则 {
        定义 可变 scope: 作用域
        scope = sema.作用域栈[scopeIdx]

        定义 可变 i: 整数
        i = 0
        当 i < 列表长度(scope.符号表) 则 {
            定义 可变 sym: 符号
            sym = scope.符号表[i]
            若 sym.名称 == 名称 则 {
                result = scopeIdx
                返回 result
            }
            i = i + 1
        }

        若 scope.父作用域 < 0 则 {
            返回 -1
        }
        scopeIdx = scope.父作用域
    }

    返回 result
}

/**
 * 获取符号类型
 */
函数 获取符号类型(sema: Sema, 名称: 文本): 整数 {
    定义 可变 scopeIdx: 整数
    scopeIdx = sema.当前作用域

    当 scopeIdx >= 0 && scopeIdx < 列表长度(sema.作用域栈) 则 {
        定义 可变 scope: 作用域
        scope = sema.作用域栈[scopeIdx]

        定义 可变 i: 整数
        i = 0
        当 i < 列表长度(scope.符号表) 则 {
            定义 可变 sym: 符号
            sym = scope.符号表[i]
            若 sym.名称 == 名称 则 {
                返回 sym.类型
            }
            i = i + 1
        }

        若 scope.父作用域 < 0 则 {
            返回 -1
        }
        scopeIdx = scope.父作用域
    }

    返回 -1
}

/**
 * 在当前作用域查找符号（不向上查找父作用域）
 */
函数 在当前作用域查找符号(sema: Sema, 名称: 文本): 整数 {
/*[DBG]     打印("DBG 查找 当前作用域=") */
/*[DBG]     打印整数(sema.当前作用域) */
/*[DBG]     打印(" 栈长=") */
/*[DBG]     打印整数(列表长度(sema.作用域栈)) */
    若 sema.当前作用域 < 0 || sema.当前作用域 >= 列表长度(sema.作用域栈) 则 {
        返回 -1
    }
/*[DBG]     打印("DBG 查找 读取scope") */
    定义 可变 scope: 作用域
    scope = sema.作用域栈[sema.当前作用域]
/*[DBG]     打印("DBG 查找 scope表长=") */
/*[DBG]     打印整数(列表长度(scope.符号表)) */

    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(scope.符号表) 则 {
/*[DBG]         打印("DBG 查找 sym[") */
/*[DBG]         打印整数(i) */
/*[DBG]         打印("]") */
        定义 可变 sym: 符号
        sym = scope.符号表[i]
        若 sym.名称 == 名称 则 {
            返回 i
        }
        i = i + 1
    }

    返回 -1
}

/**
 * 添加符号到当前作用域
 */
函数 添加符号(sema: Sema, 名称: 文本, 类型: 整数, 可变: 整数): 整数 {
/*[DBG]     打印("DBG 添加符号 开始: ") */
/*[DBG]     打印(名称) */
    // 检查是否已在当前作用域定义
    定义 可变 existingIdx: 整数
    existingIdx = 在当前作用域查找符号(sema, 名称)
/*[DBG]     打印("DBG 添加符号 查找完成") */

    若 existingIdx >= 0 则 {
        报告错误(sema, "符号 '" + 名称 + "' 已在当前作用域定义", sema.当前行号)
        返回 -1
    }

    定义 可变 sym: 符号
    sym.名称 = 名称
    sym.类型 = 类型
    sym.可变 = 可变
    sym.行号 = sema.当前行号
    sym.作用域层级 = sema.当前作用域
    sym.已初始化 = 0

    // 确保当前作用域有效
    若 sema.当前作用域 < 0 || sema.当前作用域 >= 列表长度(sema.作用域栈) 则 {
        创建作用域(sema, "全局")
    }
/*[DBG]     打印("DBG 添加符号 作用域有效") */

    // 添加符号到当前作用域
    定义 可变 scope: 作用域
    scope = 列表获取(sema.作用域栈, sema.当前作用域)
/*[DBG]     打印("DBG 添加符号 读取scope") */
    列表追加(scope.符号表, sym)
/*[DBG]     打印("DBG 添加符号 追加sym") */

    // 更新作用域栈中的作用域
    // 注意：玄语语言中列表元素是值类型，需要重新赋值
    列表设置(sema.作用域栈, sema.当前作用域, scope)
/*[DBG]     打印("DBG 添加符号 列表设置完成 returns") */
/*[DBG]     打印整数(sema.当前作用域) */

    返回 0
}

/* ============ 类型检查 ============ */

/**
 * 检查类型是否兼容
 */
函数 类型兼容(type1: 整数, type2: 整数): 整数 {
    // 相同类型兼容
    若 type1 == type2 则 {
        返回 1
    }

    // 整数和浮点可以转换
    若 type1 == 0 && type2 == 1 则 {
        返回 1
    }
    若 type1 == 1 && type2 == 0 则 {
        返回 1
    }

    // 指针和文本类型兼容
    若 type1 == 3 && type2 == 6 则 { 返回 1 }
    若 type1 == 6 && type2 == 3 则 { 返回 1 }

    返回 0
}

/**
 * 获取类型的字符串表示
 */
函数 类型转文本(type: 整数): 文本 {
    若 type == 0 则 { 返回 "整数" }
    若 type == 1 则 { 返回 "浮点数" }
    若 type == 2 则 { 返回 "布尔" }
    若 type == 3 则 { 返回 "文本" }
    若 type == 4 则 { 返回 "字符" }
    若 type == 5 则 { 返回 "无返回" }
    若 type == 6 则 { 返回 "指针" }
    若 type == 7 则 { 返回 "列表" }
    返回 "未知"
}

/**
 * 获取二元运算的结果类型
 */
函数 二元运算结果类型(leftType: 整数, op: 文本, rightType: 整数): 整数 {
    // 算术运算
    若 op == "+" || op == "-" || op == "*" || op == "/" || op == "%" 则 {
        若 leftType == 1 || rightType == 1 则 {
            返回 1  // 浮点运算返回浮点
        }
        返回 0  // 整数运算返回整数
    }

    // 比较运算返回布尔
    若 op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" 则 {
        返回 2  // 布尔类型
    }

    // 逻辑运算返回布尔
    若 op == "&&" || op == "||" 则 {
        返回 2  // 布尔类型
    }

    // 位运算返回整数
    若 op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" 则 {
        返回 0
    }

    返回 0
}

/**
 * 检查类型是否有效
 */
函数 是有效类型(type: 整数): 整数 {
    若 type >= 0 && type <= 8 则 {
        返回 1
    }
    返回 0
}

/* ============ 错误报告 ============ */

/**
 * 报告错误
 */
函数 报告错误(sema: Sema, 消息: 文本, 行号: 整数): 整数 {
    sema.错误计数 = sema.错误计数 + 1

    打印("[错误]")
    若 行号 > 0 则 {
        打印(" (行")
        打印(行号)
        打印(")")
    }
    打印(": ")
    打印(消息)

    返回 -1
}

/**
 * 报告警告
 */
函数 报告警告(sema: Sema, 消息: 文本, 行号: 整数): 整数 {
    sema.警告计数 = sema.警告计数 + 1

    打印("[警告]")
    若 行号 > 0 则 {
        打印(" (行")
        打印(行号)
        打印(")")
    }
    打印(": ")
    打印(消息)

    返回 0
}

/**
 * 报告详细错误（包含更多信息）
 */
函数 报告详细错误(sema: Sema, 消息: 文本, 行号: 整数, 列号: 整数, 建议: 文本): 整数 {
    sema.错误计数 = sema.错误计数 + 1

    打印("━━━━━━━━━━━━━━━━━━━━━━━━")
    打印("[错误]")
    若 行号 > 0 则 {
        打印(" 位置: 第")
        打印(行号)
        打印("行")
        若 列号 > 0 则 {
            打印(", 第")
            打印(列号)
            打印("列")
        }
    }
    打印("")
    打印("  信息: " + 消息)
    若 建议 != "" 则 {
        打印("  建议: " + 建议)
    }
    打印("━━━━━━━━━━━━━━━━━━━━━━━━")

    返回 -1
}

/**
 * 获取错误统计信息
 */
函数 获取错误统计(sema: Sema): 文本 {
    定义 可变 result: 文本
    result = "错误: "
    result = result + 整数转文本(sema.错误计数)
    result = result + ", 警告: "
    result = result + 整数转文本(sema.警告计数)
    返回 result
}

/* ============ 类型推导 ============ */

/**
 * 推断表达式的类型
 */
函数 推断表达式类型(exprKind: 整数): 整数 {
    // 字面量表达式
    若 exprKind == 14 则 {
        返回 0  // 整数
    }

    // 标识符表达式
    若 exprKind == 13 则 {
        返回 0  // 整数（简化）
    }

    // 调用表达式
    若 exprKind == 12 则 {
        返回 0  // 整数（简化）
    }

    // 二元表达式
    若 exprKind == 10 则 {
        返回 0  // 整数（简化）
    }

    // 一元表达式
    若 exprKind == 11 则 {
        返回 0  // 整数（简化）
    }

    // 赋值表达式
    若 exprKind == 19 则 {
        返回 0  // 整数（简化）
    }

    // 下标访问
    若 exprKind == 20 则 {
        返回 0  // 返回元素类型
    }

    // 字段访问
    若 exprKind == 21 则 {
        返回 0  // 返回字段类型
    }

    返回 0
}

/**
 * 推断二元运算的结果类型
 */
函数 推断二元类型(左: 整数, op: 文本, 右: 整数): 整数 {
    // 算术运算
    若 op == "+" || op == "-" || op == "*" || op == "/" || op == "%" 则 {
        若 左 == 1 || 右 == 1 则 {
            返回 1  // 浮点
        }
        若 左 == 3 || 右 == 3 则 {
            返回 3  // 文本（字符串连接）
        }
        返回 0  // 整数
    }

    // 比较和逻辑运算
    若 op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" 则 {
        返回 2  // 布尔
    }

    // 逻辑运算
    若 op == "&&" || op == "||" 则 {
        返回 2  // 布尔
    }

    // 位运算
    若 op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" 则 {
        返回 0  // 整数
    }

    返回 0
}

/**
 * 检查赋值类型是否兼容
 */
函数 检查赋值兼容性(目标类型: 整数, 源类型: 整数): 整数 {
    // 相同类型
    若 目标类型 == 源类型 则 {
        返回 1
    }

    // 整数和浮点可以互相赋值
    若 (目标类型 == 0 && 源类型 == 1) || (目标类型 == 1 && 源类型 == 0) 则 {
        返回 1
    }

    // 文本和指针可以兼容
    若 (目标类型 == 3 && 源类型 == 6) || (目标类型 == 6 && 源类型 == 3) 则 {
        返回 1
    }

    返回 0
}

/**
 * 推断函数返回类型
 */
函数 推断函数返回类型(funcName: 文本, paramTypes: 列表): 整数 {
    打印("推断函数返回类型: ")
    打印(funcName)

    // 内置函数映射
    若 funcName == "打印" || funcName == "打印整数" 则 {
        返回 5  // void
    }
    若 funcName == "输入整数" 则 {
        返回 0  // 整数
    }
    若 funcName == "输入浮点数" 则 {
        返回 1  // 浮点数
    }
    若 funcName == "输入文本" 则 {
        返回 3  // 文本
    }
    若 funcName == "输入字符" 则 {
        返回 4  // 字符
    }
    若 funcName == "文本长度" || funcName == "列表长度" 则 {
        返回 0  // 整数
    }

    // 默认返回整数
    返回 0
}

/**
 * 推断列表字面量类型
 */
函数 推断列表类型(elementTypes: 列表): 整数 {
    若 列表长度(elementTypes) == 0 则 {
        返回 7  // 空列表
    }

    定义 可变 firstType: 整数
    firstType = elementTypes[0]

    // 检查所有元素类型是否一致
    定义 可变 i: 整数
    i = 1
    当 i < 列表长度(elementTypes) 则 {
        若 elementTypes[i] != firstType 则 {
            返回 0  // 类型不一致，返回基础类型
        }
        i = i + 1
    }

    返回 firstType
}

/**
 * 推断一元运算结果类型
 */
函数 推断一元类型(op: 文本, operandType: 整数): 整数 {
    // 负号
    若 op == "-" 则 {
        若 operandType == 2 则 {
            返回 2  // 布尔取负无意义但返回布尔
        }
        返回 operandType  // 保持原类型
    }

    // 逻辑非
    若 op == "!" 则 {
        返回 2  // 始终返回布尔
    }

    // 位非
    若 op == "~" 则 {
        返回 0  // 始终返回整数
    }

    返回 operandType
}

/**
 * 类型提升规则
 */
函数 类型提升(a: 整数, b: 整数): 整数 {
    // 若任一操作数是浮点，则提升为浮点
    若 a == 1 || b == 1 则 {
        返回 1
    }

    // 否则返回整数
    返回 0
}

/**
 * 推断三目运算类型
 */
函数 推断三目类型(condType: 整数, thenType: 整数, elseType: 整数): 整数 {
    // 条件必须是布尔
    若 condType != 2 则 {
        打印("警告: 三目运算条件应为布尔类型")
    }

    // 两个分支必须兼容
    若 thenType == elseType 则 {
        返回 thenType
    }

    // 应用类型提升规则
    返回 类型提升(thenType, elseType)
}

/**
 * 检查类型是否可转换
 */
函数 是可转换的(fromType: 整数, toType: 整数): 整数 {
    // 相同类型
    若 fromType == toType 则 {
        返回 1
    }

    // 整数和浮点之间可转换
    若 (fromType == 0 || fromType == 1) && (toType == 0 || toType == 1) 则 {
        返回 1
    }

    // 整数可转换为布尔
    若 (fromType == 0 || fromType == 1) && toType == 2 则 {
        返回 1
    }

    // 布尔可转换为整数
    若 fromType == 2 && toType == 0 则 {
        返回 1
    }

    返回 0
}

/**
 * 获取类型的默认宽度（LLVM）
 */
函数 获取类型宽度(typeName: 文本): 整数 {
    若 typeName == "i1" 则 { 返回 1 }
    若 typeName == "i8" 则 { 返回 8 }
    若 typeName == "i16" 则 { 返回 16 }
    若 typeName == "i32" 则 { 返回 32 }
    若 typeName == "i64" 则 { 返回 64 }
    若 typeName == "float" 则 { 返回 32 }
    若 typeName == "double" 则 { 返回 64 }
    返回 64  // 默认64位
}

/**
 * 检查是否为空类型
 */
函数 是空类型(typeIdx: 整数): 整数 {
    若 typeIdx == 5 则 { 返回 1 }  // void
    若 typeIdx == 7 则 { 返回 1 }  // 空列表
    若 typeIdx == 8 则 { 返回 1 }  // 空指针
    返回 0
}

/**
 * 推断下标访问类型
 */
函数 推断下标类型(baseType: 整数, indexType: 整数): 整数 {
    // 下标必须是整数
    若 indexType != 0 则 {
        打印("警告: 下标应为整数类型")
    }

    // 列表返回元素类型
    若 baseType == 7 则 {
        返回 0  // 空列表返回整数
    }

    // 字典返回值类型
    若 baseType == 9 则 {
        返回 0  // 字典返回值类型
    }

    // 字符串返回字符
    若 baseType == 3 则 {
        返回 4  // 字符
    }

    返回 0
}

/**
 * 推断函数调用类型
 */
函数 推断调用类型(funcName: 文本, argTypes: 列表): 整数 {
    定义 可变 argCount: 整数
    argCount = 列表长度(argTypes)

    打印("推断调用类型: ")
    打印(funcName)
    打印(" (参数个数=")
    打印(argCount)
    打印(")")

    // 内置函数映射
    若 funcName == "整数" 则 {
        若 argCount == 1 则 {
            返回 0  // 转整数
        }
    }
    若 funcName == "浮点数" 则 {
        若 argCount == 1 则 {
            返回 1  // 转浮点
        }
    }
    若 funcName == "文本" 则 {
        若 argCount == 1 则 {
            返回 3  // 转文本
        }
    }

    // 默认返回整数
    返回 0
}

/**
 * 检查函数参数类型
 */
函数 检查参数类型(funcName: 文本, paramIdx: 整数, expectedType: 整数, actualType: 整数): 整数 {
    若 expectedType == actualType 则 {
        返回 1
    }

    // 尝试类型转换
    若 是可转换的(actualType, expectedType) == 1 则 {
        返回 1
    }

    打印("警告: 函数 ")
    打印(funcName)
    打印(" 第 ")
    打印(paramIdx)
    打印(" 个参数类型不匹配")
    返回 0
}

/**
 * 推断结构体字段类型
 */
函数 推断字段类型(structName: 文本, fieldName: 文本): 整数 {
    打印("推断字段类型: ")
    打印(structName)
    打印(".")
    打印(fieldName)

    // 默认返回整数
    返回 0
}

/**
 * 类型大小计算
 */
函数 计算类型大小(typeIdx: 整数): 整数 {
    若 typeIdx == 0 则 { 返回 8 }  // 整数 64位
    若 typeIdx == 1 则 { 返回 8 }  // 浮点数 64位
    若 typeIdx == 2 则 { 返回 1 }  // 布尔 8位
    若 typeIdx == 3 则 { 返回 8 }  // 文本指针 64位
    若 typeIdx == 4 则 { 返回 4 }  // 字符 32位
    若 typeIdx == 5 则 { 返回 0 }  // void
    若 typeIdx == 6 则 { 返回 8 }  // 指针 64位
    若 typeIdx == 7 则 { 返回 24 }  // 列表头
    返回 8  // 默认
}

/* ============ 泛型支持框架 ============ */

/**
 * 泛型实例化检查
 */
函数 检查泛型实例化(typeName: 文本, params: 列表): 整数 {
    // 列表类型
    若 typeName == "列表" 则 {
        若 列表长度(params) >= 1 则 {
            返回 1
        }
    }

    // 可选类型
    若 typeName == "可选" 则 {
        若 列表长度(params) >= 1 则 {
            返回 1
        }
    }

    // 结果类型
    若 typeName == "结果" 则 {
        若 列表长度(params) >= 2 则 {
            返回 1
        }
    }

    返回 0
}

/**
 * 获取泛型参数数量
 */
函数 获取泛型参数数量(typeName: 文本): 整数 {
    若 typeName == "列表" 则 { 返回 1 }
    若 typeName == "可选" 则 { 返回 1 }
    若 typeName == "结果" 则 { 返回 2 }
    若 typeName == "字典" 则 { 返回 2 }
    若 typeName == "集合" 则 { 返回 1 }
    返回 0
}

/* ============ 作用域检查 ============ */

/**
 * 检查变量是否在当前作用域中定义
 */
函数 是全局变量(sema: Sema, name: 文本): 整数 {
    定义 可变 idx: 整数
    idx = 查找符号(sema, name)

    若 idx < 0 则 {
        返回 0
    }

    // 简化：全局作用域
    返回 1
}

/**
 * 检查变量是否在作用域中可访问
 */
函数 是可访问的(sema: Sema, name: 文本): 整数 {
    定义 可变 idx: 整数
    idx = 查找符号(sema, name)

    若 idx >= 0 则 {
        返回 1
    }

    返回 0
}

/**
 * 获取变量的作用域层级
 */
函数 获取作用域层级(sema: Sema, name: 文本): 整数 {
    定义 可变 idx: 整数
    idx = 查找符号(sema, name)

    若 idx >= 0 则 {
        返回 0  // 全局作用域
    }

    返回 -1  // 未找到
}

/* ============ 模块和导入支持 ============ */

/**
 * 分析导入语句
 */
函数 分析导入语句(sema: Sema, 模块路径: 文本): 整数 {
    打印("分析导入语句: ")
    打印(模块路径)

    若 模块路径 == "" 则 {
        报告错误(sema, "导入路径不能为空", 0)
        返回 -1
    }

    // 简化：假设导入成功
    返回 0
}

/**
 * 分析模块定义
 */
函数 分析模块定义(sema: Sema, 模块名: 文本): 整数 {
    打印("分析模块定义: ")
    打印(模块名)

    // 创建模块作用域
    定义 可变 moduleScope: 整数
    moduleScope = 创建作用域(sema, 模块名)

    若 moduleScope < 0 则 {
        报告错误(sema, "无法创建模块作用域: " + 模块名, 0)
        返回 -1
    }

    // 退出模块作用域
    sema.当前作用域 = sema.当前作用域 - 1

    返回 0
}

/**
 * 解析模块路径
 */
函数 解析模块路径(path: 文本): 列表 {
    定义 可变 parts: 列表
    parts = 列表()
    返回 parts
}

/**
 * 获取模块前缀
 */
函数 获取模块前缀(moduleName: 文本, symbolName: 文本): 文本 {
    若 moduleName == "" 则 {
        返回 symbolName
    }
    返回 moduleName + "." + symbolName
}

/**
 * 检查符号是否可访问
 */
函数 检查符号可访问性(sema: Sema, 符号名: 文本, 当前模块: 文本): 整数 {
    定义 可变 idx: 整数
    idx = 查找符号(sema, 符号名)

    若 idx >= 0 则 {
        返回 1
    }

    // 检查是否从导入的模块导入
    返回 0
}

/**
 * 注册导入的符号
 */
函数 注册导入符号(sema: Sema, 本地名: 文本, 原始名: 文本, 类型: 整数): 整数 {
    打印("注册导入符号: ")
    打印(本地名)
    打印(" -> ")
    打印(原始名)

    定义 可变 result: 整数
    result = 添加符号(sema, 本地名, 类型, 0)
    返回 result
}

/* ============ AST 遍历语义分析 ============ */

/**
 * 分析 AST 节点
 */
函数 sema分析节点(sema: Sema, nodeKind: 整数, nodeName: 文本): 整数 {
    打印("分析节点: kind=")
    打印(nodeKind)
    打印(", name=")
    打印(nodeName)

    若 nodeKind == 0 则 { 返回 分析标识符(sema, nodeName) }
    若 nodeKind == 2 则 { 返回 分析变量定义(sema, nodeName, 0) }
    若 nodeKind == 3 则 { 返回 分析函数调用(sema, nodeName, 0) }
    若 nodeKind == 5 则 { 返回 分析函数定义(sema, nodeName, 5, 0) }
    若 nodeKind == 10 则 { 返回 分析二元表达式(sema, 0, 0, nodeName) }

    返回 0
}

/**
 * 分析标识符
 */
函数 分析标识符(sema: Sema, name: 文本): 整数 {
    定义 可变 idx: 整数
    idx = 查找符号(sema, name)

    若 idx < 0 则 {
        报告错误(sema, "未定义的标识符: " + name, 0)
        返回 -1
    }

    返回 0
}

/**
 * 分析赋值表达式
 */
函数 分析赋值表达式(sema: Sema, 目标名: 文本, 源类型: 整数): 整数 {
    定义 可变 idx: 整数
    idx = 查找符号(sema, 目标名)

    若 idx < 0 则 {
        报告错误(sema, "赋值目标未定义: " + 目标名, 0)
        返回 -1
    }

    返回 0
}

/**
 * 分析函数调用参数
 */
函数 分析调用参数(sema: Sema, funcName: 文本, argTypes: 列表): 整数 {
    定义 可变 i: 整数
    i = 0

    打印("分析函数 ")
    打印(funcName)
    打印(" 的 ")
    打印(列表长度(argTypes))
    打印(" 个参数")

    当 i < 列表长度(argTypes) && i < 10 则 {
        打印("  参数")
        打印(i)
        打印(" 类型: ")
        打印(argTypes[i])
        i = i + 1
    }

    返回 0
}

/**
 * 分析控制流语句
 */
函数 分析控制流(sema: Sema, stmtKind: 整数): 整数 {
    若 stmtKind == 6 则 {
        打印("分析 if 语句")
    } 否则 {
        若 stmtKind == 7 则 {
            打印("分析 while 语句")
        } 否则 {
            若 stmtKind == 8 则 {
                打印("分析 for 语句")
            }
        }
    }

    返回 0
}

/**
 * 分析类型定义
 */
函数 分析类型定义(sema: Sema, typeName: 文本, typeKind: 整数): 整数 {
    打印("分析类型定义: ")
    打印(typeName)

    定义 可变 existing: 整数
    existing = 查找符号(sema, typeName)

    若 existing >= 0 则 {
        报告错误(sema, "类型已定义: " + typeName, 0)
        返回 -1
    }

    定义 可变 result: 整数
    result = 添加符号(sema, typeName, typeKind, 0)

    返回 result
}

/**
 * 分析结构体字段
 */
函数 分析结构体字段(sema: Sema, structName: 文本, fieldName: 文本, fieldType: 整数): 整数 {
    打印("分析结构体字段: ")
    打印(structName)
    打印(".")
    打印(fieldName)

    返回 0
}

/**
 * 分析枚举成员
 */
函数 分析枚举成员(sema: Sema, enumName: 文本, memberName: 文本, value: 整数): 整数 {
    打印("分析枚举成员: ")
    打印(enumName)
    打印(".")
    打印(memberName)
    打印(" = ")
    打印(value)

    返回 0
}

/**
 * 分析 match 语句分支
 */
函数 分析Match分支(sema: Sema, 分支模式: 文本, 分支体: 整数): 整数 {
    打印("分析 match 分支: ")
    打印(分支模式)

    若 分支模式 == "_" 则 {
        打印("  (默认分支)")
    }

    返回 0
}

/**
 * 分析 break 语句
 */
函数 分析Break语句(sema: Sema): 整数 {
    打印("分析 break 语句")

    定义 可变 idx: 整数
    idx = 查找符号(sema, "__in_loop")

    若 idx < 0 则 {
        报告错误(sema, "break 语句只能在循环中使用", 0)
        返回 -1
    }

    返回 0
}

/**
 * 分析 continue 语句
 */
函数 分析Continue语句(sema: Sema): 整数 {
    打印("分析 continue 语句")

    定义 可变 idx: 整数
    idx = 查找符号(sema, "__in_loop")

    若 idx < 0 则 {
        报告错误(sema, "continue 语句只能在循环中使用", 0)
        返回 -1
    }

    返回 0
}

/**
 * 进入循环作用域
 * 更新循环状态，用于 break/continue 语句检查
 */
函数 sema进入循环(sema: Sema): 无返回 {
    /* 更新循环状态 */
    sema.循环状态.激活 = 1
    sema.循环状态.循环层级 = sema.循环状态.循环层级 + 1

    打印("进入循环作用域，层级: ")
    打印(sema.循环状态.循环层级)
}

/**
 * 退出循环作用域
 * 更新循环状态
 */
函数 sema退出循环(sema: Sema): 无返回 {
    /* 更新循环状态 */
    sema.循环状态.循环层级 = sema.循环状态.循环层级 - 1
    若 sema.循环状态.循环层级 <= 0 则 {
        sema.循环状态.激活 = 0
        sema.循环状态.循环层级 = 0
    }

    打印("退出循环作用域，剩余层级: ")
    打印(sema.循环状态.循环层级)
}

/**
 * 进入函数作用域
 */
函数 sema进入函数(sema: Sema, funcName: 文本): 无返回 {
    打印("进入函数作用域: ")
    打印(funcName)
}

/**
 * 退出函数作用域
 */
函数 sema退出函数(sema: Sema): 无返回 {
    打印("退出函数作用域")
}

/* ============ AST 遍历语义分析核心 ============ */

/**
 * 遍历 AST 根节点进行语义分析
 */
函数 sema遍历AST(sema: Sema, ast: AST节点): 整数 {
    打印("=== 开始语义分析 ===")

    sema.错误计数 = 0
    sema.警告计数 = 0

    /* 注意：全局作用域已经在 semaInit 中创建 */

    定义 可变 errorCount: 整数
    errorCount = 0

    /* 遍历顶层声明 */
    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(ast.children) 则 {
        定义 可变 child: AST节点
        child = 列表获取(ast.children, i)

        若 child.kind == 1 则 {  /* 函数定义 */
            定义 可变 result: 整数
            result = sema遍历函数定义(sema, child)
            若 result < 0 则 {
                errorCount = errorCount + 1
            }
        } 否则 若 child.kind == 3 则 {  /* 变量定义 */
            定义 可变 result: 整数
            result = sema遍历变量定义(sema, child)
            若 result < 0 则 {
                errorCount = errorCount + 1
            }
        } 否则 若 child.kind == 21 则 {  /* 结构体定义 */
            定义 可变 result: 整数
            result = sema遍历结构体定义(sema, child)
            若 result < 0 则 {
                errorCount = errorCount + 1
            }
        } 否则 若 child.kind == 22 则 {  /* 枚举定义 */
            定义 可变 result: 整数
            result = sema遍历枚举定义(sema, child)
            若 result < 0 则 {
                errorCount = errorCount + 1
            }
        } 否则 若 child.kind == 30 则 {  /* 外部声明 - 直接跳过，语义分析不报错 */
            打印("跳过外部声明")
        } 否则 {
            打印("未知顶层声明类型: ")
            打印(child.kind)
        }
        i = i + 1
    }

    打印("=== 语义分析完成 ===")
    打印("错误数: ")
    打印(sema.错误计数)
    打印("警告数: ")
    打印(sema.警告计数)

    返回 errorCount
}

/**
 * 遍历结构体定义
 */
函数 sema遍历结构体定义(sema: Sema, structNode: AST节点): 整数 {
    定义 可变 structName: 文本
    structName = structNode.name

    打印("分析结构体定义: ")
    打印(structName)

    /* 创建结构体作用域 */
    定义 可变 scopeIdx: 整数
    scopeIdx = 创建作用域(sema, structName)

    /* 添加结构体类型符号 */
    定义 可变 result: 整数
    result = 添加符号(sema, structName, 10, 0)

    打印("结构体字段数量: ")
    打印(列表长度(structNode.children))

    退出作用域(sema)

    返回 result
}

/**
 * 遍历枚举定义
 */
函数 sema遍历枚举定义(sema: Sema, enumNode: AST节点): 整数 {
    定义 可变 enumName: 文本
    enumName = enumNode.name

    打印("分析枚举定义: ")
    打印(enumName)

    /* 添加枚举类型符号 */
    定义 可变 result: 整数
    result = 添加符号(sema, enumName, 11, 0)

    打印("枚举成员数量: ")
    打印(列表长度(enumNode.children))

    返回 result
}

/**
 * 遍历函数定义
 * 完整的函数定义分析，包括：
 * 1. 解析函数名和返回类型
 * 2. 分析参数列表并添加到作用域
 * 3. 将函数添加到符号表
 * 4. 分析函数体
 * 5. 检查返回值
 */
函数 sema遍历函数定义(sema: Sema, funcNode: AST节点): 整数 {
    定义 可变 funcName: 文本
    funcName = funcNode.name

    /* 设置当前函数信息 */
    sema.当前函数名 = funcName
    sema.当前函数返回类型 = 0  /* 默认整数类型 */

    打印("分析函数定义: ")
    打印(funcName)

    /* 首先将函数添加到当前作用域 */
    定义 可变 result: 整数
    result = 添加符号(sema, funcName, sema.当前函数返回类型, 0)
    若 result < 0 则 {
        返回 -1
    }

    /* 进入函数作用域 */
    定义 可变 functionScopeIdx: 整数
    functionScopeIdx = 创建作用域(sema, funcName + "_作用域")
    sema进入函数(sema, funcName)

    /* 分析参数列表 */
    若 列表长度(funcNode.children) > 1 则 {
        定义 可变 paramListNode: AST节点
        paramListNode = 列表获取(funcNode.children, 0)
        若 paramListNode.kind == 2 则 {  /* 参数列表节点 */
            result = sema分析参数列表(sema, paramListNode)
            若 result < 0 则 {
                退出作用域(sema)
                返回 -1
            }
        }
    }

    /* 分析函数体 */
    定义 可变 bodyIdx: 整数
    bodyIdx = 1  /* 默认 body 在索引 1 */
    若 列表长度(funcNode.children) == 1 则 {
        bodyIdx = 0  /* 如果只有一个子节点，就是 body */
    }

    定义 可变 body: AST节点
    body = 列表获取(funcNode.children, bodyIdx)

    打印("函数体 kind=")
    打印(body.kind)

    result = 0
    若 body.kind == 18 则 {  /* 块语句 */
        打印("遍历块语句")
        result = sema遍历块语句(sema, body)
    } 否则 {
        /* 单表达式函数体 */
        打印("遍历表达式")
        定义 可变 exprType: 整数
        exprType = sema遍历表达式(sema, body)

        /* 检查返回类型 */
        若 exprType >= 0 && sema.当前函数返回类型 >= 0 则 {
            若 类型兼容(exprType, sema.当前函数返回类型) == 0 则 {
                报告错误(sema, "函数返回类型不匹配: 期望 " + 类型转文本(sema.当前函数返回类型) +
                     ", 实际 " + 类型转文本(exprType), funcNode.line)
            }
        }
    }

    /* 退出函数作用域 */
    sema退出函数(sema)
    退出作用域(sema)

    /* 清除当前函数信息 */
    sema.当前函数名 = ""
    sema.当前函数返回类型 = -1

    返回 result
}

/**
 * 分析参数列表
 * 解析函数参数并添加到作用域
 */
函数 sema分析参数列表(sema: Sema, paramListNode: AST节点): 整数 {
    打印("分析参数列表，参数个数: ")
    打印(列表长度(paramListNode.children))

    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(paramListNode.children) 则 {
        定义 可变 paramNode: AST节点
        paramNode = 列表获取(paramListNode.children, i)

        /* 参数节点应该是标识符或变量定义 */
        定义 可变 paramName: 文本
        paramName = paramNode.name

        /* 默认参数类型为整数 */
        定义 可变 paramType: 整数
        paramType = 0

        打印("  参数: ")
        打印(paramName)
        打印(" 类型: ")
        打印(类型转文本(paramType))

        /* 添加参数到作用域 */
        定义 可变 result: 整数
        result = 添加符号(sema, paramName, paramType, 1)  /* 参数是可变的 */
        若 result < 0 则 {
            返回 -1
        }

        i = i + 1
    }

    返回 0
}

/**
 * 遍历块语句
 */
函数 sema遍历块语句(sema: Sema, block: AST节点): 整数 {
    定义 可变 i: 整数
    i = 0
    定义 可变 errorCount: 整数
    errorCount = 0

    打印("分析块语句, children=")
    打印(列表长度(block.children))

    当 i < 列表长度(block.children) 则 {
        定义 可变 stmt: AST节点
        stmt = block.children[i]

        定义 可变 result: 整数
        result = sema遍历语句(sema, stmt)
        若 result < 0 则 {
            errorCount = errorCount + 1
        }

        i = i + 1
    }

    返回 errorCount
}

/**
 * 遍历语句
 */
函数 sema遍历语句(sema: Sema, stmt: AST节点): 整数 {
    定义 可变 result: 整数
    result = 0

    若 stmt.kind == 3 则 {  /* 变量定义 */
        result = sema遍历变量定义(sema, stmt)
    } 否则 若 stmt.kind == 12 则 {  /* 函数调用表达式 */
        result = sema遍历函数调用(sema, stmt.name, stmt.children)
    } 否则 若 stmt.kind == 5 则 {  /* if 语句 */
        result = sema遍历If语句(sema, stmt)
    } 否则 若 stmt.kind == 6 则 {  /* while 语句 */
        result = sema遍历While语句(sema, stmt)
    } 否则 若 stmt.kind == 20 则 {  /* for 语句 */
        result = sema遍历For语句(sema, stmt)
    } 否则 若 stmt.kind == 8 则 {  /* return 语句 */
        result = sema遍历返回语句(sema, stmt)
    } 否则 若 stmt.kind == 10 则 {  /* 二元表达式语句 */
        若 列表长度(stmt.children) >= 2 则 {
            定义 可变 leftChild: AST节点
            定义 可变 rightChild: AST节点
            leftChild = 列表获取(stmt.children, 0)
            rightChild = 列表获取(stmt.children, 1)
            result = sema遍历二元表达式(sema, stmt.name, leftChild, rightChild)
        }
    } 否则 若 stmt.kind == 16 则 {  /* break 语句 */
        result = sema遍历Break语句(sema, stmt)
    } 否则 若 stmt.kind == 17 则 {  /* continue 语句 */
        result = sema遍历Continue语句(sema, stmt)
    } 否则 若 stmt.kind == 25 则 {  /* match 语句 */
        若 列表长度(stmt.children) >= 1 则 {
            定义 可变 matchSubject: AST节点
            matchSubject = 列表获取(stmt.children, 0)
            定义 可变 subjectType: 整数
            subjectType = sema遍历表达式(sema, matchSubject)

            定义 可变 branchCount: 整数
            branchCount = 列表长度(stmt.children) - 1
            result = 分析Match语句(sema, subjectType, branchCount)
        }
    }

    返回 result
}

/**
 * 遍历变量定义
 * 完整的变量定义分析，包括：
 * 1. 解析变量名和类型注解
 * 2. 检查变量是否重定义
 * 3. 添加变量到符号表
 * 4. 分析初始化表达式
 * 5. 检查类型兼容性
 */
函数 sema遍历变量定义(sema: Sema, varNode: AST节点): 整数 {
    定义 可变 varName: 文本
    varName = varNode.name

    打印("分析变量定义: ")
    打印(varName)

    /* 检查是否已在当前作用域定义 */
    定义 可变 existing: 整数
    existing = 在当前作用域查找符号(sema, varName)

    若 existing >= 0 则 {
        报告错误(sema, "变量 '" + varName + "' 已在当前作用域定义", varNode.line)
        返回 -1
    }

    /* 解析变量类型（从 intValue 或 name 推断） */
    定义 可变 varType: 整数
    varType = varNode.intValue
    若 varType < 0 || varType > 8 则 {
        varType = 0  /* 默认整数类型 */
    }

    /* 检查是否是可变变量 */
    定义 可变 isMutable: 整数
    isMutable = 0  /* 默认不可变 */
    /* 可以从 varNode.value 或其他字段获取可变信息 */
    若 varNode.value == "可变" 则 {
        isMutable = 1
    }

    /* 添加变量到符号表 */
    定义 可变 result: 整数
    result = 添加符号(sema, varName, varType, isMutable)
    若 result < 0 则 {
        返回 -1
    }
/*[DBG]     打印("DBG 遍历变量定义 添加完成 children长度=") */
/*[DBG]     打印整数(列表长度(varNode.children)) */

    /* 分析初始化表达式 */
    若 列表长度(varNode.children) > 0 则 {
        定义 可变 initExpr: AST节点
        initExpr = 列表获取(varNode.children, 0)

        定义 可变 initType: 整数
        initType = sema遍历表达式(sema, initExpr)

        /* 检查初始化类型兼容性 */
        若 initType >= 0 则 {
            若 类型兼容(varType, initType) == 0 则 {
                报告警告(sema, "变量 '" + varName + "' 初始化类型不兼容: 期望 " +
                          类型转文本(varType) + ", 实际 " + 类型转文本(initType), varNode.line)
            }
        }
    }

    返回 result
}

/**
 * 遍历 if 语句
 */
函数 sema遍历If语句(sema: Sema, ifNode: AST节点): 整数 {
    打印("分析 if 语句")

    定义 可变 cond: AST节点
    cond = 列表获取(ifNode.children, 0)

    定义 可变 condType: 整数
    condType = sema遍历表达式(sema, cond)

    /* 条件必须是布尔类型 */
    若 condType != 2 则 {
        报告警告(sema, "if 条件应为布尔类型", 0)
    }

    /* 分析 then 块 */
    定义 可变 thenBlock: AST节点
    thenBlock = 列表获取(ifNode.children, 1)
    定义 可变 result: 整数
    result = sema遍历块语句(sema, thenBlock)

    /* 分析 else 块 */
    定义 可变 childrenLen: 整数
    childrenLen = 列表长度(ifNode.children)
    若 childrenLen >= 3 则 {
        定义 可变 elseBlock: AST节点
        elseBlock = 列表获取(ifNode.children, 2)
        定义 可变 elseResult: 整数
        elseResult = sema遍历块语句(sema, elseBlock)
        若 elseResult < 0 则 {
            result = elseResult
        }
    }

    返回 result
}

/**
 * 遍历 while 语句
 */
函数 sema遍历While语句(sema: Sema, whileNode: AST节点): 整数 {
    打印("分析 while 语句")

    /* 进入循环作用域 */
    sema进入循环(sema)

    /* 分析条件表达式 */
    若 列表长度(whileNode.children) >= 1 则 {
        定义 可变 cond: AST节点
        cond = 列表获取(whileNode.children, 0)

        定义 可变 condType: 整数
        condType = sema遍历表达式(sema, cond)

        /* 条件应该是布尔类型 */
        若 condType != 2 && condType != 8 则 {
            报告警告(sema, "while 条件应为布尔类型", whileNode.line)
        }
    }

    /* 分析循环体 */
    定义 可变 result: 整数
    result = 0
    若 列表长度(whileNode.children) >= 2 则 {
        定义 可变 body: AST节点
        body = 列表获取(whileNode.children, 1)

        若 body.kind == 18 则 {
            result = sema遍历块语句(sema, body)
        } 否则 {
            result = sema遍历表达式(sema, body)
        }
    }

    /* 退出循环作用域 */
    sema退出循环(sema)

    返回 result
}

/**
 * 遍历 break 语句
 * 检查 break 语句是否在循环中
 */
函数 sema遍历Break语句(sema: Sema, breakNode: AST节点): 整数 {
    打印("分析 break 语句")

    /* 检查是否在循环中 */
    若 sema.循环状态.激活 == 0 则 {
        报告错误(sema, "break 语句只能在循环中使用", breakNode.line)
        返回 -1
    }

    返回 0
}

/**
 * 遍历 continue 语句
 * 检查 continue 语句是否在循环中
 */
函数 sema遍历Continue语句(sema: Sema, continueNode: AST节点): 整数 {
    打印("分析 continue 语句")

    /* 检查是否在循环中 */
    若 sema.循环状态.激活 == 0 则 {
        报告错误(sema, "continue 语句只能在循环中使用", continueNode.line)
        返回 -1
    }

    返回 0
}

/**
 * 遍历 for 语句
 */
函数 sema遍历For语句(sema: Sema, forNode: AST节点): 整数 {
    打印("分析 for 语句")

    /* 进入循环作用域 */
    sema进入循环(sema)

    /* 分析初始化 */
    定义 可变 init: AST节点
    init = 列表获取(forNode.children, 0)
    定义 可变 initResult: 整数
    initResult = sema遍历表达式(sema, init)

    /* 分析条件 */
    定义 可变 cond: AST节点
    cond = 列表获取(forNode.children, 1)
    定义 可变 condType: 整数
    condType = sema遍历表达式(sema, cond)

    /* 分析循环体 */
    定义 可变 body: AST节点
    body = 列表获取(forNode.children, 2)
    定义 可变 result: 整数
    result = sema遍历块语句(sema, body)

    /* 退出循环作用域 */
    sema退出循环(sema)

    返回 result
}

/**
 * 遍历返回语句
 */
函数 sema遍历返回语句(sema: Sema, retNode: AST节点): 整数 {
    打印("分析 return 语句")

    若 retNode.children.kind != 0 则 {
        定义 可变 exprType: 整数
        exprType = sema遍历表达式(sema, retNode.children)
    }

    返回 0
}

/**
 * 遍历表达式
 * 完整的表达式分析，包括：
 * 1. 标识符查找和类型获取
 * 2. 字面量类型推断
 * 3. 二元表达式类型检查
 * 4. 一元表达式类型检查
 * 5. 函数调用类型检查
 */
函数 sema遍历表达式(sema: Sema, expr: AST节点): 整数 {
    定义 可变 exprType: 整数
    exprType = 8  /* 默认为未知类型 */

    /* 更新当前行号 */
    sema.当前行号 = expr.line

    若 expr.kind == 13 则 {  /* 标识符表达式 */
        exprType = sema遍历标识符(sema, expr.name)
    } 否则 若 expr.kind == 14 则 {  /* 字面量表达式 */
        /* 根据字面量值推断类型 */
        定义 可变 val: 文本
        val = expr.value
        若 val == "真" || val == "假" 则 {
            exprType = 2  /* 布尔类型 */
        } 否则 若 val == "\"" || (文本长度(val) > 0 && val[0] == "\"") 则 {
            exprType = 3  /* 文本类型 */
        } 否则 若 val == "'" || (文本长度(val) > 0 && val[0] == "'") 则 {
            exprType = 4  /* 字符类型 */
        } 否则 若 文本包含(val, ".") == 1 则 {
            exprType = 1  /* 浮点类型 */
        } 否则 {
            exprType = 0  /* 整数类型 */
        }
    } 否则 若 expr.kind == 10 则 {  /* 二元表达式 */
        若 列表长度(expr.children) >= 2 则 {
            定义 可变 leftChild: AST节点
            定义 可变 rightChild: AST节点
            leftChild = 列表获取(expr.children, 0)
            rightChild = 列表获取(expr.children, 1)
            exprType = sema遍历二元表达式(sema, expr.name, leftChild, rightChild)
        }
    } 否则 若 expr.kind == 11 则 {  /* 一元表达式 */
        若 列表长度(expr.children) >= 1 则 {
            定义 可变 operand: AST节点
            operand = 列表获取(expr.children, 0)
            exprType = sema遍历一元表达式(sema, expr.name, operand)
        }
    } 否则 若 expr.kind == 12 则 {  /* 调用表达式 */
        exprType = sema遍历函数调用(sema, expr.name, expr.children)
    } 否则 若 expr.kind == 19 则 {  /* 赋值表达式 */
        若 列表长度(expr.children) >= 2 则 {
            定义 可变 targetNode: AST节点
            定义 可变 valueNode: AST节点
            targetNode = 列表获取(expr.children, 0)
            valueNode = 列表获取(expr.children, 1)
            exprType = sema遍历赋值表达式(sema, targetNode, valueNode)
        }
    } 否则 {
        /* 其他类型默认未知，后续可以扩展 */
        exprType = 0
    }

    返回 exprType
}

/**
 * 遍历赋值表达式
 * 检查赋值目标和值的类型兼容性
 */
函数 sema遍历赋值表达式(sema: Sema, target: AST节点, value: AST节点): 整数 {
    /* 分析目标表达式 */
    定义 可变 targetType: 整数
    targetType = sema遍历表达式(sema, target)

    /* 分析值表达式 */
    定义 可变 valueType: 整数
    valueType = sema遍历表达式(sema, value)

    /* 检查类型兼容性 */
    若 targetType >= 0 && valueType >= 0 则 {
        若 检查赋值兼容性(targetType, valueType) == 0 则 {
            报告错误(sema, "赋值类型不兼容: 目标类型 " + 类型转文本(targetType) +
                     ", 值类型 " + 类型转文本(valueType), sema.当前行号)
        }
    }

    /* 赋值表达式返回目标类型 */
    返回 targetType
}

/**
 * 遍历标识符
 */
函数 sema遍历标识符(sema: Sema, name: 文本): 整数 {
    定义 可变 idx: 整数
    idx = 查找符号(sema, name)

    若 idx < 0 则 {
        报告错误(sema, "未定义的标识符: " + name, 0)
        返回 -1
    }

    定义 可变 symType: 整数
    symType = 获取符号类型(sema, name)
    返回 symType
}

/**
 * 遍历二元表达式
 */
函数 sema遍历二元表达式(sema: Sema, op: 文本, left: AST节点, right: AST节点): 整数 {
    定义 可变 leftType: 整数
    leftType = sema遍历表达式(sema, left)

    定义 可变 rightType: 整数
    rightType = sema遍历表达式(sema, right)

    /* 检查类型兼容性 */
    若 类型兼容(leftType, rightType) == 0 则 {
        报告错误(sema, "二元运算操作数类型不匹配", 0)
    }

    /* 比较运算需要整数或浮点类型，不支持指针/文本类型直接比较 */
    若 op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" 则 {
        若 leftType < 0 || leftType == 3 || leftType == 6 则 {
            报告错误(sema, "文本类型不支持直接比较，请使用运行时字符串比较函数", 0)
        }
    }

    /* 返回结果类型 */
    若 op == "+" || op == "-" || op == "*" || op == "/" || op == "%" 则 {
        返回 leftType  /* 算术运算返回左操作数类型 */
    }

    /* 如果左操作数是文本类型，比较结果应该通过运行时函数返回，这里返回整数表示错误 */
    若 leftType < 0 || leftType == 3 || leftType == 6 则 {
        返回 0  /* 返回整数表示类型错误 */
    }

    返回 2  /* 比较和逻辑运算返回布尔类型 */
}

/**
 * 遍历一元表达式
 */
函数 sema遍历一元表达式(sema: Sema, op: 文本, operand: AST节点): 整数 {
    定义 可变 operandType: 整数
    operandType = sema遍历表达式(sema, operand)

    若 op == "!" 则 {
        返回 2  /* 逻辑非返回布尔类型 */
    }

    返回 operandType  /* 其他一元运算保持原类型 */
}

/**
 * 遍历函数调用
 */
函数 sema遍历函数调用(sema: Sema, funcName: 文本, args: 列表): 整数 {
    打印("分析函数调用: ")
    打印(funcName)

    定义 可变 funcIdx: 整数
    funcIdx = 查找符号(sema, funcName)

    若 funcIdx < 0 则 {
        报告错误(sema, "调用未定义的函数: " + funcName, 0)
        返回 -1
    }

    /* 分析参数 */
    定义 可变 i: 整数
    i = 0
    当 i < 列表长度(args) && i < 10 则 {
        定义 可变 arg: AST节点
        arg = 列表获取(args, i)
        定义 可变 argType: 整数
        argType = sema遍历表达式(sema, arg)
        i = i + 1
    }

    /* 推断返回类型 */
    定义 可变 returnType: 整数
    returnType = 推断函数返回类型(funcName, args)

    返回 returnType
}

/**
 * 注册内置函数
 */
函数 注册内置函数(sema: Sema): 无返回 {
    打印("注册内置函数...")

    定义 可变 result: 整数
    /* 基本I/O */
    result = 添加符号(sema, "打印", 5, 0)
    result = 添加符号(sema, "打印整数", 5, 0)
    result = 添加符号(sema, "输入整数", 0, 0)
    result = 添加符号(sema, "输入文本", 3, 0)
    /* 文本操作 */
    result = 添加符号(sema, "文本长度", 0, 0)
    result = 添加符号(sema, "文本拼接", 3, 0)
    result = 添加符号(sema, "文本转整数", 0, 0)
    result = 添加符号(sema, "整数转文本", 3, 0)
    result = 添加符号(sema, "整数转文本内部", 3, 0)
    result = 添加符号(sema, "文本获取字符", 3, 0)
    result = 添加符号(sema, "字符编码", 0, 0)
    result = 添加符号(sema, "文本切片", 3, 0)
    /* 列表操作 */
    result = 添加符号(sema, "列表", 7, 0)
    result = 添加符号(sema, "列表长度", 0, 0)
    result = 添加符号(sema, "列表追加", 5, 0)
    result = 添加符号(sema, "列表获取", 7, 0)
    result = 添加符号(sema, "列表设置", 5, 0)
    /* 方法调用别名 */
    result = 添加符号(sema, "追加", 5, 0)
    result = 添加符号(sema, "获取", 7, 0)
    result = 添加符号(sema, "设置", 5, 0)
    /* 文件操作 */
    result = 添加符号(sema, "读取文件", 3, 0)
    result = 添加符号(sema, "写入文件", 0, 0)
    result = 添加符号(sema, "文件存在", 2, 0)
    result = 添加符号(sema, "删除文件", 0, 0)
    result = 添加符号(sema, "执行命令", 0, 0)
    /* 程序参数 */
    result = 添加符号(sema, "参数个数", 0, 0)
    result = 添加符号(sema, "命令行参数", 3, 0)
    result = 添加符号(sema, "获取参数个数", 0, 0)
    result = 添加符号(sema, "获取参数", 3, 0)
    /* UTF-8工具 */
    result = 添加符号(sema, "utf8字节长度", 0, 0)
    result = 添加符号(sema, "是utf8首字节", 2, 0)
    result = 添加符号(sema, "是utf8续字节", 2, 0)
    /* 字符判断 */
    result = 添加符号(sema, "是空格", 2, 0)
    result = 添加符号(sema, "是数字", 2, 0)
    result = 添加符号(sema, "是字母", 2, 0)
    result = 添加符号(sema, "是字母数字", 2, 0)
    /* 错误处理 */
    result = 添加符号(sema, "运行时错误", 5, 0)
}

/* ============ 语义分析函数 ============ */

/**
 * 分析变量定义
 */
函数 分析变量定义(sema: Sema, 名称: 文本, 类型: 整数): 整数 {
    打印("分析变量定义: ")
    打印(名称)

    // 检查是否已定义
    定义 可变 existing: 整数
    existing = 查找符号(sema, 名称)

    若 existing >= 0 则 {
        打印("错误: 变量 ")
        打印(名称)
        打印(" 已定义")
        返回 -1
    }

    // 添加符号
    定义 可变 result: 整数
    result = 添加符号(sema, 名称, 类型, 0)

    返回 result
}

/**
 * 分析函数调用
 */
函数 分析函数调用(sema: Sema, 函数名: 文本, 参数个数: 整数): 整数 {
    打印("分析函数调用: ")
    打印(函数名)
    打印(" (参数个数=")
    打印(参数个数)
    打印(")")

    // 检查函数是否定义
    定义 可变 funcIdx: 整数
    funcIdx = 查找符号(sema, 函数名)

    若 funcIdx < 0 则 {
        报告错误(sema, "函数未定义: " + 函数名, 0)
        返回 -1
    }

    返回 0
}

/**
 * 分析二元表达式
 */
函数 分析二元表达式(sema: Sema, 左类型: 整数, 右类型: 整数, 运算符: 文本): 整数 {
    打印("分析二元表达式: ")
    打印(运算符)

    // 检查类型兼容
    若 类型兼容(左类型, 右类型) == 0 则 {
        打印("警告: 类型不匹配")
    }

    // 算术运算返回整数
    若 运算符 == "+" || 运算符 == "-" || 运算符 == "*" || 运算符 == "/" || 运算符 == "%" 则 {
        若 左类型 == 1 || 右类型 == 1 则 {
            返回 1 // 浮点运算返回浮点
        }
        返回 0 // 整数运算返回整数
    }

    // 比较运算返回布尔
    若 运算符 == "==" || 运算符 == "!=" || 运算符 == "<" || 运算符 == ">" || 运算符 == "<=" || 运算符 == ">=" 则 {
        返回 2 // 布尔类型
    }

    // 逻辑运算返回布尔
    若 运算符 == "&&" || 运算符 == "||" 则 {
        若 左类型 != 2 || 右类型 != 2 则 {
            报告警告(sema, "逻辑运算需要布尔操作数", 0)
        }
        返回 2
    }

    返回 0
}

/**
 * 分析一元表达式
 */
函数 分析一元表达式(sema: Sema, 操作数类型: 整数, 运算符: 文本): 整数 {
    打印("分析一元表达式: ")
    打印(运算符)

    // 负号运算符
    若 运算符 == "-" 则 {
        若 操作数类型 == 2 则 {
            报告警告(sema, "布尔类型取负无意义", 0)
        }
        返回 操作数类型
    }

    // 逻辑非
    若 运算符 == "!" 则 {
        若 操作数类型 != 2 则 {
            报告警告(sema, "逻辑非需要布尔操作数", 0)
        }
        返回 2
    }

    返回 操作数类型
}

/**
 * 分析 if 语句
 */
函数 分析If语句(sema: Sema, 条件类型: 整数): 整数 {
    打印("分析 if 语句")

    // 条件必须是布尔类型
    若 条件类型 != 2 则 {
        打印("警告: if 条件应为布尔类型")
    }

    返回 0
}

/**
 * 分析 while 语句
 */
函数 分析While语句(sema: Sema, 条件类型: 整数): 整数 {
    打印("分析 while 语句")

    // 条件必须是布尔类型
    若 条件类型 != 2 则 {
        打印("警告: while 条件应为布尔类型")
    }

    返回 0
}

/**
 * 分析 for 语句
 */
函数 分析For语句(sema: Sema, 起始类型: 整数, 结束类型: 整数): 整数 {
    打印("分析 for 语句")

    若 起始类型 != 0 && 起始类型 != 1 则 {
        报告警告(sema, "for 循环起始值应为数值类型", 0)
    }

    若 结束类型 != 0 && 结束类型 != 1 则 {
        报告警告(sema, "for 循环结束值应为数值类型", 0)
    }

    返回 0
}

/**
 * 分析 return 语句
 */
函数 分析返回语句(sema: Sema, 返回类型: 整数, 表达式类型: 整数): 整数 {
    打印("分析 return 语句")

    若 返回类型 == 5 则 {
        // void 函数
        若 表达式类型 != 5 && 表达式类型 >= 0 则 {
            报告警告(sema, "void 函数不应有返回值", 0)
        }
        返回 0
    }

    若 表达式类型 < 0 则 {
        报告错误(sema, "return 语句缺少表达式", 0)
        返回 -1
    }

    若 检查赋值兼容性(返回类型, 表达式类型) == 0 则 {
        报告错误(sema, "返回值类型不匹配", 0)
        返回 -1
    }

    返回 0
}

/**
 * 分析函数定义
 */
函数 分析函数定义(sema: Sema, 函数名: 文本, 返回类型: 整数, 参数个数: 整数): 整数 {
    打印("分析函数定义: ")
    打印(函数名)

    // 检查是否已定义
    定义 可变 existing: 整数
    existing = 查找符号(sema, 函数名)

    若 existing >= 0 则 {
        报告错误(sema, "函数已定义: " + 函数名, 0)
        返回 -1
    }

    // 添加函数符号
    定义 可变 result: 整数
    result = 添加符号(sema, 函数名, 返回类型, 0)

    返回 result
}

/**
 * 分析结构体定义
 */
函数 分析结构体定义(sema: Sema, 结构体名: 文本, 字段个数: 整数): 整数 {
    打印("分析结构体定义: ")
    打印(结构体名)

    // 创建结构体作用域
    定义 可变 scopeIdx: 整数
    scopeIdx = 创建作用域(sema, 结构体名)

    若 scopeIdx < 0 则 {
        报告错误(sema, "无法创建结构体作用域", 0)
        返回 -1
    }

    返回 0
}

/**
 * 分析枚举定义
 */
函数 分析枚举定义(sema: Sema, 枚举名: 文本, 成员个数: 整数): 整数 {
    打印("分析枚举定义: ")
    打印(枚举名)

    // 添加枚举类型
    定义 可变 typeIdx: 整数
    typeIdx = 添加符号(sema, 枚举名, 0, 0)

    返回 0
}

/**
 * 分析 match 语句
 */
函数 分析Match语句(sema: Sema, 主题类型: 整数, 分支个数: 整数): 整数 {
    打印("分析 match 语句，分支数=")
