/**
 * @file types.xy
 * @brief 玄语L2编译器 - 共享类型定义
 * @description 所有模块共享的类型、枚举、结构体定义
 */

/* ============ Token 类型枚举 ============ */

枚举 TokenType {
    标识符,     // 0 - Id
    数字,       // 1 - Num
    字符串,     // 2 - Str
    关键字,     // 3 - Kw
    运算符,     // 4 - Op
    符号,       // 5 - Sym
    结束,       // 6 - Eof
    注释,       // 7 - Comment
    字符,       // 8 - Char
    赋值,       // 9 - Assign
    比较,       // 10 - Compare
    逻辑,       // 11 - Logical
    错误        // 12 - Error
}

/* ============ Token 结构 ============ */

结构体 Token {
    类型: 整数,      // TokenType
    值: 文本,        // token 文本值
    行号: 整数,      // 所在行
    列号: 整数,      // 所在列
    开始位置: 整数,  // 在源码中的开始位置
    结束位置: 整数   // 在源码中的结束位置
}

/* ============ AST 节点类型 ============ */

枚举 AST节点类型 {
    程序 = 0,
    函数定义 = 1,
    参数列表 = 2,
    变量定义 = 3,
    赋值语句 = 4,
    if语句 = 5,
    while语句 = 6,
    循环语句 = 7,
    返回语句 = 8,
    表达式语句 = 9,
    二元表达式 = 10,
    一元表达式 = 11,
    调用表达式 = 12,
    标识符表达式 = 13,
    字面量表达式 = 14,
    类型转换 = 15,
    break语句 = 16,
    continue语句 = 17,
    块语句 = 18,
    赋值表达式 = 19,
    for循环 = 20,
    结构体定义 = 21,
    枚举定义 = 22,
    结构体字段 = 23,
    枚举成员 = 24,
    match语句 = 25,
    match分支 = 26,
    match默认分支 = 27,
    导入语句 = 28,
    模块定义 = 29,
    外部声明 = 30
}

/* ============ AST 节点结构体 ============ */

结构体 AST节点 {
    id: 整数,
    kind: 整数,
    name: 文本,
    value: 文本,
    intValue: 整数,
    line: 整数,
    children: 列表
}

/* ============ Lexer 结构体 ============ */

结构体 Lexer {
    源码: 文本,
    位置: 整数,
    长度: 整数,
    行号: 整数,
    列号: 整数,
    当前字符: 整数,
    token列表: 列表,
    开始位置: 整数,
    当前位置: 整数,
    当前token: Token
}

/* ============ Lexer 上下文结构体 ============ */

结构体 LexerContext {
    状态: 整数,
    起始位置: 整数,
    当前位置: 整数,
    行号: 整数,
    列号: 整数,
    错误信息: 文本,
    是否错误: 整数
}

/* ============ Parser 结构体 ============ */

结构体 Parser {
    tokens: 列表,
    pos: 整数,
    errors: 列表,
    nodeCount: 整数,
    tokenCount: 整数,
    当前位置: 整数,
    当前行号: 整数,
    当前列号: 整数,
    源码长度: 整数
}

/* ============ 类型别名枚举 ============ */

枚举 类型别名 {
    整数类型 = 0,
    浮点类型 = 1,
    布尔类型 = 2,
    文本类型 = 3,
    字符类型 = 4,
    无返回类型 = 5,
    指针类型 = 6,
    列表类型 = 7,
    未知类型 = 8
}

/* ============ 符号表结构体 ============ */

结构体 符号 {
    名称: 文本,
    类型: 整数,
    可变: 整数,
    行号: 整数,
    作用域层级: 整数,
    已初始化: 整数
}

/* ============ 作用域结构体 ============ */

结构体 作用域 {
    名称: 文本,
    符号表: 列表,
    父作用域: 整数,
    层级: 整数
}

/* ============ 循环状态结构体 ============ */

结构体 循环状态 {
    激活: 整数,
    循环层级: 整数
}

/* ============ Sema 结构体 ============ */

结构体 Sema {
    源码: 文本,
    当前作用域: 整数,
    作用域栈: 列表,
    错误列表: 列表,
    警告列表: 列表,
    当前行号: 整数,
    错误计数: 整数,
    警告计数: 整数,
    全局作用域: 整数,
    循环状态: 循环状态,
    当前函数名: 文本,
    当前函数返回类型: 整数
}

/* ============ 循环上下文结构体（用于 break/continue） ============ */

结构体 循环上下文 {
    循环开始标签: 文本,
    循环体标签: 文本,
    continue标签: 文本,
    结束标签: 文本
}

/* ============ Codegen 结构体 ============ */

结构体 Codegen {
    moduleName: 文本,
    tempCount: 整数,
    labelCount: 整数,
    funcCount: 整数,
    output: 文本,
    indent: 整数,
    stringConstCount: 整数,
    funcDefs: 列表,
    currentFunc: 文本,
    currentReturnType: 文本,
    variableMap: 列表,
    variableTypes: 列表,
    stringConstants: 列表,
    loopContextStack: 列表,
    currentFunctionIndex: 整数,
    functionIndexCounter: 整数,
    stringConstDefs: 文本
}

/* ============ 错误级别枚举 ============ */

枚举 错误级别 {
    警告,
    错误,
    致命错误
}

/* ============ 错误恢复结构体 ============ */

结构体 ErrorRecovery {
    已恢复: 整数,
    跳过Token数: 整数,
    恢复点: 整数
}

外部 函数 打印(内容: 文本): 无返回
外部 函数 打印整数(数值: 整数): 无返回
外部 函数 输入整数(): 整数
外部 函数 输入文本(): 文本
外部 函数 文本长度(s: 文本): 整数
外部 函数 文本拼接(a: 文本, b: 文本): 文本
外部 函数 文本转整数(s: 文本): 整数
外部 函数 整数转文本(n: 整数): 文本
外部 函数 整数转文本内部(n: 整数): 文本
外部 函数 列表(): 列表
外部 函数 列表追加(lst: 列表, 项: 任意): 无返回
外部 函数 列表获取(lst: 列表, 索引: 整数): 任意
外部 函数 列表长度(lst: 列表): 整数
外部 函数 列表设置(lst: 列表, 索引: 整数, 值: 任意): 无返回
外部 函数 是空格(ch: 文本): 布尔
外部 函数 是数字(ch: 文本): 布尔
外部 函数 是字母(ch: 文本): 布尔
外部 函数 是字母数字(ch: 文本): 布尔
外部 函数 读取文件(路径: 文本): 文本
外部 函数 写入文件(路径: 文本, 内容: 文本): 整数
外部 函数 文件存在(路径: 文本): 布尔
外部 函数 删除文件(路径: 文本): 整数
外部 函数 执行命令(命令: 文本): 整数
外部 函数 命令行参数(索引: 整数): 文本
外部 函数 参数个数(): 整数
外部 函数 运行时错误(消息: 文本): 无返回
外部 函数 utf8字节长度(ch: 整数): 整数
外部 函数 是utf8首字节(ch: 整数): 布尔
外部 函数 是utf8续字节(ch: 整数): 布尔
外部 函数 文本获取字符(s: 文本, 索引: 整数): 文本
外部 函数 字符编码(ch: 文本): 整数
外部 函数 文本切片(s: 文本, 开始: 整数, 结束: 整数): 文本

函数 运行时初始化(): 无返回 {
    返回
}

/**
 * @file lexer.xy
 * @brief 词法分析器 - 自展编译器
 * @description 完整的词法扫描功能，支持 token 列表构建
 */

/* ============ 字符分类函数 ============ */

/**
 * 判断是否为空白字符
 */
函数 是空白(ch: 整数): 整数 {
    若 ch == 32 则 { 返回 1 }
    若 ch == 9  则 { 返回 1 }
    若 ch == 10 则 { 返回 1 }
    若 ch == 13 则 { 返回 1 }
    返回 0
}

/**
 * 判断是否为字母（包括中文）
 */
函数 是字母(ch: 整数): 整数 {
    // ASCII 字母
    若 ch >= 65 && ch <= 90 则 { 返回 1 }
    若 ch >= 97 && ch <= 122 则 { 返回 1 }
    若 ch == 95 则 { 返回 1 }
    // UTF-8 首字节范围（向后兼容旧版字节模式）
    若 ch >= 192 && ch <= 255 则 { 返回 1 }
    // CJK 统一表意文字 (U+4E00 - U+9FFF)
    若 ch >= 19968 && ch <= 40959 则 { 返回 1 }
    // CJK 扩展 A (U+3400 - U+4DBF)
    若 ch >= 13312 && ch <= 19903 则 { 返回 1 }
    // CJK 扩展 B+ (U+20000 - U+2A6DF) — 超出 i64 16位但仍在范围内
    若 ch >= 131072 && ch <= 173791 则 { 返回 1 }
    // 全角符号/平假名/片假名 (U+FF00 - U+FFEF, U+3040 - U+30FF)
    若 ch >= 65280 && ch <= 65519 则 { 返回 1 }
    若 ch >= 12352 && ch <= 12543 则 { 返回 1 }
    // CJK 标点符号 (U+3000 - U+303F)
    若 ch >= 12288 && ch <= 12351 则 { 返回 1 }
    返回 0
}

/**
 * 判断是否为数字
 */
函数 是数字(ch: 整数): 整数 {
    若 ch >= 48 && ch <= 57 则 { 返回 1 }
    返回 0
}

/**
 * 判断是否为字母或数字
 */
函数 是字母或数字(ch: 整数): 整数 {
    若 是字母(ch) == 1 则 { 返回 1 }
    若 是数字(ch) == 1 则 { 返回 1 }
    返回 0
}

/**
 * 判断是否为运算符字符
 */
函数 是运算符(ch: 整数): 整数 {
    若 ch == 43 则 { 返回 1 }  // +
    若 ch == 45 则 { 返回 1 }  // -
    若 ch == 42 则 { 返回 1 }  // *
    若 ch == 47 则 { 返回 1 }  // /
    若 ch == 37 则 { 返回 1 }  // %
    若 ch == 61 则 { 返回 1 }  // =
    若 ch == 33 则 { 返回 1 }  // !
    若 ch == 60 则 { 返回 1 }  // <
    若 ch == 62 则 { 返回 1 }  // >
    若 ch == 38 则 { 返回 1 }  // &
    若 ch == 124 则 { 返回 1 } // |
    若 ch == 94 则 { 返回 1 }  // ^
    若 ch == 126 则 { 返回 1 } // ~
    返回 0
}

/**
 * 判断是否为符号字符
 */
函数 是符号(ch: 整数): 整数 {
    若 ch == 40 则 { 返回 1 }  // (
    若 ch == 41 则 { 返回 1 }  // )
    若 ch == 123 则 { 返回 1 } // {
    若 ch == 125 则 { 返回 1 } // }
    若 ch == 91 则 { 返回 1 }  // [
    若 ch == 93 则 { 返回 1 }  // ]
    若 ch == 59 则 { 返回 1 }  // ;
    若 ch == 58 则 { 返回 1 }  // :
    若 ch == 44 则 { 返回 1 }  // ,
    若 ch == 46 则 { 返回 1 }  // .
    若 ch == 34 则 { 返回 1 }  // "
    若 ch == 39 则 { 返回 1 }  // '
    若 ch == 10 则 { 返回 1 }  // 换行符
    返回 0
}

/**
 * 判断是否为比较运算符起始字符
 */
函数 是比较起始(ch: 整数): 整数 {
    若 ch == 61 则 { 返回 1 }  // =
    若 ch == 33 则 { 返回 1 }  // !
    若 ch == 60 则 { 返回 1 }  // <
    若 ch == 62 则 { 返回 1 }  // >
    返回 0
}

/* ============ 关键字识别 ============ */

/**
 * 判断是否为关键字
 */
函数 是关键字(text: 文本): 整数 {
    /* ========== 控制流 (中文) ========== */
    若 text == "若" 则 { 返回 1 }
    若 text == "则" 则 { 返回 1 }
