外部 函数 tokenize(源码: 文本): 列表
外部 函数 parser分析Tokens(tokens: 列表, source: 文本): AST节点
外部 函数 semaInit(源码: 文本): Sema
外部 函数 sema分析AST(sema: Sema, ast: AST节点): 整数
外部 函数 codegen遍历AST(ast: AST节点): 文本

函数 主(): 整数 {
    定义 源码: 文本
    源码 = "函数 main(): 整数 { 返回 42 }"

    定义 tokens: 列表
    tokens = tokenize(源码)
    打印("Tokens: ")
    打印整数(列表长度(tokens))

    定义 ast: AST节点
    ast = parser分析Tokens(tokens, 源码)
    打印("AST done")

    定义 sema: Sema
    sema = semaInit("")
    定义 errors: 整数
    errors = sema分析AST(sema, ast)
    打印("Sema done")

    定义 ir: 文本
    ir = codegen遍历AST(ast)
    打印(ir)
    返回 0
}
