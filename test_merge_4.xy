    若 text == "跳过" 则 { 返回 1 }
    若 text == "退出" 则 { 返回 1 }
    若 text == "整数" 则 { 返回 1 }
    若 text == "浮点数" 则 { 返回 1 }
    若 text == "双精度" 则 { 返回 1 }
    若 text == "布尔" 则 { 返回 1 }
    若 text == "文本" 则 { 返回 1 }
    若 text == "无返回" 则 { 返回 1 }
    若 text == "字符" 则 { 返回 1 }
