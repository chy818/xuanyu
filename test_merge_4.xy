    若 text == "expand" 则 { 返回 1 }

    /* ========== 复合数据类型 (英文别名) ========== */
    若 text == "struct" 则 { 返回 1 }
    若 text == "enum" 则 { 返回 1 }
    若 text == "union" 则 { 返回 1 }
    若 text == "type" 则 { 返回 1 }

    /* ========== 任意类型 (英文别名) ========== */
    若 text == "Any" 则 { 返回 1 }

    返回 0
}

/* ============ 字符串切片函数 ============ */

/**
 * 提取子字符串
 * 使用运行时函数文本切片
 */
函数 提取子串(源码: 文本, 开始: 整数, 结束: 整数): 文本 {
    定义 可变 结果: 文本
/*[DBG]     打印("DEBUG 提取子串: 开始=") */
/*[DBG]     打印整数(开始) */
/*[DBG]     打印(" 结束=") */
/*[DBG]     打印整数(结束) */
    结果 = 文本切片(源码, 开始, 结束)
    返回 结果
}

/* ============ Lexer 核心函数 ============ */

/**
 * 获取字符
 */
函数 获取字符(lex: Lexer): 整数 {
    若 lex.位置 < lex.长度 则 {
        定义 可变 ch: 整数
        ch = 字符编码(文本获取字符(lex.源码, lex.位置))
        返回 ch
    }
    返回 0
}

/**
 * 初始化词法分析器
 */
函数 lexerInit(源码: 文本, 长度: 整数): Lexer {
    定义 可变 lex: Lexer
    lex.源码 = 源码
    lex.位置 = 0
    lex.长度 = 长度
/*[DBG]     打印("DEBUG lexerInit: 源码长度=") */
/*[DBG]     打印整数(lex.长度) */
/*[DBG]     打印("\n") */
    lex.行号 = 1
    lex.列号 = 1
    lex.开始位置 = 0
    lex.当前位置 = 0
/*[DBG]     打印("DEBUG lexerInit: 调用获取字符\n") */
    lex.当前字符 = 获取字符(lex)
/*[DBG]     打印("DEBUG lexerInit: 当前字符=") */
/*[DBG]     打印整数(lex.当前字符) */
/*[DBG]     打印("\n") */
    返回 lex
}

/**
 * 前进到下一个字符（支持UTF-8多字节字符）
 */
函数 lexer前进(lex: Lexer): Lexer {
    定义 可变 步长: 整数
    步长 = utf8字节长度(lex.当前字符)

    lex.位置 = lex.位置 + 步长
    lex.列号 = lex.列号 + 1

    若 lex.位置 < lex.长度 则 {
        lex.当前字符 = 字符编码(文本获取字符(lex.源码, lex.位置))
    } 否则 {
        lex.当前字符 = 0
    }

    若 lex.当前字符 == 10 则 {
        lex.行号 = lex.行号 + 1
        lex.列号 = 1
    }

    返回 lex
}

/**
 * 跳过空白字符
 */
函数 lexer跳过空白(lex: Lexer): Lexer {
    当 是空白(lex.当前字符) == 1 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }
    lex.开始位置 = lex.位置
    返回 lex
}

/**
 * 读取注释
 */
函数 lexer读取注释(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 7  // 注释
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    // 检查是 // 还是 /*
    若 lex.当前字符 == 47 则 {  // /
        定义 可变 nextCh: 整数
        nextCh = 0
        若 lex.位置 + 1 < lex.长度 则 {
            nextCh = 字符编码(文本获取字符(lex.源码, lex.位置 + 1))
        }

        若 nextCh == 47 则 {
            // 单行注释 // ... 一直到换行
            当 lex.当前字符 != 10 && lex.当前字符 != 0 则 {
                lex = lexer前进(lex)
            }
        } 否则 {
            若 nextCh == 42 则 {
                // 多行注释 /* ... */
                lex = lexer前进(lex)  // 跳过 /
                lex = lexer前进(lex)  // 跳过 *
                当 lex.当前字符 != 0 则 {
                    // 检查是否到达文件末尾，避免越界访问
                    若 lex.位置 + 1 >= lex.长度 则 {
                        跳出
                    }
                    若 lex.当前字符 == 42 && 字符编码(文本获取字符(lex.源码, lex.位置 + 1)) == 47 则 {
                        lex = lexer前进(lex)  // 跳过 *
                        lex = lexer前进(lex)  // 跳过 /
                        跳出
                    }
                    lex = lexer前进(lex)
                }
            } 否则 {
                // 单独的 / 是除法运算符，不是注释
                lex = lexer前进(lex)
                tok.类型 = 4  // 运算符
            }
        }
    }

    tok.结束位置 = lex.位置

    // 提取注释内容
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    lex.当前token = tok
    返回 lex
}

/**
 * 读取字符字面量
 */
函数 lexer读取字符(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 8  // 字符
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    // 跳过开始的单引号
    lex = lexer前进(lex)

    // 读取字符内容（支持转义）
    若 lex.当前字符 == 92 则 {  // 反斜杠 \
        lex = lexer前进(lex)  // 跳过反斜杠
        // 处理转义字符
        若 lex.当前字符 == 110 则 {  // \n
            lex = lexer前进(lex)
        } 否则 {
            若 lex.当前字符 == 116 则 {  // \t
                lex = lexer前进(lex)
            } 否则 {
                若 lex.当前字符 == 92 则 {  // \\
                    lex = lexer前进(lex)
                } 否则 {
                    若 lex.当前字符 == 39 则 {  // \'
                        lex = lexer前进(lex)
                    }
                }
            }
        }
    } 否则 {
        若 lex.当前字符 != 39 && lex.当前字符 != 0 则 {
            lex = lexer前进(lex)
        }
    }

    // 跳过结束的单引号
    若 lex.当前字符 == 39 则 {
        lex = lexer前进(lex)
    }

    tok.结束位置 = lex.位置

    // 提取字符值（包括引号）
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    lex.当前token = tok
    返回 lex
}

/**
 * 读取复合运算符（==, !=, <=, >=, &&, ||）
 */
函数 lexer读取复合运算符(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 10  // 比较
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    定义 可变 firstCh: 整数
    firstCh = lex.当前字符

    lex = lexer前进(lex)
    定义 可变 nextCh: 整数
    nextCh = lex.当前字符

    定义 可变 op: 文本
    op = ""

    // 双字符运算符
    若 firstCh == 61 && nextCh == 61 则 {
        op = "=="
        lex = lexer前进(lex)
    } 否则 {
        若 firstCh == 33 && nextCh == 61 则 {
            op = "!="
            lex = lexer前进(lex)
        } 否则 {
            若 firstCh == 60 && nextCh == 61 则 {
                op = "<="
                lex = lexer前进(lex)
            } 否则 {
                若 firstCh == 62 && nextCh == 61 则 {
                    op = ">="
                    lex = lexer前进(lex)
                } 否则 {
                    若 firstCh == 38 && nextCh == 38 则 {
                        op = "&&"
                        tok.类型 = 11  // 逻辑
                        lex = lexer前进(lex)
                    } 否则 {
                        若 firstCh == 124 && nextCh == 124 则 {
                            op = "||"
                            tok.类型 = 11  // 逻辑
                            lex = lexer前进(lex)
                        } 否则 {
                            // 单字符运算符
                            若 firstCh == 61 则 { op = "=" }
                            若 firstCh == 60 则 { op = "<" }
                            若 firstCh == 62 则 { op = ">" }
                            若 firstCh == 33 则 { op = "!" }
                        }
                    }
                }
            }
        }
    }

    tok.结束位置 = lex.位置
    tok.值 = op

    lex.当前token = tok
    返回 lex
}

/**
 * 读取标识符或关键字
 */
函数 lexer读取标识符(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 0
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    当 是字母或数字(lex.当前字符) == 1 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }

    tok.结束位置 = lex.位置

    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    若 是关键字(提取的值) == 1 则 {
        tok.类型 = 3
    }

    lex.当前token = tok
    返回 lex
}

/**
 * 读取数字
 */
函数 lexer读取数字(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 1
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    当 是数字(lex.当前字符) == 1 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }

    tok.结束位置 = lex.位置

    // 使用文本切片提取实际 token 值
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    lex.当前token = tok
    返回 lex
}

/**
 * 读取字符串
 */
函数 lexer读取字符串(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 2
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    // 跳过开始的双引号
    lex = lexer前进(lex)

    当 lex.当前字符 != 34 && lex.当前字符 != 0 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }

    若 lex.当前字符 == 34 则 {
        lex = lexer前进(lex)
    }

    tok.结束位置 = lex.位置

    // 使用文本切片提取实际 token 值（包括引号）
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    lex.当前token = tok
    返回 lex
}

/**
 * 读取运算符
 */
函数 lexer读取运算符(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 4
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    当 是运算符(lex.当前字符) == 1 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }

    tok.结束位置 = lex.位置

    // 使用文本切片提取实际 token 值
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    lex.当前token = tok
    返回 lex
}

/**
 * 读取符号
 */
函数 lexer读取符号(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 5
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始
    tok.结束位置 = lex.位置 + 1

    定义 可变 结束位置: 整数
    结束位置 = lex.位置 + 1
    若 结束位置 > lex.长度 则 {
        结束位置 = lex.长度
    }

    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, 结束位置)
    tok.值 = 提取的值

    lex = lexer前进(lex)

    lex.当前token = tok
    返回 lex
}

/**
 * 读取下一个 Token
 * 返回更新后的 Lexer（token存储在 lex.当前token 中）
 */
函数 lexerNextToken(lex: Lexer): Lexer {
    定义 可变 tok: Token
    tok.类型 = 6
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = lex.位置
    tok.结束位置 = lex.位置

/*[DBG]     打印("DEBUG lexerNextToken: 位置=") */
/*[DBG]     打印整数(lex.位置) */
/*[DBG]     打印(" 长度=") */
/*[DBG]     打印整数(lex.长度) */
/*[DBG]     打印(" 当前字符=") */
/*[DBG]     打印整数(lex.当前字符) */
/*[DBG]     打印("\n") */

    lex = lexer跳过空白(lex)

    定义 可变 ch: 整数
    ch = lex.当前字符

    tok.开始位置 = lex.开始位置
    tok.行号 = lex.行号
    tok.列号 = lex.列号

    // 文件结束
    若 ch == 0 则 {
        tok.类型 = 6
        tok.值 = "EOF"
        lex.当前token = tok
        返回 lex
    }

    // 字符串
    若 ch == 34 则 {
        lex = lexer读取字符串(lex)
        返回 lex
    }

    // 字符字面量
    若 ch == 39 则 {
        lex = lexer读取字符(lex)
        返回 lex
    }

    // 注释
    若 ch == 47 则 {
        定义 可变 nextCh: 整数
        nextCh = 0
        若 lex.位置 + 1 < lex.长度 则 {
            nextCh = 字符编码(文本获取字符(lex.源码, lex.位置 + 1))
        }
        若 nextCh == 47 || nextCh == 42 则 {
            lex = lexer读取注释(lex)
            返回 lex
        }
    }

    // 复合运算符 (==, !=, <=, >=, &&, ||)
    若 是比较起始(ch) == 1 则 {
        lex = lexer读取复合运算符(lex)
        返回 lex
    }

    // 字母开头 -> 标识符或关键字
    若 是字母(ch) == 1 则 {
        lex = lexer读取标识符(lex)
        返回 lex
    }

    // 数字开头 -> 数字
    若 是数字(ch) == 1 则 {
        lex = lexer读取数字(lex)
        返回 lex
    }

    // 单字符运算符 (+, -, *, /, %, etc.)
    若 是运算符(ch) == 1 则 {
        lex = lexer读取运算符(lex)
        返回 lex
    }

    // 符号
    若 是符号(ch) == 1 则 {
        lex = lexer读取符号(lex)
        返回 lex
    }

    // 未知字符
    lex = lexer前进(lex)
    tok.类型 = 12
    tok.值 = "UNKNOWN"
    tok.结束位置 = lex.位置
    lex.当前token = tok
    返回 lex
}

/* ============ 错误恢复和优化 ============ */

/**
 * 报告词法错误
 */
函数 lexer报告错误(lex: Lexer, 消息: 文本): 无返回 {
    打印("词法错误 (行")
    打印(lex.行号)
    打印(", 列")
    打印(lex.列号)
    打印("): ")
    打印(消息)
}

/**
 * 跳过到下一行
 */
函数 lexer跳到下一行(lex: Lexer): Lexer {
    当 lex.位置 < lex.长度 && lex.当前字符 != 10 则 {
        lex = lexer前进(lex)
    }
    若 lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }
    返回 lex
}

/**
 * 跳过当前 token
 */
函数 lexer跳过当前(lex: Lexer): Lexer {
    当 是空白(lex.当前字符) == 0 && lex.当前字符 != 0 则 {
        lex = lexer前进(lex)
    }
    返回 lex
}

/**
 * 检查是否为合法标识符起始字符
 */
函数 是合法标识符起始(ch: 整数): 整数 {
    若 ch >= 65 && ch <= 90 则 { 返回 1 }  // A-Z
    若 ch >= 97 && ch <= 122 则 { 返回 1 }  // a-z
    若 ch == 95 则 { 返回 1 }  // _
    若 ch >= 0xE4 则 { 返回 1 }  // 中文范围
    返回 0
}

/**
 * 检查是否为合法标识符字符
 */
函数 是合法标识符字符(ch: 整数): 整数 {
    若 是合法标识符起始(ch) == 1 则 { 返回 1 }
    若 ch >= 48 && ch <= 57 则 { 返回 1 }  // 0-9
    返回 0
}

/**
 * 验证标识符
 */
函数 lexer验证标识符(lex: Lexer): 整数 {
    定义 可变 ch: 整数
    ch = lex.当前位置

    若 是合法标识符起始(ch) == 0 则 {
        返回 0
    }

    定义 可变 pos: 整数
    pos = lex.位置 + 1

    当 pos < lex.长度 则 {
        ch = lex.当前位置
        若 是合法标识符字符(ch) == 0 则 {
            跳出
        }
        pos = pos + 1
    }

    返回 1
}

/**
 * 统计 token 类型分布
 */
函数 lexer统计Token分布(tokens: 列表): 列表 {
    定义 可变 统计: 列表
    统计 = 列表()

    打印("Token 类型分布:")

    返回 统计
}

/* ============ 词法分析器状态机 ============ */

/**
 * 创建词法分析器上下文
 */
函数 lexer创建上下文(源码: 文本): LexerContext {
    定义 可变 ctx: LexerContext
    ctx.状态 = 状态开始
    ctx.起始位置 = 0
    ctx.当前位置 = 0
    ctx.行号 = 1
    ctx.列号 = 0
    ctx.错误信息 = ""
    ctx.是否错误 = 0
    返回 ctx
}

/**
 * 从上下文获取下一个字符
 */
函数 lexer上下文中获取字符(ctx: LexerContext, 源码: 文本): 整数 {
    若 ctx.当前位置 >= 文本长度(源码) 则 {
        返回 0  // EOF
    }
    定义 可变 ch: 整数
    ch = 字符编码(文本获取字符(源码, ctx.当前位置))
    返回 ch
}

/**
 * 词法分析器状态转换
 */
函数 lexer状态转换(ctx: LexerContext, ch: 整数): 整数 {
    定义 可变 下一状态: 整数
    下一状态 = ctx.状态

    若 ctx.状态 == 状态开始 则 {
        若 ch == 0 则 {
            下一状态 = 状态结束
        } 否则 {
            若 是空白(ch) == 1 则 {
                下一状态 = 状态开始
            } 否则 {
                若 是字母(ch) == 1 则 {
                    下一状态 = 状态标识符
                } 否则 {
                    若 是数字(ch) == 1 则 {
                        下一状态 = 状态数字
                    } 否则 {
                        若 ch == 34 则 {
                            下一状态 = 状态字符串
                        } 否则 {
                            若 ch == 39 则 {
                                下一状态 = 状态字符
                            } 否则 {
                                若 ch == 47 则 {
                                    下一状态 = 状态注释
                                } 否则 {
                                    下一状态 = 状态运算符
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    返回 下一状态
}

/**
 * 处理字符串字面量（带转义）
 */
函数 lexer处理转义字符串(lex: Lexer): 文本 {
    定义 可变 结果: 文本
    结果 = ""

    打印("处理转义字符串")

    返回 结果
}

/**
 * 处理 Unicode 字符
 */
函数 lexer处理Unicode字符(lex: Lexer): 文本 {
    定义 可变 结果: 文本
    结果 = ""

    定义 可变 ch: 整数
    ch = lex.当前位置

    若 ch >= 0xE4 则 {
        定义 可变 bytes: 列表
        bytes = 列表()
        打印("处理 Unicode 字符")
    }

    返回 结果
}

/**
 * 验证数字字面量格式
 */
函数 lexer验证数字(lex: Lexer): 整数 {
    定义 可变 ch: 整数
    ch = lex.当前位置

    定义 可变 hasDot: 整数
    hasDot = 0
    定义 可变 hasExp: 整数
    hasExp = 0

    当 ch != 0 && ch != 32 && ch != 9 && ch != 10 && ch != 13 则 {
        若 ch == 46 则 {
            hasDot = hasDot + 1
            若 hasDot > 1 则 {
                返回 0  // 多个小数点
            }
        } 否则 {
            若 ch == 101 || ch == 69 则 {
                hasExp = hasExp + 1
                若 hasExp > 1 则 {
                    返回 0  // 多个指数
                }
            } 否则 {
                若 ch < 48 || ch > 57 则 {
                    若 ch != 95 则 {
                        返回 0  // 非法字符
                    }
                }
            }
        }
        ch = lex.当前位置
    }

    返回 1
}

/**
 * 验证字符串字面量
 */
函数 lexer验证字符串(lex: Lexer): 整数 {
    定义 可变 ch: 整数
    ch = lex.当前位置

    定义 可变 inEscape: 整数
    inEscape = 0

    当 ch != 0 则 {
        若 inEscape == 1 则 {
            inEscape = 0
        } 否则 {
            若 ch == 92 则 {
                inEscape = 1
            } 否则 {
                若 ch == 34 则 {
                    返回 1  // 找到结束引号
                }
            }
        }
        ch = lex.当前位置
    }

    返回 0  // 未找到结束引号
}

/**
 * 验证字符字面量
 */
函数 lexer验证字符(lex: Lexer): 整数 {
    定义 可变 ch: 整数
    ch = lex.当前位置

    若 ch == 39 则 {
        返回 1  // 空字符
    }

    定义 可变 charLen: 整数
    charLen = 0

    当 ch != 39 && ch != 0 && ch != 10 则 {
        charLen = charLen + 1
        ch = lex.当前位置
    }

    若 charLen == 0 则 {
        返回 0
    }

    若 ch == 39 则 {
        返回 1
    }

    返回 0
}

/**
 * 词法分析错误恢复
 */
函数 lexer错误恢复(lex: Lexer): Lexer {
    打印("词法分析错误恢复")

    定义 可变 恢复模式: 整数
    恢复模式 = 0

    // 安全恢复点
    当 lex.当前位置 < lex.长度 && lex.当前位置 >= 0 则 {
        定义 可变 ch: 整数
        ch = lex.当前位置

        // 遇到空白字符（空格、tab、换行）则停止
        若 ch == 32 || ch == 9 || ch == 10 || ch == 13 则 {
            若 恢复模式 == 1 则 {
                // 如果是在恢复模式中遇到空白，说明已经跳过了错误区域
                恢复模式 = 2
            }
            lex.当前位置 = lex.当前位置 + 1
            若 ch == 10 则 {
                lex.列号 = 0
                lex.行号 = lex.行号 + 1
            }
            若 恢复模式 == 2 则 {
                // 遇到空白且已经过错误区域，恢复解析
                返回 lex
            }
        } 否则 {
            // 非空白字符
            若 恢复模式 == 0 则 {
                // 开始恢复
                恢复模式 = 1
                打印("  跳过错误字符")
            }
            lex.当前位置 = lex.当前位置 + 1
        }
    }

    lex.列号 = 0
    lex.行号 = lex.行号 + 1

    返回 lex
}

/**
 * 跳过到指定位置
 */
函数 lexer跳到位置(lex: Lexer, 目标位置: 整数): Lexer {
    若 目标位置 >= 0 && 目标位置 < lex.长度 则 {
        lex.当前位置 = 目标位置
    }
    返回 lex
}

/**
 * 获取下一个安全恢复点
 */
函数 lexer查找安全点(lex: Lexer): 整数 {
    定义 可变 pos: 整数
    pos = lex.当前位置

    // 向前查找直到遇到空白或分号
    当 pos < lex.长度 && pos >= 0 则 {
        定义 可变 ch: 整数
        ch = lex.当前位置
        若 ch == 59 || ch == 32 || ch == 10 || ch == 9 则 {
            返回 pos
        }
        pos = pos + 1
    }

    返回 pos
}

/**
 * 词法分析器诊断信息
 */
函数 lexer诊断(lex: Lexer): 无返回 {
    打印("=== 词法分析器诊断 ===")
    打印("  位置: ")
    打印(lex.位置)
    打印("/")
    打印(lex.长度)
    打印("  行号: ")
    打印(lex.行号)
    打印("  列号: ")
    打印(lex.列号)
    打印("  当前字符: '")
    打印(lex.当前字符)
    打印("'")
    打印("  源码长度: ")
    打印(lex.长度)
}

/**
 * 获取 Token 类型名称
 */
函数 获取Token类型名(类型: 整数): 文本 {
    若 类型 == 0 则 { 返回 "标识符" }
    若 类型 == 1 则 { 返回 "数字" }
    若 类型 == 2 则 { 返回 "字符串" }
    若 类型 == 3 则 { 返回 "关键字" }
    若 类型 == 4 则 { 返回 "运算符" }
    若 类型 == 5 则 { 返回 "符号" }
    若 类型 == 6 则 { 返回 "结束" }
    若 类型 == 7 则 { 返回 "注释" }
    若 类型 == 8 则 { 返回 "字符" }
    若 类型 == 9 则 { 返回 "赋值" }
    若 类型 == 10 则 { 返回 "比较" }
    若 类型 == 11 则 { 返回 "逻辑" }
    若 类型 == 12 则 { 返回 "错误" }
    返回 "未知"
}

/**
 * 验证 token 序列
 */
函数 lexer验证Tokens(tokens: 列表): 整数 {
    若 列表长度(tokens) == 0 则 {
        返回 0
    }
    返回 1
}

/* ============ 主函数 ============ */

/**
 * 执行词法分析
 */
函数 lexerRun(源码: 文本): 整数 {
    打印("=== 词法分析 ===")

    定义 可变 lex: Lexer
    lex = lexerInit(源码, 文本长度(源码))

    定义 可变 count: 整数
    count = 0

    定义 可变 tok: Token
    tok.类型 = 0
    tok.值 = ""
    tok.行号 = 0
    tok.列号 = 0
    tok.开始位置 = 0
    tok.结束位置 = 0

    当 tok.类型 != 6 && count < 1000 则 {
        lex = lexerNextToken(lex)
        tok = lex.当前token

        // 跳过注释
        若 tok.类型 == 7 则 {
            跳过
        }

        若 tok.类型 != 6 则 {
            count = count + 1
            打印("Token ")
            打印(count)
            打印(": ")
            打印(tok.值)
            打印(" (类型=")
            打印(tok.类型)
            打印(", 行=")
            打印(tok.行号)
            打印(")")
        }
    }

    打印("")
    打印("词法分析完成，共识别 ")
    打印(count)
    打印(" 个 Token")

    返回 count
}

/**
 * 完整的 tokenize 函数 - 将源码转换为 token 列表
 * @param 源码 输入的源代码文本
 * @return token 列表
 */
函数 tokenize(源码: 文本): 列表 {
    定义 可变 lex: Lexer
    lex = lexerInit(源码, 文本长度(源码))
/*[DBG]     打印("DEBUG tokenize: lexerInit 完成\n") */

    定义 可变 tokens: 列表
    tokens = 列表()
/*[DBG]     打印("DEBUG tokenize: 创建列表完成\n") */

    定义 可变 循环次数: 整数
    循环次数 = 0

    当 循环次数 < 50000 则 {
        若 lex.位置 >= lex.长度 则 {
            定义 可变 eofTok: Token
            eofTok.类型 = 6
            eofTok.值 = "EOF"
            eofTok.行号 = lex.行号
            eofTok.列号 = lex.列号
            eofTok.开始位置 = lex.位置
            eofTok.结束位置 = lex.位置
            列表追加(tokens, eofTok)
            跳出
        }

        lex = lexerNextToken(lex)
        定义 可变 tok: Token
        tok = lex.当前token

        若 tok.类型 == 6 则 {
            列表追加(tokens, tok)
            跳出
        }

        若 tok.类型 == 7 则 {
            循环次数 = 循环次数 + 1
            跳过
        }

        列表追加(tokens, tok)
/*[DBG]         打印("DEBUG Token: 类型=") */
/*[DBG]         打印整数(tok.类型) */
/*[DBG]         打印(", 值='") */
/*[DBG]         打印(tok.值) */
/*[DBG]         打印("'\n") */
        循环次数 = 循环次数 + 1
    }

    返回 tokens
}

/**
 * 打印 token 列表
 * @param tokens token 列表
 */
函数 打印Tokens(tokens: 列表): 无返回 {
    定义 可变 i: 整数
    i = 0
    定义 可变 len: 整数
    len = 列表长度(tokens)

    打印("=== Token 列表 ===")

    当 i < len 则 {
        定义 可变 tok: Token
        tok = 列表获取(tokens, i)

        定义 可变 类型名: 文本
        类型名 = 获取Token类型名(tok.类型)

        打印("Token ")
        打印(i + 1)
        打印(": [")
        打印(类型名)
        打印("] '")
        打印(tok.值)
        打印("' (行:")
        打印(tok.行号)
        打印(", 列:")
        打印(tok.列号)
        打印(")")

        i = i + 1
    }

    打印("总计: ")
    打印(len)
    打印(" 个 tokens")
}


/**
 * @file parser.xy
 * @brief 语法解析器 - 自展编译器
 * @description 递归下降解析器，实现表达式、语句、函数的解析
 */

/* ============ 关键字表 ============ */

/* 关键字识别 */
函数 是关键字(text: 文本): 整数 {
    若 text == "若" 则 { 返回 1 }
    若 text == "则" 则 { 返回 1 }
    若 text == "否则" 则 { 返回 1 }
    若 text == "当" 则 { 返回 1 }
    若 text == "循环" 则 { 返回 1 }
    若 text == "从" 则 { 返回 1 }
    若 text == "到" 则 { 返回 1 }
    若 text == "返回" 则 { 返回 1 }
    若 text == "定义" 则 { 返回 1 }
    若 text == "可变" 则 { 返回 1 }
    若 text == "函数" 则 { 返回 1 }
    若 text == "结构体" 则 { 返回 1 }
    若 text == "枚举" 则 { 返回 1 }
    若 text == "真" 则 { 返回 1 }
    若 text == "假" 则 { 返回 1 }
    若 text == "跳过" 则 { 返回 1 }
    若 text == "退出" 则 { 返回 1 }
    若 text == "引入" 则 { 返回 1 }
    若 text == "模块" 则 { 返回 1 }
    若 text == "导出" 则 { 返回 1 }
    返回 0
}

/* 获取关键字类型 */
函数 getKeywordType(text: 文本): 整数 {
    若 text == "若" 则 { 返回 1 }     // IF
    若 text == "则" 则 { 返回 2 }     // THEN
    若 text == "否则" 则 { 返回 3 }   // ELSE
    若 text == "当" 则 { 返回 4 }    // WHILE
    若 text == "循环" 则 { 返回 5 }   // LOOP
    若 text == "从" 则 { 返回 6 }    // FROM
    若 text == "到" 则 { 返回 7 }    // TO
    若 text == "返回" 则 { 返回 8 }   // RETURN
    若 text == "定义" 则 { 返回 9 }   // LET
    若 text == "函数" 则 { 返回 10 }  // FUNC
    若 text == "真" 则 { 返回 11 }   // TRUE
    若 text == "假" 则 { 返回 12 }   // FALSE
    若 text == "跳过" 则 { 返回 13 }  // CONTINUE
    若 text == "退出" 则 { 返回 14 }  // BREAK
    若 text == "引入" 则 { 返回 15 }  // IMPORT
    若 text == "模块" 则 { 返回 16 }  // MODULE
    若 text == "导出" 则 { 返回 17 }  // EXPORT
    若 text == "整数" 则 { 返回 20 }  // TYPE_INT
    若 text == "浮点数" 则 { 返回 21 } // TYPE_FLOAT
    若 text == "双精度" 则 { 返回 22 } // TYPE_DOUBLE
    若 text == "布尔" 则 { 返回 23 }  // TYPE_BOOL
    若 text == "文本" 则 { 返回 24 }  // TYPE_STRING
    若 text == "无返回" 则 { 返回 25 } // TYPE_VOID
    若 text == "字符" 则 { 返回 26 }  // TYPE_CHAR
    若 text == "指针" 则 { 返回 27 }  // TYPE_POINTER
    若 text == "列表" 则 { 返回 28 }  // TYPE_LIST
    若 text == "长整数" 则 { 返回 29 } // TYPE_LONG
    返回 0
}

/* ============ 初始化 ============ */

函数 parserInit(tokens: 列表): Parser {
    定义 可变 p: Parser
    p.pos = 0
    p.tokens = tokens
    p.errors = 列表()
    p.nodeCount = 0
    p.tokenCount = 列表长度(tokens)
    返回 p
}

/* ============ Token 访问辅助函数 ============ */

/* 获取当前 token */
函数 parserPeekToken(p: Parser): Token {
    定义 可变 tok: Token
    tok.类型 = 0
    tok.值 = ""
    tok.行号 = 0
    tok.列号 = 0
    tok.开始位置 = 0
    tok.结束位置 = 0

    若 p.pos < p.tokenCount 则 {
        定义 可变 t: Token
        t = p.tokens[p.pos]
        返回 t
    }

    tok.类型 = 6  // 结束
    tok.值 = "EOF"
    返回 tok
}

/* 检查当前 token 是否为指定值 */
函数 parserCheck(p: Parser, 值: 文本): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    若 tok.值 == 值 则 {
        返回 1
    }
    返回 0
}

/* 检查当前 token 是否为指定类型 */
函数 parserCheckType(p: Parser, 类型: 整数): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    若 tok.类型 == 类型 则 {
        返回 1
    }
    返回 0
}

/* 匹配并消费 token */
函数 parserMatch(p: Parser, 值: 文本): 整数 {
    若 parserCheck(p, 值) == 1 则 {
        p.pos = p.pos + 1
        返回 1
    }
    返回 0
}

/* 生成新的 AST 节点 ID */
函数 parserNewNodeId(p: Parser): 整数 {
    p.nodeCount = p.nodeCount + 1
    返回 p.nodeCount
}

/* 创建 AST 节点 */
函数 parserCreateNode(kind: 整数, name: 文本, value: 文本, line: 整数): AST节点 {
    定义 可变 node: AST节点
    node.id = 0
    node.kind = kind
    node.name = name
    node.value = value
    node.intValue = 0
    node.line = line
    node.children = 列表()
/*[DBG]     打印("DEBUG parseBlock: end, children=") */
/*[DBG]     打印整数(列表长度(node.children)) */
/*[DBG]     打印("\n") */
    返回 node
}

/* ============ 表达式解析 ============ */

/* 解析主表达式 (标识符、数字、字符串、括号) */
函数 parsePrimary(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 node: AST节点
    node = parserCreateNode(0, "", "", tok.行号)

    /* 标识符 */
    若 tok.类型 == 0 则 {
        node.kind = 13  // 标识符表达式
        node.name = tok.值
        node.value = tok.值
        p.pos = p.pos + 1

        /* 检查是否是函数调用 */
        tok = parserPeekToken(p)
        若 tok.值 == "(" 则 {
            node = parseCall(p, node)
        }
        返回 node
    }

    /* 数字 */
    若 tok.类型 == 1 则 {
        node.kind = 14  // 字面量表达式
        node.value = tok.值
        node.intValue = 文本转整数(tok.值)
        p.pos = p.pos + 1
        返回 node
    }

    /* 字符串 */
    若 tok.类型 == 2 则 {
        node.kind = 14  // 字面量表达式
        node.value = tok.值
        p.pos = p.pos + 1
        返回 node
    }

    /* 类型关键字作为构造函数: 列表(), 整数() 等（也用作标识符） */
    若 tok.类型 == 3 则 {
        node.kind = 13  // 标识符表达式
        node.name = tok.值
        node.value = tok.值
        p.pos = p.pos + 1

        /* 检查是否是函数调用 */
        tok = parserPeekToken(p)
        若 tok.值 == "(" 则 {
            node = parseCall(p, node)
        }
        返回 node
    }

    /* 左括号 - 括号表达式 */
    若 tok.值 == "(" 则 {
        p.pos = p.pos + 1
        node = parseExpression(p)
        tok = parserPeekToken(p)
        若 tok.值 == ")" 则 {
            p.pos = p.pos + 1
        }
        返回 node
    }

    /* 一元减号 */
    若 tok.值 == "-" 则 {
        p.pos = p.pos + 1
        定义 可变 operand: AST节点
        operand = parsePrimary(p)
        node.kind = 11  // 一元表达式
        node.name = "-"
        返回 node
    }

    /* 空表达式 */
    返回 node
}

/* 解析函数调用 */
函数 parseCall(p: Parser, funcNode: AST节点): AST节点 {
    定义 可变 tok: Token

    /* 消费 ( */
    tok = parserPeekToken(p)
    若 tok.值 == "(" 则 {
        p.pos = p.pos + 1
    } 否则 {
        parser报告错误(p, "期望 '('")
    }

    funcNode.kind = 12  // 调用表达式
    funcNode.children = 列表()

    /* 循环解析参数 */
    循环 {
        tok = parserPeekToken(p)
/*[DBG]         打印("DEBUG parseCall: tok='") */
/*[DBG]         打印(tok.值) */
/*[DBG]         打印("' type=") */
/*[DBG]         打印整数(tok.类型) */
/*[DBG]         打印(" pos=") */
/*[DBG]         打印整数(p.pos) */
/*[DBG]         打印("\n") */

        // 结束条件：遇到 )
        若 tok.值 == ")" 则 {
            跳出
        }

        // 文件末尾，缺少 )
        若 tok.类型 == 6 则 {
            parser报告错误(p, "函数调用未闭合，期望 ')'")
            跳出
        }

        // 解析一个参数
        定义 可变 arg: AST节点
        arg = parseExpression(p)
        列表追加(funcNode.children, arg)

        // 看下一个 token：逗号 or 结束
        tok = parserPeekToken(p)
        若 tok.值 == "," 则 {
            p.pos = p.pos + 1  // 吃掉逗号，继续下一个参数
        } 否则 若 tok.值 != ")" 则 {
            parser报告错误(p, "参数后期望逗号或右括号")
        }
    }

    /* 消费 ) */
    tok = parserPeekToken(p)
    若 tok.值 == ")" 则 {
        p.pos = p.pos + 1
    } 否则 {
        parser报告错误(p, "期望 ')' 结束函数调用")
    }

    返回 funcNode
}

/* 解析一元表达式 */
函数 parseUnary(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    /* 一元运算符 */
    若 tok.值 == "!" || tok.值 == "-" 则 {
        定义 可变 op: 文本
        op = tok.值
        p.pos = p.pos + 1
        定义 可变 operand: AST节点
        operand = parseUnary(p)
        定义 可变 node: AST节点
         node = parserCreateNode(11, op, "", tok.行号)
        列表追加(node.children, operand)
        返回 node
    }

    /* 先解析基本表达式，再处理后缀（调用、索引、字段访问） */
    定义 可变 primary: AST节点
    primary = parsePrimary(p)
    返回 parsePostfix(p, primary)
}

/* 获取运算符优先级 */
函数 getOpPriority(op: 文本): 整数 {
    若 op == "||" 则 { 返回 1 }
    若 op == "&&" 则 { 返回 2 }
    若 op == "==" || op == "!=" 则 { 返回 3 }
    若 op == "<" || op == ">" || op == "<=" || op == ">=" 则 { 返回 4 }
    若 op == "+" || op == "-" 则 { 返回 5 }
    若 op == "*" || op == "/" || op == "%" 则 { 返回 6 }
    返回 0
}

/* 是右结合运算符 */
函数 是右结合(op: 文本): 整数 {
    若 op == "=" 则 { 返回 1 }
    返回 0
}

/* 解析带优先级的二元表达式 (Pratt Parser) */
函数 parseBinaryExpr(p: Parser, minPriority: 整数): AST节点 {
    定义 可变 left: AST节点
    left = parseUnary(p)

    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 priority: 整数
    priority = getOpPriority(tok.值)

    当 priority >= minPriority && priority > 0 则 {
        定义 可变 op: 文本
        op = tok.值
        p.pos = p.pos + 1

        定义 可变 nextMinPriority: 整数
        nextMinPriority = priority + 1
        若 是右结合(op) == 1 则 {
            nextMinPriority = priority
        }

        定义 可变 right: AST节点
        right = parseBinaryExpr(p, nextMinPriority)

        定义 可变 node: AST节点
         node = parserCreateNode(10, op, "", tok.行号)
        列表追加(node.children, left)
        列表追加(node.children, right)

        left = node
        tok = parserPeekToken(p)
        priority = getOpPriority(tok.值)
    }

    返回 left
}

/* 是二元运算符 */
函数 isBinaryOp(text: 文本): 整数 {
    若 text == "+" || text == "-" || text == "*" || text == "/" 则 { 返回 1 }
    若 text == "%" || text == "==" || text == "!=" 则 { 返回 1 }
    若 text == "<" || text == ">" || text == "<=" || text == ">=" 则 { 返回 1 }
    若 text == "&&" || text == "||" 则 { 返回 1 }
    返回 0
}

/* 解析二元表达式 */
函数 parseExpression(p: Parser): AST节点 {
    返回 parseBinaryExpr(p, 1)
}

/* 解析索引访问表达式 */
/* 索引访问: base[index] -> children[0]=base, children[1]=index */
函数 parseIndexAccess(p: Parser, base: AST节点): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 node: AST节点
    node = parserCreateNode(15, "", "", tok.行号)  // 复用类型转换节点kind=15
    node.children = 列表()
    node.children.追加(base)  // children[0] = 被索引对象
    node.children.追加(空节点)  // children[1] = 索引（稍后填充）

    /* 消费 '[' */
    若 tok.值 == "[" 则 {
        p.pos = p.pos + 1

        /* 解析索引 */
        定义 可变 index: AST节点
        index = parseExpression(p)

        /* 消费 ']' */
        tok = parserPeekToken(p)
        若 tok.值 == "]" 则 {
            p.pos = p.pos + 1
        }

        /* 设置索引 */
        node.children[1] = index
    }

    返回 node
}

/* 解析字段访问表达式 */
函数 parseFieldAccess(p: Parser, base: AST节点): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 node: AST节点
    node = parserCreateNode(0, "", "", tok.行号)

    /* 消费 '.' */
    若 tok.值 == "." 则 {
        p.pos = p.pos + 1

        /* 获取字段名 */
        tok = parserPeekToken(p)
        若 tok.类型 == 0 则 {
node.kind = 23  // 结构体字段节点
 node.name = tok.值
 列表追加(node.children, base)
 p.pos = p.pos + 1
        }
    }

    返回 node
}

/* 解析后缀表达式（索引、调用、字段访问） */
函数 parsePostfix(p: Parser, base: AST节点): AST节点 {
    定义 可变 node: AST节点
    node = base

    定义 可变 tok: Token
    tok = parserPeekToken(p)

    当 tok.值 == "(" || tok.值 == "[" || tok.值 == "." 则 {
        若 tok.值 == "(" 则 {
            node = parseCall(p, node)
        } 否则 {
            若 tok.值 == "[" 则 {
                node = parseIndexAccess(p, node)
            } 否则 {
                若 tok.值 == "." 则 {
                    node = parseFieldAccess(p, node)
                }
            }
        }
        tok = parserPeekToken(p)
    }

/*[DBG]     打印("DEBUG parseBlock: end, children=") */
/*[DBG]     打印整数(列表长度(node.children)) */
/*[DBG]     打印("\n") */
    返回 node
}

/* ============ 语句解析 ============ */

/* 解析赋值语句或表达式语句 */
函数 parseAssignmentOrExpression(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 node: AST节点
    node = parserCreateNode(9, "", "", tok.行号)  // 表达式语句

    // 检查是否是赋值
    若 tok.类型 == 0 则 {
        定义 可变 nextTok: Token
        定义 可变 savedPos: 整数
        savedPos = p.pos

        // 消费标识符
        p.pos = p.pos + 1
        nextTok = parserPeekToken(p)

        // 如果下一个是 =、+=、-=、*=、/=、%= 则为赋值
        若 nextTok.值 == "=" 则 {
            p.pos = p.pos + 1  // 消费 =
            定义 可变 valueNode: AST节点
            valueNode = parseExpression(p)
            node.kind = 19  // 赋值表达式
            node.name = tok.值
            node.value = "="
            返回 node
        } 否则 {
            // 不是赋值，回退
            p.pos = savedPos
        }
    }

    // 作为表达式解析
    node = parseExpression(p)
    返回 node
}

/* 解析赋值语句 */
函数 parseAssignmentStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号

    定义 可变 node: AST节点
    node = parserCreateNode(4, "", "", line)  // 赋值语句

    // 获取变量名
    tok = parserPeekToken(p)
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    // 获取赋值运算符
    tok = parserPeekToken(p)
    定义 可变 op: 文本
    op = "="

    若 tok.值 == "=" 则 { op = "=" }
    若 tok.值 == "+=" 则 { op = "+=" }
    若 tok.值 == "-=" 则 { op = "-=" }
    若 tok.值 == "*=" 则 { op = "*=" }
    若 tok.值 == "/=" 则 { op = "/=" }
    若 tok.值 == "%=" 则 { op = "%=" }

    node.value = op
    p.pos = p.pos + 1

    // 解析右侧表达式
    定义 可变 valueNode: AST节点
    valueNode = parseExpression(p)

    // 消费分号（如果有）
    tok = parserPeekToken(p)
    若 tok.值 == ";" 则 {
        p.pos = p.pos + 1
    }

    返回 node
}

/* 解析变量定义语句: 定义 可变 变量名: 类型 = 值 */
函数 parseLetStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号

    定义 可变 node: AST节点
    node = parserCreateNode(3, "", "", line)  // 变量定义

    /* 消费 '定义' */
    若 tok.值 == "定义" 则 {
        p.pos = p.pos + 1
    }

    /* 处理可选的 '可变' 关键字 */
    tok = parserPeekToken(p)
    若 tok.值 == "可变" 则 {
        p.pos = p.pos + 1
    }

    /* 获取变量名 */
    tok = parserPeekToken(p)
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    /* 消费 ':' (可选) */
    tok = parserPeekToken(p)
    若 tok.值 == ":" 则 {
        p.pos = p.pos + 1
        /* 消费类型 */
        tok = parserPeekToken(p)
        node.value = tok.值
        p.pos = p.pos + 1
    }

    /* 消费 '=' */
    tok = parserPeekToken(p)
    若 tok.值 == "=" 则 {
        p.pos = p.pos + 1
        /* 解析初始值表达式 */
        定义 可变 expr: AST节点
        expr = parseExpression(p)
        列表追加(node.children, expr)  // 设置初始值作为子节点
    }

    返回 node
}

/* 解析返回语句 */
函数 parseReturnStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号

    定义 可变 node: AST节点
    node = parserCreateNode(8, "", "", line)  // 返回语句

    /* 消费 '返回' */
    若 tok.值 == "返回" 则 {
        p.pos = p.pos + 1
    }

    /* 解析返回值（可选） */
    tok = parserPeekToken(p)
    若 tok.值 != "}" 则 {
        定义 可变 expr: AST节点
        expr = parseExpression(p)
        列表追加(node.children, expr)  // 设置返回值作为子节点
    }

    返回 node
}

/* 解析 break 语句 */
函数 parseBreakStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号

    定义 可变 node: AST节点
    node = parserCreateNode(16, "", "", line)  // break语句

    /* 消费 '退出' */
    若 tok.值 == "退出" 则 {
        p.pos = p.pos + 1
    }

    /* 消费 ';' */
    tok = parserPeekToken(p)
    若 tok.值 == ";" 则 {
        p.pos = p.pos + 1
    }

    返回 node
}

/* 解析 continue 语句 */
函数 parseContinueStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号

    定义 可变 node: AST节点
    node = parserCreateNode(17, "", "", line)  // continue语句

    /* 消费 '跳过' */
    若 tok.值 == "跳过" 则 {
        p.pos = p.pos + 1
    }

    /* 消费 ';' */
    tok = parserPeekToken(p)
    若 tok.值 == ";" 则 {
        p.pos = p.pos + 1
    }

    返回 node
}

/* 解析块语句 */
函数 parseBlock(p: Parser): AST节点 {
    打印("[BLOCK ENTER]\n")
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    定义 可变 line: 整数
    line = tok.行号

    定义 可变 node: AST节点
    node = parserCreateNode(18, "", "", line)  // 块语句
    node.children = 列表()

/*[DBG]     打印("DEBUG parseBlock: start\n") */
    /* 消费 '{' */
    若 tok.值 == "{" 则 {
        p.pos = p.pos + 1
    }

    /* 循环解析语句 */
    tok = parserPeekToken(p)
/*[DBG]     打印("DEBUG parseBlock: first body tok='") */
/*[DBG]     打印(tok.值) */
/*[DBG]     打印("' type=") */
/*[DBG]     打印整数(tok.类型) */
/*[DBG]     打印("\n") */
    当 tok.值 != "}" && tok.值 != "" && tok.类型 != 6 则 {
/*[DBG]         打印("DEBUG blk: tok=") */
/*[DBG]         打印(tok.值) */
/*[DBG]         打印(" type=") */
/*[DBG]         打印整数(tok.类型) */
/*[DBG]         打印("\n") */
        定义 可变 stmt: AST节点

        若 tok.值 == "定义" 则 {
            stmt = parseLetStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "返回" 则 {
            stmt = parseReturnStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "若" 则 {
            stmt = parseIfStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "当" 则 {
            stmt = parseWhileStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "循环" 则 {
            stmt = parseForStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "匹配" 则 {
            stmt = parseMatchStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "退出" 则 {
            stmt = parseBreakStatement(p)
            列表追加(node.children, stmt)
        } 否则 若 tok.值 == "跳过" 则 {
            stmt = parseContinueStatement(p)
            列表追加(node.children, stmt)
        } 否则 {
            stmt = parseAssignmentOrExpression(p)
            列表追加(node.children, stmt)
            // 消费分号
            tok = parserPeekToken(p)
            若 tok.值 == ";" 则 {
                p.pos = p.pos + 1
            }
        }

        tok = parserPeekToken(p)
    }

    /* 消费 '}' */
    若 tok.值 == "}" 则 {
        p.pos = p.pos + 1
    }

    返回 node
}

/* 解析 if 语句 */
/* 支持: 若 expr 则 { ... }
 *       若 expr 则 { ... } 否则若 expr 则 { ... }
 *       若 expr 则 { ... } 否则 { ... }
 */
函数 parseIfStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(5, "", "", line)
    node.children = 列表()

    /* 消费 '若' */
    tok = parserPeekToken(p)
    若 tok.值 == "若" 则 {
        line = tok.行号
        p.pos = p.pos + 1
    }

    /* 解析条件表达式 */
    定义 可变 condNode: AST节点
    condNode = parseExpression(p)
    node.children.追加(condNode)

    /* 消费 '则' */
    tok = parserPeekToken(p)
    若 tok.值 == "则" 则 {
        p.pos = p.pos + 1
    }

    /* 解析 then 分支（块或单语句） */
    定义 可变 thenNode: AST节点
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        thenNode = parseBlock(p)
    } 否则 {
        thenNode = parseExpression(p)
    }
    node.children.追加(thenNode)

    /* 检查 '否则' 或 '否则若' */
    tok = parserPeekToken(p)
    定义 可变 elseNode: AST节点
    elseNode = parserCreateNode(0, "", "", line)

    若 tok.值 == "否则若" 则 {
        /* 否则若 - 递归解析嵌套的 if 语句 */
        p.pos = p.pos + 1
        elseNode = parseIfStatement(p)
    } 否则 若 tok.值 == "否则" 则 {
        p.pos = p.pos + 1
        /* 解析普通 else 块 */
        tok = parserPeekToken(p)
        若 tok.值 == "{" 则 {
            elseNode = parseBlock(p)
        } 否则 {
            /* 否则后是单语句（简化处理，解析为表达式） */
            elseNode = parseExpression(p)
        }
    }
    node.children.追加(elseNode)

    返回 node
}

/* 解析 while 语句 */
函数 parseWhileStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(6, "", "", line)
    node.children = 列表()

    /* 消费 '当' */
    tok = parserPeekToken(p)
    若 tok.值 == "当" 则 {
        line = tok.行号
        p.pos = p.pos + 1
    }

    /* 解析条件表达式 */
    定义 可变 condNode: AST节点
    condNode = parseExpression(p)
    node.children.追加(condNode)

    /* 解析循环体（块或单语句） */
    定义 可变 bodyNode: AST节点
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        bodyNode = parseBlock(p)
    } 否则 {
        bodyNode = parseExpression(p)
    }
    node.children.追加(bodyNode)

    返回 node
}

/* 解析 for 循环语句: 循环 变量 从 起始 到 结束 遍历 */
函数 parseForStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(20, "", "", line)
    node.children = 列表()

    /* 消费 '循环' */
    tok = parserPeekToken(p)
    若 tok.值 == "循环" 则 {
        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }

    /* 获取循环变量名 */
    tok = parserPeekToken(p)
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    /* 消费 '从' */
    tok = parserPeekToken(p)
    若 tok.值 == "从" 则 {
        p.pos = p.pos + 1
    }

    /* 解析起始值 */
    定义 可变 startNode: AST节点
    startNode = parseExpression(p)
    node.children.追加(startNode)

    /* 消费 '到' */
    tok = parserPeekToken(p)
    若 tok.值 == "到" 则 {
        p.pos = p.pos + 1
    }

    /* 解析结束值 */
    定义 可变 endNode: AST节点
    endNode = parseExpression(p)
    node.children.追加(endNode)

    /* 解析循环体（块或单语句） */
    定义 可变 bodyNode: AST节点
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        bodyNode = parseBlock(p)
    } 否则 {
        bodyNode = parseExpression(p)
    }
    node.children.追加(bodyNode)

    返回 node
}

/* 解析 match 语句: 匹配 表达式 { case 值: 语句, default: 语句 } */
函数 parseMatchStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(25, "", "", line)  // match语句
    node.children = 列表()

    /* 消费 '匹配' */
    tok = parserPeekToken(p)
    若 tok.值 == "匹配" 则 {
        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }

    /* 解析被匹配的值并添加到 children */
    定义 可变 subjectNode: AST节点
    subjectNode = parseExpression(p)
    node.children.追加(subjectNode)

    /* 消费 '{' */
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        p.pos = p.pos + 1
    }

    /* 解析分支 */
    tok = parserPeekToken(p)
    当 tok.值 != "}" && tok.值 != "" && tok.类型 != 6 则 {
        定义 可变 branchNode: AST节点
        branchNode = parserCreateNode(26, "", "", line)
        branchNode.children = 列表()

        /* 检查是否是 default 分支 */
        若 tok.值 == "默认" 则 {
            /* 默认分支 */
            p.pos = p.pos + 1
            tok = parserPeekToken(p)
            若 tok.值 == ":" 则 {
                p.pos = p.pos + 1
            }
            定义 可变 defaultBody: AST节点
            defaultBody = parseExpression(p)
            branchNode = parserCreateNode(27, "", "", line)  // match默认分支
            branchNode.children = 列表()
            branchNode.children.追加(defaultBody)
            node.children.追加(branchNode)
        } 否则 {
            /* case 分支 */
            若 tok.值 == "情况" 则 {
                p.pos = p.pos + 1
            }

            /* 解析 case 值 */
            定义 可变 caseValue: 文本
            caseValue = ""
            tok = parserPeekToken(p)
            若 tok.类型 == 1 则 {
                caseValue = tok.值
                p.pos = p.pos + 1
            } 否则 {
                若 tok.类型 == 0 则 {
                    caseValue = tok.值
                    p.pos = p.pos + 1
                }
            }

            branchNode = parserCreateNode(26, caseValue, "", tok.行号)  // match分支
            branchNode.children = 列表()

            /* 消费 ':' */
            tok = parserPeekToken(p)
            若 tok.值 == ":" 则 {
                p.pos = p.pos + 1
            }

            /* 解析分支体并添加到 children */
            定义 可变 branchBody: AST节点
            branchBody = parseExpression(p)
            branchNode.children.追加(branchBody)
            node.children.追加(branchNode)
        }

        /* 消费 ',' || ';' */
        tok = parserPeekToken(p)
        若 tok.值 == "," 则 {
            p.pos = p.pos + 1
        }

        tok = parserPeekToken(p)
    }

    /* 消费 '}' */
    tok = parserPeekToken(p)
    若 tok.值 == "}" 则 {
        p.pos = p.pos + 1
    }

/*[DBG]     打印("DEBUG parseBlock: end, children=") */
/*[DBG]     打印整数(列表长度(node.children)) */
/*[DBG]     打印("\n") */
    返回 node
}

/* ============ 函数解析 ============ */

/* 解析结构体定义: 结构体 结构体名 { 字段1: 类型1, 字段2: 类型2 } */
函数 parseStructDefinition(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(21, "", "", line)  // 结构体定义
    node.children = 列表()

    /* 消费 '结构体' */
    tok = parserPeekToken(p)
    若 tok.值 == "结构体" 则 {
        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }

    /* 获取结构体名 */
    tok = parserPeekToken(p)
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    /* 消费 '{' */
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        p.pos = p.pos + 1
    }

    /* 解析字段列表 */
    tok = parserPeekToken(p)
    当 tok.值 != "}" && tok.值 != "" && tok.类型 != 6 则 {
        /* 获取字段名 */
        若 tok.类型 == 0 则 {
            定义 可变 fieldNode: AST节点
            fieldNode = parserCreateNode(23, tok.值, "", tok.行号)  // 结构体字段
            p.pos = p.pos + 1

            /* 消费 ':' */
            tok = parserPeekToken(p)
            若 tok.值 == ":" 则 {
                p.pos = p.pos + 1
            }

            /* 获取字段类型 */
            tok = parserPeekToken(p)
            若 tok.类型 == 3 则 {
                fieldNode.value = tok.值
                p.pos = p.pos + 1
            }

            node.children.追加(fieldNode)

            /* 消费 ',' || '}' */
            tok = parserPeekToken(p)
            若 tok.值 == "," 则 {
                p.pos = p.pos + 1
            }
        }

        tok = parserPeekToken(p)
    }

    /* 消费 '}' */
    tok = parserPeekToken(p)
    若 tok.值 == "}" 则 {
        p.pos = p.pos + 1
    }

    返回 node
}

函数 parseImportStatement(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(28, "", "", line)  // 导入语句
    node.children = 列表()

    /* 消费 '引入' */
    tok = parserPeekToken(p)
    若 tok.值 == "引入" 则 {
        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }

    /* 解析模块路径 */
    tok = parserPeekToken(p)
    若 tok.类型 == 2 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    /* 消费分号（可选） */
    tok = parserPeekToken(p)
    若 tok.值 == ";" 则 {
        p.pos = p.pos + 1
    }

    返回 node
}

/* 解析模块定义: 模块 模块名 { ... } */
函数 parseModuleDefinition(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(29, "", "", line)  // 模块定义
    node.children = 列表()

    /* 消费 '模块' */
    tok = parserPeekToken(p)
    若 tok.值 == "模块" 则 {
        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }

    /* 获取模块名 */
    tok = parserPeekToken(p)
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    /* 消费 '{' */
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        p.pos = p.pos + 1
    }

    /* 解析模块内容（函数定义列表） */
    tok = parserPeekToken(p)
    当 tok.值 != "}" && tok.值 != "" && tok.类型 != 6 则 {
        若 tok.值 == "函数" 则 {
            定义 可变 funcNode: AST节点
            funcNode = parseFunction(p)
            列表追加(node.children, funcNode)
        } 否则 若 tok.值 == "引入" 则 {
            定义 可变 importNode: AST节点
            importNode = parseImportStatement(p)
            列表追加(node.children, importNode)
        } 否则 {
            p.pos = p.pos + 1
        }
        tok = parserPeekToken(p)
    }

    /* 消费 '}' */
    若 tok.值 == "}" 则 {
        p.pos = p.pos + 1
    }

    返回 node
}

/* 解析枚举定义: 枚举 枚举名 { 成员1, 成员2, 成员3 } */
函数 parseEnumDefinition(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(22, "", "", line)  // 枚举定义
    node.children = 列表()

    /* 消费 '枚举' */
    tok = parserPeekToken(p)
    若 tok.值 == "枚举" 则 {
        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }

    /* 获取枚举名 */
    tok = parserPeekToken(p)
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    /* 消费 '{' */
    tok = parserPeekToken(p)
    若 tok.值 == "{" 则 {
        p.pos = p.pos + 1
    }

    /* 解析成员列表 */
    tok = parserPeekToken(p)
    当 tok.值 != "}" && tok.值 != "" && tok.类型 != 6 则 {
        若 tok.类型 == 0 则 {
            定义 可变 memberNode: AST节点
            memberNode = parserCreateNode(24, tok.值, "", tok.行号)
            node.children.追加(memberNode)
            p.pos = p.pos + 1

            /* 消费 ',' || '}' */
            tok = parserPeekToken(p)
            若 tok.值 == "," 则 {
                p.pos = p.pos + 1
            }
        }

        tok = parserPeekToken(p)
    }

    /* 消费 '}' */
    tok = parserPeekToken(p)
    若 tok.值 == "}" 则 {
        p.pos = p.pos + 1
    }

    返回 node
}

/* 解析函数签名: 函数 函数名(参数): 返回类型 */
函数 parseFunctionSignature(p: Parser): AST节点 {
    打印("[SIG enter]\n")
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(1, "", "", line)  // 函数定义
    打印("[SIG node created]\n")
    node.children = 列表()
    打印("[SIG about to peek func]\n")

    /* 消费 '函数' */
    tok = parserPeekToken(p)
    打印("[SIG peeked func] val=")
    打印(tok.值)
    打印("\n")
    若 tok.值 == "函数" 则 {
        line = tok.行号
        打印("[SIG consuming func]\n")
        p.pos = p.pos + 1
        打印("[SIG consumed func]\n")
    }

    /* 获取函数名 */
    打印("[SIG before peek name] pos=")
    打印整数(p.pos)
    打印("\n")
    tok = parserPeekToken(p)
    打印("[SIG peeked name] val=")
    打印(tok.值)
    打印("\n")
    若 tok.类型 == 0 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    /* 消费 '(' */
    tok = parserPeekToken(p)
    若 tok.值 == "(" 则 {
        p.pos = p.pos + 1
    }

    /* 解析参数列表 (简化) */
    tok = parserPeekToken(p)
    当 tok.值 != ")" && tok.值 != "" && tok.类型 != 6 则 {
        /* 解析参数名 */
        若 tok.类型 == 0 则 {
            p.pos = p.pos + 1
            /* 消费 ':' */
            tok = parserPeekToken(p)
            若 tok.值 == ":" 则 {
                p.pos = p.pos + 1
                /* 消费参数类型 */
                tok = parserPeekToken(p)
                若 tok.类型 == 3 则 {
                    p.pos = p.pos + 1
                }
            }
        }
        /* 消费 ',' */
        tok = parserPeekToken(p)
        若 tok.值 == "," 则 {
            p.pos = p.pos + 1
        }
        tok = parserPeekToken(p)
    }

    /* 消费 ')' */
    打印("[SIG before )]\n")
    tok = parserPeekToken(p)
    若 tok.值 == ")" 则 {
        p.pos = p.pos + 1
    }
    打印("[SIG after )]\n")

    /* 消费返回类型 ':' 和类型 */
    tok = parserPeekToken(p)
    若 tok.值 == ":" 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
        node.value = tok.值  // 返回类型
        p.pos = p.pos + 1
    }

    打印("[SIG returning]\n")
    node.line = line
    返回 node
}

/* 解析函数定义 */
函数 parseFunction(p: Parser): AST节点 {
    打印("[PFUNC enter]\n")
    /* 解析函数签名 */
    定义 可变 funcNode: AST节点
    funcNode = parseFunctionSignature(p)
    打印("[PFUNC sig done]\n")

    /* 解析函数体 */
    定义 可变 bodyNode: AST节点
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    打印("[PARSEFUNC: peeked='")
    打印(tok.值)
    打印("' type=")
    打印整数(tok.类型)
    打印("]\n")
    若 tok.值 == "{" 则 {
        打印("[PARSEFUNC: calling parseBlock]\n")
        bodyNode = parseBlock(p)
    } 否则 {
        打印("[PARSEFUNC: calling parseExpression]\n")
        bodyNode = parseExpression(p)
    }

    打印("解析函数: ")
    打印(funcNode.name)

    定义 可变 funcChildren: 列表
    funcChildren = 列表()
    打印("[PFUNC appending body]\n")
    funcChildren.追加(bodyNode)
    打印("[PFUNC appended ok]\n")
    funcNode.children = funcChildren
    打印("[PFUNC returning funcNode]\n")
    返回 funcNode
}

/* ============ 语法错误恢复 ============ */

/**
 * 报告语法错误
 */
函数 parser报告错误(p: Parser, 消息: 文本): 无返回 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    打印("语法错误 (行")
    打印(tok.行号)
    打印(", 列")
    打印(tok.列号)
    打印("): ")
    打印(消息)
}

/**
 * 跳过到指定 token
 */
函数 parser跳过到(p: Parser, target: 文本): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    当 tok.值 != target && tok.类型 != 6 && tok.值 != "" 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
    }

    若 tok.值 == target 则 {
        返回 1
    }
    返回 0
}

/**
 * 跳过到指定类型
 */
函数 parser跳过到类型(p: Parser, 类型: 整数): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    当 tok.类型 != 类型 && tok.类型 != 6 && tok.值 != "" 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
    }

    若 tok.类型 == 类型 则 {
        返回 1
    }
    返回 0
}

/**
 * 同步到函数开始
 */
/**
 * 检查下一个 token 是否为指定值
 */
函数 parser预览(p: Parser, 值: 文本): 整数 {
    定义 可变 savedPos: 整数
    savedPos = p.pos

    定义 可变 tok: Token
    tok = parserPeekToken(p)
    p.pos = p.pos + 1

    p.pos = savedPos

    若 tok.值 == 值 则 {
        返回 1
    }
    返回 0
}

/**
 * 检查下一个 token 是否为指定类型
 */
函数 parser预览类型(p: Parser, 类型: 整数): 整数 {
    定义 可变 savedPos: 整数
    savedPos = p.pos

    定义 可变 tok: Token
    tok = parserPeekToken(p)
    p.pos = p.pos + 1

    p.pos = savedPos

    若 tok.类型 == 类型 则 {
        返回 1
    }
    返回 0
}

/**
 * 尝试恢复解析
 */
函数 parser尝试恢复(p: Parser): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    /* 常见恢复点 */
    若 tok.值 == "函数" 则 { 返回 1 }
    若 tok.值 == "定义" 则 { 返回 1 }
    若 tok.值 == "若" 则 { 返回 1 }
    若 tok.值 == "当" 则 { 返回 1 }
    若 tok.值 == "循环" 则 { 返回 1 }
    若 tok.值 == "返回" 则 { 返回 1 }
    若 tok.值 == "{" 则 { 返回 1 }
    若 tok.值 == "}" 则 { 返回 1 }

    /* 无法恢复 */
    返回 0
}

/**
 * 解析类型注解
 */
函数 parseTypeAnnotation(p: Parser): 文本 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 typeName: 文本
    typeName = ""

    /* 消费 ':' */
    若 tok.值 == ":" 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
        若 tok.类型 == 3 则 {
            typeName = tok.值
            p.pos = p.pos + 1
        }
    }

    返回 typeName
}

/**
 * 解析默认参数值
 */
函数 parseDefaultValue(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 defaultNode: AST节点
    defaultNode = parserCreateNode(14, "", "", tok.行号)

    /* 检查 '=' */
    若 tok.值 == "=" 则 {
        p.pos = p.pos + 1
        defaultNode = parseExpression(p)
    }

    返回 defaultNode
}

/**
 * 解析参数列表
 */
函数 parseParameterList(p: Parser): 列表 {
    定义 可变 params: 列表
    params = 列表()

    定义 可变 tok: Token
    tok = parserPeekToken(p)

    /* 消费 '(' */
    若 tok.值 == "(" 则 {
        p.pos = p.pos + 1
    }

    /* 解析参数 */
    tok = parserPeekToken(p)
    当 tok.值 != ")" && tok.值 != "" && tok.类型 != 6 则 {
        /* 获取参数名 */
        若 tok.类型 == 0 则 {
            定义 可变 paramNode: AST节点
            paramNode = parserCreateNode(2, tok.值, "", tok.行号)
            p.pos = p.pos + 1

            /* 解析类型注解 */
            tok = parserPeekToken(p)
            若 tok.值 == ":" 则 {
                p.pos = p.pos + 1
                tok = parserPeekToken(p)
                若 tok.类型 == 3 则 {
                    paramNode.value = tok.值
                    p.pos = p.pos + 1
                }
            }

            /* 解析默认值 */
            tok = parserPeekToken(p)
            若 tok.值 == "=" 则 {
                定义 可变 defaultVal: AST节点
                defaultVal = parseDefaultValue(p)
                paramNode.children = defaultVal
            }
        }

        /* 消费 ',' */
        tok = parserPeekToken(p)
        若 tok.值 == "," 则 {
            p.pos = p.pos + 1
        }

        tok = parserPeekToken(p)
    }

    /* 消费 ')' */
    若 tok.值 == ")" 则 {
        p.pos = p.pos + 1
    }

    返回 params
}

/**
 * 解析特性注解
 */
函数 parseAttribute(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 attrNode: AST节点
    attrNode = parserCreateNode(0, "", "", tok.行号)

    /* 消费 '@' */
    若 tok.值 == "@" 则 {
        p.pos = p.pos + 1
        tok = parserPeekToken(p)
        attrNode.name = tok.值
        p.pos = p.pos + 1

        /* 消费 '(' 如果有参数 */
        tok = parserPeekToken(p)
        若 tok.值 == "(" 则 {
            p.pos = p.pos + 1
            tok = parserPeekToken(p)
            当 tok.值 != ")" && tok.值 != "" 则 {
                p.pos = p.pos + 1
                tok = parserPeekToken(p)
            }
            若 tok.值 == ")" 则 {
                p.pos = p.pos + 1
            }
        }
    }

    返回 attrNode
}

/**
 * 解析 where 子句
 */
函数 parseWhereClause(p: Parser): AST节点 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    定义 可变 whereNode: AST节点
    whereNode = parserCreateNode(0, "", "", tok.行号)

    /* 消费 'where' */
    若 tok.值 == "where" 则 {
        p.pos = p.pos + 1
        /* 解析约束条件 */
        tok = parserPeekToken(p)
        当 tok.值 != "{" && tok.值 != "" && tok.类型 != 6 则 {
            p.pos = p.pos + 1
            tok = parserPeekToken(p)
        }
    }

    返回 whereNode
}

/* ============ 错误恢复机制 ============ */

/**
 * 创建错误恢复上下文
 */
函数 parser创建错误恢复(): ErrorRecovery {
    定义 可变 recovery: ErrorRecovery
    recovery.已恢复 = 0
    recovery.跳过Token数 = 0
    recovery.恢复点 = 0
    返回 recovery
}

/**
 * 找到同步恢复点
 */
函数 parser找到恢复点(p: Parser): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    /* 优先级恢复点 */
    若 tok.值 == "函数" 则 { 返回 1 }
    若 tok.值 == "定义" 则 { 返回 1 }
    若 tok.值 == "若" 则 { 返回 1 }
    若 tok.值 == "当" 则 { 返回 1 }
    若 tok.值 == "循环" 则 { 返回 1 }
    若 tok.值 == "返回" 则 { 返回 1 }
    若 tok.值 == "{" 则 { 返回 1 }
    若 tok.值 == "}" 则 { 返回 1 }
    若 tok.值 == "结构体" 则 { 返回 1 }
    若 tok.值 == "枚举" 则 { 返回 1 }
    若 tok.值 == "模块" 则 { 返回 1 }
    若 tok.值 == "导入" 则 { 返回 1 }

    返回 0
}

/**
 * 跳过错误token直到恢复点
 */
函数 parser跳过到恢复点(p: Parser): Parser {
    定义 可变 recovery: ErrorRecovery
    recovery = parser创建错误恢复()

    当 p.pos < p.tokenCount && recovery.已恢复 == 0 则 {
        定义 可变 tok: Token
        tok = parserPeekToken(p)

        若 parser找到恢复点(p) == 1 则 {
            recovery.已恢复 = 1
        } 否则 {
            p.pos = p.pos + 1
            recovery.跳过Token数 = recovery.跳过Token数 + 1
        }
    }

    返回 p
}

/**
 * 报告解析错误并尝试恢复
 */
函数 parser错误报告恢复(p: Parser, 消息: 文本): Parser {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    打印("解析错误 [行 ")
    打印(tok.行号)
    打印("]: ")
    打印(消息)

    /* 尝试恢复 */
    p = parser跳过到恢复点(p)

    返回 p
}

/**
 * 检查是否需要插入缺失的 token
 */
函数 parser检查缺失Token(p: Parser, expected: 文本): 整数 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    若 tok.值 == expected 则 {
        返回 1
    }

    打印("警告: 期望 '")
    打印(expected)
    打印("'，实际 '")
    打印(tok.值)
    打印("'")

    返回 0
}

/**
 * 插入缺失的 token
 */
函数 parser插入缺失Token(p: Parser, tokenType: 整数, tokenValue: 文本): Token {
    定义 可变 inserted: Token
    inserted.类型 = tokenType
    inserted.值 = tokenValue
    inserted.行号 = p.当前行号
    inserted.列号 = p.当前列号
    inserted.开始位置 = p.当前位置
    inserted.结束位置 = p.当前位置

    打印("插入缺失 token: ")
    打印(tokenValue)

    返回 inserted
}

/**
 * 同步到函数边界
 */
函数 parser同步到函数(p: Parser): Parser {
    定义 可变 depth: 整数
    depth = 0

    当 p.pos < p.tokenCount 则 {
        定义 可变 tok: Token
        tok = parserPeekToken(p)

        若 tok.值 == "函数" && depth == 0 则 {
            返回 p
        }

        若 tok.值 == "{" 则 {
            depth = depth + 1
        } 否则 {
            若 tok.值 == "}" 则 {
                depth = depth - 1
            }
        }

        p.pos = p.pos + 1
    }

    返回 p
}

/**
 * 同步到语句边界
 */
函数 parser同步到语句(p: Parser): Parser {
    当 p.当前位置 < p.源码长度 则 {
        定义 可变 tok: Token
        tok = parserPeekToken(p)

        /* 语句开始关键字 */
        若 tok.值 == "若" 则 { 返回 p }
        若 tok.值 == "当" 则 { 返回 p }
        若 tok.值 == "循环" 则 { 返回 p }
        若 tok.值 == "定义" 则 { 返回 p }
        若 tok.值 == "返回" 则 { 返回 p }
        若 tok.值 == "打印" 则 { 返回 p }
        若 tok.值 == "{" 则 { 返回 p }
        若 tok.值 == "}" 则 { 返回 p }
        若 tok.类型 == 6 则 { 返回 p }

        p.pos = p.pos + 1
    }

    返回 p
}

/**
 * 解析器 panic 模式恢复
 */
函数 parserPanic恢复(p: Parser): Parser {
    打印("进入 panic 模式恢复...")

    p = parser同步到函数(p)

    打印("panic 模式恢复完成")

    返回 p
}

/**
 * 记录解析边界
 */
函数 parser记录边界(p: Parser): 无返回 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)
    打印("解析位置: 行 ")
    打印(tok.行号)
    打印(", 列 ")
    打印(tok.列号)
}

/**
 * 解析器诊断信息
 */
函数 parser诊断(p: Parser): 无返回 {
    打印("=== 解析器诊断 ===")
    打印("  当前位置: ")
    打印(p.pos)
    打印("/")
    打印(p.tokenCount)
    打印("  节点计数: ")
    打印(p.nodeCount)
    打印("  错误列表长度: ")
    打印(列表长度(p.errors))
}

/**
 * 打印 AST 节点（递归）
 */
函数 打印AST节点(node: AST节点, 缩进: 整数): 无返回 {
    定义 可变 i: 整数
    i = 0

    /* 打印缩进 */
    当 i < 缩进 则 {
        打印("  ")
        i = i + 1
    }

    /* 打印节点类型 */
    定义 可变 类型名: 文本
    类型名 = ""
    若 node.kind == 0 则 { 类型名 = "程序" }
    若 node.kind == 1 则 { 类型名 = "函数定义" }
    若 node.kind == 2 则 { 类型名 = "参数列表" }
    若 node.kind == 3 则 { 类型名 = "变量定义" }
    若 node.kind == 4 则 { 类型名 = "赋值语句" }
    若 node.kind == 5 则 { 类型名 = "if语句" }
    若 node.kind == 6 则 { 类型名 = "while语句" }
    若 node.kind == 7 则 { 类型名 = "循环语句" }
    若 node.kind == 8 则 { 类型名 = "返回语句" }
    若 node.kind == 9 则 { 类型名 = "表达式语句" }
    若 node.kind == 10 则 { 类型名 = "二元表达式" }
    若 node.kind == 11 则 { 类型名 = "一元表达式" }
    若 node.kind == 12 则 { 类型名 = "调用表达式" }
    若 node.kind == 13 则 { 类型名 = "标识符表达式" }
    若 node.kind == 14 则 { 类型名 = "字面量表达式" }
    若 node.kind == 15 则 { 类型名 = "类型转换" }
    若 node.kind == 16 则 { 类型名 = "break语句" }
    若 node.kind == 17 则 { 类型名 = "continue语句" }
    若 node.kind == 18 则 { 类型名 = "块语句" }
    若 node.kind == 19 则 { 类型名 = "赋值表达式" }
    若 node.kind == 20 则 { 类型名 = "for循环" }
    若 node.kind == 21 则 { 类型名 = "结构体定义" }
    若 node.kind == 22 则 { 类型名 = "枚举定义" }
    若 node.kind == 23 则 { 类型名 = "结构体字段" }
    若 node.kind == 24 则 { 类型名 = "枚举成员" }
    若 node.kind == 25 则 { 类型名 = "match语句" }
    若 node.kind == 26 则 { 类型名 = "match分支" }
    若 node.kind == 27 则 { 类型名 = "match默认分支" }
    若 node.kind == 28 则 { 类型名 = "导入语句" }
    若 node.kind == 29 则 { 类型名 = "模块定义" }
    若 node.kind == 30 则 { 类型名 = "外部声明" }

    打印("[")
    打印(类型名)
    打印("]")

    若 node.name != "" 则 {
        打印(" 名称: ")
        打印(node.name)
    }

    若 node.value != "" 则 {
        打印(" 值: '")
        打印(node.value)
        打印("'")
    }

    若 node.line > 0 则 {
        打印(" 行: ")
        打印(node.line)
    }

    打印("")

    /* 递归打印子节点 */
    定义 可变 childCount: 整数
    childCount = 列表长度(node.children)
    i = 0
    当 i < childCount 则 {
        定义 可变 child: AST节点
        child = 列表获取(node.children, i)
        打印AST节点(child, 缩进 + 1)
        i = i + 1
    }
}

/**
 * 打印完整的 AST
 */
函数 打印AST(root: AST节点): 无返回 {
    打印("=== AST 树 ===")
    打印AST节点(root, 0)
    打印("=== AST 结束 ===")
}

/* ============ 解析统计和调试 ============ */

/**
 * 获取解析统计信息
 */
函数 parser获取统计(p: Parser): 列表 {
    定义 可变 stats: 列表
    stats = 列表()
    返回 stats
}

/**
 * 打印解析进度
 */
函数 parser打印进度(p: Parser): 无返回 {
    定义 可变 tok: Token
    tok = parserPeekToken(p)

    详细输出("解析进度: 位置=")
    详细输出(整数转文本(p.pos))
    详细输出("/")
    详细输出(整数转文本(p.tokenCount))
    详细输出(", 当前Token=")
    详细输出(tok.值)
}

/**
 * 验证解析器状态
 */
函数 parser验证状态(p: Parser): 整数 {
    若 p.pos < 0 则 { 返回 0 }
    若 p.pos > p.tokenCount 则 { 返回 0 }
    返回 1
}

/* ============ 主解析循环 ============ */

函数 parserRun(tokens: 列表): 整数 {
    打印("=== 语法分析 ===")

    定义 可变 p: Parser
    p = parserInit(tokens)

    定义 可变 funcCount: 整数
    funcCount = 0

    定义 可变 tok: Token
    tok = parserPeekToken(p)

    /* 循环解析直到文件结束 */
    当 tok.类型 != 6 && tok.值 != "" && funcCount < 100 则 {
        若 tok.值 == "函数" 则 {
            定义 可变 funcNode: AST节点
            funcNode = parseFunction(p)
            funcCount = funcCount + 1
        } 否则 {
            若 tok.值 == "结构体" 则 {
                定义 可变 structNode: AST节点
                structNode = parseStructDefinition(p)
                打印("解析结构体: ")
                打印(structNode.name)
            } 否则 {
                若 tok.值 == "枚举" 则 {
                    定义 可变 enumNode: AST节点
                    enumNode = parseEnumDefinition(p)
                    打印("解析枚举: ")
                    打印(enumNode.name)
                } 否则 {
                    若 tok.值 == "引入" 则 {
                        定义 可变 importNode: AST节点
                        importNode = parseImportStatement(p)
                        打印("解析导入: ")
                        打印(importNode.name)
                    } 否则 {
                        若 tok.值 == "模块" 则 {
                            定义 可变 moduleNode: AST节点
                            moduleNode = parseModuleDefinition(p)
                            打印("解析模块: ")
                            打印(moduleNode.name)
                        } 否则 {
                            /* 跳过未知 token */
                            p.pos = p.pos + 1
                        }
                    }
                }
            }
        }

        tok = parserPeekToken(p)
    }

    打印("语法分析完成，共解析 ")
    打印(funcCount)
    打印(" 个函数")
    打印("生成 ")
    打印(p.nodeCount)
    打印(" 个 AST 节点")

    返回 funcCount
}

/* ============ AST 构建入口函数 ============ */

/**
 * 分析 Token 列表并返回 AST 根节点
 * 这是解析器的外部入口函数
 */
函数 parser分析Tokens(tokens: 列表, source: 文本): AST节点 {
/*[DBG]     打印("DEBUG parser入口: tokensPtr=") */
/*[DBG]     打印(tokens) */
/*[DBG]     打印(" srcLen=") */
/*[DBG]     打印整数(文本长度(source)) */
/*[DBG]     打印("\n") */
    定义 可变 p: Parser
    p = parserInit(tokens)

    定义 可变 progNode: AST节点
    progNode = parserCreateNode(0, "程序", "", 0)  // kind=0 表示程序节点
    progNode.children = 列表()

    定义 可变 tok: Token
/*[DBG]     打印("DEBUG parser: pos=") 打印整数(p.pos) 打印(" count=") 打印整数(p.tokenCount) 打印("\n") */
/*[DBG]     打印("DEBUG parser: about to peek\n") */
    tok = parserPeekToken(p)
/*[DBG]     打印("DEBUG parser: peek done, type=") */
/*[DBG]     打印整数(tok.类型) */
/*[DBG]     打印(" value='") */
/*[DBG]     打印(tok.值) */
/*[DBG]     打印("'\n") */
/*[DBG]     打印("DEBUG parser: entering loop\n") */

    /* 循环解析直到文件结束 */
    当 tok.类型 != 6 && tok.值 != "" 则 {
/*[DBG]         打印("DEBUG parser loop: tok=") */
/*[DBG]         打印(tok.值) */
/*[DBG]         打印(" type=") */
/*[DBG]         打印整数(tok.类型) */
/*[DBG]         打印("\n") */
        若 tok.值 == "函数" || tok.值 == "function" 则 {
/*[DBG]             打印("DEBUG: calling parseFunction\n") */
            定义 可变 funcNode: AST节点
            funcNode = parseFunction(p)
            progNode.children.追加(funcNode)
/*[DBG]             打印("DEBUG: parseFunction returned\n") */
        } 否则 若 tok.值 == "结构体" || tok.值 == "struct" 则 {
            定义 可变 structNode: AST节点
            structNode = parseStructDefinition(p)
            progNode.children.追加(structNode)
        } 否则 若 tok.值 == "枚举" || tok.值 == "enum" 则 {
            定义 可变 enumNode: AST节点
            enumNode = parseEnumDefinition(p)
            progNode.children.追加(enumNode)
        } 否则 若 tok.值 == "引入" || tok.值 == "import" 则 {
            定义 可变 importNode: AST节点
            importNode = parseImportStatement(p)
            progNode.children.追加(importNode)
        } 否则 若 tok.值 == "模块" || tok.值 == "module" 则 {
            定义 可变 moduleNode: AST节点
            moduleNode = parseModuleDefinition(p)
            progNode.children.追加(moduleNode)
        } 否则 若 tok.值 == "外部" || tok.值 == "extern" 则 {
            定义 可变 externalNode: AST节点
            externalNode = parseExternalDeclaration(p)
            progNode.children.追加(externalNode)
        } 否则 {
            /* 跳过未知 token */
            p.pos = p.pos + 1
        }
        打印("[LOOP next tok='")
        打印(tok.值)
        打印("' type=")
        打印整数(tok.类型)
        打印("\n")
        tok = parserPeekToken(p)
    }

    打印("[PARSER DONE] children=")
    打印整数(列表长度(progNode.children))
    打印("\n")
    返回 progNode
}

/* ============ 外部声明解析 ============ */

/**
 * 解析外部函数声明
 * 语法: 外部 "C函数名"
 */
函数 parseExternalDeclaration(p: Parser): AST节点 {
    定义 可变 tok: Token
    定义 可变 line: 整数
    line = 0

    定义 可变 node: AST节点
    node = parserCreateNode(30, "", "", line)
    node.children = 列表()

    /* 消费 '外部' */
    tok = parserPeekToken(p)
    若 tok.值 == "外部" 则 {
        line = tok.行号
        node.line = line
        p.pos = p.pos + 1
    }

    /* 获取函数名字符串 */
    tok = parserPeekToken(p)
    若 tok.类型 == 2 则 {
        node.name = tok.值
        p.pos = p.pos + 1
    }

    返回 node
}

