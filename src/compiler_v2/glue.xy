/**
 * @file glue.xy
 * @brief L2自举胶水代码 — 仅包含主函数和外部声明
 * @description 所有重模块（lexer/parser/sema/codegen）由L1预编译为.o
 *              L2只需编译此轻量文件，链接预编译模块即可
 */

/* ============ 外部函数声明（由L1预编译提供） ============ */
外部 函数 tokenize(源码: 文本): 列表
外部 函数 parser分析Tokens(tokens: 列表, source: 文本): AST节点
外部 函数 semaInit(源码: 文本): Sema
外部 函数 sema分析AST(sema: Sema, ast: AST节点): 整数
外部 函数 codegen遍历AST(ast: AST节点): 文本

/* ============ 主函数 ============ */

函数 主(): 整数 {
    定义 可变 参数个数: 整数
    参数个数 = 获取参数个数()

    定义 可变 源文件: 文本
    定义 可变 ir文件路径: 文本
    源文件 = ""
    ir文件路径 = ""

    定义 可变 i: 整数
    i = 1
    当 i < 参数个数 则 {
        定义 可变 p: 文本
        p = 获取参数(i)

        若 p == "--ir-file" 则 {
            i = i + 1
            若 i < 参数个数 则 {
                ir文件路径 = 获取参数(i)
            }
        } 否则 若 p == "--version" || p == "-v" 则 {
            打印("玄语L2编译器 (自举)")
            打印("版本 0.2.0")
            返回 0
        } 否则 若 p == "--help" || p == "-h" 则 {
            打印("用法: xyc <源文件> --ir-file <输出>")
            返回 0
        } 否则 {
            源文件 = p
        }

        i = i + 1
    }

    若 源文件 == "" 则 {
        打印("错误: 请指定源文件")
        返回 1
    }

    /* 读取源文件 */
    定义 可变 源码: 文本
    源码 = 读取文件(源文件)
    若 文本长度(源码) == 0 则 {
        打印("错误: 文件为空")
        返回 1
    }

    /* 阶段1: 词法分析 */
    定义 可变 tokens: 列表
    tokens = tokenize(源码)
    打印("词法分析完成: ")
    打印整数(列表长度(tokens))
    打印(" tokens")

    /* 阶段2: 语法分析 */
    定义 可变 ast: AST节点
    ast = parser分析Tokens(tokens, 源码)
    打印("语法分析完成: ")
    打印整数(列表长度(ast.children))
    打印(" 声明")

    /* 阶段3: 语义分析 */
    定义 可变 sema: Sema
    sema = semaInit("")
    定义 可变 errors: 整数
    errors = sema分析AST(sema, ast)
    若 errors > 0 则 {
        打印("语义错误: ")
        打印整数(errors)
        返回 1
    }
    打印("语义分析通过")

    /* 阶段4: 代码生成 */
    定义 可变 ir: 文本
    ir = codegen遍历AST(ast)

    若 ir文件路径 != "" 则 {
        写入文件(ir文件路径, ir)
        打印("IR 已写入: ")
        打印(ir文件路径)
    } 否则 {
        打印(ir)
    }

    打印("编译成功!")
    返回 0
}
