/**
 * @file compiler_new.xy
 * @brief 玄语L2编译器 - 整合驱动
 * @description 整合词法分析、语法分析、语义分析、代码生成（使用引入替代外部）
 */

/* ============ 模块导入 ============ */

引入 "types"
引入 "lexer_s"
引入 "parser_s"
引入 "sema_s"
引入 "codegen_s"

/* ============ 常量定义 ============ */

常量 退出成功 = 0
常量 退出失败 = 1

/* ============ 打印函数 ============ */

函数 打印换行(): 无返回 {
    打印("")
}

函数 打印横线(): 无返回 {
    打印("========================================")
}

函数 打印编译器名称(): 无返回 {
    打印("玄语L2编译器")
}

函数 打印版本信息(): 无返回 {
    打印("版本 v0.4.0-alpha L2 自举编译器")
}

函数 打印用法(): 无返回 {
    打印横线()
    打印编译器名称()
    打印版本信息()
    打印横线()
    打印换行()
    打印("用法: xyc <源文件> [选项]")
    打印换行()
    打印("选项:")
    打印("  -o <输出>   指定输出文件名")
    打印("  --ir        输出LLVM IR")
    打印("  --run       编译后运行")
    打印("  -h, --help  显示帮助")
    打印("  -v, --version 显示版本")
    打印换行()
}

/* ============ 词法分析阶段 ============ */

函数 执行词法分析(源码: 文本): 列表 {
    打印("=== 词法分析 ===")
/*[DBG]     打印("DEBUG 执行词法分析: 源码长度=") */
/*[DBG]     打印整数(文本长度(源码)) */
/*[DBG]     打印("\n") */
    定义 可变 tokens: 列表
    tokens = tokenize(源码)
    打印("词法分析完成，共 ")
    打印整数(列表长度(tokens))
    打印(" 个 Token")
    打印换行()
    返回 tokens
}

/* ============ 语法分析阶段 ============ */

函数 执行语法分析(tokens: 列表, 源码: 文本): AST节点 {
    打印("=== 语法分析 ===")
/*[DBG]     打印("DEBUG 执行语法分析: 调用 parser分析Tokens") */
    定义 可变 ast: AST节点
    ast = parser分析Tokens(tokens, 源码)
    打印("语法分析完成，共 ")
    打印整数(列表长度(ast.children))
    打印(" 个顶层声明")
    打印换行()
    打印换行()
    返回 ast
}

/* ============ 语义分析阶段 ============ */

函数 执行语义分析(ast: AST节点): 整数 {
    打印("=== 语义分析 ===")
    定义 可变 sema: Sema
    sema = semaInit("")
    定义 可变 错误数: 整数
    错误数 = sema分析AST(sema, ast)
    若 错误数 > 0 则 {
        打印("语义分析发现 ")
        打印整数(错误数)
        打印(" 个错误")
    } 否则 {
        打印("语义分析完成，无错误")
    }
    打印换行()
    返回 错误数
}

/* ============ 代码生成阶段 ============ */

函数 执行代码生成(ast: AST节点): 文本 {
    打印("=== 代码生成 ===")
    定义 可变 ir: 文本
    ir = codegen遍历AST(ast)
    打印("代码生成完成")
    打印换行()
    返回 ir
}

/* ============ 编译单个源文件 ============ */

函数 编译源文件(源文件路径: 文本, ir文件路径: 文本): 整数 {
/*[DBG]     打印("DEBUG: 进入编译源文件函数\n") */

    定义 可变 源码: 文本
    源码 = 读取文件(源文件路径)
/*[DBG]     打印("DEBUG: 文件读取完成，长度: ") */
/*[DBG]     打印整数(文本长度(源码)) */
/*[DBG]     打印("\n") */

    若 文本长度(源码) == 0 则 {
        打印("ERROR: 文件为空\n")
        返回 退出失败
    }

    // 阶段1: 词法分析
    定义 可变 tokens: 列表
    tokens = 执行词法分析(源码)

    // 阶段2: 语法分析
/*[DBG]     打印("DEBUG: tokens list has ") */
/*[DBG]     打印整数(列表长度(tokens)) */
/*[DBG]     打印(" elements\n") */
/*[DBG]     打印("DEBUG: 准备调用执行语法分析\n") */
    定义 可变 ast: AST节点
    ast = 执行语法分析(tokens, 源码)
/*[DBG]     打印("DEBUG: 语法分析完成\n") */

    // 阶段3: 语义分析
/*[DBG]     打印("DEBUG: 准备调用执行语义分析\n") */
    定义 可变 错误数: 整数
    错误数 = 执行语义分析(ast)
/*[DBG]     打印("DEBUG: 语义分析完成\n") */

    若 错误数 > 0 则 {
        打印横线()
        打印("编译失败: 发现 ")
        打印整数(错误数)
        打印(" 个语义错误")
        打印横线()
        返回 退出失败
    }

    // 阶段4: 代码生成
/*[DBG]     打印("DEBUG: 准备调用执行代码生成\n") */
    定义 可变 ir: 文本
    ir = 执行代码生成(ast)
/*[DBG]     打印("DEBUG: 代码生成完成\n") */

    // 输出IR
    若 ir文件路径 == "" 则 {
        打印横线()
        打印("生成的LLVM IR:")
        打印横线()
        打印(ir)
        打印横线()
    } 否则 {
        写入文件(ir文件路径, ir)
        打印("IR 已写入: ")
        打印(ir文件路径)
        打印换行()
    }

    打印("编译成功!")
    打印横线()

    返回 退出成功
}

/* ============ 主函数 ============ */

函数 主(): 整数 {
/*[DBG]     打印("DEBUG[主]: 进入主函数\n") */
    定义 可变 i: 整数
    定义 可变 显示帮助: 整数
    定义 可变 显示版本: 整数
    定义 可变 源文件: 文本
    定义 可变 输出模式: 文本
    定义 可变 ir文件路径: 文本

/*[DBG]     打印("DEBUG[主]: 初始化变量\n") */
    i = 0
    显示帮助 = 0
    显示版本 = 0
    源文件 = ""
    输出模式 = "ir"
    ir文件路径 = ""

    定义 可变 参数个数: 整数
    参数个数 = 获取参数个数()
/*[DBG]     打印("DEBUG[主]: 参数个数: ") */
/*[DBG]     打印整数(参数个数) */
/*[DBG]     打印("\n") */

    i = 1
    当 i < 参数个数 则 {
        定义 可变 参数: 文本
        参数 = 获取参数(i)

/*[DBG]         打印("DEBUG[主]: 参数 ") */
/*[DBG]         打印整数(i) */
/*[DBG]         打印(": ") */
/*[DBG]         打印(参数) */
/*[DBG]         打印("\n") */

        若 参数 == "-h" || 参数 == "--help" 则 {
            显示帮助 = 1
        } 否则 {
            若 参数 == "-v" || 参数 == "--version" 则 {
                显示版本 = 1
            } 否则 {
                若 参数 == "--ir" 则 {
                    输出模式 = "ir"
                } 否则 {
                    若 参数 == "--run" 则 {
                        输出模式 = "run"
                    } 否则 {
                        若 参数 == "-o" 则 {
                            i = i + 1
                        } 否则 {
                            若 参数 == "--ir-file" 则 {
                                i = i + 1
                                若 i < 参数个数 则 {
                                    ir文件路径 = 获取参数(i)
                                }
                            } 否则 {
                                源文件 = 参数
                            }
                        }
                    }
                }
            }
        }

        i = i + 1
    }

    若 显示帮助 == 1 则 {
        打印用法()
        返回 退出成功
    }

    若 显示版本 == 1 则 {
        打印横线()
        打印编译器名称()
        打印版本信息()
        打印横线()
        返回 退出成功
    }

    若 源文件 == "" 则 {
/*[DBG]         打印("DEBUG: 未指定源文件\n") */
        打印用法()
        返回 退出失败
    }

/*[DBG]     打印("DEBUG: 源文件路径: ") */
/*[DBG]     打印(源文件) */
/*[DBG]     打印("\n") */
/*[DBG]     打印("DEBUG: IR输出路径: ") */
/*[DBG]     打印(ir文件路径) */
/*[DBG]     打印("\n") */

/*[DBG]     打印("DEBUG: 准备调用编译源文件\n") */
    定义 可变 结果: 整数
    结果 = 编译源文件(源文件, ir文件路径)
/*[DBG]     打印("DEBUG: 编译完成，返回: ") */
/*[DBG]     打印整数(结果) */
/*[DBG]     打印("\n") */

    返回 结果
}
