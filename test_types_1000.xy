枚举 TokenType {
    标识符,     // 0 - Id
    数字,       // 1 - Num
    字符串,     // 2 - Str
    关键字,     // 3 - Kw
    运算符,     // 4 - Op
    符号,       // 5 - Sym
    结束,       // 6 - Eof
    注释,       // 7 - Comment
    字符,       // 8 - Char
    赋值,       // 9 - Assign
    比较,       // 10 - Compare
    逻辑,       // 11 - Logical
    错误        // 12 - Error
}

/* ============ Token 结构 ============ */

结构体 Token {
    类型: 整数,      // TokenType
    值: 文本,        // token 文本值
    行号: 整数,      // 所在行
    列号: 整数,      // 所在列
    开始位置: 整数,  // 在源码中的开始位置
    结束位置: 整数   // 在源码中的结束位置
}

/* ============ AST 节点类型 ============ */

枚举 AST节点类型 {
    程序 = 0,
    函数定义 = 1,
    参数列表 = 2,
    变量定义 = 3,
    赋值语句 = 4,
    if语句 = 5,
    while语句 = 6,
    循环语句 = 7,
    返回语句 = 8,
    表达式语句 = 9,
    二元表达式 = 10,
    一元表达式 = 11,
    调用表达式 = 12,
    标识符表达式 = 13,
    字面量表达式 = 14,
    类型转换 = 15,
    break语句 = 16,
    continue语句 = 17,
    块语句 = 18,
    赋值表达式 = 19,
    for循环 = 20,
    结构体定义 = 21,
    枚举定义 = 22,
    结构体字段 =
函数 主(): 整数 { 返回 0 }
