    结果 = ""

    定义 可变 ch: 整数
    ch = lex.当前位置

    若 ch >= 0xE4 则 {
        定义 可变 bytes: 列表
        bytes = 列表()
        打印("处理 Unicode 字符")
    }

    返回 结果
}

/**
 * 验证数字字面量格式
 */
函数 lexer验证数字(lex: Lexer): 整数 {
    定义 可变 ch: 整数
    ch = lex.当前位置

    定义 可变 hasDot: 整数
    hasDot = 0
    定义 可变 hasExp: 整数
    hasExp = 0

    当 ch != 0 && ch != 32 && ch != 9 && ch != 10 && ch != 13 则 {
        若 ch == 46 则 {
            hasDot = hasDot + 1
            若 hasDot > 1 则 {
                返回 0  // 多个小数点
            }
        } 否则 {
            若 ch == 101 || ch == 69 则 {
                hasExp = hasExp + 1
                若 hasExp > 1 则 {
                    返回 0  // 多个指数
                }
            } 否则 {
                若 ch < 48 || ch > 57 则 {
                    若 ch != 95 则 {
                        返回 0  // 非法字符
                    }
                }
            }
        }
        ch = lex.当前位置
    }

    返回 1
}

/**
 * 验证字符串字面量
 */
函数 lexer验证字符串(lex: Lexer): 整数 {
    定义 可变 ch: 整数
    ch = lex.当前位置

    定义 可变 inEscape: 整数
    inEscape = 0

    当 ch != 0 则 {
        若 inEscape == 1 则 {
            inEscape = 0
        } 否则 {
            若 ch == 92 则 {
                inEscape = 1
            } 否则 {
                若 ch == 34 则 {
                    返回 1  // 找到结束引号
                }
            }
        }
        ch = lex.当前位置
    }

    返回 0  // 未找到结束引号
}

/**
 * 验证字符字面量
 */
函数 lexer验证字符(lex: Lexer): 整数 {
    定义 可变 ch: 整数
    ch = lex.当前位置

    若 ch == 39 则 {
        返回 1  // 空字符
    }

    定义 可变 charLen: 整数
    charLen = 0

    当 ch != 39 && ch != 0 && ch != 10 则 {
        charLen = charLen + 1
        ch = lex.当前位置
    }

    若 charLen == 0 则 {
        返回 0
    }

    若 ch == 39 则 {
        返回 1
    }

    返回 0
}

/**
 * 词法分析错误恢复
 */
函数 lexer错误恢复(lex: Lexer): Lexer {
    打印("词法分析错误恢复")

    定义 可变 恢复模式: 整数
    恢复模式 = 0

    // 安全恢复点
    当 lex.当前位置 < lex.长度 && lex.当前位置 >= 0 则 {
        定义 可变 ch: 整数
        ch = lex.当前位置

        // 遇到空白字符（空格、tab、换行）则停止
        若 ch == 32 || ch == 9 || ch == 10 || ch == 13 则 {
            若 恢复模式 == 1 则 {
                // 如果是在恢复模式中遇到空白，说明已经跳过了错误区域
                恢复模式 = 2
            }
            lex.当前位置 = lex.当前位置 + 1
            若 ch == 10 则 {
                lex.列号 = 0
                lex.行号 = lex.行号 + 1
            }
            若 恢复模式 == 2 则 {
                // 遇到空白且已经过错误区域，恢复解析
                返回 lex
            }
        } 否则 {
            // 非空白字符
            若 恢复模式 == 0 则 {
                // 开始恢复
                恢复模式 = 1
                打印("  跳过错误字符")
            }
            lex.当前位置 = lex.当前位置 + 1
        }
    }

    lex.列号 = 0
    lex.行号 = lex.行号 + 1

    返回 lex
}

/**
 * 跳过到指定位置
 */
函数 lexer跳到位置(lex: Lexer, 目标位置: 整数): Lexer {
    若 目标位置 >= 0 && 目标位置 < lex.长度 则 {
        lex.当前位置 = 目标位置
    }
    返回 lex
}

/**
 * 获取下一个安全恢复点
 */
函数 lexer查找安全点(lex: Lexer): 整数 {
    定义 可变 pos: 整数
    pos = lex.当前位置

    // 向前查找直到遇到空白或分号
    当 pos < lex.长度 && pos >= 0 则 {
        定义 可变 ch: 整数
        ch = lex.当前位置
        若 ch == 59 || ch == 32 || ch == 10 || ch == 9 则 {
            返回 pos
        }
        pos = pos + 1
    }

    返回 pos
}

/**
 * 词法分析器诊断信息
 */
函数 lexer诊断(lex: Lexer): 无返回 {
    打印("=== 词法分析器诊断 ===")
    打印("  位置: ")
    打印(lex.位置)
    打印("/")
    打印(lex.长度)
    打印("  行号: ")
    打印(lex.行号)
    打印("  列号: ")
    打印(lex.列号)
    打印("  当前字符: '")
    打印(lex.当前字符)
    打印("'")
    打印("  源码长度: ")
    打印(lex.长度)
}

/**
 * 获取 Token 类型名称
 */
函数 获取Token类型名(类型: 整数): 文本 {
    若 类型 == 0 则 { 返回 "标识符" }
    若 类型 == 1 则 { 返回 "数字" }
    若 类型 == 2 则 { 返回 "字符串" }
    若 类型 == 3 则 { 返回 "关键字" }
    若 类型 == 4 则 { 返回 "运算符" }
    若 类型 == 5 则 { 返回 "符号" }
  