    若 text == "proc" 则 { 返回 1 }
    若 text == "return" 则 { 返回 1 }
    若 text == "async" 则 { 返回 1 }
    若 text == "await" 则 { 返回 1 }
    若 text == "spawn" 则 { 返回 1 }

    /* ========== 数据类型 (英文别名) ========== */
    若 text == "int" 则 { 返回 1 }
    若 text == "i64" 则 { 返回 1 }
    若 text == "long" 则 { 返回 1 }
    若 text == "float" 则 { 返回 1 }
    若 text == "f64" 则 { 返回 1 }
    若 text == "double" 则 { 返回 1 }
    若 text == "bool" 则 { 返回 1 }
    若 text == "string" 则 { 返回 1 }
    若 text == "str" 则 { 返回 1 }
    若 text == "char" 则 { 返回 1 }
    若 text == "void" 则 { 返回 1 }
    若 text == "ptr" 则 { 返回 1 }
    若 text == "pointer" 则 { 返回 1 }
    若 text == "list" 则 { 返回 1 }
    若 text == "Option" 则 { 返回 1 }

    /* ========== 内存安全与所有权 (英文别名) ========== */
    若 text == "let" 则 { 返回 1 }
    若 text == "mut" 则 { 返回 1 }
    若 text == "ref" 则 { 返回 1 }
    若 text == "borrow" 则 { 返回 1 }
    若 text == "mut_ref" 则 { 返回 1 }
    若 text == "move" 则 { 返回 1 }
    若 text == "own" 则 { 返回 1 }
    若 text == "manual" 则 { 返回 1 }
    若 text == "unsafe" 则 { 返回 1 }

    /* ========== 可见性与修饰符 (英文别名) ========== */
    若 text == "public" 则 { 返回 1 }
    若 text == "private" 则 { 返回 1 }
    若 text == "const" 则 { 返回 1 }
    若 text == "static" 则 { 返回 1 }
    若 text == "extern" 则 { 返回 1 }

    /* ========== 模块系统 (英文别名) ========== */
    若 text == "module" 则 { 返回 1 }
    若 text == "import" 则 { 返回 1 }
    若 text == "use" 则 { 返回 1 }
    若 text == "export" 则 { 返回 1 }
    若 text == "pub" 则 { 返回 1 }

    /* ========== 错误处理 (英文别名) ========== */
    若 text == "try" 则 { 返回 1 }
    若 text == "catch" 则 { 返回 1 }
    若 text == "throw" 则 { 返回 1 }
    若 text == "finally" 则 { 返回 1 }

    /* ========== 元编程 (英文别名) ========== */
    若 text == "macro" 则 { 返回 1 }
    若 text == "expand" 则 { 返回 1 }

    /* ========== 复合数据类型 (英文别名) ========== */
    若 text == "struct" 则 { 返回 1 }
    若 text == "enum" 则 { 返回 1 }
    若 text == "union" 则 { 返回 1 }
    若 text == "type" 则 { 返回 1 }

    /* ========== 任意类型 (英文别名) ========== */
    若 text == "Any" 则 { 返回 1 }

    返回 0
}

/* ============ 字符串切片函数 ============ */

/**
 * 提取子字符串
 * 使用运行时函数文本切片
 */
函数 提取子串(源码: 文本, 开始: 整数, 结束: 整数): 文本 {
    定义 可变 结果: 文本
    打印("DEBUG 提取子串: 开始=")
    打印整数(开始)
    打印(" 结束=")
    打印整数(结束)
    结果 = 文本切片(源码, 开始, 结束)
    打印(" 结果长度=")
    定义 可变 len: 整数
    len = 文本长度(结果)
    打印整数(len)
    打印(" 内容:")
    定义 可变 i: 整数
    i = 0
    当 i < len 则 {
        定义 可变 ch: 文本
        ch = 文本获取字符(结果, i)
        定义 可变 code: 整数
        code = 字符编码(ch)
        打印整数(code)
        打印(" ")
        i = i + 1
    }
    打印("\n")
    返回 结果
}

/* ============ Lexer 核心函数 ============ */

/**
 * 获取字符
 */
函数 获取字符(lex: Lexer): 整数 {
    若 lex.位置 < lex.长度 则 {
        定义 可变 ch: 整数
        ch = 字符编码(文本获取字符(lex.源码, lex.位置))
        返回 ch
    }
    返回 0
}

/**
 * 初始化词法分析器
 */
函数 lexerInit(源码: 文本, 长度: 整数): Lexer {
    定义 可变 lex: Lexer
    lex.源码 = 源码
    lex.位置 = 0
    lex.长度 = 长度
    打印("DEBUG lexerInit: 源码长度=")
    打印整数(lex.长度)
    打印("\n")
    lex.行号 = 1
    lex.列号 = 1
    lex.开始位置 = 0
    lex.当前位置 = 0
    打印("DEBUG lexerInit: 调用获取字符\n")
    lex.当前字符 = 获取字符(lex)
    打印("DEBUG lexerInit: 当前字符=")
    打印整数(lex.当前字符)
    打印("\n")
    返回 lex
}

/**
 * 前进到下一个字符（支持UTF-8多字节字符）
 */
函数 lexer前进(lex: Lexer): Lexer {
    定义 可变 步长: 整数
    步长 = utf8字节长度(lex.当前字符)

    lex.位置 = lex.位置 + 步长
    lex.列号 = lex.列号 + 1

    若 lex.位置 < lex.长度 则 {
        lex.当前字符 = 字符编码(文本获取字符(lex.源码, lex.位置))
    } 否则 {
        lex.当前字符 = 0
    }

    若 lex.当前字符 == 10 则 {
        lex.行号 = lex.行号 + 1
        lex.列号 = 1
    }

    返回 lex
}

/**
 * 跳过空白字符
 */
函数 lexer跳过空白(lex: Lexer): Lexer {
    当 是空白(lex.当前字符) == 1 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }
    lex.开始位置 = lex.位置
    返回 lex
}

/**
 * 读取注释
 */
函数 lexer读取注释(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 7  // 注释
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    // 检查是 // 还是 /*
    若 lex.当前字符 == 47 则 {  // /
        定义 可变 nextCh: 整数
        nextCh = 0
        若 lex.位置 + 1 < lex.长度 则 {
            nextCh = 字符编码(文本获取字符(lex.源码, lex.位置 + 1))
        }

        若 nextCh == 47 则 {
            // 单行注释 // ... 一直到换行
            当 lex.当前字符 != 10 && lex.当前字符 != 0 则 {
                lex = lexer前进(lex)
            }
        } 否则 {
            若 nextCh == 42 则 {
                // 多行注释 /* ... */
                lex = lexer前进(lex)  // 跳过 /
                lex = lexer前进(lex)  // 跳过 *
                当 lex.当前字符 != 0 则 {
                    // 检查是否到达文件末尾，避免越界访问
                    若 lex.位置 + 1 >= lex.长度 则 {
                        跳出
                    }
                    若 lex.当前字符 == 42 && 字符编码(文本获取字符(lex.源码, lex.位置 + 1)) == 47 则 {
                        lex = lexer前进(lex)  // 跳过 *
                        lex = lexer前进(lex)  // 跳过 /
                        跳出
                    }
                    lex = lexer前进(lex)
                }
            } 否则 {
                // 单独的 / 是除法运算符，不是注释
                lex = lexer前进(lex)
                tok.类型 = 4  // 运算符
            }
        }
    }

    tok.结束位置 = lex.位置

    // 提取注释内容
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    lex.当前token = tok
    返回 lex
}

/**
 * 读取字符字面量
 */
函数 lexer读取字符(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 8  // 字符
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    // 跳过开始的单引号
    lex = lexer前进(lex)

    // 读取字符内容（支持转义）
    若 lex.当前字符 == 92 则 {  // 反斜杠 \
        lex = lexer前进(lex)  // 跳过反斜杠
        // 处理转义字符
        若 lex.当前字符 == 110 则 {  // \n
            lex = lexer前进(lex)
        } 否则 {
            若 lex.当前字符 == 116 则 {  // \t
                lex = lexer前进(lex)
            } 否则 {
                若 lex.当前字符 == 92 则 {  // \\
                    lex = lexer前进(lex)
                } 否则 {
                    若 lex.当前字符 == 39 则 {  // \'
                        lex = lexer前进(lex)
                    }
                }
            }
        }
    } 否则 {
        若 lex.当前字符 != 39 && lex.当前字符 != 0 则 {
            lex = lexer前进(lex)
        }
    }

    // 跳过结束的单引号
    若 lex.当前字符 == 39 则 {
        lex = lexer前进(lex)
    }

    tok.结束位置 = lex.位置

    // 提取字符值（包括引号）
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    lex.当前token = tok
    返回 lex
}

/**
 * 读取复合运算符（==, !=, <=, >=, &&, ||）
 */
函数 lexer读取复合运算符(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 10  // 比较
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    定义 可变 firstCh: 整数
    firstCh = lex.当前字符

    lex = lexer前进(lex)
    定义 可变 nextCh: 整数
    nextCh = lex.当前字符

    定义 可变 op: 文本
    op = ""

    // 双字符运算符
    若 firstCh == 61 && nextCh == 61 则 {
        op = "=="
        lex = lexer前进(lex)
    } 否则 {
        若 firstCh == 33 && nextCh == 61 则 {
            op = "!="
            lex = lexer前进(lex)
        } 否则 {
            若 firstCh == 60 && nextCh == 61 则 {
                op = "<="
                lex = lexer前进(lex)
            } 否则 {
                若 firstCh == 62 && nextCh == 61 则 {
                    op = ">="
                    lex = lexer前进(lex)
                } 否则 {
                    若 firstCh == 38 && nextCh == 38 则 {
                        op = "&&"
                        tok.类型 = 11  // 逻辑
                        lex = lexer前进(lex)
                    } 否则 {
                        若 firstCh == 124 && nextCh == 124 则 {
                            op = "||"
                            tok.类型 = 11  // 逻辑
                            lex = lexer前进(lex)
                        } 否则 {
                            // 单字符运算符
                            若 firstCh == 61 则 { op = "=" }
                            若 firstCh == 60 则 { op = "<" }
                            若 firstCh == 62 则 { op = ">" }
                            若 firstCh == 33 则 { op = "!" }
                        }
                    }
                }
            }
        }
    }

    tok.结束位置 = lex.位置
    tok.值 = op

    lex.当前token = tok
    返回 lex
}

/**
 * 读取标识符或关键字
 */
函数 lexer读取标识符(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 0
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    当 是字母或数字(lex.当前字符) == 1 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }

    tok.结束位置 = lex.位置

    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    若 是关键字(提取的值) == 1 则 {
        tok.类型 = 3
    }

    lex.当前token = tok
    返回 lex
}

/**
 * 读取数字
 */
函数 lexer读取数字(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 1
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    当 是数字(lex.当前字符) == 1 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }

    tok.结束位置 = lex.位置

    // 使用文本切片提取实际 token 值
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    lex.当前token = tok
    返回 lex
}

/**
 * 读取字符串
 */
函数 lexer读取字符串(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 2
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    // 跳过开始的双引号
    lex = lexer前进(lex)

    当 lex.当前字符 != 34 && lex.当前字符 != 0 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }

    若 lex.当前字符 == 34 则 {
        lex = lexer前进(lex)
    }

    tok.结束位置 = lex.位置

    // 使用文本切片提取实际 token 值（包括引号）
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    lex.当前token = tok
    返回 lex
}

/**
 * 读取运算符
 */
函数 lexer读取运算符(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 4
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始

    当 是运算符(lex.当前字符) == 1 && lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }

    tok.结束位置 = lex.位置

    // 使用文本切片提取实际 token 值
    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, lex.位置)
    tok.值 = 提取的值

    lex.当前token = tok
    返回 lex
}

/**
 * 读取符号
 */
函数 lexer读取符号(lex: Lexer): Lexer {
    定义 可变 tok: Token
    定义 可变 开始: 整数
    开始 = lex.开始位置

    tok.类型 = 5
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = 开始
    tok.结束位置 = lex.位置 + 1

    定义 可变 结束位置: 整数
    结束位置 = lex.位置 + 1
    若 结束位置 > lex.长度 则 {
        结束位置 = lex.长度
    }

    定义 可变 提取的值: 文本
    提取的值 = 提取子串(lex.源码, 开始, 结束位置)
    tok.值 = 提取的值

    lex = lexer前进(lex)

    lex.当前token = tok
    返回 lex
}

/**
 * 读取下一个 Token
 * 返回更新后的 Lexer（token存储在 lex.当前token 中）
 */
函数 lexerNextToken(lex: Lexer): Lexer {
    定义 可变 tok: Token
    tok.类型 = 6
    tok.值 = ""
    tok.行号 = lex.行号
    tok.列号 = lex.列号
    tok.开始位置 = lex.位置
    tok.结束位置 = lex.位置

    打印("DEBUG lexerNextToken: 位置=")
    打印整数(lex.位置)
    打印(" 长度=")
    打印整数(lex.长度)
    打印(" 当前字符=")
    打印整数(lex.当前字符)
    打印("\n")

    lex = lexer跳过空白(lex)

    定义 可变 ch: 整数
    ch = lex.当前字符

    tok.开始位置 = lex.开始位置
    tok.行号 = lex.行号
    tok.列号 = lex.列号

    // 文件结束
    若 ch == 0 则 {
        tok.类型 = 6
        tok.值 = "EOF"
        lex.当前token = tok
        返回 lex
    }

    // 字符串
    若 ch == 34 则 {
        lex = lexer读取字符串(lex)
        返回 lex
    }

    // 字符字面量
    若 ch == 39 则 {
        lex = lexer读取字符(lex)
        返回 lex
    }

    // 注释
    若 ch == 47 则 {
        定义 可变 nextCh: 整数
        nextCh = 0
        若 lex.位置 + 1 < lex.长度 则 {
            nextCh = 字符编码(文本获取字符(lex.源码, lex.位置 + 1))
        }
        若 nextCh == 47 || nextCh == 42 则 {
            lex = lexer读取注释(lex)
            返回 lex
        }
    }

    // 复合运算符 (==, !=, <=, >=, &&, ||)
    若 是比较起始(ch) == 1 则 {
        lex = lexer读取复合运算符(lex)
        返回 lex
    }

    // 字母开头 -> 标识符或关键字
    若 是字母(ch) == 1 则 {
        lex = lexer读取标识符(lex)
        返回 lex
    }

    // 数字开头 -> 数字
    若 是数字(ch) == 1 则 {
        lex = lexer读取数字(lex)
        返回 lex
    }

    // 单字符运算符 (+, -, *, /, %, etc.)
    若 是运算符(ch) == 1 则 {
        lex = lexer读取运算符(lex)
        返回 lex
    }

    // 符号
    若 是符号(ch) == 1 则 {
        lex = lexer读取符号(lex)
        返回 lex
    }

    // 未知字符
    lex = lexer前进(lex)
    tok.类型 = 12
    tok.值 = "UNKNOWN"
    tok.结束位置 = lex.位置
    lex.当前token = tok
    返回 lex
}

/* ============ 错误恢复和优化 ============ */

/**
 * 报告词法错误
 */
函数 lexer报告错误(lex: Lexer, 消息: 文本): 无返回 {
    打印("词法错误 (行")
    打印(lex.行号)
    打印(", 列")
    打印(lex.列号)
    打印("): ")
    打印(消息)
}

/**
 * 跳过到下一行
 */
函数 lexer跳到下一行(lex: Lexer): Lexer {
    当 lex.位置 < lex.长度 && lex.当前字符 != 10 则 {
        lex = lexer前进(lex)
    }
    若 lex.位置 < lex.长度 则 {
        lex = lexer前进(lex)
    }
    返回 lex
}

/**
 * 跳过当前 token
 */
函数 lexer跳过当前(lex: Lexer): Lexer {
    当 是空白(lex.当前字符) == 0 && lex.当前字符 != 0 则 {
        lex = lexer前进(lex)
    }
    返回 lex
}

/**
 * 检查是否为合法标识符起始字符
 */
函数 是合法标识符起始(ch: 整数): 整数 {
    若 ch >= 65 && ch <= 90 则 { 返回 1 }  // A-Z
    若 ch >= 97 && ch <= 122 则 { 返回 1 }  // a-z
    若 ch == 95 则 { 返回 1 }  // _
    若 ch >= 0xE4 则 { 返回 1 }  // 中文范围
    返回 0
}

/**
 * 检查是否为合法标识符字符
 */
函数 是合法标识符字符(ch: 整数): 整数 {
    若 是合法标识符起始(ch) == 1 则 { 返回 1 }
    若 ch >= 48 && ch <= 57 则 { 返回 1 }  // 0-9
    返回 0
}

/**
 * 验证标识符
 */
函数 lexer验证标识符(lex: Lexer): 整数 {
    定义 可变 ch: 整数
    ch = lex.当前位置

    若 是合法标识符起始(ch) == 0 则 {
        返回 0
    }

    定义 可变 pos: 整数
    pos = lex.位置 + 1

    当 pos < lex.长度 则 {
        ch = lex.当前位置
        若 是合法标识符字符(ch) == 0 则 {
            跳出
        }
        pos = pos + 1
    }

    返回 1
}

/**
 * 统计 token 类型分布
 */
函数 lexer统计Token分布(tokens: 列表): 列表 {
    定义 可变 统计: 列表
    统计 = 列表()

    打印("Token 类型分布:")

