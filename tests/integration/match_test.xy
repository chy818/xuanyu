/**
 * @file tests/integration/match_test.xy
 * @brief 模式匹配集成测试（枚举判别 + 默认分支）
 * @status 通过 (v0.3.0 prep: 最小可用 Match codegen)
 */

// 简单枚举定义
枚举 颜色 { 红, 绿, 蓝 }

/**
 * 主函数 - 枚举判别匹配
 */
函数 主 函数(): 整数 {
    定义 颜色值 = 红

    定义 可变 结果: 整数 = 0
    匹配 颜色值 {
        情况 红 => { 打印("红色") 结果 = 1 }
        情况 绿 => { 打印("绿色") 结果 = 2 }
        情况 蓝 => { 打印("蓝色") 结果 = 3 }
        默认 => { 打印("未知") 结果 = 0 }
    }
    // 期望输出: 红色 (命中 情况 红 分支，判别值比较 + 默认兜底)
    // 颜色值 == 红，因此结果应为 1
    打印整数(结果)
    返回 0
}