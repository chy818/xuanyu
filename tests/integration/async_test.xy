/**
 * @file tests/integration/async_test.xy
 * @brief 异步集成测试（启动 + 等待 并发执行）
 * @status 预期失败 / TODO(v0.3.0)
 * @description runtime 尚无协程调度器；parser 尚不支持 异步/启动 关键字（仅 lexer 有），
 *              codegen 对 Await 只是透传。本文件当前以 --ir-pure 编译会在语法分析阶段失败。
 *              异步特性(sema codegen + 协程调度器)落地后移除下方标记并接入 CI。
 */

/**
 * 异步函数示例
 */
函数 异步任务(名称: 文本, 次数: 整数): 整数 {
    定义 可变 总和 = 0
    循环 从 i 到 次数 {
        总和 = 总和 + i
    }
    返回 总和
}

/**
 * 主函数 - 启动并等待异步任务
 */
函数 主 函数(): 整数 {
    定义 任务一 = 启动 异步任务("任务一", 10)
    定义 任务二 = 启动 异步任务("任务二", 20)

    // 等待两个协程完成并汇总
    定义 结果一 = 等待 任务一
    定义 结果二 = 等待 任务二
    打印整数(结果一 + 结果二)

    // 期望输出: 55 (1..10) + 210 (1..20) = 265
    返回 0
}