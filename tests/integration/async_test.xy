/**
 * @file tests/integration/async_test.xy
 * @brief 异步集成测试（启动 + 等待 并发执行）
 * @status 通过 (v0.3.0)
 * @description 测试异步函数的启动、等待和结果汇总。
 *              协程包装器 + runtime 协程调度器已落地。
 */

/**
 * 异步任务：计算 0 + 1 + ... + (次数-1)
 */
异步 函数 异步任务(名称: 文本, 次数: 整数): 整数 {
    定义 可变 总和 = 0
    循环 从 i 到 次数 {
        总和 = 总和 + i
    }
    返回 总和
}

/**
 * 主函数 - 启动并等待异步任务
 */
函数 主 函数(): 整数 {
    定义 任务一 = 启动 异步任务("任务一", 10)
    定义 任务二 = 启动 异步任务("任务二", 20)

    // 等待两个协程完成并汇总
    定义 结果一 = 等待 任务一
    定义 结果二 = 等待 任务二
    打印整数(结果一 + 结果二)

    // 期望输出: 55 (0+1+...+10) + 210 (0+1+...+20) = 265
    返回 0
}